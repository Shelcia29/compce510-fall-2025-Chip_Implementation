@flow_step(genus_manage_ungrouping)  2:     foreach dpo [get_db insts -if {.base_cell.class != ""}] {
                                        	if {[get_db $dpo .parent.name] != [get_db flow_vars_design_name]} {
                                        	    set exit_loop false
                                        	} else {
                                        	    set exit_loop true
                                        	}
                                        	while {!$exit_loop} {
                                        	    set dpo [get_db $dpo .parent]
                                        	    set_db $dpo .ungroup_ok false
                                        	    if {[string first [string tolower [get_db flow_vars_design_name]] [string tolower [get_db $dpo .parent.name]]] == 0} {
                                        		set exit_loop true
                                        	    }
                                        	}
                                            }
  Setting attribute of hinst 'i_clk_div_inv': 'ungroup_ok' = false
  Setting attribute of hinst 'i_clk_divider': 'ungroup_ok' = false
  Setting attribute of hinst 'i_rst_sync1': 'ungroup_ok' = false
  Setting attribute of hinst 'i_rst_sync2': 'ungroup_ok' = false
  Setting attribute of hinst 'i_rst_sync_and': 'ungroup_ok' = false
