syn_map:@flow_step(pre_syn_map)  7:     if {![get_feature -feature add_scan]} {
syn_map:                            	# go through all instantiated cgs
syn_map:                            	foreach icg_inst [get_db [get_db insts -if {.base_name==inst_CKLNQD*}] .name] {
syn_map:                            	    puts "Info: ICG: $icg_inst ([get_db [get_db insts $icg_inst] .base_cell.base_name])"
syn_map:                            	    set_db [get_db pins $icg_inst/Q] .dft_controllable "[get_db pins $icg_inst/CP] non_inverting"
syn_map:                            
syn_map:                            	    # prevent Genus from adding RC_CG_INST* hierarchy to instantiated clock gates
syn_map:                            	    # Note, TE has to be connected manually to shift enable later on!
syn_map:                            	    set_db [get_db insts $icg_inst] .lp_clock_gating_exclude true
syn_map:                            	}
syn_map:                            	# go through all automatically inserted cgs
syn_map:                            	foreach aicg_inst [get_db [get_db insts *RC_CGIC_INST] .name] {
syn_map:                            	    if {[llength [get_db pins $aicg_inst/CP]]} {
syn_map:                            		set_db [get_db pins $aicg_inst/Q] .dft_controllable "[get_db pins $aicg_inst/CP] non_inverting"
syn_map:                            	    } elseif {[llength [get_db pins $aicg_inst/CPN]]} {
syn_map:                            		set_db [get_db pins $aicg_inst/Q] .dft_controllable "[get_db pins $aicg_inst/CPN] non_inverting"
syn_map:                            	    } else {
syn_map:                            		puts "Error: No CP nor CPN pin on inst: $aicg_inst. Cannot set cell output as dft_controllable"
syn_map:                            	    }
syn_map:                            	}
syn_map:                                }
