syn_map:#@ Begin verbose flow_step activate_views
syn_map:@flow_step(activate_views)  2:     set db [get_db flow_starting_db]
syn_map:@flow_step(activate_views)  3:     set flow [lindex [get_db flow_hier_path] end]
syn_map:@flow_step(activate_views)  4:     set setup_views [get_feature $flow -feature setup_views]
syn_map:@flow_step(activate_views)  5:     set hold_views [get_feature $flow -feature hold_views]
syn_map:@flow_step(activate_views)  6:     set leakage_view [get_feature $flow -feature leakage_view]
syn_map:@flow_step(activate_views)  7:     set dynamic_view [get_feature $flow -feature dynamic_view]
syn_map:@flow_step(activate_views)  9:     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
syn_map:                               	#- use read_db args for DB types and set_analysis_views for TCL
syn_map:                               	if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] eq {enc} && [file isfile [lindex $db 1]])} {
syn_map:                               	    set cmd "set_analysis_view"
syn_map:                               	    if {$setup_views ne ""} {
syn_map:                               		append cmd " -setup [list $setup_views]"
syn_map:                               	    } else {
syn_map:                               		append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
syn_map:                               	    }
syn_map:                               	    if {$hold_views ne ""} {
syn_map:                               		append cmd " -hold [list $hold_views]"
syn_map:                               	    } else {
syn_map:                               		append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
syn_map:                               	    }
syn_map:                               	    if {$leakage_view ne ""} {
syn_map:                               		append cmd " -leakage [list $leakage_view]"
syn_map:                               	    } else {
syn_map:                               		if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
syn_map:                               		    append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
syn_map:                               		}
syn_map:                               	    }
syn_map:                               	    if {$dynamic_view ne ""} {
syn_map:                               		append cmd " -dynamic [list $dynamic_view]"
syn_map:                               	    } else {
syn_map:                               		if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
syn_map:                               		    append cmd " -dynamic [list [get_db [get_db analysis_views -if .is_dynamic] .name]]"
syn_map:                               		}
syn_map:                               	    }
syn_map:                               	    eval $cmd
syn_map:                               	} elseif {[llength [get_db analysis_views]] == 0} {
syn_map:                               	    set_flowkit_read_db_args -setup_views "$setup_views" -hold_views "$hold_views" -leakage_view "$leakage_view" -dynamic_view "$dynamic_view"
syn_map:                               	} else {
syn_map:                               	}
syn_map:                                   }
syn_map:#@ End verbose flow_step activate_views
syn_map:##FLOW_KIT: enabling features from command line: {report_lec add_scan}
syn_map:#@ Begin verbose flow_step init_mcpu
syn_map:@flow_step(init_mcpu)  2:     # Multi host/cpu attributes
syn_map:@flow_step(init_mcpu)  3:     #-----------------------------------------------------------------------------
syn_map:@flow_step(init_mcpu)  4:     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
syn_map:@flow_step(init_mcpu)  5:     # the specified dist script.  This connects the number of CPUs being reserved
syn_map:@flow_step(init_mcpu)  6:     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_map:@flow_step(init_mcpu)  7:     # a typical environment variable exported by distribution platforms and is
syn_map:@flow_step(init_mcpu)  8:     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_map:@flow_step(init_mcpu)  9:     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_map:                          	set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_map:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_map:                          	set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_map:                              } else {
syn_map:                          	set max_cpus 8
syn_map:                              }
syn_map:@flow_step(init_mcpu) 17:     switch -glob [get_db program_short_name] {
syn_map:                          	joules*       -
syn_map:                          	genus*        {
syn_map:                          	    set_db max_cpus_per_server                $max_cpus
syn_map:                          	}
syn_map:                          	innovus*      -
syn_map:                          	tempus*       -
syn_map:                          	voltus*       {
syn_map:                          	    set_multi_cpu_usage -verbose -local_cpu   $max_cpus
syn_map:                          	    if {[get_feature -feature opt_signoff]} {
syn_map:                          		if {[is_flow -inside flow:opt_signoff]} {
syn_map:                          		    set_multi_cpu_usage -verbose -remote_host         1 -cpu_per_remote_host $max_cpus
syn_map:                          		    set_distributed_hosts                             -local
syn_map:                          		}
syn_map:                          	    }
syn_map:                          	    if {[get_feature -feature sta_eco]} {
syn_map:                          		if {[is_flow -inside flow:sta_eco]} {
syn_map:                          		    set_multi_cpu_usage -verbose -remote_host         1 -cpu_per_remote_host $max_cpus
syn_map:                          		    set_distributed_hosts                             -local
syn_map:                          		}
syn_map:                          	    }
syn_map:                          	}
syn_map:                          	default       {}
syn_map:                              }
