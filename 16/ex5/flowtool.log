syn_map:#@ Begin verbose flow_step syn_map.genus_to_lec
syn_map:@flow_step(genus_to_lec)  2:     #- create output location
syn_map:@flow_step(genus_to_lec)  3:     set design  [get_db current_design .name]
syn_map:@flow_step(genus_to_lec)  4:     if {[is_flow -quiet -inside flow:syn_opt] && [get_feature pnr_db_handoff]} {
syn_map:                                     set out_dir [lindex [get_db flow_starting_db] 1]/cmn
syn_map:                                 } else {
syn_map:                                     set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
syn_map:                                     file mkdir $out_dir
syn_map:                                 }
syn_map:@flow_step(genus_to_lec) 11:     #- write dofile for LEC
syn_map:@flow_step(genus_to_lec) 12:     if {[is_flow -inside flow:syn_map]} {
syn_map:                                     if {[file exists scripts/lec.pre_compare.tcl]} {
syn_map:                                         write_do_lec  -top $design  -golden_design rtl  -revised_design fv_map  -pre_compare scripts/lec.pre_compare.tcl  -no_lp  -no_exit  -logfile [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  > [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do]
syn_map:                                     } else {
syn_map:                                         write_do_lec  -top $design  -golden_design rtl  -revised_design fv_map  -no_lp  -no_exit  -logfile [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  > [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do]
syn_map:                                     }
syn_map:                             	# Note, TL: From Benoit. Check if still needed!
syn_map:                             	#- Add "analyze_datapath -flowgraph" to dofile
syn_map:                             	file rename -force [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do] [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do.tmp]
syn_map:                             	set file_r [open [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do.tmp] r]
syn_map:                             	set file_w [open [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do] w]
syn_map:                             	
syn_map:                             	while {![eof $file_r]} {
syn_map:                             	    set line [gets $file_r]
syn_map:                             	    if {[regexp {analyze_datapath[ \t]+-verbose;} $line]} {
syn_map:                             		set line [regsub {(analyze_datapath[ \t]+-verbose;)} $line {analyze_datapath -flowgraph -verbose;}]
syn_map:                             	    } elseif {[regexp "read_library.+-lp all.+" $line]} {
syn_map:                             		set line [regsub -- "-lp all " $line ""]
syn_map:                             	    }
syn_map:                             
syn_map:                             	    puts $file_w $line
syn_map:                             	}
syn_map:                             	
syn_map:                             	close $file_r
syn_map:                             	close $file_w
syn_map:                             	# Note, TL. Check if needed end!
syn_map:                             
syn_map:                                 } else {
syn_map:                                     if {[file exists scripts/lec.pre_compare.syn_opt.tcl]} {
syn_map:                                         write_do_lec  -top $design  -golden_design fv_map  -revised_design [file join $out_dir $design.v.gz]  -pre_compare scripts/lec.pre_compare.syn_opt.tcl  -no_lp  -logfile [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  > [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do]
syn_map:                                     } else {
syn_map:                                         write_do_lec  -top $design  -golden_design fv_map  -revised_design [file join $out_dir $design.v.gz]  -no_lp  -logfile [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  > [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do]
syn_map:                                     }
syn_map:                             	#- Add "analyze_datapath -flowgraph" to dofile
syn_map:                             	file rename -force [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do] [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do.tmp]
syn_map:                             	set file_r [open [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do.tmp] r]
syn_map:                             	set file_w [open [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do] w]
syn_map:                             	
syn_map:                             	while {![eof $file_r]} {
syn_map:                             	    set line [gets $file_r]
syn_map:                             	    if {[regexp "read_library.+-lp all.+" $line]} {
syn_map:                             		set line [regsub -- "-lp all " $line ""]
syn_map:                             	    }
syn_map:                             
syn_map:                             	    puts $file_w $line
syn_map:                             	}
syn_map:                             	
syn_map:                             	close $file_r
syn_map:                             	close $file_w
syn_map:                             
syn_map:                                 }
