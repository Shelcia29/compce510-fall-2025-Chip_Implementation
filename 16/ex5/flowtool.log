syn_generic:                                 	
syn_generic:                                 	# print memories into a text file (/reports folder)
syn_generic:                                 	set fp [open [get_db flow_report_directory]/[get_db flow_vars_design_name].memories.txt w]
syn_generic:                                 	if {[llength [get_db insts -if {.is_memory}]] > 0} {
syn_generic:                                 	    get_db insts -if {.is_memory} -foreach {puts $fp "[get_db $object .name] : [get_db $object .base_cell.name]"}
syn_generic:                                 	} else {
syn_generic:                                 	    puts $fp "no memories found"
syn_generic:                                 	}
syn_generic:                                 	
syn_generic:                                 	close $fp
syn_generic:                                     }
