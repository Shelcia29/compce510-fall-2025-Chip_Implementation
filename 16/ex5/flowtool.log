syn_generic:@file(mmmc_config.tcl) 12: array unset tcs
syn_generic:@file(mmmc_config.tcl) 13: array unset rcs
syn_generic:@file(mmmc_config.tcl) 14: array unset ocs
syn_generic:@file(mmmc_config.tcl) 15: foreach dc $mmmc_vars(delay_corners) {
syn_generic:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_generic:
syn_generic:    # temperature
syn_generic:    set temp_val "0.0"
syn_generic:    if {${temp} == "m40c" || ${temp} == "M40C"} {
syn_generic:        set temp_val "-40.0"
syn_generic:    } elseif {${temp} == "125c" || ${temp} == "125C"} {
syn_generic:        set temp_val "125.0"
syn_generic:    } elseif {${temp} == "25c" || ${temp} == "25C"} {
syn_generic:        set temp_val "25.0"
syn_generic:    } elseif {${temp} == "85c" || ${temp} == "85C"} {
syn_generic:        set temp_val "85.0"
syn_generic:    } else {
syn_generic:        set temp_val "0.0"
syn_generic:    }
syn_generic:    
syn_generic:    # voltage
syn_generic:    set volt_val "0.9"
syn_generic:    set volt_val [regsub {[v|V]} [regsub {[p|P]} $volt "."] ""]
syn_generic:    
syn_generic:
syn_generic:    ## LIBRARY SETS
syn_generic:    if {[get_db program_short_name] == "genus"} {
syn_generic:	create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_nldm)
syn_generic:    } elseif {[get_db program_short_name] == "innovus"} {
syn_generic:	create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
syn_generic:    } elseif {[get_db program_short_name] == "tempus"} {
syn_generic:        if {[info exist $mmmc_vars(${dc},timing_lvf)] && [info exist $mmmc_vars(${dc},timing_socv)]} {
syn_generic:            create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_lvf) -socv $mmmc_vars(${dc},timing_socv)
syn_generic:        } else {
syn_generic:            create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
syn_generic:        }
syn_generic:    } elseif {[get_db program_short_name] == "voltus"} {
syn_generic:        if {[info exist $mmmc_vars(${dc},timing_lvf)] && [info exist $mmmc_vars(${dc},timing_socv)]} {
syn_generic:            create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_lvf) -socv $mmmc_vars(${dc},timing_socv)
syn_generic:        } else {
syn_generic:            create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
syn_generic:        }
syn_generic:    } else {
syn_generic:	create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
syn_generic:    }
syn_generic:
syn_generic:    ## OPERATING CONDITIONS
syn_generic:    if {![info exists ocs("${volt}_${temp}")]} {
syn_generic:	create_opcond -name "${volt}_${temp}" -process 1.0 -voltage $volt_val -temperature $temp_val
syn_generic:	set ocs("${volt}_${temp}") 1
syn_generic:    }
syn_generic:
syn_generic:    ## TIMING CONDITIONS
syn_generic:    if {![info exists tcs("${corn}_${volt}_${temp}")]} {
syn_generic:	create_timing_condition -name "${corn}_${volt}_${temp}" -library_sets "${corn}_${volt}_${temp}_ls" -opcond "${volt}_${temp}"
syn_generic:	set tcs("${corn}_${volt}_${temp}") 1
syn_generic:    }
syn_generic:    
syn_generic:    ## RC CORNERS
syn_generic:    if {![info exists rcs("${rc}_${temp}")]} {
syn_generic:	create_rc_corner -name "${rc}_${temp}" -qrc_tech $mmmc_vars("${rc}_${temp}",qrc_tech) -temperature $mmmc_vars("${rc}_${temp}",temperature)
syn_generic:	set rcs("${rc}_${temp}") 1
syn_generic:    }
syn_generic:
syn_generic:    ## DELAY CORNERS
syn_generic:    create_delay_corner -name ${dc} -timing_condition "${corn}_${volt}_${temp}" -rc_corner "${rc}_${temp}"
syn_generic:
syn_generic:    ## ANALYSIS VIEWS
syn_generic:    foreach constraint_mode $mmmc_vars(constraint_modes) {
syn_generic:	create_analysis_view -name "${dc}_${constraint_mode}" -delay_corner $dc -constraint_mode $constraint_mode
syn_generic:    }
syn_generic:}
