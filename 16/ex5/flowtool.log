syn_map:#@ Begin verbose source ./scripts/mmmc_setup.tcl
syn_map:@file(mmmc_setup.tcl) 6: set MMMC_SETUP_VERSION "v1.0"
syn_map:@file(mmmc_setup.tcl) 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
syn_map:Info: MMMC SETUP: gpdk045 : v1.0
syn_map:@file(mmmc_setup.tcl) 11: set mmmc_vars(delay_corners) \
syn_map:    [list \
syn_map:	 slow_0p9v_125c_cmax \
syn_map:	 fast_1p1v_0c_cmin \
syn_map:	 ]
syn_map:@file(mmmc_setup.tcl) 19: foreach dc $mmmc_vars(delay_corners) {
syn_map:
syn_map:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_map:
syn_map:    # qrc techfile
syn_map:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
syn_map:    # temperature
syn_map:    if {${temp} == "m40c"} {
syn_map:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
syn_map:    } elseif {${temp} == "125c"} {
syn_map:	set mmmc_vars("${rc}_${temp}",temperature) "125"
syn_map:    } elseif {${temp} == "0c"} {
syn_map:	set mmmc_vars("${rc}_${temp}",temperature) "0"
syn_map:    } else {
syn_map:	set mmmc_vars("${rc}_${temp}",temperature) "25"
syn_map:    }
syn_map:
syn_map:
syn_map:    ###########################################
syn_map:    # OCVs &  Clock uncertainties for FLAT OCV
syn_map:    ###########################################
syn_map:
syn_map:    # use following uncertainties
syn_map:    # FUNC:
syn_map:    # setup:
syn_map:    # clock jitter: defined through clock cycle
syn_map:    # TECH uncertainty: 25ps
syn_map:    # extra uncertainty (implementation): 20ps
syn_map:    # extra uncertainty (signoff STA): 0ps
syn_map:    # hold:
syn_map:    # TECH uncertainty (SSG): 50ps
syn_map:    # TECH uncertainty (fast): 40ps
syn_map:    # extra uncertainty (implementation): 15ps
syn_map:    # extra uncertainty (signoff STA): 0ps
syn_map:
syn_map:    # Note, add 1% OCV on top of previous to match LVF
syn_map:    # so flat values below have 0.01 added (subtracted) because of this
syn_map:
syn_map:    # setup in slow, 0.81v, -40C/125c, cmax
syn_map:    if {$corn eq "slow" &&
syn_map:	$volt eq "0p9v" &&
syn_map:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_map:	($rc eq "cmax")} {
syn_map:	
syn_map:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
syn_map:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
syn_map:	# +2.0% for launching clock cell
syn_map:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
syn_map:	# hold not checked in this corner
syn_map:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
syn_map:	# + 6.9% on data cell
syn_map:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
syn_map:
syn_map:	# -6.0% for clock net
syn_map:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
syn_map:	# +6.0% for clock net
syn_map:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
syn_map:	# hold not checked in this corner
syn_map:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
syn_map:	# +6.0 for data net
syn_map:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
syn_map:
syn_map:    # hold in slow, 0.81v, -40c/125c, cmax
syn_map:    } elseif {$corn eq "slow" &&
syn_map:	      $volt eq "0p9v" &&
syn_map:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_map:	      ($rc eq "cmax")} {
syn_map:	
syn_map:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
syn_map:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
syn_map:	# +3.2% for capturing clock cell
syn_map:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
syn_map:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
syn_map:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
syn_map:	# setup not checked
syn_map:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
syn_map:
syn_map:	# -8.5% for launching clock net
syn_map:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
syn_map:	# no derate on capturing clock net
syn_map:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
syn_map:	# -8.5% for data net
syn_map:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
syn_map:	# setup not checked
syn_map:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
syn_map:
syn_map:    # hold in fast, 0.99v, -40c/0c/125c, cmax
syn_map:    } elseif {$corn eq "fast" &&
syn_map:	      $volt eq "1p1v" &&
syn_map:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_map:	      ($rc eq "cmax")} {
syn_map:	
syn_map:	# -3.7% for launching clock cell
syn_map:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
syn_map:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
syn_map:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
syn_map:	# -12.1% for data
syn_map:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
syn_map:	# setup not checked
syn_map:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
syn_map:
syn_map:	# -8.5% for launching clock net
syn_map:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
syn_map:	# no derate on capturing clock net
syn_map:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
syn_map:	# -8.5% for data net
syn_map:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
syn_map:	# setup not checked
syn_map:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
syn_map:
syn_map:    # hold in fast, 0.99v, -40c/0c/125c, cmin
syn_map:    } elseif {$corn eq "fast" &&
syn_map:	      $volt eq "1p1v" &&
syn_map:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_map:	      ($rc eq "cmin")} {
syn_map:	
syn_map:	# -3.7% for launching clock cell
syn_map:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
syn_map:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
