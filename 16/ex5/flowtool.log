syn_map:#@ Begin verbose flow_step syn_map.report_synth.report_dft_genus
syn_map:@flow_step(report_dft_genus)  2:     report_scan_setup        > [file join [get_db flow_report_directory] [get_db flow_report_name] [get_db flow_report_prefix]scan.setup.rpt]
syn_map:@flow_step(report_dft_genus)  4:     if {[is_flow -inside flow:syn_opt]} {
syn_map:                                 	report_scan_chains       > [file join [get_db flow_report_directory] [get_db flow_report_name] [get_db flow_report_prefix]scan.chains.rpt]
syn_map:                                 	if {[llength [get_db actual_scan_chains]] > 0} {
syn_map:                                 	    write_scandef            > [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.def]
syn_map:                                             # By default compression chains are written to abstract. For hierarchical integration has to be fullscan
syn_map:                                             if {[get_feature -feature dft_compressor] && [get_db dft_add_test_compression_new_flow]} {
syn_map:                                                 # spatial synthesis seems to delete scan clock in some cases, redefine it here
syn_map:                                                 foreach name [list jtag_tck_[get_db flow_vars_design_name] jtag_tck] {
syn_map:                                                     set tck_port [get_db ports $name]
syn_map:                                                     if {[llength $tck_port]} {
syn_map:                                                         if {$tck_port ni [get_db [get_db test_clocks] .sources]} {
syn_map:                                                             define_test_clock -name jtag_tck_[get_db flow_vars_design_name] $tck_port
syn_map:                                                         }
syn_map:                                                         break
syn_map:                                                     }
syn_map:                                                 }
syn_map:                                 
syn_map:                                                 define_dft_cfg_mode -name FULLSCAN -type scan  -mode_enable_low [get_db test_signals -if {.function==compression_enable || .function==spread_enable}]
syn_map:                                 
syn_map:                                                 check_dft_rules -dft_cfg_mode FULLSCAN
syn_map:                                 
syn_map:                                                 for {set i 0} {$i < [get_db dft_compression_num_scanin]} {incr i} {
syn_map:                                                     define_scan_chain -name FULLSCAN_$i  -sdi [get_db [get_db test_signals -if {.function==compress_sdi && .index==$i}] .pin]  -sdo [get_db [get_db test_signals -if {.function==compress_sdo && .index==$i}] .pin]  -dft_configuration_mode FULLSCAN  -multi_mode -analyze
syn_map:                                                 }
syn_map:                                 
syn_map:                                                 write_dft_abstract_model -write_as_libcell -dft_cfg_mode FULLSCAN >  [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.abstract]
syn_map:                                 
syn_map:                                                 # input->inout arcs aren't written to abstract
syn_map:                                                 # TODO deleting self controllable definition would be good as now scan out
syn_map:                                                 # controllables overwrite them but it requires the order to always be same
syn_map:                                                 dft_utils::read_scan_abstract [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.abstract]
syn_map:                                                 foreach port [get_db ports -if {.is_user_scan_out}] {
syn_map:                                                     set controllable [report_dft_trace_back -continue $port]
syn_map:                                                     if {[get_db $controllable .obj_type]!="port"} {
syn_map:                                                         continue
syn_map:                                                     }
syn_map:                                                     dft_utils::add_dft_controllable -from [get_db $controllable .name] -to [get_db $port .name]
syn_map:                                                 }
syn_map:                                                 dft_utils::write_scan_abstract [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.abstract]
syn_map:                                 
syn_map:                                                 delete_obj [get_db dft_configuration_modes FULLSCAN]
syn_map:                                                 check_dft_rules
syn_map:                                 
syn_map:                                                 report_core_wrapper_cell -report_flops > [file join [get_db flow_report_directory] [get_db flow_report_name] [get_db flow_report_prefix]core_wrapper.rpt]
syn_map:                                             } else {
syn_map:                                                 write_dft_abstract_model -write_as_libcell > [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.abstract]
syn_map:                                             }
syn_map:                                 	}
syn_map:                                     }
