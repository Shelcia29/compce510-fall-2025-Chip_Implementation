syn_generic:#@ Begin verbose flow_step syn_generic.pre_syn_generic
syn_generic:@flow_step(pre_syn_generic)  2:     # If we're not doing scan insertion, exclude all instantiated clock gates from "clock gating".
syn_generic:@flow_step(pre_syn_generic)  3:     # Otherwise Genus will add RC_CG_INST* hierarchy to instantiated clock gates
syn_generic:@flow_step(pre_syn_generic)  4:     # which can then i.e. mess up STA constraints later on
syn_generic:@flow_step(pre_syn_generic)  5:     if {![get_feature -feature add_scan]} {
syn_generic:                                	# go through all instantiated cgs
syn_generic:                                	foreach icg_inst [get_db [get_db insts -if {.base_name==inst_CKLNQD*}] .name] {
syn_generic:                                	    puts "Info: ICG: $icg_inst ([get_db [get_db insts $icg_inst] .base_cell.base_name])"
syn_generic:                                	    # prevent Genus from adding RC_CG_INST* hierarchy to instantiated clock gates
syn_generic:                                	    # Note, TE has to be connected manually to shift enable later on!
syn_generic:                                	    set_db [get_db insts $icg_inst] .lp_clock_gating_exclude true
syn_generic:                                	}
syn_generic:                                    }
