syn_generic:#@ Begin verbose flow_step syn_generic.manage_uncertainty
syn_generic:@flow_step(manage_uncertainty)  2:     if {0} {
syn_generic:                                       # only set functional mode clock uncertainties
syn_generic:                                       set_interactive_constraint_modes [get_db constraint_modes -if {(.is_setup||.is_hold) && .name==*func*} -u]
syn_generic:                                       set clock_names [get_db -u [get_db clocks -if {.base_name!=*_virtual}] .base_name]
syn_generic:                                   
syn_generic:                                       global mmmc_vars
syn_generic:                                       # Note TL: Fix these. Clock uncertainties are corner specific, not mode specific
syn_generic:                                       if {[is_flow -quiet -after flow:opt_signoff] || [is_flow -quiet -inside flow:opt_signoff] ||
syn_generic:                                   	[is_flow -quiet -after flow:sta] || [is_flow -quiet -inside flow:sta]} {
syn_generic:                                   	set stp 0.085
syn_generic:                                   	set hld 0.050
syn_generic:                                       } elseif {[is_flow -quiet -after flow:floorplan] || [is_flow -quiet -inside flow:floorplan]} {
syn_generic:                                   	set stp 0.105
syn_generic:                                   	set hld 0.065
syn_generic:                                       } elseif {[is_flow -quiet -after flow:syn_generic] || [is_flow -quiet -inside flow:syn_generic]} {
syn_generic:                                   	set stp 0.105
syn_generic:                                   	set hld 0.065
syn_generic:                                       } else {
syn_generic:                                   	puts "Error([info script]): flow step out of bounds (syn_generic <-> floorplan <-> sta)"
syn_generic:                                       }
syn_generic:                                   
syn_generic:                                       puts "Info([info script]): Setting setup uncertainty to $stp, hold uncertainty to $hld"
syn_generic:                                       foreach clock_name $clock_names {
syn_generic:                                   	set_clock_uncertainty -setup $stp [get_clocks $clock_name]
syn_generic:                                   	set_clock_uncertainty -hold $hld [get_clocks $clock_name]
syn_generic:                                   
syn_generic:                                   	if {[llength [get_db clocks -if ".base_name==${clock_name}_virtual && .view_name==*func"]]} {
syn_generic:                                   	    set_clock_uncertainty -setup $stp [get_clocks ${clock_name}_virtual]
syn_generic:                                   	    set_clock_uncertainty -setup $stp -from [get_clocks ${clock_name}_virtual] -to   [get_clocks $clock_name]
syn_generic:                                   	    set_clock_uncertainty -setup $stp -to   [get_clocks ${clock_name}_virtual] -from [get_clocks $clock_name]
syn_generic:                                   	    set_clock_uncertainty -hold $hld [get_clocks ${clock_name}_virtual]
syn_generic:                                   	}
syn_generic:                                       }
syn_generic:                                       set_interactive_constraint_modes {}
syn_generic:                                   }
syn_generic:#@ End verbose flow_step syn_generic.manage_uncertainty
syn_generic:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_generic:UM:              1              1                                      manage_uncertainty
syn_generic:##FLOW_KIT: enabling features from command line: {report_lec add_scan}
