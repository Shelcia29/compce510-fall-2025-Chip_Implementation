syn_generic:                                             # By default compression chains are written to abstract. For hierarchical integration has to be fullscan
syn_generic:                                             if {[get_feature -feature dft_compressor] && [get_db dft_add_test_compression_new_flow]} {
syn_generic:                                                 # spatial synthesis seems to delete scan clock in some cases, redefine it here
syn_generic:                                                 foreach name [list jtag_tck_[get_db flow_vars_design_name] jtag_tck] {
syn_generic:                                                     set tck_port [get_db ports $name]
syn_generic:                                                     if {[llength $tck_port]} {
syn_generic:                                                         if {$tck_port ni [get_db [get_db test_clocks] .sources]} {
syn_generic:                                                             define_test_clock -name jtag_tck_[get_db flow_vars_design_name] $tck_port
syn_generic:                                                         }
syn_generic:                                                         break
syn_generic:                                                     }
syn_generic:                                                 }
syn_generic:                                 
syn_generic:                                                 define_dft_cfg_mode -name FULLSCAN -type scan  -mode_enable_low [get_db test_signals -if {.function==compression_enable || .function==spread_enable}]
syn_generic:                                 
syn_generic:                                                 check_dft_rules -dft_cfg_mode FULLSCAN
syn_generic:                                 
syn_generic:                                                 for {set i 0} {$i < [get_db dft_compression_num_scanin]} {incr i} {
syn_generic:                                                     define_scan_chain -name FULLSCAN_$i  -sdi [get_db [get_db test_signals -if {.function==compress_sdi && .index==$i}] .pin]  -sdo [get_db [get_db test_signals -if {.function==compress_sdo && .index==$i}] .pin]  -dft_configuration_mode FULLSCAN  -multi_mode -analyze
