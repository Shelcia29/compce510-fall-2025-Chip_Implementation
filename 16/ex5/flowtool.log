syn_generic:@flow_step(genus_manage_derating)  4:     global mmmc_vars
syn_generic:@flow_step(genus_manage_derating)  5:     foreach dc [get_db [get_db delay_corners -if {.is_setup}] .name] {
syn_generic:                                      	if {![info exists mmmc_vars(${dc},flat_data_cell_early)] ||
syn_generic:                                      	    ![info exists mmmc_vars(${dc},flat_data_cell_late)] ||
syn_generic:                                      	    ![info exists mmmc_vars(${dc},flat_clock_cell_early)] ||
syn_generic:                                      	    ![info exists mmmc_vars(${dc},flat_clock_cell_late)] ||
syn_generic:                                      	    ![info exists mmmc_vars(${dc},flat_data_net_early)] ||
syn_generic:                                      	    ![info exists mmmc_vars(${dc},flat_data_net_late)] ||
syn_generic:                                      	    ![info exists mmmc_vars(${dc},flat_clock_net_early)] ||
syn_generic:                                      	    ![info exists mmmc_vars(${dc},flat_clock_net_late)]} {
syn_generic:                                      	    puts "Fatal: mmmc_vars(${dc},flat_\[clock|data\]_\[cell|net\]_\[early|late\]) not defined! Check mmmc_setup.tcl!"
syn_generic:                                      	    exit 1
syn_generic:                                      	}
syn_generic:                                      	# Cell OCV
syn_generic:                                      	# Data
syn_generic:                                      	set_timing_derate -data  -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},flat_data_cell_early)
syn_generic:                                      	set_timing_derate -data  -cell_delay -late  -delay_corner ${dc} $mmmc_vars(${dc},flat_data_cell_late)
syn_generic:                                      	# Clock
syn_generic:                                      	set_timing_derate -clock -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},flat_clock_cell_early)
syn_generic:                                      	set_timing_derate -clock -cell_delay -late  -delay_corner ${dc} $mmmc_vars(${dc},flat_clock_cell_late)
syn_generic:                                      	
syn_generic:                                      	# Wire OCV
syn_generic:                                      	# Data
syn_generic:                                      	set_timing_derate -data  -net_delay  -early -delay_corner ${dc} $mmmc_vars(${dc},flat_data_net_early)
syn_generic:                                      	set_timing_derate -data  -net_delay  -late  -delay_corner ${dc} $mmmc_vars(${dc},flat_data_net_late)
syn_generic:                                      	# Clock
syn_generic:                                      	set_timing_derate -clock -net_delay  -early -delay_corner ${dc} $mmmc_vars(${dc},flat_clock_net_early)
syn_generic:                                      	set_timing_derate -clock -net_delay  -late  -delay_corner ${dc} $mmmc_vars(${dc},flat_clock_net_late)
syn_generic:                                          }
