syn_generic:#@ Begin verbose source ./scripts/mmmc_setup.tcl
syn_generic:@file(mmmc_setup.tcl) 6: set MMMC_SETUP_VERSION "v1.0"
syn_generic:@file(mmmc_setup.tcl) 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
syn_generic:Info: MMMC SETUP: gpdk045 : v1.0
syn_generic:@file(mmmc_setup.tcl) 11: set mmmc_vars(delay_corners) \
syn_generic:    [list \
syn_generic:	 slow_0p9v_125c_cmax \
syn_generic:	 fast_1p1v_0c_cmin \
syn_generic:	 ]
syn_generic:@file(mmmc_setup.tcl) 19: foreach dc $mmmc_vars(delay_corners) {
syn_generic:
syn_generic:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_generic:
syn_generic:    # qrc techfile
syn_generic:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
syn_generic:    # temperature
syn_generic:    if {${temp} == "m40c"} {
syn_generic:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
syn_generic:    } elseif {${temp} == "125c"} {
syn_generic:	set mmmc_vars("${rc}_${temp}",temperature) "125"
syn_generic:    } elseif {${temp} == "0c"} {
syn_generic:	set mmmc_vars("${rc}_${temp}",temperature) "0"
syn_generic:    } else {
syn_generic:	set mmmc_vars("${rc}_${temp}",temperature) "25"
syn_generic:    }
syn_generic:
syn_generic:
syn_generic:    ###########################################
syn_generic:    # OCVs &  Clock uncertainties for FLAT OCV
syn_generic:    ###########################################
syn_generic:
syn_generic:    # use following uncertainties
syn_generic:    # FUNC:
syn_generic:    # setup:
syn_generic:    # clock jitter: defined through clock cycle
syn_generic:    # TECH uncertainty: 25ps
syn_generic:    # extra uncertainty (implementation): 20ps
syn_generic:    # extra uncertainty (signoff STA): 0ps
syn_generic:    # hold:
syn_generic:    # TECH uncertainty (SSG): 50ps
syn_generic:    # TECH uncertainty (fast): 40ps
syn_generic:    # extra uncertainty (implementation): 15ps
syn_generic:    # extra uncertainty (signoff STA): 0ps
syn_generic:
syn_generic:    # Note, add 1% OCV on top of previous to match LVF
syn_generic:    # so flat values below have 0.01 added (subtracted) because of this
syn_generic:
syn_generic:    # setup in slow, 0.81v, -40C/125c, cmax
syn_generic:    if {$corn eq "slow" &&
syn_generic:	$volt eq "0p9v" &&
syn_generic:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_generic:	($rc eq "cmax")} {
syn_generic:	
syn_generic:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
syn_generic:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
syn_generic:	# +2.0% for launching clock cell
syn_generic:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
syn_generic:	# hold not checked in this corner
syn_generic:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
syn_generic:	# + 6.9% on data cell
syn_generic:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
syn_generic:
syn_generic:	# -6.0% for clock net
syn_generic:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
syn_generic:	# +6.0% for clock net
syn_generic:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
syn_generic:	# hold not checked in this corner
syn_generic:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
syn_generic:	# +6.0 for data net
syn_generic:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
syn_generic:
syn_generic:    # hold in slow, 0.81v, -40c/125c, cmax
syn_generic:    } elseif {$corn eq "slow" &&
syn_generic:	      $volt eq "0p9v" &&
syn_generic:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_generic:	      ($rc eq "cmax")} {
syn_generic:	
syn_generic:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
syn_generic:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
syn_generic:	# +3.2% for capturing clock cell
syn_generic:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
syn_generic:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
syn_generic:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
syn_generic:	# setup not checked
syn_generic:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
syn_generic:
syn_generic:	# -8.5% for launching clock net
syn_generic:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
syn_generic:	# no derate on capturing clock net
syn_generic:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
syn_generic:	# -8.5% for data net
