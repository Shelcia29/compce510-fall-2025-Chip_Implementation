[11/14 15:55:50     12s] 	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
[11/14 15:55:50     12s]     } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
[11/14 15:55:50     12s] 	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
[11/14 15:55:50     12s]     } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
[11/14 15:55:50     12s] 	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
[11/14 15:55:50     12s]     } else {
[11/14 15:55:50     12s] 	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
[11/14 15:55:50     12s] 	exit 1
[11/14 15:55:50     12s]     }
[11/14 15:55:50     12s] 
[11/14 15:55:50     12s]     # Read .lib -files
[11/14 15:55:50     12s]     # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
[11/14 15:55:50     12s]     foreach dc $mmmc_vars(delay_corners) {
[11/14 15:55:50     12s] 
