[11/14 16:45:57     12s]       -default [dict get $flow_vars $myAttr default] \
[11/14 16:45:57     12s]       -help_string [dict get $flow_vars $myAttr description] \
[11/14 16:45:57     12s]       -obj_type root
[11/14 16:45:57     12s]     }
[11/14 16:45:57     12s] }
