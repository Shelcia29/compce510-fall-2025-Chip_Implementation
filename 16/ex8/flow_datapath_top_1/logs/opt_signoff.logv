[11/14 16:45:57     12s]     # Note, add 1% OCV on top of previous to match LVF
[11/14 16:45:57     12s]     # so flat values below have 0.01 added (subtracted) because of this
[11/14 16:45:57     12s] 
[11/14 16:45:57     12s]     # setup in slow, 0.81v, -40C/125c, cmax
[11/14 16:45:57     12s]     if {$corn eq "slow" &&
[11/14 16:45:57     12s] 	$volt eq "0p9v" &&
[11/14 16:45:57     12s] 	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
[11/14 16:45:57     12s] 	($rc eq "cmax")} {
[11/14 16:45:57     12s] 	
[11/14 16:45:57     12s] 	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
[11/14 16:45:57     12s] 	# +2.0% for launching clock cell
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
[11/14 16:45:57     12s] 	# hold not checked in this corner
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
[11/14 16:45:57     12s] 	# + 6.9% on data cell
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
[11/14 16:45:57     12s] 
[11/14 16:45:57     12s] 	# -6.0% for clock net
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
[11/14 16:45:57     12s] 	# +6.0% for clock net
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
[11/14 16:45:57     12s] 	# hold not checked in this corner
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
[11/14 16:45:57     12s] 	# +6.0 for data net
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
[11/14 16:45:57     12s] 
[11/14 16:45:57     12s]     # hold in slow, 0.81v, -40c/125c, cmax
[11/14 16:45:57     12s]     } elseif {$corn eq "slow" &&
[11/14 16:45:57     12s] 	      $volt eq "0p9v" &&
[11/14 16:45:57     12s] 	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
[11/14 16:45:57     12s] 	      ($rc eq "cmax")} {
[11/14 16:45:57     12s] 	
[11/14 16:45:57     12s] 	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
[11/14 16:45:57     12s] 	# +3.2% for capturing clock cell
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
[11/14 16:45:57     12s] 	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
[11/14 16:45:57     12s] 	# setup not checked
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
[11/14 16:45:57     12s] 
[11/14 16:45:57     12s] 	# -8.5% for launching clock net
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
[11/14 16:45:57     12s] 	# no derate on capturing clock net
[11/14 16:45:57     12s] 	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
