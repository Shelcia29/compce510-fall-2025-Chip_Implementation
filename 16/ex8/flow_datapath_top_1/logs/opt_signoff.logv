[11/14 16:45:57     12s] @file 18: # Read .lib -files
[11/14 16:45:57     12s] @file 19: foreach dc $mmmc_vars(delay_corners) {
[11/14 16:45:57     12s] 
[11/14 16:45:57     12s]     regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
[11/14 16:45:57     12s] 
[11/14 16:45:57     12s]     # qrc techfile
[11/14 16:45:57     12s]     set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
[11/14 16:45:57     12s]     # temperature
[11/14 16:45:57     12s]     if {${temp} == "m40c"} {
[11/14 16:45:57     12s] 	set mmmc_vars("${rc}_${temp}",temperature) "-40"
[11/14 16:45:57     12s]     } elseif {${temp} == "125c"} {
[11/14 16:45:57     12s] 	set mmmc_vars("${rc}_${temp}",temperature) "125"
[11/14 16:45:57     12s]     } elseif {${temp} == "0c"} {
[11/14 16:45:57     12s] 	set mmmc_vars("${rc}_${temp}",temperature) "0"
[11/14 16:45:57     12s]     } else {
[11/14 16:45:57     12s] 	set mmmc_vars("${rc}_${temp}",temperature) "25"
[11/14 16:45:57     12s]     }
[11/14 16:45:57     12s] 
