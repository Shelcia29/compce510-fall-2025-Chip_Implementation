[11/14 17:44:30     17s] @file 3: ##############################################################################
[11/14 17:44:30     17s] @file 4: # Time-stamp: <2025-09-23 16:49:18 qftele>
[11/14 17:44:30     17s] @file 5:
[11/14 17:44:30     17s] @file 6: set MMMC_SETUP_VERSION "v1.0"
[11/14 17:44:30     17s] @file 7: # $TECHNOLOGY is set in tech_setup.tcl
