[11/14 17:44:25     11s]       -category user_flow \
[11/14 17:44:25     11s]       -data_type [dict get $flow_vars $myAttr type] \
[11/14 17:44:25     11s]       -default [dict get $flow_vars $myAttr default] \
[11/14 17:44:25     11s]       -help_string [dict get $flow_vars $myAttr description] \
[11/14 17:44:25     11s]       -obj_type root
[11/14 17:44:25     11s]     }
[11/14 17:44:25     11s] }
