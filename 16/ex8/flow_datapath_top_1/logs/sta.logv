[11/14 17:44:25     11s] @file 1: ##############################################################################
[11/14 17:44:25     11s] @file 2: # Project level Mode & Corner definitions
[11/14 17:44:25     11s] @file 3: ##############################################################################
[11/14 17:44:25     11s] @file 4: # Time-stamp: <2025-09-23 16:49:18 qftele>
[11/14 17:44:25     11s] @file 5:
[11/14 17:44:25     11s] @file 6: set MMMC_SETUP_VERSION "v1.0"
[11/14 17:44:25     11s] @file 7: # $TECHNOLOGY is set in tech_setup.tcl
[11/14 17:44:25     11s] @file 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
[11/14 17:44:25     11s] Info: MMMC SETUP: gpdk045 : v1.0
[11/14 17:44:25     11s] @file 9:
[11/14 17:44:25     11s] @file 10: # Delay corner list
[11/14 17:44:25     11s] @file 11: set mmmc_vars(delay_corners) \
[11/14 17:44:25     11s]     [list \
[11/14 17:44:25     11s] 	 slow_0p9v_125c_cmax \
[11/14 17:44:25     11s] 	 fast_1p1v_0c_cmin \
[11/14 17:44:25     11s] 	 ]
[11/14 17:44:25     11s] @file 16:
[11/14 17:44:25     11s] @file 17:
[11/14 17:44:25     11s] @file 18: # Read .lib -files
[11/14 17:44:25     11s] @file 19: foreach dc $mmmc_vars(delay_corners) {
[11/14 17:44:25     11s] 
[11/14 17:44:25     11s]     regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
[11/14 17:44:25     11s] 
[11/14 17:44:25     11s]     # qrc techfile
[11/14 17:44:25     11s]     set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
[11/14 17:44:25     11s]     # temperature
[11/14 17:44:25     11s]     if {${temp} == "m40c"} {
[11/14 17:44:25     11s] 	set mmmc_vars("${rc}_${temp}",temperature) "-40"
[11/14 17:44:25     11s]     } elseif {${temp} == "125c"} {
[11/14 17:44:25     11s] 	set mmmc_vars("${rc}_${temp}",temperature) "125"
[11/14 17:44:25     11s]     } elseif {${temp} == "0c"} {
[11/14 17:44:25     11s] 	set mmmc_vars("${rc}_${temp}",temperature) "0"
[11/14 17:44:25     11s]     } else {
[11/14 17:44:25     11s] 	set mmmc_vars("${rc}_${temp}",temperature) "25"
[11/14 17:44:25     11s]     }
[11/14 17:44:25     11s] 
[11/14 17:44:25     11s] 
[11/14 17:44:25     11s]     ###########################################
[11/14 17:44:25     11s]     # OCVs &  Clock uncertainties for FLAT OCV
[11/14 17:44:25     11s]     ###########################################
[11/14 17:44:25     11s] 
[11/14 17:44:25     11s]     # use following uncertainties
[11/14 17:44:25     11s]     # FUNC:
[11/14 17:44:25     11s]     # setup:
[11/14 17:44:25     11s]     # clock jitter: defined through clock cycle
[11/14 17:44:25     11s]     # TECH uncertainty: 25ps
[11/14 17:44:25     11s]     # extra uncertainty (implementation): 20ps
[11/14 17:44:25     11s]     # extra uncertainty (signoff STA): 0ps
[11/14 17:44:25     11s]     # hold:
[11/14 17:44:25     11s]     # TECH uncertainty (SSG): 50ps
[11/14 17:44:25     11s]     # TECH uncertainty (fast): 40ps
[11/14 17:44:25     11s]     # extra uncertainty (implementation): 15ps
[11/14 17:44:25     11s]     # extra uncertainty (signoff STA): 0ps
[11/14 17:44:25     11s] 
[11/14 17:44:25     11s]     # Note, add 1% OCV on top of previous to match LVF
[11/14 17:44:25     11s]     # so flat values below have 0.01 added (subtracted) because of this
[11/14 17:44:25     11s] 
[11/14 17:44:25     11s]     # setup in slow, 0.81v, -40C/125c, cmax
[11/14 17:44:25     11s]     if {$corn eq "slow" &&
[11/14 17:44:25     11s] 	$volt eq "0p9v" &&
[11/14 17:44:25     11s] 	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
[11/14 17:44:25     11s] 	($rc eq "cmax")} {
[11/14 17:44:25     11s] 	
[11/14 17:44:25     11s] 	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
[11/14 17:44:25     11s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
[11/14 17:44:25     11s] 	# +2.0% for launching clock cell
