[11/14 17:44:30     17s] @file 173: # Transform all dict to attribute
[11/14 17:44:30     17s] @file 174: foreach myAttr [dict keys $flow_vars] {
[11/14 17:44:30     17s]   if { ![is_attribute -obj_type root $myAttr]} {
[11/14 17:44:30     17s]     define_attribute $myAttr \
