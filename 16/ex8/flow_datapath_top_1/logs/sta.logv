[11/14 17:44:30     17s]     }
[11/14 17:44:30     17s] 
[11/14 17:44:30     17s]     ###########################################
[11/14 17:44:30     17s]     # OCVs &  Clock uncertainties for SOCV
[11/14 17:44:30     17s]     ###########################################
[11/14 17:44:30     17s] 
[11/14 17:44:30     17s]     # Note, only voltage and temperature OCVs needed
[11/14 17:44:30     17s] 
[11/14 17:44:30     17s]     # Early & late variation factors from:
[11/14 17:44:30     17s]     set mmmc_vars(early_rc_variation_factor) 0.06
[11/14 17:44:30     17s]     set mmmc_vars(late_rc_variation_factor) 0.06
[11/14 17:44:30     17s] 
[11/14 17:44:30     17s]     set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
