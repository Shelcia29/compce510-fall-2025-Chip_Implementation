[11/14 17:44:30     17s]     if {[info exists local_macro_exportdir($blockname)]} {
[11/14 17:44:30     17s] 	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
[11/14 17:44:30     17s] 	    puts "Warning([info script]): Overriding global setting for $blockname ->"
