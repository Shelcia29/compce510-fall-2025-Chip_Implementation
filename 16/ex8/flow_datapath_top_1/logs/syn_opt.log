@flow_step(activate_views)  2:     set db [get_db flow_starting_db]
@flow_step(activate_views)  3:     set flow [lindex [get_db flow_hier_path] end]
@flow_step(activate_views)  4:     set setup_views [get_feature $flow -feature setup_views]
@flow_step(activate_views)  5:     set hold_views [get_feature $flow -feature hold_views]
@flow_step(activate_views)  6:     set leakage_view [get_feature $flow -feature leakage_view]
@flow_step(activate_views)  7:     set dynamic_view [get_feature $flow -feature dynamic_view]
@flow_step(activate_views)  9:     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
                               	#- use read_db args for DB types and set_analysis_views for TCL
                               	if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] eq {enc} && [file isfile [lindex $db 1]])} {
                               	    set cmd "set_analysis_view"
                               	    if {$setup_views ne ""} {
                               		append cmd " -setup [list $setup_views]"
                               	    } else {
                               		append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
                               	    }
                               	    if {$hold_views ne ""} {
                               		append cmd " -hold [list $hold_views]"
                               	    } else {
                               		append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
                               	    }
                               	    if {$leakage_view ne ""} {
                               		append cmd " -leakage [list $leakage_view]"
                               	    } else {
                               		if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
                               		    append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
