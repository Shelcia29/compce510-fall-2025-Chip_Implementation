[11/14 16:09:15     12s] @file 26: foreach {blockname blockpath} [array get global_macro_exportdir] {
[11/14 16:09:15     12s] 
[11/14 16:09:15     12s]     # do not read in a model for DUT
[11/14 16:09:15     12s]     if {![string compare $blockname [get_db flow_vars_design_name]]} {
[11/14 16:09:15     12s] 	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
[11/14 16:09:15     12s] 	continue
[11/14 16:09:15     12s]     }
[11/14 16:09:15     12s] 
[11/14 16:09:15     12s]     if {[info exists local_macro_exportdir($blockname)]} {
[11/14 16:09:15     12s] 	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
[11/14 16:09:15     12s] 	    puts "Warning([info script]): Overriding global setting for $blockname ->"
[11/14 16:09:15     12s] 	    puts "\#OLD\#: $blockpath"
[11/14 16:09:15     12s] 	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
[11/14 16:09:15     12s] 	    set $blockpath $local_macro_exportdir($blockname)
[11/14 16:09:15     12s] 	}
[11/14 16:09:15     12s]     }
[11/14 16:09:15     12s] 
[11/14 16:09:15     12s]     # scan abstract for DFT
[11/14 16:09:15     12s]     if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
[11/14 16:09:15     12s] 	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
[11/14 16:09:15     12s]     } else {
[11/14 16:09:15     12s] 	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
[11/14 16:09:15     12s]     }
[11/14 16:09:15     12s] 
