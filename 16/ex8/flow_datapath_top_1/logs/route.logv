[11/14 16:09:15     12s] 	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
[11/14 16:09:15     12s] 	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 16:09:15     12s] 	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
