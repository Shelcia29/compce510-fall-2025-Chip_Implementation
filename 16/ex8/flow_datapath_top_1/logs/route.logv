[11/14 16:09:15     12s] @file 5:
[11/14 16:09:15     12s] @file 6: set MMMC_SETUP_VERSION "v1.0"
[11/14 16:09:15     12s] @file 7: # $TECHNOLOGY is set in tech_setup.tcl
