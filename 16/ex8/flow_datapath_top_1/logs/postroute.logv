[11/14 16:22:49     12s]     ###########################################
[11/14 16:22:49     12s]     # OCVs &  Clock uncertainties for SOCV
[11/14 16:22:49     12s]     ###########################################
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]     # Note, only voltage and temperature OCVs needed
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]     # Early & late variation factors from:
[11/14 16:22:49     12s]     set mmmc_vars(early_rc_variation_factor) 0.06
[11/14 16:22:49     12s]     set mmmc_vars(late_rc_variation_factor) 0.06
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]     set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]     # slow, 0.81v, -40c
[11/14 16:22:49     12s]     if {$corn eq "slow" &&
[11/14 16:22:49     12s] 	$volt eq "0p9v" &&
[11/14 16:22:49     12s] 	$temp eq "m40c"} {
[11/14 16:22:49     12s]         
[11/14 16:22:49     12s]         # DATA  @ 20.3mV : 7.4%
[11/14 16:22:49     12s]         # DATA  @ 10c    : 0.9%
[11/14 16:22:49     12s]         # CLOCK @ 20.3mV : 5.4%
[11/14 16:22:49     12s]         # CLOCK @ 10c    : 0.7%
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]         # For setup only derate clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 16:22:49     12s]         # For hold in slow derate data & launching clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]     } elseif {$corn eq "slow" &&
[11/14 16:22:49     12s] 	$volt eq "0p9v" &&
[11/14 16:22:49     12s] 	$temp eq "125c"} {
[11/14 16:22:49     12s]        
[11/14 16:22:49     12s]         # DATA  @ 20.3mV : 5.0%
[11/14 16:22:49     12s]         # DATA  @ 10c    : 0.3%
[11/14 16:22:49     12s]         # CLOCK @ 20.3mV : 3.5%
[11/14 16:22:49     12s]         # CLOCK @ 10c    : 0.2%
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]         # For setup only derate clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 16:22:49     12s]         # For hold in slow derate data & launching clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]     } elseif {$corn eq "slow" &&
[11/14 16:22:49     12s] 	$volt eq "0p9v" &&
[11/14 16:22:49     12s] 	$temp eq "0c"} {
[11/14 16:22:49     12s]        
[11/14 16:22:49     12s]         # DATA  @ 20.3mV : 6.6%
[11/14 16:22:49     12s]         # DATA  @ 10c    : 0.8%
[11/14 16:22:49     12s]         # CLOCK @ 20.3mV : 4.9%
[11/14 16:22:49     12s]         # CLOCK @ 10c    : 0.6%
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]         # For setup only derate clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 16:22:49     12s]         # For hold in slow derate data & launching clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]     } elseif {$corn eq "fast" &&
[11/14 16:22:49     12s] 	$volt eq "1p1v" &&
[11/14 16:22:49     12s] 	$temp eq "m40c"} {
[11/14 16:22:49     12s]        
[11/14 16:22:49     12s]         # DATA  @ 45mV   : 7.4%
[11/14 16:22:49     12s]         # DATA  @ 10c    : 0.5%
[11/14 16:22:49     12s]         # CLOCK @ 45mV   : 5.1%
[11/14 16:22:49     12s]         # CLOCK @ 10c    : 0.6%
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]         # For setup only derate clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 16:22:49     12s]         # For hold in slow derate data & launching clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]      } elseif {$corn eq "fast" &&
[11/14 16:22:49     12s] 	$volt eq "1p1v" &&
[11/14 16:22:49     12s] 	$temp eq "125c"} {
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]         # DATA  @ 45mV   : 5.8%
[11/14 16:22:49     12s]         # DATA  @ 10c    : 0.5%
[11/14 16:22:49     12s]         # CLOCK @ 45mV   : 3.6%
[11/14 16:22:49     12s]         # CLOCK @ 10c    : 0.6%
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]         # For setup only derate clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 16:22:49     12s]         # For hold in slow derate data & launching clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]     } elseif {$corn eq "fast" &&
[11/14 16:22:49     12s] 	$volt eq "1p1v" &&
[11/14 16:22:49     12s] 	$temp eq "0c"} {
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]         # DATA  @ 45mV   : 7.0%
[11/14 16:22:49     12s]         # DATA  @ 10c    : 0.4%
[11/14 16:22:49     12s]         # CLOCK @ 45mV   : 4.7%
[11/14 16:22:49     12s]         # CLOCK @ 10c    : 0.4%
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]         # For setup only derate clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 16:22:49     12s]         # For hold in slow derate data & launching clock
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
[11/14 16:22:49     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
[11/14 16:22:49     12s] 
[11/14 16:22:49     12s]      } else {
[11/14 16:22:49     12s]         puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
[11/14 16:22:49     12s]         exit 1
[11/14 16:22:49     12s]     }
[11/14 16:22:49     12s] }
