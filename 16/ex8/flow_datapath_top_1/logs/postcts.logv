[11/14 16:05:33     12s] 
[11/14 16:05:33     12s] 	# no derate on launching clock net
[11/14 16:05:33     12s] 	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
[11/14 16:05:33     12s] 	# +8.5% for capturing clock net
[11/14 16:05:33     12s] 	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
[11/14 16:05:33     12s] 	# no derate for data net
[11/14 16:05:33     12s] 	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
[11/14 16:05:33     12s] 	# setup not checked
[11/14 16:05:33     12s] 	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
[11/14 16:05:33     12s] 
[11/14 16:05:33     12s]     } else {
