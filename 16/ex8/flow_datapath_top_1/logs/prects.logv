[11/14 15:48:36     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
[11/14 15:48:36     12s] 
[11/14 15:48:36     12s]     } elseif {$corn eq "slow" &&
[11/14 15:48:36     12s] 	$volt eq "0p9v" &&
[11/14 15:48:36     12s] 	$temp eq "0c"} {
[11/14 15:48:36     12s]        
[11/14 15:48:36     12s]         # DATA  @ 20.3mV : 6.6%
[11/14 15:48:36     12s]         # DATA  @ 10c    : 0.8%
[11/14 15:48:36     12s]         # CLOCK @ 20.3mV : 4.9%
[11/14 15:48:36     12s]         # CLOCK @ 10c    : 0.6%
[11/14 15:48:36     12s] 
[11/14 15:48:36     12s]         # For setup only derate clock
