[11/14 15:48:36     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
[11/14 15:48:36     12s] 
[11/14 15:48:36     12s]     } elseif {$corn eq "fast" &&
[11/14 15:48:36     12s] 	$volt eq "1p1v" &&
