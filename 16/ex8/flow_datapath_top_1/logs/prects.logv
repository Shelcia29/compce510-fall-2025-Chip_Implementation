[11/14 15:48:36     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 15:48:36     12s]         # For hold in slow derate data & launching clock
[11/14 15:48:36     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
[11/14 15:48:36     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
[11/14 15:48:36     12s] 
[11/14 15:48:36     12s]     } elseif {$corn eq "slow" &&
[11/14 15:48:36     12s] 	$volt eq "0p9v" &&
[11/14 15:48:36     12s] 	$temp eq "125c"} {
[11/14 15:48:36     12s]        
[11/14 15:48:36     12s]         # DATA  @ 20.3mV : 5.0%
[11/14 15:48:36     12s]         # DATA  @ 10c    : 0.3%
[11/14 15:48:36     12s]         # CLOCK @ 20.3mV : 3.5%
[11/14 15:48:36     12s]         # CLOCK @ 10c    : 0.2%
[11/14 15:48:36     12s] 
[11/14 15:48:36     12s]         # For setup only derate clock
[11/14 15:48:36     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
[11/14 15:48:36     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 15:48:36     12s]         # For hold in slow derate data & launching clock
