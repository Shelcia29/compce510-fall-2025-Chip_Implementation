[11/14 15:48:36     12s] 	$temp eq "125c"} {
[11/14 15:48:36     12s] 
[11/14 15:48:36     12s]         # DATA  @ 45mV   : 5.8%
[11/14 15:48:36     12s]         # DATA  @ 10c    : 0.5%
