[11/14 15:48:36     12s]     # Note, add 1% OCV on top of previous to match LVF
[11/14 15:48:36     12s]     # so flat values below have 0.01 added (subtracted) because of this
[11/14 15:48:36     12s] 
[11/14 15:48:36     12s]     # setup in slow, 0.81v, -40C/125c, cmax
[11/14 15:48:36     12s]     if {$corn eq "slow" &&
[11/14 15:48:36     12s] 	$volt eq "0p9v" &&
