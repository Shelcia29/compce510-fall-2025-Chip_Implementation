[11/14 15:48:36     12s]     } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
[11/14 15:48:36     12s] 	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
[11/14 15:48:36     12s]     } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
