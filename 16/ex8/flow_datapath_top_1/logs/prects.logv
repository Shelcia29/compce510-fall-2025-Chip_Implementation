[11/14 15:48:36     12s]     # qrc techfile
[11/14 15:48:36     12s]     set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
[11/14 15:48:36     12s]     # temperature
[11/14 15:48:36     12s]     if {${temp} == "m40c"} {
[11/14 15:48:36     12s] 	set mmmc_vars("${rc}_${temp}",temperature) "-40"
[11/14 15:48:36     12s]     } elseif {${temp} == "125c"} {
[11/14 15:48:36     12s] 	set mmmc_vars("${rc}_${temp}",temperature) "125"
[11/14 15:48:36     12s]     } elseif {${temp} == "0c"} {
[11/14 15:48:36     12s] 	set mmmc_vars("${rc}_${temp}",temperature) "0"
[11/14 15:48:36     12s]     } else {
[11/14 15:48:36     12s] 	set mmmc_vars("${rc}_${temp}",temperature) "25"
[11/14 15:48:36     12s]     }
[11/14 15:48:36     12s] 
