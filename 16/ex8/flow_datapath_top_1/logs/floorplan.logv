[11/14 15:46:29     13s]       -category user_flow \
[11/14 15:46:29     13s]       -data_type [dict get $flow_vars $myAttr type] \
[11/14 15:46:29     13s]       -default [dict get $flow_vars $myAttr default] \
[11/14 15:46:29     13s]       -help_string [dict get $flow_vars $myAttr description] \
[11/14 15:46:29     13s]       -obj_type root
[11/14 15:46:29     13s]     }
[11/14 15:46:29     13s] }
