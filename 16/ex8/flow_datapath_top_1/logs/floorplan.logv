[11/14 15:46:29     13s] }
[11/14 15:46:29     13s] @file 24:
[11/14 15:46:29     13s] @file 25: # Go through global settings for macros and see if there's a local override
[11/14 15:46:29     13s] @file 26: foreach {blockname blockpath} [array get global_macro_exportdir] {
[11/14 15:46:29     13s] 
[11/14 15:46:29     13s]     # do not read in a model for DUT
[11/14 15:46:29     13s]     if {![string compare $blockname [get_db flow_vars_design_name]]} {
[11/14 15:46:29     13s] 	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
[11/14 15:46:29     13s] 	continue
[11/14 15:46:29     13s]     }
[11/14 15:46:29     13s] 
[11/14 15:46:29     13s]     if {[info exists local_macro_exportdir($blockname)]} {
[11/14 15:46:29     13s] 	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
[11/14 15:46:29     13s] 	    puts "Warning([info script]): Overriding global setting for $blockname ->"
[11/14 15:46:29     13s] 	    puts "\#OLD\#: $blockpath"
[11/14 15:46:29     13s] 	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
[11/14 15:46:29     13s] 	    set $blockpath $local_macro_exportdir($blockname)
[11/14 15:46:29     13s] 	}
[11/14 15:46:29     13s]     }
[11/14 15:46:29     13s] 
[11/14 15:46:29     13s]     # scan abstract for DFT
[11/14 15:46:29     13s]     if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
[11/14 15:46:29     13s] 	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
[11/14 15:46:29     13s]     } else {
[11/14 15:46:29     13s] 	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
[11/14 15:46:29     13s]     }
[11/14 15:46:29     13s] 
[11/14 15:46:29     13s]     # MACROs
[11/14 15:46:29     13s]     if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
[11/14 15:46:29     13s] 	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
[11/14 15:46:29     13s]     } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
[11/14 15:46:29     13s] 	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
[11/14 15:46:29     13s]     } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
[11/14 15:46:29     13s] 	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
[11/14 15:46:29     13s]     } else {
[11/14 15:46:29     13s] 	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
[11/14 15:46:29     13s] 	exit 1
[11/14 15:46:29     13s]     }
[11/14 15:46:29     13s] 
[11/14 15:46:29     13s]     # Read .lib -files
[11/14 15:46:29     13s]     # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
[11/14 15:46:29     13s]     foreach dc $mmmc_vars(delay_corners) {
[11/14 15:46:29     13s] 
[11/14 15:46:29     13s] 	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
[11/14 15:46:29     13s] 
[11/14 15:46:29     13s] 	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
[11/14 15:46:29     13s] 	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 15:46:29     13s] 	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 15:46:29     13s] 	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
[11/14 15:46:29     13s] 	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 15:46:29     13s] 	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 15:46:29     13s] 	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
[11/14 15:46:29     13s] 	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
