            lappend spef_list ${blockpath}/dbs/opt_signoff/${blockname}.${rcc_name}.spef.gz
        }
        puts "Info: read_spef \"${spef_list}\" -rc_corner $rcc_name"
        read_spef "${spef_list}" -rc_corner $rcc_name
    }
