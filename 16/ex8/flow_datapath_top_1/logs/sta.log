@flow 15: foreach corner $corners {
        set rcc_name [get_db ${corner} .name]

        set spef_list [list ${spef_dir}/[get_db flow_vars_design_name].${rcc_name}.spef.gz]
        # subblock SPEFs
        foreach {blockname blockpath} [array get local_macro_exportdir] {
