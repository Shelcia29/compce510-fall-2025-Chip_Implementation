cts:#@ Begin verbose flow_step activate_views
cts:@flow 2: set db [get_db flow_starting_db]
cts:@flow 3: set flow [lindex [get_db flow_hier_path] end]
cts:@flow 4: set setup_views [get_feature $flow -feature setup_views]
cts:@flow 5: set hold_views [get_feature $flow -feature hold_views]
cts:@flow 6: set leakage_view [get_feature $flow -feature leakage_view]
cts:@flow 7: set dynamic_view [get_feature $flow -feature dynamic_view]
cts:@flow 9: if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {...}
cts:#@ End verbose flow_step activate_views
