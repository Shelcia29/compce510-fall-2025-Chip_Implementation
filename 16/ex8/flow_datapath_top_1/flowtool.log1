syn_generic:
syn_generic:# set module name and location of all sub-blocks here
syn_generic:array set local_macro_exportdir {
syn_generic:    matmul_sync "../flow_matmul_sync_1"
syn_generic:}
syn_generic:
syn_generic:array set memarray {
syn_generic:    256x32 "IN22FDX_S1DU_BFUG_W00256B032M04C128"
syn_generic:}
syn_generic:
syn_generic:# Go through global settings for macros and see if there's a local override
syn_generic:foreach {blockname blockpath} [array get global_macro_exportdir] {
syn_generic:
syn_generic:    # do not read in a model for DUT
syn_generic:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
syn_generic:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
syn_generic:	continue
syn_generic:    }
syn_generic:
syn_generic:    if {[info exists local_macro_exportdir($blockname)]} {
syn_generic:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
syn_generic:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
syn_generic:	    puts "\#OLD\#: $blockpath"
syn_generic:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
syn_generic:	    set $blockpath $local_macro_exportdir($blockname)
syn_generic:	}
syn_generic:    }
syn_generic:
syn_generic:    # scan abstract for DFT
syn_generic:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
syn_generic:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
syn_generic:    } else {
