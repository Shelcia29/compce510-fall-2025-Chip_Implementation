prects:@flow 3: # Tool settings: NOTE: already set by flow_config.tcl
prects:@flow 4: #set_multi_cpu_usage -local_cpu 8 -remote_host 1 -cpu_per_remote_host 8
prects:@flow 6: if {[get_feature -feature report_lec]} {
prects:@flow 7: # Init attributes  [get_db -category init]
prects:@flow 8: 	#-------------------------------------------------------------------------------
prects:@@flow 9: set_db write_lec_directory_naming_style "fv/%s/[get_db flow_report_name]"
prects:@flow 10:
prects:@flow 11: }
prects:@@flow 12: set_db init_design_uniquify 1
prects:@flow 14: # Design attributes  [get_db -category design]
prects:@flow 15: #-------------------------------------------------------------------------------
prects:@@flow 16: set_db design_process_node            45
prects:##  Process: 45            (User Set)               
prects:##     Node: (not set)                           
prects:
prects:##  Check design process and node:  
prects:##  Design tech node is not set.
prects:
prects:Applying the recommended capacitance filtering threshold values for 45nm process node: total_c_th=0, relative_c_th=1 and coupling_c_th=0.1.
prects:	These values will be used by all post-route extraction engines, including TQuantus, IQuantus and Quantus QRC extraction.
prects:	Capacitance filtering mode(extract_rc_cap_filter_mode option of the set_db) is 'relative_and_coupling' for all engines.
prects:	The accuracy mode for post_route extract_rc_effort_level low extraction will be set to 'high'.
prects:	Default value for EffortLevel(extract_rc_effort_level option of the set_db) in post_route extraction mode is 'medium'.
prects:@flow 17: if {[get_feature -feature flow_express]} {...}
prects:@@flow 20: set_db design_early_clock_flow              true
prects:@flow 22: # Via naming
prects:@flow 23: #-------------------------------------------------------------------------------
prects:@flow 24: # Use design name as prefix for VIAs, as otherwise they will cause collision when merging designs on toplevel
prects:@@flow 25: set_db write_stream_via_names true
prects:@flow 27: # Timing attributes  [get_db -category timing && delaycalc]
prects:@flow 28: #-------------------------------------------------------------------------------
prects:@@flow 29: set_db timing_analysis_cppr           both
prects:@@flow 30: set_db timing_analysis_type           ocv
prects:@@flow 31: set_db timing_report_fields           {timing_point net cell fanout load transition delay incr_delay arrival edge user_derate power_domain}
prects:@flow 33: #set_db timing_analysis_socv                               true                        ;# Enable socv analysis
prects:@flow 34: #set_db timing_socv_rc_variation_mode                      true                        ;# Enable interconnect variation mode in SOCV mode
prects:@flow 35: #set_db  timing_report_enable_verbose_ssta_mode true
prects:@flow 37: # Add, TL: flow sets this to "no_async", async is default and should be used
prects:@@flow 38: set_db timing_analysis_async_checks async
prects:@flow 39: # Add, TL: maybe a bit hazardous... disable default io delay for ports which are unconstrained!
prects:@flow 40: # if true, will cause hold problems (since launching clock is the receiving clock (with same latency!))
prects:@@flow 41: set_db timing_apply_default_primary_input_assertion false
prects:@@flow 43: set_db delaycal_advanced_node_pin_cap_settings true
prects:@@flow 44: set_db delaycal_advanced_pin_cap_mode true
prects:@flow 47: # Extraction attributes  [get_db -category extract_rc]
prects:@flow 48: #-------------------------------------------------------------------------------
prects:@flow 49: if {[get_feature -feature add_pvs_fill] || [get_feature -feature add_pegasus_beol_fill]} {...}
prects:@flow 52: if {[is_flow -after flow:opt_signoff] || [is_flow -inside flow:opt_signoff]} {...}
prects:@flow 58: if {[is_flow -after flow:route]} {...}
prects:@flow 64: if {0} {...
prects:@flow 66: } else {
prects:@@flow 67: set_db delaycal_equivalent_waveform_model               no_propagation
prects:@flow 68: }
prects:@@flow 69: set_db si_aggressor_alignment                             timing_aware_edge       
prects:@flow 71: # Mod, TL: Too few licenses to extract all corners in parallel . Use the following to reduce number of used licenses :
prects:@flow 72: #set_db extract_rc_qrc_run_mode sequential
prects:@flow 74: # Floorplan attributes  [get_db -category floorplan]
prects:@flow 75: #-------------------------------------------------------------------------------
prects:@@flow 76: set_db finish_floorplan_active_objs   [list macro soft_blockage core]
prects:@flow 77: # Constraints for even or odd site width/ row height
prects:@@flow 78: set_db floorplan_row_site_height                          even
prects:@@flow 79: set_db floorplan_row_site_width                           even
prects:@flow 81: # Placement attributes  [get_db -category place]
prects:@flow 82: #-------------------------------------------------------------------------------
