postcts:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
postcts:@file 1: ################################################################################
postcts:@file 2: # Local setup for macros in hierarchical designs
postcts:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
postcts:@file 4: ################################################################################
postcts:@file 5: # Time-stamp: <2025-11-10 22:56:41 qftele>
postcts:@file 6: #########################################################################################################
postcts:@file 7: # Macro info
postcts:@file 8: # List versions of macros used in DUT
postcts:@file 9: #########################################################################################################
postcts:@file 10: if {1} {
postcts:@file 11: array unset global_macro_exportdir
postcts:@file 12:
postcts:@file 13: set macro_scan_abstract_filelist [list ]
postcts:@file 14: set macro_lef_filelist [list ]
postcts:@file 15:
postcts:@file 16: # set module name and location of all sub-blocks here
postcts:@file 17: array set local_macro_exportdir {
postcts:    matmul_sync "../flow_matmul_sync_1"
postcts:}
postcts:@file 20:
postcts:@file 21: array set memarray {
postcts:    256x32 "IN22FDX_S1DU_BFUG_W00256B032M04C128"
postcts:}
postcts:@file 24:
postcts:@file 25: # Go through global settings for macros and see if there's a local override
postcts:@file 26: foreach {blockname blockpath} [array get global_macro_exportdir] {
postcts:
postcts:    # do not read in a model for DUT
postcts:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
postcts:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
postcts:	continue
postcts:    }
postcts:
postcts:    if {[info exists local_macro_exportdir($blockname)]} {
postcts:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
postcts:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
postcts:	    puts "\#OLD\#: $blockpath"
postcts:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
postcts:	    set $blockpath $local_macro_exportdir($blockname)
postcts:	}
postcts:    }
postcts:
postcts:    # scan abstract for DFT
postcts:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
postcts:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
postcts:    } else {
postcts:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
postcts:    }
postcts:
postcts:    # MACROs
postcts:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
postcts:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
postcts:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
postcts:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
postcts:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
postcts:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
postcts:    } else {
postcts:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
postcts:	exit 1
postcts:    }
postcts:
postcts:    # Read .lib -files
postcts:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
postcts:    foreach dc $mmmc_vars(delay_corners) {
postcts:
postcts:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postcts:
postcts:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postcts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postcts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postcts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	} else {
postcts:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
postcts:	    exit 1
postcts:	}
postcts:    }
postcts:}
postcts:@file 83: # sanity check to see if global setting are missing block which are defined in local settings!
postcts:@file 84: foreach {blockname blockpath} [array get local_macro_exportdir] {
postcts:    # do not read in a model for DUT
postcts:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
postcts:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
postcts:	continue
postcts:    }
postcts:
postcts:    set found 0
postcts:    if {[info exists global_macro_exportdir($blockname)]} {
postcts:	set found 1
postcts:    }
postcts:
postcts:    if {!$found} {
postcts:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
postcts:    } else {
postcts:	# it was found so it's already set
postcts:	continue
postcts:    }
postcts:
postcts:    # scan abstract for DFT
postcts:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
postcts:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
postcts:    } else {
postcts:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
postcts:    }
postcts:
postcts:    # MACROs
postcts:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
postcts:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
postcts:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
postcts:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
postcts:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
postcts:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
postcts:    } else {
postcts:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
postcts:	exit 1
postcts:    }
postcts:
postcts:    # Read .lib -files
postcts:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
postcts:    foreach dc $mmmc_vars(delay_corners) {
postcts:
postcts:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postcts:
postcts:        puts "corn volt temp rc: ${corn}_${volt}_${temp}_${rc}"
postcts:
postcts:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postcts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postcts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postcts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	} else {
postcts:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
postcts:	    exit 1
postcts:	}
postcts:    }
postcts:}
postcts:Warning(scripts/local_macro_setup.tcl): Global setting for matmul_sync set in local setting not found from global settings! Report this to project toplevel!
