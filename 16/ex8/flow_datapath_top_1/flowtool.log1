sta:@file 1: ################################################################################
sta:@file 2: # Local setup for macros in hierarchical designs
sta:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
sta:@file 4: ################################################################################
sta:@file 5: # Time-stamp: <2025-11-10 22:56:41 qftele>
sta:@file 6: #########################################################################################################
sta:@file 7: # Macro info
sta:@file 8: # List versions of macros used in DUT
sta:@file 9: #########################################################################################################
sta:@file 10: if {1} {
sta:@file 11: array unset global_macro_exportdir
sta:@file 12:
sta:@file 13: set macro_scan_abstract_filelist [list ]
sta:@file 14: set macro_lef_filelist [list ]
sta:@file 15:
sta:@file 16: # set module name and location of all sub-blocks here
sta:@file 17: array set local_macro_exportdir {
sta:    matmul_sync "../flow_matmul_sync_1"
sta:}
sta:@file 20:
sta:@file 21: array set memarray {
sta:    256x32 "IN22FDX_S1DU_BFUG_W00256B032M04C128"
sta:}
sta:@file 24:
sta:@file 25: # Go through global settings for macros and see if there's a local override
sta:@file 26: foreach {blockname blockpath} [array get global_macro_exportdir] {
sta:
sta:    # do not read in a model for DUT
sta:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
sta:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
sta:	continue
sta:    }
sta:
sta:    if {[info exists local_macro_exportdir($blockname)]} {
sta:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
sta:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
sta:	    puts "\#OLD\#: $blockpath"
sta:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
sta:	    set $blockpath $local_macro_exportdir($blockname)
sta:	}
sta:    }
sta:
sta:    # scan abstract for DFT
sta:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
sta:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
sta:    } else {
sta:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
sta:    }
sta:
sta:    # MACROs
sta:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
sta:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
sta:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
sta:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
sta:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
sta:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
sta:    } else {
sta:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
sta:	exit 1
sta:    }
sta:
sta:    # Read .lib -files
sta:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
sta:    foreach dc $mmmc_vars(delay_corners) {
sta:
sta:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
sta:
sta:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
sta:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
sta:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
sta:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	} else {
sta:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
sta:	    exit 1
sta:	}
sta:    }
sta:}
sta:@file 83: # sanity check to see if global setting are missing block which are defined in local settings!
sta:@file 84: foreach {blockname blockpath} [array get local_macro_exportdir] {
sta:    # do not read in a model for DUT
sta:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
sta:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
sta:	continue
sta:    }
sta:
sta:    set found 0
sta:    if {[info exists global_macro_exportdir($blockname)]} {
sta:	set found 1
sta:    }
sta:
sta:    if {!$found} {
sta:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
sta:    } else {
sta:	# it was found so it's already set
sta:	continue
sta:    }
sta:
sta:    # scan abstract for DFT
sta:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
sta:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
sta:    } else {
sta:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
sta:    }
sta:
sta:    # MACROs
sta:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
sta:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
sta:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
sta:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
sta:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
sta:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
sta:    } else {
sta:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
sta:	exit 1
sta:    }
sta:
sta:    # Read .lib -files
sta:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
sta:    foreach dc $mmmc_vars(delay_corners) {
sta:
sta:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
sta:
sta:        puts "corn volt temp rc: ${corn}_${volt}_${temp}_${rc}"
sta:
sta:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
sta:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
sta:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
sta:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	} else {
sta:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
sta:	    exit 1
sta:	}
sta:    }
sta:}
