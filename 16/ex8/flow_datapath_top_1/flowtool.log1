prects:@file 173: # Transform all dict to attribute
prects:@file 174: foreach myAttr [dict keys $flow_vars] {
prects:  if { ![is_attribute -obj_type root $myAttr]} {
prects:    define_attribute $myAttr \
prects:      -category user_flow \
prects:      -data_type [dict get $flow_vars $myAttr type] \
prects:      -default [dict get $flow_vars $myAttr default] \
prects:      -help_string [dict get $flow_vars $myAttr description] \
prects:      -obj_type root
prects:    }
prects:}
