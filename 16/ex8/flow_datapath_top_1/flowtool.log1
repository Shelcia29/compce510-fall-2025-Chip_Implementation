sta:@@file 1: read_mmmc [get_db flow_source_directory]/mmmc_config.tcl
sta:#@ Begin verbose source /home/student/16/ex8/flow_datapath_top_1/cadence_flow_scripts/scripts/mmmc_config.tcl (pre)
sta:@file 1: # Flowkit v19.10-s008_1
sta:@file 2: # Time-stamp: <2025-11-11 10:34:33 qftele>
sta:@file 3:
sta:@file 4:
sta:@file 5: ##############################################################################
sta:@file 6: ## CONSTRAINT MODES
sta:@file 7: ##############################################################################
sta:@file 8: foreach constraint_mode $mmmc_vars(constraint_modes) {
sta:    create_constraint_mode -name $constraint_mode -sdc_files $mmmc_vars($constraint_mode,sdc_files)
sta:}
sta:@file 11:
sta:@file 12: array unset tcs
sta:@file 13: array unset rcs
sta:@file 14: array unset ocs
sta:@file 15: foreach dc $mmmc_vars(delay_corners) {
sta:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
sta:
sta:    # temperature
sta:    set temp_val "0.0"
sta:    if {${temp} == "m40c" || ${temp} == "M40C"} {
sta:        set temp_val "-40.0"
sta:    } elseif {${temp} == "125c" || ${temp} == "125C"} {
sta:        set temp_val "125.0"
sta:    } elseif {${temp} == "25c" || ${temp} == "25C"} {
sta:        set temp_val "25.0"
sta:    } elseif {${temp} == "85c" || ${temp} == "85C"} {
sta:        set temp_val "85.0"
sta:    } else {
sta:        set temp_val "0.0"
sta:    }
sta:    
sta:    # voltage
sta:    set volt_val "0.9"
sta:    set volt_val [regsub {[v|V]} [regsub {[p|P]} $volt "."] ""]
sta:    
sta:
sta:    ## LIBRARY SETS
sta:    if {[get_db program_short_name] == "genus"} {
sta:	create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_nldm)
sta:    } elseif {[get_db program_short_name] == "innovus"} {
sta:	create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
sta:    } elseif {[get_db program_short_name] == "tempus"} {
sta:        if {[info exist $mmmc_vars(${dc},timing_lvf)] && [info exist $mmmc_vars(${dc},timing_socv)]} {
sta:            create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_lvf) -socv $mmmc_vars(${dc},timing_socv)
sta:        } else {
sta:            create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
sta:        }
sta:    } elseif {[get_db program_short_name] == "voltus"} {
sta:        if {[info exist $mmmc_vars(${dc},timing_lvf)] && [info exist $mmmc_vars(${dc},timing_socv)]} {
sta:            create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_lvf) -socv $mmmc_vars(${dc},timing_socv)
sta:        } else {
sta:            create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
sta:        }
sta:    } else {
sta:	create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
sta:    }
sta:
sta:    ## OPERATING CONDITIONS
sta:    if {![info exists ocs("${volt}_${temp}")]} {
sta:	create_opcond -name "${volt}_${temp}" -process 1.0 -voltage $volt_val -temperature $temp_val
sta:	set ocs("${volt}_${temp}") 1
sta:    }
sta:
sta:    ## TIMING CONDITIONS
sta:    if {![info exists tcs("${corn}_${volt}_${temp}")]} {
sta:	create_timing_condition -name "${corn}_${volt}_${temp}" -library_sets "${corn}_${volt}_${temp}_ls" -opcond "${volt}_${temp}"
sta:	set tcs("${corn}_${volt}_${temp}") 1
sta:    }
sta:    
sta:    ## RC CORNERS
sta:    if {![info exists rcs("${rc}_${temp}")]} {
sta:	create_rc_corner -name "${rc}_${temp}" -qrc_tech $mmmc_vars("${rc}_${temp}",qrc_tech) -temperature $mmmc_vars("${rc}_${temp}",temperature)
sta:	set rcs("${rc}_${temp}") 1
sta:    }
sta:
sta:    ## DELAY CORNERS
sta:    create_delay_corner -name ${dc} -timing_condition "${corn}_${volt}_${temp}" -rc_corner "${rc}_${temp}"
sta:
sta:    ## ANALYSIS VIEWS
sta:    foreach constraint_mode $mmmc_vars(constraint_modes) {
sta:	create_analysis_view -name "${dc}_${constraint_mode}" -delay_corner $dc -constraint_mode $constraint_mode
sta:    }
sta:}
