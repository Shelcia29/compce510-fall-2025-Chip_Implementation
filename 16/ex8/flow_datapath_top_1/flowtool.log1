opt_signoff:@file 173: # Transform all dict to attribute
opt_signoff:@file 174: foreach myAttr [dict keys $flow_vars] {
opt_signoff:  if { ![is_attribute -obj_type root $myAttr]} {
opt_signoff:    define_attribute $myAttr \
opt_signoff:      -category user_flow \
opt_signoff:      -data_type [dict get $flow_vars $myAttr type] \
opt_signoff:      -default [dict get $flow_vars $myAttr default] \
opt_signoff:      -help_string [dict get $flow_vars $myAttr description] \
opt_signoff:      -obj_type root
opt_signoff:    }
opt_signoff:}
