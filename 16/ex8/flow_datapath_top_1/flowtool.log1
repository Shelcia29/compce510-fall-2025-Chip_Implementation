postroute:Warning: Overriding project macro setup from local folder
postroute:Info: Sourcing scripts/local_macro_setup.tcl
postroute:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
postroute:@file 1: ################################################################################
postroute:@file 2: # Local setup for macros in hierarchical designs
postroute:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
postroute:@file 4: ################################################################################
postroute:@file 5: # Time-stamp: <2025-11-10 22:56:41 qftele>
postroute:@file 6: #########################################################################################################
postroute:@file 7: # Macro info
postroute:@file 8: # List versions of macros used in DUT
postroute:@file 9: #########################################################################################################
postroute:@file 10: if {1} {
postroute:@file 11: array unset global_macro_exportdir
postroute:@file 12:
postroute:@file 13: set macro_scan_abstract_filelist [list ]
postroute:@file 14: set macro_lef_filelist [list ]
postroute:@file 15:
postroute:@file 16: # set module name and location of all sub-blocks here
postroute:@file 17: array set local_macro_exportdir {
postroute:    matmul_sync "../flow_matmul_sync_1"
postroute:}
postroute:@file 20:
postroute:@file 21: array set memarray {
postroute:    256x32 "IN22FDX_S1DU_BFUG_W00256B032M04C128"
postroute:}
postroute:@file 24:
postroute:@file 25: # Go through global settings for macros and see if there's a local override
postroute:@file 26: foreach {blockname blockpath} [array get global_macro_exportdir] {
postroute:
postroute:    # do not read in a model for DUT
postroute:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
postroute:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
postroute:	continue
postroute:    }
postroute:
postroute:    if {[info exists local_macro_exportdir($blockname)]} {
postroute:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
postroute:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
postroute:	    puts "\#OLD\#: $blockpath"
postroute:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
postroute:	    set $blockpath $local_macro_exportdir($blockname)
postroute:	}
postroute:    }
postroute:
postroute:    # scan abstract for DFT
postroute:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
postroute:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
postroute:    } else {
postroute:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
postroute:    }
postroute:
postroute:    # MACROs
postroute:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
postroute:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
postroute:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
postroute:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
postroute:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
postroute:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
postroute:    } else {
postroute:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
postroute:	exit 1
postroute:    }
postroute:
postroute:    # Read .lib -files
postroute:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
postroute:    foreach dc $mmmc_vars(delay_corners) {
postroute:
postroute:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postroute:
postroute:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postroute:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postroute:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postroute:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	} else {
postroute:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
postroute:	    exit 1
postroute:	}
postroute:    }
postroute:}
postroute:@file 83: # sanity check to see if global setting are missing block which are defined in local settings!
postroute:@file 84: foreach {blockname blockpath} [array get local_macro_exportdir] {
postroute:    # do not read in a model for DUT
postroute:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
postroute:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
postroute:	continue
postroute:    }
postroute:
postroute:    set found 0
postroute:    if {[info exists global_macro_exportdir($blockname)]} {
postroute:	set found 1
postroute:    }
postroute:
postroute:    if {!$found} {
postroute:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
postroute:    } else {
postroute:	# it was found so it's already set
postroute:	continue
postroute:    }
postroute:
postroute:    # scan abstract for DFT
postroute:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
postroute:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
postroute:    } else {
postroute:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
postroute:    }
postroute:
postroute:    # MACROs
postroute:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
postroute:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
postroute:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
postroute:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
postroute:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
postroute:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
postroute:    } else {
postroute:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
postroute:	exit 1
postroute:    }
postroute:
postroute:    # Read .lib -files
postroute:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
postroute:    foreach dc $mmmc_vars(delay_corners) {
postroute:
postroute:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postroute:
postroute:        puts "corn volt temp rc: ${corn}_${volt}_${temp}_${rc}"
postroute:
postroute:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postroute:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postroute:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postroute:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	} else {
postroute:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
postroute:	    exit 1
postroute:	}
postroute:    }
postroute:}
