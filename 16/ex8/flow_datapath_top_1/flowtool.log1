sta:#@ Begin verbose flow_step sta.tempus_manage_derating
sta:@flow 3: global mmmc_vars
sta:@flow 4: foreach active_av [get_db [get_db analysis_views -if {.is_setup || .is_hold}] .name] {
sta:	# SOCV RC variation
sta:	set_socv_rc_variation_factor -view ${active_av} -late  $mmmc_vars(late_rc_variation_factor)
sta:	set_socv_rc_variation_factor -view ${active_av} -early $mmmc_vars(early_rc_variation_factor)
sta:
sta:    }
sta:@@flow 11: set_socv_reporting_nsigma_multiplier -hold $mmmc_vars(timing_socv_analysis_nsigma_multiplier)  -setup $mmmc_vars(timing_socv_analysis_nsigma_multiplier) -views [get_db [get_db analysis_views -if {.is_setup || .is_hold}] .name]
sta:@flow 13: foreach dc [get_db [get_db delay_corners] .name] {
sta:        regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
sta:
sta:        # If rc-corner name ends in _T it is a setup corner
sta:        if {[regexp {_T$} $rc]} {
sta:            # For setup only derate capturing clock -> early
sta:            set_timing_derate -add -clock -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},socv_clock_cell_early)
sta:        } else {
sta:            if {[regexp {ss} $corn]} {
sta:                # For hold in SS derate launching clock and data
sta:                set_timing_derate -add -data  -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},socv_data_cell_early)
sta:                set_timing_derate -add -clock -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},socv_clock_cell_early)
sta:            } else {
sta:                # For hold in FF only derate capturing clock -> late
sta:                set_timing_derate -add -clock -cell_delay -late  -delay_corner ${dc} $mmmc_vars(${dc},socv_clock_cell_late)
sta:            }
sta:        }
sta:    }
sta:#@ End verbose flow_step sta.tempus_manage_derating
sta:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
sta:UM:           3.44              3                                      tempus_manage_derating
