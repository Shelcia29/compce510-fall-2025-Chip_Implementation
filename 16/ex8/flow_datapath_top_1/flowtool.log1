syn_opt:                                       if {[get_db flow_feature_synth_physical] || [get_db flow_feature_synth_spatial]} {
syn_opt:                                           place_dft_sequentials
syn_opt:                                           
syn_opt:                                           connect_scan_chains -chains 1500_chain  -elements [get_db scan_segments -if {.core_wrapper}]  -physical -incremental
syn_opt:                                       } else {
syn_opt:                                           connect_scan_chains -chains 1500_chain  -elements [get_db scan_segments -if {.core_wrapper}]  -incremental
syn_opt:                                       }
syn_opt:                                       set_db current_design .dft_min_number_of_scan_chains $num_chains
syn_opt:                                   }
