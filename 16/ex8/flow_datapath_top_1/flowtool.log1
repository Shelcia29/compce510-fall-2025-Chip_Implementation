opt_signoff:##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan opt_signoff}
opt_signoff:#@ Begin verbose flow_step activate_views
opt_signoff:@flow 2: set db [get_db flow_starting_db]
opt_signoff:@flow 3: set flow [lindex [get_db flow_hier_path] end]
opt_signoff:@flow 4: set setup_views [get_feature $flow -feature setup_views]
opt_signoff:@flow 5: set hold_views [get_feature $flow -feature hold_views]
opt_signoff:@flow 6: set leakage_view [get_feature $flow -feature leakage_view]
opt_signoff:@flow 7: set dynamic_view [get_feature $flow -feature dynamic_view]
opt_signoff:@flow 9: if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {...}
opt_signoff:#@ End verbose flow_step activate_views
opt_signoff:##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan opt_signoff}
opt_signoff:#@ Begin verbose flow_step init_mcpu
opt_signoff:@flow 2: # Multi host/cpu attributes
opt_signoff:@flow 3: #-----------------------------------------------------------------------------
opt_signoff:@flow 4: # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
opt_signoff:@flow 5: # the specified dist script.  This connects the number of CPUs being reserved
opt_signoff:@flow 6: # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
opt_signoff:@flow 7: # a typical environment variable exported by distribution platforms and is
opt_signoff:@flow 8: # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
opt_signoff:@flow 9: if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
opt_signoff:@flow 10: set max_cpus $::env(FLOWTOOL_NUM_CPUS)
opt_signoff:@flow 11: }
opt_signoff:@flow 17: switch -glob {innovus} {
opt_signoff:@@flow 0: set_multi_cpu_usage -verbose -local_cpu   $max_cpus
opt_signoff:**WARN: (PRL-39):	Number of local CPUs specified (16) > Actual number of CPUs in the host (8). The lower value will be used.
opt_signoff:set_multi_cpu_usage -local_cpu 8
opt_signoff:@flow 1: if {[get_feature -feature opt_signoff]} {
opt_signoff:@flow 2: if {[is_flow -inside flow:opt_signoff]} {
opt_signoff:@@flow 3: set_multi_cpu_usage -verbose -remote_host         1 -cpu_per_remote_host $max_cpus
opt_signoff:set_multi_cpu_usage -remote_host 1
opt_signoff:set_multi_cpu_usage -cpu_per_remote_host 16
opt_signoff:@@flow 4: set_distributed_hosts                             -local
opt_signoff:The timeout for a remote job to respond is 3600 seconds.
opt_signoff:Submit command for task runs will be: local
opt_signoff:@flow 5: }
opt_signoff:@flow 6: }
opt_signoff:@flow 7: if {[get_feature -feature sta_eco]} {...}
opt_signoff:@flow 13: }
opt_signoff:#@ End verbose flow_step init_mcpu
opt_signoff:End steps for plugin point Cadence.plugin.flowkit.read_db.pre
