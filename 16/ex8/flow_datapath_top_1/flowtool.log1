postroute:@@flow 86: set_db place_detail_filler_gap_effort                     high
postroute:**WARN: (IMPSP-2904):	option place_detail_filler_gap_effort and place_detail_filler_gap_min_gap will be obsolete from next release and is replaced by place_detail_legalization_inst_gap <site>.
postroute:@@flow 88: set_db place_global_uniform_density                       true                        ;
postroute:@flow 88: # Enable even cell distribution for designs with less than 70% utilization
postroute:@@flow 90: set_db place_global_place_io_pins               true
postroute:@@flow 91: set_db place_detail_use_check_drc               true
postroute:@flow 92: #set_db place_detail_color_aware_legal           true
postroute:@flow 94: # Tieoff attributes  [get_db -category add_tieoffs]
postroute:@flow 95: #-------------------------------------------------------------------------------
postroute:@@flow 96: set_db add_tieoffs_cells                        [list TIEHI TIELO]
postroute:@flow 97: # tieoff max fanout not honored without this?
postroute:@@flow 98: set_db add_tieoffs_max_fanout 32
postroute:@flow 100: # Optimization attributes  [get_db -category opt]
postroute:@flow 101: #-------------------------------------------------------------------------------
postroute:@@flow 102: set_db opt_fix_hold_allow_setup_tns_degradation           true                        ;
postroute:@flow 102: # When set to true, allows setup total negative slack to degrade during hold optimization.
postroute:@@flow 103: set_db opt_fix_hold_verbose                               true                        ;
postroute:@flow 103: # When set to true, display extra info in the log about remaining hold violations.
postroute:@@flow 104: set_db opt_new_inst_prefix            "[get_db flow_report_name]_"
postroute:@flow 105: # Note, do not use DEL* -cells for hold fixing because of HUGE variation
postroute:@@flow 106: set_db opt_fix_hold_lib_cells                   [list  ]
postroute:**WARN: (IMPOPT-7140):	The "set_db opt_hold_cells" list is empty
postroute:@flow 107: # enable data checks during gigaplace (false by default)
postroute:@flow 108: #set_db opt_enable_data_to_data_checks     true
postroute:@flow 110: # fix max_fanout / max_load violations, false by default
postroute:@@flow 111: set_db opt_fix_fanout_load true
postroute:@flow 113: # Clock attributes  [get_db -category cts]
postroute:@flow 114: #-------------------------------------------------------------------------------
postroute:@@flow 115: set_db cts_top_fanout_threshold                           2000                        ;
postroute:@flow 115: # Minimum number of transitive fanout in the clock tree for a net to be routed as a top net
postroute:@@flow 116: set_db cts_target_skew                          0.15
postroute:@@flow 117: set_db cts_target_max_transition_time           0.10
postroute:@@flow 119: set_db cts_buffer_cells                         [list CLKBUFX12 CLKBUFX16 CLKBUFX2 CLKBUFX20 CLKBUFX3 CLKBUFX4 CLKBUFX6 CLKBUFX8]
postroute:@@flow 120: set_db cts_inverter_cells                       [list CLKINVX1 CLKINVX12 CLKINVX16 CLKINVX2 CLKINVX20 CLKINVX3 CLKINVX4 CLKINVX6 CLKINVX8]
