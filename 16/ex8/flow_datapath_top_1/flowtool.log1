postroute:@flow 10:
postroute:@flow 11: }
postroute:@@flow 12: set_db init_design_uniquify 1
postroute:@flow 14: # Design attributes  [get_db -category design]
postroute:@flow 15: #-------------------------------------------------------------------------------
postroute:@@flow 16: set_db design_process_node            45
postroute:##  Process: 45            (User Set)               
postroute:##     Node: (not set)                           
postroute:
postroute:##  Check design process and node:  
postroute:##  Design tech node is not set.
postroute:
postroute:Applying the recommended capacitance filtering threshold values for 45nm process node: total_c_th=0, relative_c_th=1 and coupling_c_th=0.1.
postroute:	These values will be used by all post-route extraction engines, including TQuantus, IQuantus and Quantus QRC extraction.
postroute:	Capacitance filtering mode(extract_rc_cap_filter_mode option of the set_db) is 'relative_and_coupling' for all engines.
postroute:	The accuracy mode for post_route extract_rc_effort_level low extraction will be set to 'high'.
postroute:	Default value for EffortLevel(extract_rc_effort_level option of the set_db) in post_route extraction mode is 'medium'.
postroute:@flow 17: if {[get_feature -feature flow_express]} {...}
postroute:@@flow 20: set_db design_early_clock_flow              true
postroute:@flow 22: # Via naming
postroute:@flow 23: #-------------------------------------------------------------------------------
postroute:@flow 24: # Use design name as prefix for VIAs, as otherwise they will cause collision when merging designs on toplevel
postroute:@@flow 25: set_db write_stream_via_names true
postroute:@flow 27: # Timing attributes  [get_db -category timing && delaycalc]
postroute:@flow 28: #-------------------------------------------------------------------------------
postroute:@@flow 29: set_db timing_analysis_cppr           both
postroute:@@flow 30: set_db timing_analysis_type           ocv
postroute:@@flow 31: set_db timing_report_fields           {timing_point net cell fanout load transition delay incr_delay arrival edge user_derate power_domain}
postroute:@flow 33: #set_db timing_analysis_socv                               true                        ;# Enable socv analysis
postroute:@flow 34: #set_db timing_socv_rc_variation_mode                      true                        ;# Enable interconnect variation mode in SOCV mode
postroute:@flow 35: #set_db  timing_report_enable_verbose_ssta_mode true
postroute:@flow 37: # Add, TL: flow sets this to "no_async", async is default and should be used
postroute:@@flow 38: set_db timing_analysis_async_checks async
postroute:@flow 39: # Add, TL: maybe a bit hazardous... disable default io delay for ports which are unconstrained!
postroute:@flow 40: # if true, will cause hold problems (since launching clock is the receiving clock (with same latency!))
postroute:@@flow 41: set_db timing_apply_default_primary_input_assertion false
postroute:@@flow 43: set_db delaycal_advanced_node_pin_cap_settings true
postroute:@@flow 44: set_db delaycal_advanced_pin_cap_mode true
postroute:@flow 47: # Extraction attributes  [get_db -category extract_rc]
postroute:@flow 48: #-------------------------------------------------------------------------------
postroute:@flow 49: if {[get_feature -feature add_pvs_fill] || [get_feature -feature add_pegasus_beol_fill]} {...}
postroute:@flow 52: if {[is_flow -after flow:opt_signoff] || [is_flow -inside flow:opt_signoff]} {...}
postroute:@flow 58: if {[is_flow -after flow:route]} {
postroute:@@flow 59: set_db delaycal_enable_si           true
postroute:@@flow 60: set_db extract_rc_engine            post_route
postroute:@flow 61: # Note, TL: default is false, see effect of setting to true
postroute:@flow 62: 	#set_db si_delay_separate_on_data                  true
postroute:@flow 63: }
postroute:@flow 64: if {1} {
postroute:@@flow 65: set_db delaycal_equivalent_waveform_model               propagation
postroute:@flow 66: }
postroute:@@flow 69: set_db si_aggressor_alignment                             timing_aware_edge       
postroute:@flow 71: # Mod, TL: Too few licenses to extract all corners in parallel . Use the following to reduce number of used licenses :
postroute:@flow 72: #set_db extract_rc_qrc_run_mode sequential
postroute:@flow 74: # Floorplan attributes  [get_db -category floorplan]
postroute:@flow 75: #-------------------------------------------------------------------------------
postroute:@@flow 76: set_db finish_floorplan_active_objs   [list macro soft_blockage core]
postroute:@flow 77: # Constraints for even or odd site width/ row height
postroute:@@flow 78: set_db floorplan_row_site_height                          even
postroute:@@flow 79: set_db floorplan_row_site_width                           even
postroute:@flow 81: # Placement attributes  [get_db -category place]
postroute:@flow 82: #-------------------------------------------------------------------------------
postroute:@@flow 83: set_db place_detail_legalization_inst_gap                 1 
postroute:@@flow 84: set_db place_detail_use_no_diffusion_one_site_filler      false                        ;
postroute:@flow 84: # False to not leave 1-site gaps
postroute:@@flow 85: set_db place_detail_filler_gap_min_gap                    0.2
postroute:**WARN: (IMPSP-2904):	option place_detail_filler_gap_effort and place_detail_filler_gap_min_gap will be obsolete from next release and is replaced by place_detail_legalization_inst_gap <site>.
postroute:@@flow 86: set_db place_detail_filler_gap_effort                     high
postroute:**WARN: (IMPSP-2904):	option place_detail_filler_gap_effort and place_detail_filler_gap_min_gap will be obsolete from next release and is replaced by place_detail_legalization_inst_gap <site>.
postroute:@@flow 88: set_db place_global_uniform_density                       true                        ;
postroute:@flow 88: # Enable even cell distribution for designs with less than 70% utilization
postroute:@@flow 90: set_db place_global_place_io_pins               true
postroute:@@flow 91: set_db place_detail_use_check_drc               true
postroute:@flow 92: #set_db place_detail_color_aware_legal           true
postroute:@flow 94: # Tieoff attributes  [get_db -category add_tieoffs]
postroute:@flow 95: #-------------------------------------------------------------------------------
postroute:@@flow 96: set_db add_tieoffs_cells                        [list TIEHI TIELO]
postroute:@flow 97: # tieoff max fanout not honored without this?
postroute:@@flow 98: set_db add_tieoffs_max_fanout 32
postroute:@flow 100: # Optimization attributes  [get_db -category opt]
postroute:@flow 101: #-------------------------------------------------------------------------------
postroute:@@flow 102: set_db opt_fix_hold_allow_setup_tns_degradation           true                        ;
postroute:@flow 102: # When set to true, allows setup total negative slack to degrade during hold optimization.
postroute:@@flow 103: set_db opt_fix_hold_verbose                               true                        ;
postroute:@flow 103: # When set to true, display extra info in the log about remaining hold violations.
postroute:@@flow 104: set_db opt_new_inst_prefix            "[get_db flow_report_name]_"
postroute:@flow 105: # Note, do not use DEL* -cells for hold fixing because of HUGE variation
postroute:@@flow 106: set_db opt_fix_hold_lib_cells                   [list  ]
postroute:**WARN: (IMPOPT-7140):	The "set_db opt_hold_cells" list is empty
postroute:@flow 107: # enable data checks during gigaplace (false by default)
postroute:@flow 108: #set_db opt_enable_data_to_data_checks     true
postroute:@flow 110: # fix max_fanout / max_load violations, false by default
postroute:@@flow 111: set_db opt_fix_fanout_load true
postroute:@flow 113: # Clock attributes  [get_db -category cts]
postroute:@flow 114: #-------------------------------------------------------------------------------
postroute:@@flow 115: set_db cts_top_fanout_threshold                           2000                        ;
postroute:@flow 115: # Minimum number of transitive fanout in the clock tree for a net to be routed as a top net
postroute:@@flow 116: set_db cts_target_skew                          0.15
postroute:@@flow 117: set_db cts_target_max_transition_time           0.10
postroute:@@flow 119: set_db cts_buffer_cells                         [list CLKBUFX12 CLKBUFX16 CLKBUFX2 CLKBUFX20 CLKBUFX3 CLKBUFX4 CLKBUFX6 CLKBUFX8]
postroute:@@flow 120: set_db cts_inverter_cells                       [list CLKINVX1 CLKINVX12 CLKINVX16 CLKINVX2 CLKINVX20 CLKINVX3 CLKINVX4 CLKINVX6 CLKINVX8]
postroute:@@flow 121: set_db cts_clock_gating_cells                   [list TLATNCAX12 TLATNCAX16 TLATNCAX2 TLATNCAX20 TLATNCAX3 TLATNCAX4 TLATNCAX6 TLATNCAX8]
postroute:@@flow 122: set_db cts_logic_cells                          [get_db [get_db base_cells CLK*] .name]
postroute:@flow 124: #- Route types definitions occur during the "init_floorplan" flow_step
postroute:@flow 125: if {[get_db route_types] ne ""} {
postroute:@@flow 126: set_db cts_route_type_leaf                     cts_route_type_leaf
postroute:@@flow 127: set_db cts_route_type_trunk                    cts_route_type_trunk
postroute:@@flow 128: set_db cts_route_type_top                      cts_route_type_top
postroute:@flow 129: }
postroute:@flow 131: # Only use inverters in clock tree, no buffers
postroute:@@flow 132: set_db cts_use_inverters true
postroute:@flow 134: # Use max 32 fanout also in CTS
postroute:@@flow 135: set_db cts_max_fanout 32
postroute:@flow 137: # power balance leakage / dynamic
postroute:@flow 138: #-------------------------------------------------------------------------------
postroute:@flow 139: # Optimize both leakage & dynamic with same weight
postroute:@@flow 140: set_db opt_leakage_to_dynamic_ratio                 0.5
postroute:@flow 142: # Filler attributes  [get_db -category add_fillers]
postroute:@flow 143: #-------------------------------------------------------------------------------
postroute:@flow 144: #set_db add_fillers_avoid_abutment_patterns                "1:1 2:1"                   ;# Avoid 1:1 filler abutment
postroute:@@flow 145: set_db add_fillers_cells                        [list  DECAP10 DECAP2 DECAP3 DECAP4 DECAP5 DECAP6 DECAP7 DECAP8 DECAP9  FILL1 FILL16 FILL2 FILL32 FILL4 FILL64 FILL8  ]
postroute:@@flow 146: set_db add_fillers_no_single_site_gap true
postroute:@flow 147: # Insert fillers to toplevel hierarchy
postroute:@@flow 148: set_db add_fillers_cell_name_style                      flat
postroute:@flow 150: # Routing attributes  [get_db -category route]
postroute:@flow 151: #-------------------------------------------------------------------------------
postroute:@@flow 152: set_db route_early_global_bottom_routing_layer            [get_db [get_db layers Metal2] .route_index]
postroute:**WARN: (IMPPSP-1003):	Found use of 'route_early_global_bottom_routing_layer'. This will continue to work in this release; however, it is recommended to use 'design_bottom_routing_layer' instead.
postroute:@@flow 153: set_db route_early_global_top_routing_layer               [get_db [get_db layers Metal11] .route_index]
postroute:**WARN: (IMPPSP-1003):	Found use of 'route_early_global_top_routing_layer'. This will continue to work in this release; however, it is recommended to use 'design_top_routing_layer' instead.
postroute:@flow 154: #set_db route_early_global_num_tracks_per_clock_wire     1
postroute:@@flow 155: set_db route_early_global_num_tracks_per_clock_wire     5
postroute:@flow 157: # Note TL: use only up to M8 in routing
postroute:@@flow 158: set_db route_design_bottom_routing_layer                  [get_db [get_db layers Metal2] .route_index]
postroute:#WARNING (NRIF-90) Option set_db route_bottom_routing_layer is obsolete. It will continue to work for the current release. To ensure compatibility with future releases, use option set_db design_bottom_routing_layer instead.
postroute:@@flow 159: set_db route_design_top_routing_layer                     [get_db [get_db layers Metal11] .route_index]
postroute:#WARNING (NRIF-91) Option set_db route_top_routing_layer is obsolete. It will continue to work for the current release. To ensure compatibility with future releases, use option set_db design_top_routing_layer instead.
postroute:@@flow 161: set_db route_design_detail_post_route_swap_via          none
postroute:#WARNING (NRIF-83) When route_detail_post_route_swap_via is set to 'none', the post route via swapping step will be skipped in all scenarios.
postroute:@@flow 162: set_db route_design_with_litho_driven                   true
postroute:@@flow 163: set_db route_design_with_timing_driven                  true
postroute:@flow 165: # Antenna options
postroute:@@flow 166: set_db route_design_antenna_pin_limit                   1000
postroute:@@flow 167: set_db route_design_antenna_cell_name                   ANTENNA
postroute:@@flow 168: set_db route_design_add_antenna_inst_prefix             "ANTENNA"
postroute:@@flow 169: set_db route_design_antenna_diode_insertion             true
postroute:@@flow 170: set_db route_design_detail_fix_antenna                  true
postroute:@flow 172: #set_db route_design_process_node                        45
postroute:@@flow 173: set_db route_design_with_via_in_pin                     1:1 ;
postroute:@flow 173: # enclose via inside stdcell pin shape on M1 accesses
postroute:@flow 175: # H240 trim grid definition
postroute:@flow 176: #set_db route_design_with_trim_metal "-layer 2  #-mask2 {-pitch 0.24 -core_offset 0.225 -width 0.03 }  #-mask2 {-pitch 0.24 -core_offset 0.095 -width 0.03 }  #-mask1 {-pitch 0.24 -core_offset 0.015 -width 0.03 }  #-mask1 {-pitch 0.24 -core_offset 0.145 -width 0.03 }"
postroute:@@flow 178: set_db route_design_concurrent_minimize_via_count_effort  high                        ;
postroute:@flow 178: # Reduce the via count while routing
postroute:@@flow 179: set_db route_design_detail_use_multi_cut_via_effort       high                        ;
postroute:@flow 179: # Turn on concurrent double/bar cut routing before CTS
postroute:@flow 180: #set_db route_design_with_via_only_for_block_cell_pin      2:2                         ;# Access M2 MACRO pin with VIA only
postroute:@flow 182: if {1} {
postroute:@flow 183: #	reset_db route_design_detail_use_multi_cut_via_effort                               ;# Turn off concurrent double/bar cut routing
postroute:@flow 184: #	eval_legacy {setNanoRouteMode -drouteExpConcurrentMinimizeViaCountCost 64}          ;# Concurrently minimize via count adding via cost
postroute:@flow 185: #	set_db route_design_antenna_diode_insertion             true                        ;# Allow diode insertion for Antenna fixing
postroute:@@flow 186: set_db route_design_detail_post_route_swap_via          multicut                    ;
postroute:#WARNING (NRIF-80) When route_detail_post_route_swap_via is set to 'multiCut', the post route via swapping step will be performed on all nets, and to double cut vias. To swap to DFM vias based on via weight, please set the option to 'true'.
postroute:@flow 186: # If postroute double cuts are desired..although the percentage of swap is low for N7
postroute:@flow 187: }
postroute:@@flow 189: eval_legacy {setNanoRouteMode  -routeExpShieldAddTappingVia true}                     ;
postroute:@flow 189: # Add Tapping via for the specified distance for shielding
postroute:@flow 191: # Timing ECO attributes [get_db -category opt_signoff] 
postroute:@flow 192: #-------------------------------------------------------------------------------
postroute:@@flow 193: set_db distributed_child_license_checkout_list          tpsxl
postroute:@flow 195: # techniques                                                                    
postroute:@flow 196: #set_db opt_signoff_resize_inst  true                                           
postroute:@flow 197: #set_db opt_signoff_add_inst true                                               
postroute:@flow 198: #set_db opt_signoff_swap_inst true                                              
postroute:@flow 199: #set_db opt_signoff_delete_inst true                                            
postroute:@flow 200: #set_db opt_signoff_allow_skewing false                                         
postroute:@flow 201: #set_db opt_signoff_optimize_sequential_cells false                             
postroute:@@flow 202: set_db opt_signoff_optimize_core_only                   true                                    
postroute:@flow 203: #set_db opt_signoff_optimize_replicated_modules false                           
postroute:@flow 205: # target
postroute:@flow 206: #set_db opt_signoff_setup_target_slack 0.0
postroute:@flow 207: #set_db opt_signoff_hold_target_slack 0.0 
postroute:@flow 209: # Note TL: both false by default
postroute:@@flow 210: set_db opt_signoff_fix_si_slew true
postroute:@@flow 211: set_db opt_signoff_fix_xtalk   true
postroute:@@flow 212: set_db opt_signoff_fix_glitch  true
postroute:@flow 214: # Hold fixing
postroute:@@flow 215: set_db opt_signoff_fix_hold_allow_setup_optimization      true                        ;
postroute:@flow 215: # When set to true, incremental Setup fixing is performed during Hold fixing in order to create more Setup margins on Hold violated nodes that could not be fixed earlier due to Setup timing conflict
postroute:@@flow 216: set_db opt_signoff_fix_hold_allow_setup_tns_degrade       true                        ;
postroute:@flow 216: # When  specified,  the  Setup Total Negative Slack can be degraded during Hold time violations fixing while still maintaining the Setup Worst Negative Slack in every Setup active views.
postroute:@flow 218: # PBA
postroute:@@flow 219: set_db opt_signoff_retime                               path_slew_propagation
postroute:@flow 220: #set_db opt_signoff_check_type both                 
postroute:@flow 221: #set_db opt_signoff_max_paths -1                    
postroute:@flow 222: #set_db opt_signoff_nworst -1                       
postroute:@flow 223: #set_db opt_signoff_max_slack 0.0                   
