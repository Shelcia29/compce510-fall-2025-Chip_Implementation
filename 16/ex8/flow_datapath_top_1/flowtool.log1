prects:Warning: Overriding project macro setup from local folder
prects:Info: Sourcing scripts/local_macro_setup.tcl
prects:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
prects:@file 1: ################################################################################
prects:@file 2: # Local setup for macros in hierarchical designs
prects:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
prects:@file 4: ################################################################################
prects:@file 5: # Time-stamp: <2025-11-10 22:56:41 qftele>
prects:@file 6: #########################################################################################################
prects:@file 7: # Macro info
prects:@file 8: # List versions of macros used in DUT
prects:@file 9: #########################################################################################################
prects:@file 10: if {1} {
prects:@file 11: array unset global_macro_exportdir
prects:@file 12:
prects:@file 13: set macro_scan_abstract_filelist [list ]
prects:@file 14: set macro_lef_filelist [list ]
prects:@file 15:
prects:@file 16: # set module name and location of all sub-blocks here
prects:@file 17: array set local_macro_exportdir {
prects:    matmul_sync "../flow_matmul_sync_1"
prects:}
prects:@file 20:
prects:@file 21: array set memarray {
prects:    256x32 "IN22FDX_S1DU_BFUG_W00256B032M04C128"
prects:}
prects:@file 24:
prects:@file 25: # Go through global settings for macros and see if there's a local override
prects:@file 26: foreach {blockname blockpath} [array get global_macro_exportdir] {
prects:
prects:    # do not read in a model for DUT
prects:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
prects:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
prects:	continue
prects:    }
prects:
prects:    if {[info exists local_macro_exportdir($blockname)]} {
prects:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
prects:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
prects:	    puts "\#OLD\#: $blockpath"
prects:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
prects:	    set $blockpath $local_macro_exportdir($blockname)
prects:	}
prects:    }
prects:
prects:    # scan abstract for DFT
prects:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
prects:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
prects:    } else {
prects:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
prects:    }
prects:
prects:    # MACROs
prects:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
prects:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
prects:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
prects:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
prects:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
prects:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
prects:    } else {
prects:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
prects:	exit 1
prects:    }
prects:
prects:    # Read .lib -files
prects:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
prects:    foreach dc $mmmc_vars(delay_corners) {
prects:
prects:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
prects:
prects:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
prects:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
prects:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
prects:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	} else {
prects:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
prects:	    exit 1
prects:	}
prects:    }
prects:}
prects:@file 83: # sanity check to see if global setting are missing block which are defined in local settings!
prects:@file 84: foreach {blockname blockpath} [array get local_macro_exportdir] {
prects:    # do not read in a model for DUT
prects:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
prects:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
prects:	continue
prects:    }
prects:
prects:    set found 0
prects:    if {[info exists global_macro_exportdir($blockname)]} {
prects:	set found 1
prects:    }
prects:
prects:    if {!$found} {
prects:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
prects:    } else {
prects:	# it was found so it's already set
prects:	continue
prects:    }
prects:
prects:    # scan abstract for DFT
prects:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
prects:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
prects:    } else {
prects:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
prects:    }
prects:
prects:    # MACROs
prects:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
prects:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
prects:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
prects:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
prects:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
prects:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
prects:    } else {
prects:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
prects:	exit 1
prects:    }
prects:
prects:    # Read .lib -files
prects:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
prects:    foreach dc $mmmc_vars(delay_corners) {
prects:
prects:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
prects:
prects:        puts "corn volt temp rc: ${corn}_${volt}_${temp}_${rc}"
prects:
prects:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
prects:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
prects:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
prects:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	} else {
prects:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
prects:	    exit 1
prects:	}
prects:    }
prects:}
