sta:@file 173: # Transform all dict to attribute
sta:@file 174: foreach myAttr [dict keys $flow_vars] {
sta:  if { ![is_attribute -obj_type root $myAttr]} {
sta:    define_attribute $myAttr \
sta:      -category user_flow \
sta:      -data_type [dict get $flow_vars $myAttr type] \
sta:      -default [dict get $flow_vars $myAttr default] \
sta:      -help_string [dict get $flow_vars $myAttr description] \
sta:      -obj_type root
sta:    }
sta:}
