syn_opt:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
