floorplan:@file 83: # sanity check to see if global setting are missing block which are defined in local settings!
floorplan:@file 84: foreach {blockname blockpath} [array get local_macro_exportdir] {
floorplan:    # do not read in a model for DUT
floorplan:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
floorplan:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
floorplan:	continue
floorplan:    }
floorplan:
floorplan:    set found 0
floorplan:    if {[info exists global_macro_exportdir($blockname)]} {
floorplan:	set found 1
floorplan:    }
floorplan:
floorplan:    if {!$found} {
floorplan:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
floorplan:    } else {
floorplan:	# it was found so it's already set
floorplan:	continue
floorplan:    }
floorplan:
floorplan:    # scan abstract for DFT
floorplan:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
floorplan:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
floorplan:    } else {
floorplan:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
floorplan:    }
floorplan:
floorplan:    # MACROs
floorplan:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
floorplan:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
floorplan:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
floorplan:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
floorplan:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
floorplan:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
floorplan:    } else {
floorplan:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
floorplan:	exit 1
floorplan:    }
floorplan:
floorplan:    # Read .lib -files
floorplan:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
floorplan:    foreach dc $mmmc_vars(delay_corners) {
floorplan:
floorplan:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
floorplan:
floorplan:        puts "corn volt temp rc: ${corn}_${volt}_${temp}_${rc}"
floorplan:
floorplan:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
floorplan:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
floorplan:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
floorplan:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	} else {
floorplan:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
floorplan:	    exit 1
floorplan:	}
floorplan:    }
floorplan:}
