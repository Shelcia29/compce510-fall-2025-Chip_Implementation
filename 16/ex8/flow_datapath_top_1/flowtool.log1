floorplan:@file 7: set TECH_SETUP_VERSION "v1.0"
floorplan:@file 8: puts "Info: TECHNOLOGY SETUP: $TECHNOLOGY : $TECH_SETUP_VERSION"
floorplan:Info: TECHNOLOGY SETUP: gpdk045 : v1.0
floorplan:@file 9:
floorplan:@file 10: # Directory structure
floorplan:@@file 11: set_db flow_vars_lef_tech_file                             "/opt/soc/tech/GPDK045/gsclib045/lef/gsclib045_tech.lef"
floorplan:@@file 12: set_db flow_vars_qrc_tech_directory                        "/opt/soc/tech/GPDK045/gsclib045/qrc"
floorplan:@@file 13: set_db flow_vars_gdsout_stream_map_file                    "/opt/soc/tech/GPDK045/gsclib045/oa22/gsclib045/gsclib045.layermap"
