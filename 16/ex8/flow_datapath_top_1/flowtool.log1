sta:#@ Begin verbose flow_step sta.tempus_load_latency_files
sta:@flow 2: foreach dpo [get_db analysis_views] {
sta:	set dpo_latency_file [file join [get_db flow_db_directory]/latency_files [get_db $dpo .name]_latency.sdc]
sta:	if {[file exists $dpo_latency_file]} {
sta:	    update_analysis_view -name [get_db $dpo .name] -latency_file $dpo_latency_file
sta:	} else {
sta:            puts "Warning: Could not find latency file for view: [get_db $dpo .name] in [get_db flow_db_directory]/latency_files"
sta:            puts "Note: Using different view for latency"
sta:            if {[regexp {^ss_0p81v.*worst_T_(\w+)$} [get_db $dpo .name] -> mode_name]} {
sta:                set new_dpo_name ss_0p81v_m40c_rcworst_T_${mode_name}
sta:                set dpo_latency_file [file join [get_db flow_db_directory]/latency_files ${new_dpo_name}_latency.sdc]
sta:            } elseif {[regexp {^ss_0p81v.*worst_(\w+)$} [get_db $dpo .name] -> mode_name]} {
sta:                set new_dpo_name ss_0p81v_m40c_rcworst_${mode_name}
sta:                set dpo_latency_file [file join [get_db flow_db_directory]/latency_files ${new_dpo_name}_latency.sdc]
sta:            } elseif {[regexp {^ff_0p99v.*best_(\w+)$} [get_db $dpo .name] -> mode_name]} {
sta:                set new_dpo_name ff_0p99v_125c_cbest_${mode_name}
sta:                set dpo_latency_file [file join [get_db flow_db_directory]/latency_files ${new_dpo_name}_latency.sdc]
sta:            } elseif {[regexp {^ff_0p99v.*worst_(\w+)$} [get_db $dpo .name] -> mode_name]} {
sta:                set new_dpo_name ff_0p99v_125c_cbest_${mode_name}
sta:                set dpo_latency_file [file join [get_db flow_db_directory]/latency_files ${new_dpo_name}_latency.sdc]
sta:            }
sta:                
sta:            if {[file exists $dpo_latency_file]} {
sta:                update_analysis_view -name [get_db $dpo .name] -latency_file $dpo_latency_file
sta:            } else {
sta:                puts "Error: Could not map [get_db $dpo .name] to latency file $dpo_latency_file"
sta:            }
sta:        }
sta:    }
