postcts:@file 145:
postcts:@file 146: ########################################################################
postcts:@file 147: # Memories
postcts:@file 148: ########################################################################
postcts:@file 149:
postcts:@file 150: set memory_gds_filelist [list]
postcts:@file 151: set memory_spi_filelist [list]
postcts:@file 152: foreach {memdir memlist} [array get memarray] {
postcts:
postcts:    set mem_directory ./models
postcts:    puts "Info: setting mem_directory as $mem_directory"
postcts:    foreach mem $memlist {
postcts:
postcts:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
postcts:
postcts:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
postcts:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
postcts:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
postcts:
postcts:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
postcts:
postcts:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
postcts:
postcts:        foreach dc $mmmc_vars(delay_corners) {
postcts:
postcts:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postcts:
postcts:	    puts "Info: Adding NLDM: ${mem_directory}/${mem}.${corn}_${volt}_${temp}_${rc}_func.lib"
postcts:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.${corn}_${volt}_${temp}_${rc}_func.lib
postcts:            lappend mmmc_vars(${dc},timing_ecsm) ${mem_directory}/${mem}.${corn}_${volt}_${temp}_${rc}_func.lib
postcts:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
postcts:        }
postcts:    }
postcts:}
