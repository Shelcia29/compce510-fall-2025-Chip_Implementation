syn_generic:    }
syn_generic:
syn_generic:    # MACROs
syn_generic:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
syn_generic:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
syn_generic:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
syn_generic:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
syn_generic:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
syn_generic:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
syn_generic:    } else {
syn_generic:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
syn_generic:	exit 1
syn_generic:    }
syn_generic:
syn_generic:    # Read .lib -files
syn_generic:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
syn_generic:    foreach dc $mmmc_vars(delay_corners) {
syn_generic:
syn_generic:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_generic:
syn_generic:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_generic:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_generic:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_generic:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
