route:@file 7: puts "Info: MACRO SETUP: $MACRO_SETUP_VERSION"
route:Info: MACRO SETUP: v1.0
route:@file 8:
route:@file 9: #########################################################################################################
route:@file 10: # Macro info
route:@file 11: # List all DUT versions of all macros in project
route:@file 12: #########################################################################################################
route:@file 13: array set global_macro_exportdir {
