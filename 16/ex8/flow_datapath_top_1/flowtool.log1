postcts:@file 173: # Transform all dict to attribute
postcts:@file 174: foreach myAttr [dict keys $flow_vars] {
postcts:  if { ![is_attribute -obj_type root $myAttr]} {
postcts:    define_attribute $myAttr \
postcts:      -category user_flow \
postcts:      -data_type [dict get $flow_vars $myAttr type] \
postcts:      -default [dict get $flow_vars $myAttr default] \
postcts:      -help_string [dict get $flow_vars $myAttr description] \
postcts:      -obj_type root
postcts:    }
postcts:}
