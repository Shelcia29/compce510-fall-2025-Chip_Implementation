route:#@ Begin verbose source /home/student/16/ex8/flow_datapath_top_1/cadence_flow_scripts/scripts/global_macro_setup.tcl (pre)
route:@file 1: ################################################################################
route:@file 2: # Setup for macros in hierarchical designs
