route:@file 9:
route:@file 10: # Delay corner list
route:@file 11: set mmmc_vars(delay_corners) \
route:    [list \
route:	 slow_0p9v_125c_cmax \
route:	 fast_1p1v_0c_cmin \
route:	 ]
route:@file 16:
route:@file 17:
route:@file 18: # Read .lib -files
route:@file 19: foreach dc $mmmc_vars(delay_corners) {
route:
route:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
route:
route:    # qrc techfile
route:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
route:    # temperature
route:    if {${temp} == "m40c"} {
route:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
route:    } elseif {${temp} == "125c"} {
route:	set mmmc_vars("${rc}_${temp}",temperature) "125"
route:    } elseif {${temp} == "0c"} {
route:	set mmmc_vars("${rc}_${temp}",temperature) "0"
route:    } else {
route:	set mmmc_vars("${rc}_${temp}",temperature) "25"
route:    }
route:
route:
route:    ###########################################
route:    # OCVs &  Clock uncertainties for FLAT OCV
route:    ###########################################
route:
route:    # use following uncertainties
route:    # FUNC:
route:    # setup:
route:    # clock jitter: defined through clock cycle
route:    # TECH uncertainty: 25ps
route:    # extra uncertainty (implementation): 20ps
route:    # extra uncertainty (signoff STA): 0ps
route:    # hold:
route:    # TECH uncertainty (SSG): 50ps
route:    # TECH uncertainty (fast): 40ps
route:    # extra uncertainty (implementation): 15ps
route:    # extra uncertainty (signoff STA): 0ps
route:
route:    # Note, add 1% OCV on top of previous to match LVF
route:    # so flat values below have 0.01 added (subtracted) because of this
route:
route:    # setup in slow, 0.81v, -40C/125c, cmax
route:    if {$corn eq "slow" &&
route:	$volt eq "0p9v" &&
route:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
route:	($rc eq "cmax")} {
route:	
route:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
route:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
route:	# +2.0% for launching clock cell
route:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
route:	# hold not checked in this corner
route:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
route:	# + 6.9% on data cell
route:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
route:
route:	# -6.0% for clock net
route:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
route:	# +6.0% for clock net
route:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
route:	# hold not checked in this corner
route:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
route:	# +6.0 for data net
route:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
route:
route:    # hold in slow, 0.81v, -40c/125c, cmax
route:    } elseif {$corn eq "slow" &&
route:	      $volt eq "0p9v" &&
route:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
route:	      ($rc eq "cmax")} {
route:	
route:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
route:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
route:	# +3.2% for capturing clock cell
route:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
route:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
route:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
route:	# setup not checked
route:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
route:
route:	# -8.5% for launching clock net
route:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
route:	# no derate on capturing clock net
route:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
route:	# -8.5% for data net
route:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
route:	# setup not checked
route:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
route:
route:    # hold in fast, 0.99v, -40c/0c/125c, cmax
route:    } elseif {$corn eq "fast" &&
route:	      $volt eq "1p1v" &&
route:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
route:	      ($rc eq "cmax")} {
route:	
route:	# -3.7% for launching clock cell
route:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
route:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
route:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
route:	# -12.1% for data
route:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
route:	# setup not checked
route:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
route:
route:	# -8.5% for launching clock net
route:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
route:	# no derate on capturing clock net
route:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
route:	# -8.5% for data net
route:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
route:	# setup not checked
route:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
route:
route:    # hold in fast, 0.99v, -40c/0c/125c, cmin
route:    } elseif {$corn eq "fast" &&
route:	      $volt eq "1p1v" &&
route:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
route:	      ($rc eq "cmin")} {
route:	
route:	# -3.7% for launching clock cell
route:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
route:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
route:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
route:	# -12.1% for data
route:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
route:	# setup not checked
route:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
route:
route:	# no derate on launching clock net
route:	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
route:	# +8.5% for capturing clock net
route:	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
route:	# no derate for data net
route:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
route:	# setup not checked
route:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
route:
route:    } else {
route:	puts "Fatal: delay corner ${dc} OCVs not defined (corner: $corn, voltage: $volt, temperature: $temp, rc: ${rc})"
route:	exit 1
route:    }
route:
route:    ###########################################
route:    # OCVs &  Clock uncertainties for SOCV
route:    ###########################################
route:
route:    # Note, only voltage and temperature OCVs needed
route:
route:    # Early & late variation factors from:
route:    set mmmc_vars(early_rc_variation_factor) 0.06
route:    set mmmc_vars(late_rc_variation_factor) 0.06
route:
route:    set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
route:
route:    # slow, 0.81v, -40c
route:    if {$corn eq "slow" &&
route:	$volt eq "0p9v" &&
route:	$temp eq "m40c"} {
route:        
route:        # DATA  @ 20.3mV : 7.4%
route:        # DATA  @ 10c    : 0.9%
route:        # CLOCK @ 20.3mV : 5.4%
route:        # CLOCK @ 10c    : 0.7%
route:
route:        # For setup only derate clock
route:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
route:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
route:        # For hold in slow derate data & launching clock
route:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
route:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
route:
route:    } elseif {$corn eq "slow" &&
route:	$volt eq "0p9v" &&
route:	$temp eq "125c"} {
route:       
route:        # DATA  @ 20.3mV : 5.0%
route:        # DATA  @ 10c    : 0.3%
route:        # CLOCK @ 20.3mV : 3.5%
route:        # CLOCK @ 10c    : 0.2%
route:
route:        # For setup only derate clock
route:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
route:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
route:        # For hold in slow derate data & launching clock
route:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
route:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
route:
route:    } elseif {$corn eq "slow" &&
route:	$volt eq "0p9v" &&
route:	$temp eq "0c"} {
route:       
route:        # DATA  @ 20.3mV : 6.6%
route:        # DATA  @ 10c    : 0.8%
route:        # CLOCK @ 20.3mV : 4.9%
route:        # CLOCK @ 10c    : 0.6%
route:
route:        # For setup only derate clock
route:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
route:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
route:        # For hold in slow derate data & launching clock
route:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
route:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
route:
route:    } elseif {$corn eq "fast" &&
route:	$volt eq "1p1v" &&
route:	$temp eq "m40c"} {
route:       
route:        # DATA  @ 45mV   : 7.4%
route:        # DATA  @ 10c    : 0.5%
route:        # CLOCK @ 45mV   : 5.1%
route:        # CLOCK @ 10c    : 0.6%
route:
route:        # For setup only derate clock
route:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
route:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
route:        # For hold in slow derate data & launching clock
route:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
route:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
route:
route:     } elseif {$corn eq "fast" &&
route:	$volt eq "1p1v" &&
route:	$temp eq "125c"} {
route:
route:        # DATA  @ 45mV   : 5.8%
route:        # DATA  @ 10c    : 0.5%
route:        # CLOCK @ 45mV   : 3.6%
route:        # CLOCK @ 10c    : 0.6%
route:
route:        # For setup only derate clock
route:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
route:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
route:        # For hold in slow derate data & launching clock
route:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
route:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
route:
route:    } elseif {$corn eq "fast" &&
route:	$volt eq "1p1v" &&
route:	$temp eq "0c"} {
route:
route:        # DATA  @ 45mV   : 7.0%
route:        # DATA  @ 10c    : 0.4%
route:        # CLOCK @ 45mV   : 4.7%
route:        # CLOCK @ 10c    : 0.4%
route:
route:        # For setup only derate clock
route:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
route:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
route:        # For hold in slow derate data & launching clock
route:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
route:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
route:
route:     } else {
route:        puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
route:        exit 1
route:    }
route:}
route:@file 272:
route:@file 273: # Constraint mode list
route:@file 274: set mmmc_vars(constraint_modes) [get_db flow_vars_constraint_modes]
route:@file 275:
route:@file 276: foreach cm $mmmc_vars(constraint_modes) {
route:    if {[get_db program_short_name] == "genus"} {
route:#	if {${cm} == "func"} {
route:	    set mmmc_vars(${cm},sdc_files) [list [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.${cm}.tcl \
route:						[get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].boundary_conditions.tcl \
route:						]
route:#	} else {
route:#	    set mmmc_vars(${cm},sdc_files) [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.dummy.tcl
route:#	}
route:    } else {
route:	if {${cm} == "func"} {
route:	    set mmmc_vars(${cm},sdc_files) [list [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.${cm}.tcl \
route:						[get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].boundary_conditions.tcl \
route:						[get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.hier_dft.tcl \
route:						]
route:	} else {
route:	    set mmmc_vars(${cm},sdc_files) [list [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.${cm}.tcl \
route:						[get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].boundary_conditions.tcl \
route:						]
route:	}
route:    }
route:}
route:#@ End verbose source scripts/mmmc_setup.tcl
