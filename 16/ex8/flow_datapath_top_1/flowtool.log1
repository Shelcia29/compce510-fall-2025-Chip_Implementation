floorplan:@flow 3: # Tool settings: NOTE: already set by flow_config.tcl
floorplan:@flow 4: #set_multi_cpu_usage -local_cpu 8 -remote_host 1 -cpu_per_remote_host 8
floorplan:@flow 6: if {[get_feature -feature report_lec]} {
floorplan:@flow 7: # Init attributes  [get_db -category init]
floorplan:@flow 8: 	#-------------------------------------------------------------------------------
floorplan:@@flow 9: set_db write_lec_directory_naming_style "fv/%s/[get_db flow_report_name]"
floorplan:@flow 10:
floorplan:@flow 11: }
floorplan:@@flow 12: set_db init_design_uniquify 1
floorplan:@flow 14: # Design attributes  [get_db -category design]
floorplan:@flow 15: #-------------------------------------------------------------------------------
floorplan:@@flow 16: set_db design_process_node            45
floorplan:##  Process: 45            (User Set)               
floorplan:##     Node: (not set)                           
floorplan:
floorplan:##  Check design process and node:  
floorplan:##  Design tech node is not set.
floorplan:
floorplan:Applying the recommended capacitance filtering threshold values for 45nm process node: total_c_th=0, relative_c_th=1 and coupling_c_th=0.1.
floorplan:	These values will be used by all post-route extraction engines, including TQuantus, IQuantus and Quantus QRC extraction.
floorplan:	Capacitance filtering mode(extract_rc_cap_filter_mode option of the set_db) is 'relative_and_coupling' for all engines.
floorplan:	The accuracy mode for post_route extract_rc_effort_level low extraction will be set to 'high'.
floorplan:	Default value for EffortLevel(extract_rc_effort_level option of the set_db) in post_route extraction mode is 'medium'.
floorplan:@flow 17: if {[get_feature -feature flow_express]} {...}
floorplan:@@flow 20: set_db design_early_clock_flow              true
floorplan:@flow 22: # Via naming
floorplan:@flow 23: #-------------------------------------------------------------------------------
floorplan:@flow 24: # Use design name as prefix for VIAs, as otherwise they will cause collision when merging designs on toplevel
floorplan:@@flow 25: set_db write_stream_via_names true
floorplan:@flow 27: # Timing attributes  [get_db -category timing && delaycalc]
floorplan:@flow 28: #-------------------------------------------------------------------------------
floorplan:@@flow 29: set_db timing_analysis_cppr           both
floorplan:@@flow 30: set_db timing_analysis_type           ocv
floorplan:@@flow 31: set_db timing_report_fields           {timing_point net cell fanout load transition delay incr_delay arrival edge user_derate power_domain}
floorplan:@flow 33: #set_db timing_analysis_socv                               true                        ;# Enable socv analysis
floorplan:@flow 34: #set_db timing_socv_rc_variation_mode                      true                        ;# Enable interconnect variation mode in SOCV mode
