syn_opt:set_db flow_vars_lef_list [concat [get_db flow_vars_lef_list] $macro_lef_filelist]
syn_opt:set pll_idx [lsearch -regexp [get_db flow_vars_lef_list] {CLKPLL}]
syn_opt:set_db flow_vars_lef_list [lreplace [get_db flow_vars_lef_list] $pll_idx $pll_idx]
