syn_opt:#@ Begin verbose source ./scripts/local_macro_setup.tcl
syn_opt:@file(local_macro_setup.tcl) 10: if {1} {
syn_opt:array unset global_macro_exportdir
syn_opt:
syn_opt:set macro_scan_abstract_filelist [list ]
syn_opt:set macro_lef_filelist [list ]
syn_opt:
syn_opt:# set module name and location of all sub-blocks here
syn_opt:array set local_macro_exportdir {
syn_opt:    matmul_sync "../flow_matmul_sync_1"
syn_opt:}
syn_opt:
syn_opt:array set memarray {
syn_opt:    256x32 "IN22FDX_S1DU_BFUG_W00256B032M04C128"
syn_opt:}
syn_opt:
syn_opt:# Go through global settings for macros and see if there's a local override
syn_opt:foreach {blockname blockpath} [array get global_macro_exportdir] {
syn_opt:
syn_opt:    # do not read in a model for DUT
syn_opt:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
syn_opt:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
syn_opt:	continue
syn_opt:    }
syn_opt:
syn_opt:    if {[info exists local_macro_exportdir($blockname)]} {
syn_opt:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
syn_opt:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
syn_opt:	    puts "\#OLD\#: $blockpath"
syn_opt:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
syn_opt:	    set $blockpath $local_macro_exportdir($blockname)
syn_opt:	}
syn_opt:    }
syn_opt:
syn_opt:    # scan abstract for DFT
syn_opt:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
syn_opt:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
syn_opt:    } else {
syn_opt:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
syn_opt:    }
syn_opt:
syn_opt:    # MACROs
syn_opt:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
syn_opt:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
syn_opt:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
syn_opt:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
syn_opt:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
syn_opt:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
syn_opt:    } else {
syn_opt:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
syn_opt:	exit 1
syn_opt:    }
syn_opt:
syn_opt:    # Read .lib -files
syn_opt:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
syn_opt:    foreach dc $mmmc_vars(delay_corners) {
syn_opt:
syn_opt:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_opt:
syn_opt:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_opt:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_opt:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_opt:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	} else {
syn_opt:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
syn_opt:	    exit 1
syn_opt:	}
syn_opt:    }
syn_opt:}
syn_opt:# sanity check to see if global setting are missing block which are defined in local settings!
syn_opt:foreach {blockname blockpath} [array get local_macro_exportdir] {
syn_opt:    # do not read in a model for DUT
syn_opt:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
syn_opt:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
syn_opt:	continue
syn_opt:    }
syn_opt:
syn_opt:    set found 0
syn_opt:    if {[info exists global_macro_exportdir($blockname)]} {
syn_opt:	set found 1
syn_opt:    }
syn_opt:
syn_opt:    if {!$found} {
syn_opt:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
syn_opt:    } else {
syn_opt:	# it was found so it's already set
syn_opt:	continue
syn_opt:    }
syn_opt:
syn_opt:    # scan abstract for DFT
syn_opt:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
syn_opt:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
syn_opt:    } else {
syn_opt:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
syn_opt:    }
syn_opt:
syn_opt:    # MACROs
syn_opt:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
syn_opt:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
syn_opt:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
syn_opt:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
syn_opt:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
syn_opt:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
syn_opt:    } else {
syn_opt:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
syn_opt:	exit 1
syn_opt:    }
syn_opt:
syn_opt:    # Read .lib -files
syn_opt:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
syn_opt:    foreach dc $mmmc_vars(delay_corners) {
syn_opt:
syn_opt:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_opt:
syn_opt:        puts "corn volt temp rc: ${corn}_${volt}_${temp}_${rc}"
syn_opt:
syn_opt:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_opt:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_opt:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_opt:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_opt:	} else {
syn_opt:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
syn_opt:	    exit 1
syn_opt:	}
syn_opt:    }
syn_opt:}
