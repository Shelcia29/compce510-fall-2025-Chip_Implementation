syn_map:@file(library_setup.tcl) 51: foreach dc $mmmc_vars(delay_corners) {
syn_map:    set mmmc_vars(${dc},timing_nldm) [list \
syn_map:                                         ]
syn_map:    set mmmc_vars(${dc},timing_ecsm) [list \
syn_map:                                         ]
syn_map:    if {[regexp {slow} $dc]} {
syn_map:        lappend mmmc_vars(${dc},timing_nldm) [get_db flow_vars_stdcell_path]/timing/slow_vdd1v0_basicCells.lib
