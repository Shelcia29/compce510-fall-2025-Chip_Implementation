route:Warning: Overriding project macro setup from local folder
route:Info: Sourcing scripts/local_macro_setup.tcl
route:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
route:@file 1: ################################################################################
route:@file 2: # Local setup for macros in hierarchical designs
route:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
route:@file 4: ################################################################################
route:@file 5: # Time-stamp: <2025-11-10 22:56:41 qftele>
route:@file 6: #########################################################################################################
route:@file 7: # Macro info
route:@file 8: # List versions of macros used in DUT
route:@file 9: #########################################################################################################
route:@file 10: if {1} {
route:@file 11: array unset global_macro_exportdir
route:@file 12:
route:@file 13: set macro_scan_abstract_filelist [list ]
route:@file 14: set macro_lef_filelist [list ]
route:@file 15:
route:@file 16: # set module name and location of all sub-blocks here
route:@file 17: array set local_macro_exportdir {
route:    matmul_sync "../flow_matmul_sync_1"
route:}
route:@file 20:
route:@file 21: array set memarray {
route:    256x32 "IN22FDX_S1DU_BFUG_W00256B032M04C128"
route:}
route:@file 24:
route:@file 25: # Go through global settings for macros and see if there's a local override
route:@file 26: foreach {blockname blockpath} [array get global_macro_exportdir] {
route:
route:    # do not read in a model for DUT
route:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
route:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
route:	continue
route:    }
route:
route:    if {[info exists local_macro_exportdir($blockname)]} {
route:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
route:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
route:	    puts "\#OLD\#: $blockpath"
route:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
route:	    set $blockpath $local_macro_exportdir($blockname)
route:	}
route:    }
route:
route:    # scan abstract for DFT
route:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
route:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
route:    } else {
route:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
route:    }
route:
route:    # MACROs
route:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
route:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
route:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
route:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
route:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
route:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
route:    } else {
route:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
route:	exit 1
route:    }
route:
route:    # Read .lib -files
route:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
route:    foreach dc $mmmc_vars(delay_corners) {
route:
route:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
route:
route:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
route:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
route:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
route:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	} else {
route:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
route:	    exit 1
route:	}
route:    }
route:}
route:@file 83: # sanity check to see if global setting are missing block which are defined in local settings!
route:@file 84: foreach {blockname blockpath} [array get local_macro_exportdir] {
route:    # do not read in a model for DUT
route:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
route:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
route:	continue
route:    }
route:
route:    set found 0
route:    if {[info exists global_macro_exportdir($blockname)]} {
route:	set found 1
route:    }
route:
route:    if {!$found} {
route:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
route:    } else {
route:	# it was found so it's already set
route:	continue
route:    }
route:
route:    # scan abstract for DFT
route:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
route:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
route:    } else {
route:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
route:    }
route:
route:    # MACROs
route:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
route:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
route:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
route:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
route:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
route:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
route:    } else {
route:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
route:	exit 1
route:    }
route:
route:    # Read .lib -files
route:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
route:    foreach dc $mmmc_vars(delay_corners) {
route:
route:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
route:
route:        puts "corn volt temp rc: ${corn}_${volt}_${temp}_${rc}"
route:
route:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
route:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
route:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
route:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	} else {
route:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
route:	    exit 1
route:	}
route:    }
