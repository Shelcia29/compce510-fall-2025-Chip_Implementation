postcts:Warning: Overriding project mmmc setup from local folder
postcts:Info: Sourcing scripts/mmmc_setup.tcl
postcts:#@ Begin verbose source scripts/mmmc_setup.tcl (pre)
postcts:@file 1: ##############################################################################
postcts:@file 2: # Project level Mode & Corner definitions
postcts:@file 3: ##############################################################################
postcts:@file 4: # Time-stamp: <2025-09-23 16:49:18 qftele>
postcts:@file 5:
postcts:@file 6: set MMMC_SETUP_VERSION "v1.0"
postcts:@file 7: # $TECHNOLOGY is set in tech_setup.tcl
postcts:@file 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
postcts:Info: MMMC SETUP: gpdk045 : v1.0
postcts:@file 9:
postcts:@file 10: # Delay corner list
postcts:@file 11: set mmmc_vars(delay_corners) \
postcts:    [list \
postcts:	 slow_0p9v_125c_cmax \
postcts:	 fast_1p1v_0c_cmin \
postcts:	 ]
postcts:@file 16:
postcts:@file 17:
postcts:@file 18: # Read .lib -files
postcts:@file 19: foreach dc $mmmc_vars(delay_corners) {
postcts:
postcts:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postcts:
postcts:    # qrc techfile
postcts:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
postcts:    # temperature
postcts:    if {${temp} == "m40c"} {
postcts:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
postcts:    } elseif {${temp} == "125c"} {
postcts:	set mmmc_vars("${rc}_${temp}",temperature) "125"
postcts:    } elseif {${temp} == "0c"} {
postcts:	set mmmc_vars("${rc}_${temp}",temperature) "0"
postcts:    } else {
postcts:	set mmmc_vars("${rc}_${temp}",temperature) "25"
postcts:    }
postcts:
postcts:
postcts:    ###########################################
postcts:    # OCVs &  Clock uncertainties for FLAT OCV
postcts:    ###########################################
postcts:
postcts:    # use following uncertainties
postcts:    # FUNC:
postcts:    # setup:
postcts:    # clock jitter: defined through clock cycle
postcts:    # TECH uncertainty: 25ps
postcts:    # extra uncertainty (implementation): 20ps
postcts:    # extra uncertainty (signoff STA): 0ps
postcts:    # hold:
postcts:    # TECH uncertainty (SSG): 50ps
postcts:    # TECH uncertainty (fast): 40ps
postcts:    # extra uncertainty (implementation): 15ps
postcts:    # extra uncertainty (signoff STA): 0ps
postcts:
postcts:    # Note, add 1% OCV on top of previous to match LVF
postcts:    # so flat values below have 0.01 added (subtracted) because of this
postcts:
postcts:    # setup in slow, 0.81v, -40C/125c, cmax
postcts:    if {$corn eq "slow" &&
postcts:	$volt eq "0p9v" &&
postcts:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
postcts:	($rc eq "cmax")} {
postcts:	
postcts:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
postcts:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
postcts:	# +2.0% for launching clock cell
postcts:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
postcts:	# hold not checked in this corner
postcts:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
postcts:	# + 6.9% on data cell
postcts:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
postcts:
postcts:	# -6.0% for clock net
postcts:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
postcts:	# +6.0% for clock net
postcts:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
postcts:	# hold not checked in this corner
postcts:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
postcts:	# +6.0 for data net
postcts:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
postcts:
postcts:    # hold in slow, 0.81v, -40c/125c, cmax
postcts:    } elseif {$corn eq "slow" &&
postcts:	      $volt eq "0p9v" &&
postcts:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
postcts:	      ($rc eq "cmax")} {
postcts:	
postcts:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
postcts:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
postcts:	# +3.2% for capturing clock cell
postcts:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
postcts:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
postcts:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
postcts:	# setup not checked
postcts:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
postcts:
postcts:	# -8.5% for launching clock net
postcts:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
postcts:	# no derate on capturing clock net
postcts:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
postcts:	# -8.5% for data net
postcts:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
postcts:	# setup not checked
postcts:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
postcts:
postcts:    # hold in fast, 0.99v, -40c/0c/125c, cmax
postcts:    } elseif {$corn eq "fast" &&
postcts:	      $volt eq "1p1v" &&
postcts:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
postcts:	      ($rc eq "cmax")} {
postcts:	
postcts:	# -3.7% for launching clock cell
postcts:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
postcts:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
postcts:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
postcts:	# -12.1% for data
postcts:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
postcts:	# setup not checked
postcts:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
postcts:
postcts:	# -8.5% for launching clock net
postcts:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
postcts:	# no derate on capturing clock net
postcts:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
postcts:	# -8.5% for data net
postcts:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
postcts:	# setup not checked
postcts:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
postcts:
postcts:    # hold in fast, 0.99v, -40c/0c/125c, cmin
postcts:    } elseif {$corn eq "fast" &&
postcts:	      $volt eq "1p1v" &&
postcts:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
postcts:	      ($rc eq "cmin")} {
postcts:	
postcts:	# -3.7% for launching clock cell
postcts:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
postcts:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
postcts:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
postcts:	# -12.1% for data
postcts:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
postcts:	# setup not checked
postcts:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
postcts:
postcts:	# no derate on launching clock net
postcts:	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
postcts:	# +8.5% for capturing clock net
postcts:	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
postcts:	# no derate for data net
postcts:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
postcts:	# setup not checked
postcts:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
postcts:
postcts:    } else {
postcts:	puts "Fatal: delay corner ${dc} OCVs not defined (corner: $corn, voltage: $volt, temperature: $temp, rc: ${rc})"
postcts:	exit 1
postcts:    }
postcts:
postcts:    ###########################################
postcts:    # OCVs &  Clock uncertainties for SOCV
postcts:    ###########################################
postcts:
postcts:    # Note, only voltage and temperature OCVs needed
postcts:
postcts:    # Early & late variation factors from:
postcts:    set mmmc_vars(early_rc_variation_factor) 0.06
postcts:    set mmmc_vars(late_rc_variation_factor) 0.06
postcts:
postcts:    set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
postcts:
postcts:    # slow, 0.81v, -40c
postcts:    if {$corn eq "slow" &&
postcts:	$volt eq "0p9v" &&
postcts:	$temp eq "m40c"} {
postcts:        
postcts:        # DATA  @ 20.3mV : 7.4%
postcts:        # DATA  @ 10c    : 0.9%
postcts:        # CLOCK @ 20.3mV : 5.4%
postcts:        # CLOCK @ 10c    : 0.7%
postcts:
postcts:        # For setup only derate clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
postcts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postcts:        # For hold in slow derate data & launching clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
postcts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
postcts:
postcts:    } elseif {$corn eq "slow" &&
postcts:	$volt eq "0p9v" &&
postcts:	$temp eq "125c"} {
postcts:       
postcts:        # DATA  @ 20.3mV : 5.0%
postcts:        # DATA  @ 10c    : 0.3%
postcts:        # CLOCK @ 20.3mV : 3.5%
postcts:        # CLOCK @ 10c    : 0.2%
postcts:
postcts:        # For setup only derate clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
postcts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postcts:        # For hold in slow derate data & launching clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
postcts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
postcts:
postcts:    } elseif {$corn eq "slow" &&
postcts:	$volt eq "0p9v" &&
postcts:	$temp eq "0c"} {
postcts:       
postcts:        # DATA  @ 20.3mV : 6.6%
postcts:        # DATA  @ 10c    : 0.8%
postcts:        # CLOCK @ 20.3mV : 4.9%
postcts:        # CLOCK @ 10c    : 0.6%
postcts:
postcts:        # For setup only derate clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
postcts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postcts:        # For hold in slow derate data & launching clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
postcts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
postcts:
postcts:    } elseif {$corn eq "fast" &&
postcts:	$volt eq "1p1v" &&
postcts:	$temp eq "m40c"} {
postcts:       
postcts:        # DATA  @ 45mV   : 7.4%
postcts:        # DATA  @ 10c    : 0.5%
postcts:        # CLOCK @ 45mV   : 5.1%
postcts:        # CLOCK @ 10c    : 0.6%
postcts:
postcts:        # For setup only derate clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
postcts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postcts:        # For hold in slow derate data & launching clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
postcts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
postcts:
postcts:     } elseif {$corn eq "fast" &&
postcts:	$volt eq "1p1v" &&
postcts:	$temp eq "125c"} {
postcts:
postcts:        # DATA  @ 45mV   : 5.8%
postcts:        # DATA  @ 10c    : 0.5%
postcts:        # CLOCK @ 45mV   : 3.6%
postcts:        # CLOCK @ 10c    : 0.6%
postcts:
postcts:        # For setup only derate clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
postcts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postcts:        # For hold in slow derate data & launching clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
postcts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
postcts:
postcts:    } elseif {$corn eq "fast" &&
postcts:	$volt eq "1p1v" &&
postcts:	$temp eq "0c"} {
postcts:
postcts:        # DATA  @ 45mV   : 7.0%
postcts:        # DATA  @ 10c    : 0.4%
postcts:        # CLOCK @ 45mV   : 4.7%
postcts:        # CLOCK @ 10c    : 0.4%
postcts:
postcts:        # For setup only derate clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
postcts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postcts:        # For hold in slow derate data & launching clock
postcts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
postcts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
postcts:
postcts:     } else {
postcts:        puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
postcts:        exit 1
postcts:    }
postcts:}
