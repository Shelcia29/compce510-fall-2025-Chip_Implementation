syn_opt:##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan opt_signoff}
syn_opt:#@ Begin verbose flow_step activate_views
syn_opt:@flow_step(activate_views)  2:     set db [get_db flow_starting_db]
syn_opt:@flow_step(activate_views)  3:     set flow [lindex [get_db flow_hier_path] end]
syn_opt:@flow_step(activate_views)  4:     set setup_views [get_feature $flow -feature setup_views]
syn_opt:@flow_step(activate_views)  5:     set hold_views [get_feature $flow -feature hold_views]
syn_opt:@flow_step(activate_views)  6:     set leakage_view [get_feature $flow -feature leakage_view]
syn_opt:@flow_step(activate_views)  7:     set dynamic_view [get_feature $flow -feature dynamic_view]
syn_opt:@flow_step(activate_views)  9:     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
syn_opt:                               	#- use read_db args for DB types and set_analysis_views for TCL
syn_opt:                               	if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] eq {enc} && [file isfile [lindex $db 1]])} {
syn_opt:                               	    set cmd "set_analysis_view"
syn_opt:                               	    if {$setup_views ne ""} {
syn_opt:                               		append cmd " -setup [list $setup_views]"
syn_opt:                               	    } else {
syn_opt:                               		append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
syn_opt:                               	    }
syn_opt:                               	    if {$hold_views ne ""} {
syn_opt:                               		append cmd " -hold [list $hold_views]"
syn_opt:                               	    } else {
syn_opt:                               		append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
syn_opt:                               	    }
syn_opt:                               	    if {$leakage_view ne ""} {
syn_opt:                               		append cmd " -leakage [list $leakage_view]"
syn_opt:                               	    } else {
syn_opt:                               		if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
syn_opt:                               		    append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
syn_opt:                               		}
syn_opt:                               	    }
syn_opt:                               	    if {$dynamic_view ne ""} {
syn_opt:                               		append cmd " -dynamic [list $dynamic_view]"
syn_opt:                               	    } else {
syn_opt:                               		if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
syn_opt:                               		    append cmd " -dynamic [list [get_db [get_db analysis_views -if .is_dynamic] .name]]"
syn_opt:                               		}
syn_opt:                               	    }
syn_opt:                               	    eval $cmd
syn_opt:                               	} elseif {[llength [get_db analysis_views]] == 0} {
syn_opt:                               	    set_flowkit_read_db_args -setup_views "$setup_views" -hold_views "$hold_views" -leakage_view "$leakage_view" -dynamic_view "$dynamic_view"
syn_opt:                               	} else {
syn_opt:                               	}
syn_opt:                                   }
syn_opt:#@ End verbose flow_step activate_views
syn_opt:##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan opt_signoff}
syn_opt:#@ Begin verbose flow_step init_mcpu
syn_opt:@flow_step(init_mcpu)  2:     # Multi host/cpu attributes
syn_opt:@flow_step(init_mcpu)  3:     #-----------------------------------------------------------------------------
syn_opt:@flow_step(init_mcpu)  4:     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
syn_opt:@flow_step(init_mcpu)  5:     # the specified dist script.  This connects the number of CPUs being reserved
syn_opt:@flow_step(init_mcpu)  6:     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_opt:@flow_step(init_mcpu)  7:     # a typical environment variable exported by distribution platforms and is
syn_opt:@flow_step(init_mcpu)  8:     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_opt:@flow_step(init_mcpu)  9:     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_opt:                          	set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_opt:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_opt:                          	set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_opt:                              } else {
syn_opt:                          	set max_cpus 8
syn_opt:                              }
syn_opt:@flow_step(init_mcpu) 17:     switch -glob [get_db program_short_name] {
syn_opt:                          	joules*       -
syn_opt:                          	genus*        {
syn_opt:                          	    set_db max_cpus_per_server                $max_cpus
syn_opt:                          	}
syn_opt:                          	innovus*      -
syn_opt:                          	tempus*       -
syn_opt:                          	voltus*       {
syn_opt:                          	    set_multi_cpu_usage -verbose -local_cpu   $max_cpus
syn_opt:                          	    if {[get_feature -feature opt_signoff]} {
syn_opt:                          		if {[is_flow -inside flow:opt_signoff]} {
syn_opt:                          		    set_multi_cpu_usage -verbose -remote_host         1 -cpu_per_remote_host $max_cpus
syn_opt:                          		    set_distributed_hosts                             -local
syn_opt:                          		}
syn_opt:                          	    }
syn_opt:                          	    if {[get_feature -feature sta_eco]} {
syn_opt:                          		if {[is_flow -inside flow:sta_eco]} {
syn_opt:                          		    set_multi_cpu_usage -verbose -remote_host         1 -cpu_per_remote_host $max_cpus
syn_opt:                          		    set_distributed_hosts                             -local
syn_opt:                          		}
syn_opt:                          	    }
syn_opt:                          	}
syn_opt:                          	default       {}
syn_opt:                              }
syn_opt:  Setting attribute of root '/': 'max_cpus_per_server' = 16
syn_opt:#@ End verbose flow_step init_mcpu
