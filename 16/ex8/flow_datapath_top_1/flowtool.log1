syn_generic:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
syn_generic:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
syn_generic:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
syn_generic:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
syn_generic:    } else {
syn_generic:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
syn_generic:	exit 1
syn_generic:    }
syn_generic:
syn_generic:    # Read .lib -files
syn_generic:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
syn_generic:    foreach dc $mmmc_vars(delay_corners) {
syn_generic:
syn_generic:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_generic:
