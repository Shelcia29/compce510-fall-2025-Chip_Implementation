syn_generic:#@ Begin verbose flow_step syn_generic.init_scan
syn_generic:@flow_step(init_scan)   3:     set_db dft_prefix 				DFT_[get_db flow_vars_design_name]_
syn_generic:  Setting attribute of root '/': 'dft_prefix' = DFT_datapath_top_
syn_generic:@flow_step(init_scan)   4:     set_db dft_identify_top_level_test_clocks 	false
syn_generic:  Setting attribute of root '/': 'dft_identify_top_level_test_clocks' = false
syn_generic:@flow_step(init_scan)   5:     set_db dft_identify_test_signals 		false
syn_generic:  Setting attribute of root '/': 'dft_identify_test_signals' = false
syn_generic:@flow_step(init_scan)   6:     set_db dft_identify_internal_test_clocks 	false
syn_generic:  Setting attribute of root '/': 'dft_identify_internal_test_clocks' = false
syn_generic:@flow_step(init_scan)   7:     #set_db use_scan_seqs_for_non_dft 		true
syn_generic:@flow_step(init_scan)   8:     set_db use_scan_seqs_for_non_dft 		false
syn_generic:  Setting attribute of root '/': 'use_scan_seqs_for_non_dft' = false
syn_generic:@flow_step(init_scan)   9:     set_db dft_auto_identify_shift_register         true
syn_generic:  Setting attribute of root '/': 'dft_auto_identify_shift_register' = true
syn_generic:@flow_step(init_scan)  10:     set_db dft_identify_shared_wrapper_cells        false
syn_generic:  Setting attribute of root '/': 'dft_identify_shared_wrapper_cells' = false
syn_generic:@flow_step(init_scan)  11:     #set_db dft_shared_wrapper_through	        combinational
syn_generic:@flow_step(init_scan)  13:     #- DFT Attributes to control scan mapping and connectivity
syn_generic:@flow_step(init_scan)  14:     #set_db designs .dft_mix_clock_edges_in_scan_chains true 
syn_generic:@flow_step(init_scan)  15:     set_db [current_design] .dft_mix_clock_edges_in_scan_chains true 
syn_generic:  Setting attribute of design 'datapath_top': 'dft_mix_clock_edges_in_scan_chains' = true
syn_generic:@flow_step(init_scan)  16:     set_db [current_design] .dft_lockup_element_type level_sensitive
syn_generic:  Setting attribute of design 'datapath_top': 'dft_lockup_element_type' = level_sensitive
syn_generic:@flow_step(init_scan)  17:     set_db current_design .dft_clock_edge_for_head_of_scan_chains leading
syn_generic:  Setting attribute of design 'datapath_top': 'dft_clock_edge_for_head_of_scan_chains' = leading
syn_generic:@flow_step(init_scan)  18:     set_db current_design .dft_clock_edge_for_tail_of_scan_chains trailing
syn_generic:  Setting attribute of design 'datapath_top': 'dft_clock_edge_for_tail_of_scan_chains' = trailing
syn_generic:@flow_step(init_scan)  19:     # min number of chains used as max number of chains in connect_scan_chain -command
syn_generic:@flow_step(init_scan)  20:     set_db [current_design] .dft_min_number_of_scan_chains 1
syn_generic:  Setting attribute of design 'datapath_top': 'dft_min_number_of_scan_chains' = 1
syn_generic:@flow_step(init_scan)  21:     set_db [current_design] .dft_max_length_of_scan_chains 30000
syn_generic:  Setting attribute of design 'datapath_top': 'dft_max_length_of_scan_chains' = 30000
syn_generic:@flow_step(init_scan)  23:     #- Define test clock
syn_generic:@flow_step(init_scan)  24:     #define_test_clock			     -name foo
syn_generic:@flow_step(init_scan)  25:     define_test_clock -name jtag_tck_[get_db flow_vars_design_name] -domain scan_jtag clk_i
syn_generic:Info    : Added DFT object. [DFT-100]
syn_generic:        : Added test clock domain 'scan_jtag'.
syn_generic:Info    : Added DFT object. [DFT-100]
syn_generic:        : Added test clock 'jtag_tck_datapath_top'.
syn_generic:@flow_step(init_scan)  27:     #- Define test mode port
syn_generic:@flow_step(init_scan)  28:     define_test_signal -function test_mode -lec_value 0 -name scan_mode_[get_db flow_vars_design_name] -create_port -active high scan_mode_[get_db flow_vars_design_name]
syn_generic:Info    : Created DFT port. [DFT-130]
syn_generic:        : Created test mode port 'scan_mode_datapath_top' in module 'datapath_top'.
syn_generic:        : A port for DFT purposes was created.
syn_generic:Info    : Added DFT object. [DFT-100]
syn_generic:        : Added test mode signal 'scan_mode_datapath_top'.
syn_generic:@flow_step(init_scan)  29:     #- Define scan enable port
syn_generic:@flow_step(init_scan)  30:     define_test_signal -function shift_enable -lec_value 0 -name scan_enable_[get_db flow_vars_design_name] -create_port -active high scan_enable_[get_db flow_vars_design_name]
syn_generic:Info    : Created DFT port. [DFT-130]
syn_generic:        : Created shift enable port 'scan_enable_datapath_top' in module 'datapath_top'.
syn_generic:Info    : Added DFT object. [DFT-100]
syn_generic:        : Added shift enable signal 'scan_enable_datapath_top'.
syn_generic:@flow_step(init_scan)  31:     # Add, TL: pipeline shift enable
syn_generic:@flow_step(init_scan)  32:     #define_test_signal -name pipe_sen -function pipe_sen -create_port -active low pipe_sen
syn_generic:@flow_step(init_scan)  34:     #- Specify ICG bypass signal for DFT
syn_generic:@flow_step(init_scan)  35:     set_db current_design .lp_clock_gating_test_signal [get_db test_signals scan_enable_[get_db flow_vars_design_name] ]
syn_generic:  Setting attribute of design 'datapath_top': 'lp_clock_gating_test_signal' = test_signal:datapath_top/scan_enable_datapath_top
syn_generic:@flow_step(init_scan)  37:     #- Define test reset port
syn_generic:@flow_step(init_scan)  38:     define_test_signal -function async_set_reset -name scan_reset_[get_db flow_vars_design_name] -active high rst_ni
syn_generic:Info    : Added DFT object. [DFT-100]
syn_generic:        : Added test mode signal 'scan_reset_datapath_top'.
syn_generic:@flow_step(init_scan)  40:     if {0} {
syn_generic:                                   define_test_signal -function wint -name WINT_[get_db flow_vars_design_name] -create_port WINT
syn_generic:                                   define_test_signal -function wext -name WEXT_[get_db flow_vars_design_name] -create_port WEXT
syn_generic:                               }
syn_generic:@flow_step(init_scan)  45:     #- Control cg clocks
syn_generic:@flow_step(init_scan)  46:     # go through all instantiated cgs
syn_generic:@flow_step(init_scan)  47:     foreach icg_inst [get_db [get_db insts -if {.base_name==inst_TLATNTSCAX*}] .name] {
syn_generic:                           	puts "Info: ICG: $icg_inst ([get_db [get_db insts $icg_inst] .base_cell.base_name])"
syn_generic:                           	set_db [get_db pins $icg_inst/Z] .dft_controllable "[get_db pins $icg_inst/CP] non_inverting"
syn_generic:                           
syn_generic:                           	# prevent Genus from adding RC_CG_INST* hierarchy to instantiated clock gates
syn_generic:                           	# Note, TE has to be connected manually to shift enable later on!
syn_generic:                           	set_db [get_db insts $icg_inst] .lp_clock_gating_exclude true
syn_generic:                               }
