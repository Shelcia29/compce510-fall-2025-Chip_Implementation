syn_opt:#@ Begin verbose flow_step syn_opt.genus_to_lec
syn_opt:@flow_step(genus_to_lec)  2:     #- create output location
syn_opt:@flow_step(genus_to_lec)  3:     set design  [get_db current_design .name]
syn_opt:@flow_step(genus_to_lec)  4:     if {[is_flow -quiet -inside flow:syn_opt] && [get_feature pnr_db_handoff]} {
syn_opt:                                     set out_dir [lindex [get_db flow_starting_db] 1]/cmn
syn_opt:                                 } else {
syn_opt:                                     set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
syn_opt:                                     file mkdir $out_dir
syn_opt:                                 }
syn_opt:@flow_step(genus_to_lec) 11:     #- write dofile for LEC
syn_opt:@flow_step(genus_to_lec) 12:     if {[is_flow -inside flow:syn_map]} {
syn_opt:                                     if {[file exists scripts/lec.pre_compare.tcl]} {
syn_opt:                                         write_do_lec  -top $design  -golden_design rtl  -revised_design fv_map  -pre_compare scripts/lec.pre_compare.tcl  -no_lp  -no_exit  -logfile [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  > [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do]
syn_opt:                                     } else {
syn_opt:                                         write_do_lec  -top $design  -golden_design rtl  -revised_design fv_map  -no_lp  -no_exit  -logfile [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  > [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do]
syn_opt:                                     }
syn_opt:                             	# Note, TL: From Benoit. Check if still needed!
syn_opt:                             	#- Add "analyze_datapath -flowgraph" to dofile
syn_opt:                             	file rename -force [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do] [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do.tmp]
syn_opt:                             	set file_r [open [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do.tmp] r]
syn_opt:                             	set file_w [open [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do] w]
syn_opt:                             	
syn_opt:                             	while {![eof $file_r]} {
syn_opt:                             	    set line [gets $file_r]
syn_opt:                             	    if {[regexp {analyze_datapath[ \t]+-verbose;} $line]} {
syn_opt:                             		set line [regsub {(analyze_datapath[ \t]+-verbose;)} $line {analyze_datapath -flowgraph -verbose;}]
syn_opt:                             	    } elseif {[regexp "read_library.+-lp all.+" $line]} {
syn_opt:                             		set line [regsub -- "-lp all " $line ""]
syn_opt:                             	    }
syn_opt:                             
syn_opt:                             	    puts $file_w $line
syn_opt:                             	}
syn_opt:                             	
syn_opt:                             	close $file_r
syn_opt:                             	close $file_w
syn_opt:                             	# Note, TL. Check if needed end!
syn_opt:                             
syn_opt:                                 } else {
syn_opt:                                     if {[file exists scripts/lec.pre_compare.syn_opt.tcl]} {
syn_opt:                                         write_do_lec  -top $design  -golden_design fv_map  -revised_design [file join $out_dir $design.v.gz]  -pre_compare scripts/lec.pre_compare.syn_opt.tcl  -no_lp  -logfile [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  > [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do]
syn_opt:                                     } else {
syn_opt:                                         write_do_lec  -top $design  -golden_design fv_map  -revised_design [file join $out_dir $design.v.gz]  -no_lp  -logfile [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  > [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do]
syn_opt:                                     }
syn_opt:                             	#- Add "analyze_datapath -flowgraph" to dofile
syn_opt:                             	file rename -force [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do] [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do.tmp]
syn_opt:                             	set file_r [open [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do.tmp] r]
syn_opt:                             	set file_w [open [file join [get_db current_design .verification_directory] lec.[get_db flow_report_name].do] w]
