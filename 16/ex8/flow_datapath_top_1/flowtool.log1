opt_signoff:@file 24:
opt_signoff:@file 25: # Go through global settings for macros and see if there's a local override
opt_signoff:@file 26: foreach {blockname blockpath} [array get global_macro_exportdir] {
opt_signoff:
opt_signoff:    # do not read in a model for DUT
opt_signoff:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
opt_signoff:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
opt_signoff:	continue
opt_signoff:    }
opt_signoff:
opt_signoff:    if {[info exists local_macro_exportdir($blockname)]} {
opt_signoff:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
opt_signoff:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
opt_signoff:	    puts "\#OLD\#: $blockpath"
opt_signoff:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
opt_signoff:	    set $blockpath $local_macro_exportdir($blockname)
opt_signoff:	}
opt_signoff:    }
opt_signoff:
opt_signoff:    # scan abstract for DFT
opt_signoff:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
opt_signoff:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
opt_signoff:    } else {
opt_signoff:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
opt_signoff:    }
opt_signoff:
opt_signoff:    # MACROs
opt_signoff:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
opt_signoff:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
opt_signoff:    } elseif {[file exists $blockpath/models/cts/$blockname.lef]} {
opt_signoff:	lappend macro_lef_filelist $blockpath/models/cts/$blockname.lef
opt_signoff:    } elseif {[file exists $blockpath/models/floorplan/$blockname.lef]} {
opt_signoff:	lappend macro_lef_filelist $blockpath/models/floorplan/$blockname.lef
opt_signoff:    } else {
opt_signoff:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/{opt_signoff|cts|floorplan}"
opt_signoff:	exit 1
opt_signoff:    }
opt_signoff:
opt_signoff:    # Read .lib -files
opt_signoff:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
opt_signoff:    foreach dc $mmmc_vars(delay_corners) {
opt_signoff:
opt_signoff:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
opt_signoff:
opt_signoff:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
opt_signoff:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	} elseif {[file exists $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
opt_signoff:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/cts/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	} elseif {[file exists $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
opt_signoff:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/floorplan/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	} else {
opt_signoff:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/{opt_signoff.sta|cts|floorplan}"
opt_signoff:	    exit 1
opt_signoff:	}
opt_signoff:    }
opt_signoff:}
opt_signoff:@file 83: # sanity check to see if global setting are missing block which are defined in local settings!
opt_signoff:@file 84: foreach {blockname blockpath} [array get local_macro_exportdir] {
opt_signoff:    # do not read in a model for DUT
opt_signoff:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
opt_signoff:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
opt_signoff:	continue
opt_signoff:    }
opt_signoff:
opt_signoff:    set found 0
opt_signoff:    if {[info exists global_macro_exportdir($blockname)]} {
opt_signoff:	set found 1
opt_signoff:    }
opt_signoff:
opt_signoff:    if {!$found} {
opt_signoff:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
opt_signoff:    } else {
opt_signoff:	# it was found so it's already set
opt_signoff:	continue
opt_signoff:    }
opt_signoff:
opt_signoff:    # scan abstract for DFT
opt_signoff:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
opt_signoff:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
opt_signoff:    } else {
opt_signoff:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
opt_signoff:    }
opt_signoff:
opt_signoff:    # MACROs
