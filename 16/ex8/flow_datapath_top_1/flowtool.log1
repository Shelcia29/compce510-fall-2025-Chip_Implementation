syn_map:  Setting attribute of root '/': 'flow_report_name' = syn_map
syn_map:@flow_step(block_finish)  5:     if {[get_feature pnr_db_handoff] && [is_flow -quiet -inside flow:syn_opt]} {
syn_map:                                     set_db flow_write_db_common true
syn_map:                                 } else {
syn_map:                                     set_db flow_write_db_common false
syn_map:                                 }
syn_map:  Setting attribute of root '/': 'flow_write_db_common' = false
syn_map:@flow_step(block_finish) 11:     #- Store non-default root attributes to metrics
syn_map:@flow_step(block_finish) 12:     catch {report_obj -tcl} flow_root_config
syn_map:@flow_step(block_finish) 13:     if {[dict exists $flow_root_config root:/]} {
syn_map:                             	set flow_root_config [dict get $flow_root_config root:/]
syn_map:                                 } elseif {[dict exists $flow_root_config root:]} {
syn_map:                             	set flow_root_config [dict get $flow_root_config root:]
syn_map:                                 } else {
syn_map:                                 }
syn_map:@flow_step(block_finish) 19:     foreach key [dict keys $flow_root_config] {
syn_map:                             	if {[string length [dict get $flow_root_config $key]] > 200} {
syn_map:                             	    dict set flow_root_config $key "\[long value truncated\]"
syn_map:                             	}
syn_map:                                 }
syn_map:@flow_step(block_finish) 24:     set_metric -name flow.root_config -value $flow_root_config
syn_map:#@ End verbose flow_step syn_map.block_finish
