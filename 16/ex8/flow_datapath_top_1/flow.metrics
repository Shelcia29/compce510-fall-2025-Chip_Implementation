severity warn short {Option %s in 'set_db' will be obsolete. 'set_db %s %s'will mapped to 'set_db opt_skew_ccopt %s' internally when design_flow_effort is not set to extreme and 'opt_skew_ccopt' has not been explict set by user.}} {count 3 id IMPAFP-9024 severity warn short {This command is hidden and will be obsolete in the next major release. For module placement, use proto_design instead. For macro placement, use place_design -concurrent_macros to place both standard cells and macros together.}} {count 3 id IMPCTE-104 severity warn short {The constraint mode of this inactive view '%s' has been modified and may need to be reanalyzed to ensure proper timing results. To reanalyze timing for this view make the view active using 'set_analysis_view' and run timing analysis.}} {count 3 id IMPTCM-77 severity warn short {Option \"%s\" for command %s is obsolete and will be removed in a future release. The obsolete option still works in this release but to avoid this warning and to ensure compatibility with future releases, remove the obsolete option from your script.}} {count 11 id IMPUDM-33 severity warn short {Global variable \"%s\" is obsolete and will be removed in a future release. The obsolete variable still works in this release, but to avoid this warning and to ensure compatibility with future releases, remove the obsolete variable from your script.}} {count 2 id PRL-39 severity warn short {Number of local CPUs specified (%d) > Actual number of CPUs in the host (%d). The lower value will be used.}} {count 3 id GLOBAL-100 severity warn short {Global '%s' has become obsolete. It will be removed in the next release.}} {count 3 id TCLCMD-1142 severity warn short {Virtual clock '%s' is being created with no source objects.}} {count 10 id TECHLIB-302 severity warn short {No function defined for cell '%s'. The cell will only be used for analysis.}} {count 99 id TECHLIB-1329 severity warn short {The attribute '%s' on the %s in cell '%s' is missing, even though the cell has multiple supply voltages.}}"},{"name":"messages.instant","value":"{count 144 id IMPLF-200 severity warn short {Pin '%s' in macro '%s' has no ANTENNAGATEAREA value defined. The library data is incomplete and some process antenna rules will not be checked correctly.}} {count 2 id IMPLF-201 severity warn short {Pin '%s' in macro '%s' has no ANTENNADIFFAREA value defined. The library data is incomplete and some process antenna rules will not be checked correctly.}} {count 2 id IMPFP-3961 severity warn short {The techSite '%s' has no related standard cells in the LEF/OA library. The calculations for this site type cannot be made unless standard cell models of this type exist in the LEF/OA library. Ignore this warning if the SITE is not used by the library. Alternatively, remove the SITE definition for the LEF/OA library to avoid this message.}} {count 4 id IMPDBTCL-299 severity warn short {The attribute '%s' still works but will be obsolete in a future major release. You should remove it from your script before the next major release to avoid errors. It should be changed to the new name of '%s'.}} {count 10 id IMPDBTCL-321 severity warn short {The attribute '%s' still works but will be obsolete in a future major release. You should remove it from your script before the next major release to avoid errors.}} {count 1 id IMPOPT-3602 severity warn short {The specified path group name %s is not defined.}} {count 2 id IMPOPT-7155 severity warn short {Option %s in 'set_db' will be obsolete. 'set_db %s %s'will mapped to 'set_db opt_skew_ccopt %s' internally when design_flow_effort is not set to extreme and 'opt_skew_ccopt' has not been explict set by user.}} {count 3 id IMPAFP-9024 severity warn short {This command is hidden and will be obsolete in the next major release. For module placement, use proto_design instead. For macro placement, use place_design -concurrent_macros to place both standard cells and macros together.}} {count 3 id IMPCTE-104 severity warn short {The constraint mode of this inactive view '%s' has been modified and may need to be reanalyzed to ensure proper timing results. To reanalyze timing for this view make the view active using 'set_analysis_view' and run timing analysis.}} {count 3 id IMPTCM-77 severity warn short {Option \"%s\" for command %s is obsolete and will be removed in a future release. The obsolete option still works in this release but to avoid this warning and to ensure compatibility with future releases, remove the obsolete option from your script.}} {count 11 id IMPUDM-33 severity warn short {Global variable \"%s\" is obsolete and will be removed in a future release. The obsolete variable still works in this release, but to avoid this warning and to ensure compatibility with future releases, remove the obsolete variable from your script.}} {count 2 id PRL-39 severity warn short {Number of local CPUs specified (%d) > Actual number of CPUs in the host (%d). The lower value will be used.}} {count 3 id GLOBAL-100 severity warn short {Global '%s' has become obsolete. It will be removed in the next release.}} {count 3 id TCLCMD-1142 severity warn short {Virtual clock '%s' is being created with no source objects.}} {count 10 id TECHLIB-302 severity warn short {No function defined for cell '%s'. The cell will only be used for analysis.}} {count 99 id TECHLIB-1329 severity warn short {The attribute '%s' on the %s in cell '%s' is missing, even though the cell has multiple supply voltages.}}"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"block_start"},{"inherited":true,"name":"uuid","value":"5a09d677-8e30-4bd0-8698-6d94a42385b1"}],"name":"block_start","parent_key":"flow:block .steps flow:floorplan","path":"floorplan/block_start","previous":["0e507ed1-78c3-4987-af3a-20782ca0f1bc"],"real_end":1763128005.0,"real_start":1763128004.0,"snapshots":[{"branch":"default","delta_cpu":25.37,"delta_cpu_not_child":13.91,"delta_cpu_user":15.27,"delta_cpu_user_not_child":10.13,"delta_real_not_child":31.0,"key":"flow:block .steps flow:floorplan .steps flow_step:block_start {.init_flow init_flow}","metrics":[{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"25.37"},{"inherited":true,"name":"flow.cputime.not_child","value":"13.91"},{"inherited":true,"name":"flow.cputime.total","value":"1137.02"},{"inherited":true,"name":"flow.cputime.user","value":"15.27"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"10.13"},{"inherited":true,"name":"flow.cputime.user.total","value":"881.31"},{"inherited":true,"name":"flow.last_child_snapshot","value":"read_db"},{"name":"flow.machine.load","value":"2.45"},{"inherited":true,"name":"flow.memory","value":"3017.05 MB"},{"name":"flow.memory.instant","value":"3017.05 MB"},{"inherited":true,"name":"flow.memory.resident","value":"2953.72 MB"},{"name":"flow.memory.resident.instant","value":"2953.72 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"2953.72 MB"},{"name":"flow.memory.resident.peak.instant","value":"2953.72 MB"},{"inherited":true,"name":"flow.realtime","value":"44"},{"inherited":true,"name":"flow.realtime.not_child","value":"31"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763127960.0 1763128004.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763127960.0 1763128004.0}"},{"inherited":true,"name":"flow.realtime.total","value":"1187"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"init_flow"},{"inherited":true,"name":"uuid","value":"d288b46c-f5eb-4c79-a272-9d34b6ae3894"}],"name":"init_flow","parent_key":"flow:block .steps flow:floorplan .steps flow_step:block_start","path":"floorplan/block_start/init_flow","previous":[],"real_end":1763128004.0,"real_start":1763127960.0,"snapshots":[{"branch":"default","delta_cpu":11.46,"delta_cpu_not_child":11.46,"delta_cpu_user":5.14,"delta_cpu_user_not_child":5.14,"delta_real_not_child":13.0,"key":"097c67bc-bbb8-407b-b136-7e842a541f9c","metrics":[{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"11.46"},{"inherited":true,"name":"flow.cputime.not_child","value":"11.46"},{"inherited":true,"name":"flow.cputime.total","value":"1123.11"},{"inherited":true,"name":"flow.cputime.user","value":"5.14"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"5.14"},{"inherited":true,"name":"flow.cputime.user.total","value":"871.18"},{"name":"flow.machine.load","value":"2.48"},{"inherited":true,"name":"flow.memory","value":"3017.05 MB"},{"name":"flow.memory.instant","value":"3017.05 MB"},{"inherited":true,"name":"flow.memory.resident","value":"2933.35 MB"},{"name":"flow.memory.resident.instant","value":"2933.35 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"2936.03 MB"},{"name":"flow.memory.resident.peak.instant","value":"2936.03 MB"},{"inherited":true,"name":"flow.realtime","value":"13"},{"inherited":true,"name":"flow.realtime.not_child","value":"13"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763127990.0 1763128003.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763127990.0 1763128003.0}"},{"inherited":true,"name":"flow.realtime.total","value":"1186"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"read_db"},{"inherited":true,"name":"uuid","value":"097c67bc-bbb8-407b-b136-7e842a541f9c"}],"name":"read_db","parent_key":"flow:block .steps flow:floorplan .steps flow_step:block_start {.init_flow init_flow}","path":"floorplan/block_start/init_flow/read_db","previous":["43ffbc86-9031-4460-91a8-5bb50d088fe3"],"real_end":1763128003.0,"real_start":1763127990.0,"snapshots":[],"total_cpu":1123.11,"total_cpu_user":871.18,"uuid":"097c67bc-bbb8-407b-b136-7e842a541f9c"}],"total_cpu":1137.02,"total_cpu_user":881.31,"uuid":"d288b46c-f5eb-4c79-a272-9d34b6ae3894"}],"total_cpu":1137.79,"total_cpu_user":882.0,"uuid":"5a09d677-8e30-4bd0-8698-6d94a42385b1"},{"branch":"default","delta_cpu":2.45,"delta_cpu_not_child":2.45,"delta_cpu_user":1.75,"delta_cpu_user_not_child":1.75,"delta_real_not_child":2.0,"key":"flow:block .steps flow:floorplan .steps flow_step:init_innovus","metrics":[{"name":"design.name","value":"datapath_top"},{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"2.45"},{"inherited":true,"name":"flow.cputime.not_child","value":"2.45"},{"inherited":true,"name":"flow.cputime.total","value":"1140.24"},{"inherited":true,"name":"flow.cputime.user","value":"1.75"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"1.75"},{"inherited":true,"name":"flow.cputime.user.total","value":"883.75"},{"name":"flow.db.starting","value":"cdb /home/student/16/ex8/flow_datapath_top_1/dbs/syn_opt.cdb datapath_top {}"},{"name":"flow.log","value":"/home/student/16/ex8/flow_datapath_top_1/logs/floorplan.log"},{"name":"flow.machine","value":"ASIC-vm"},{"name":"flow.machine.cpu.frequency","value":"2112.001 Mhz"},{"name":"flow.machine.cpu.model","value":"12th Gen Intel(R) Core(TM) i7-12700"},{"name":"flow.machine.cpu.number","value":"8"},{"name":"flow.machine.hostname","value":"ASIC-vm"},{"name":"flow.machine.load","value":"2.45"},{"name":"flow.machine.memory.free","value":"3280116 kB"},{"name":"flow.machine.memory.total","value":"16369280 kB"},{"name":"flow.machine.os","value":"Linux 4.18.0-553.69.1.el8_10.x86_64"},{"name":"flow.machine.swap.free","value":"3899644 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"3017.05 MB"},{"name":"flow.memory.instant","value":"3017.05 MB"},{"inherited":true,"name":"flow.memory.resident","value":"2968.04 MB"},{"name":"flow.memory.resident.instant","value":"2968.04 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"2968.04 MB"},{"name":"flow.memory.resident.peak.instant","value":"2968.04 MB"},{"inherited":true,"name":"flow.realtime","value":"2"},{"inherited":true,"name":"flow.realtime.not_child","value":"2"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763128005.0 1763128007.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763128005.0 1763128007.0}"},{"inherited":true,"name":"flow.realtime.total","value":"1190"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"# Tool settings: NOTE: already set by flow_config.tcl\n    #set_multi_cpu_usage -local_cpu 8 -remote_host 1 -cpu_per_remote_host 8\n\n    if {[get_feature -feature report_lec]} {\n\t# Init attributes  [get_db -category init]\n\t#-------------------------------------------------------------------------------\n\tset_db write_lec_directory_naming_style \"fv/%s/[get_db flow_report_name]\"\n\t\n    }\n    set_db init_design_uniquify 1\n\n    # Design attributes  [get_db -category design]\n    #-------------------------------------------------------------------------------\n    set_db design_process_node            45\n    if {[get_feature -feature flow_express]} {\n\tset_db design_flow_effort                   express\n    }\n    set_db design_early_clock_flow              true\n    \n    # Via naming\n    #-------------------------------------------------------------------------------\n    # Use design name as prefix for VIAs, as otherwise they will cause collision when merging designs on toplevel\n    set_db write_stream_via_names true\n\n    # Timing attributes  [get_db -category timing && delaycalc]\n    #-------------------------------------------------------------------------------\n    set_db timing_analysis_cppr           both\n    set_db timing_analysis_type           ocv\n    set_db timing_report_fields           {timing_point net cell fanout load transition delay incr_delay arrival edge user_derate power_domain}\n\n    #set_db timing_analysis_socv                               true                        ;# Enable socv analysis\n    #set_db timing_socv_rc_variation_mode                      true                        ;# Enable interconnect variation mode in SOCV mode\n    #set_db  timing_report_enable_verbose_ssta_mode true\n\n    # Add, TL: flow sets this to \"no_async\", async is default and should be used\n    set_db timing_analysis_async_checks async\n    # Add, TL: maybe a bit hazardous... disable default io delay for ports which are unconstrained!\n    # if true, will cause hold problems (since launching clock is the receiving clock (with same latency!))\n    set_db timing_apply_default_primary_input_assertion false\n\n    set_db delaycal_advanced_node_pin_cap_settings true\n    set_db delaycal_advanced_pin_cap_mode true\n\n    \n    # Extraction attributes  [get_db -category extract_rc]\n    #-------------------------------------------------------------------------------\n    if {[get_feature -feature add_pvs_fill] || [get_feature -feature add_pegasus_beol_fill]} {\n        set_db extract_rc_pvs_fill            true\n    }\n    if {[is_flow -after flow:opt_signoff] || [is_flow -inside flow:opt_signoff]} {\n\tset_db extract_rc_effort_level signoff\n        set_db extract_rc_qrc_cmd_type partial\n        set_db extract_rc_qrc_cmd_file scripts/gpdk045_qrc.map\n    }\n\t\n    if {[is_flow -after flow:route]} {\n\tset_db delaycal_enable_si           true\n\tset_db extract_rc_engine            post_route\n\t# Note, TL: default is false, see effect of setting to true\n\t#set_db si_delay_separate_on_data                  true\n    }    \n    if [is_flow -after_history flow:route] {\n\tset_db delaycal_equivalent_waveform_model               propagation\n    } else {\n\tset_db delaycal_equivalent_waveform_model               no_propagation\n    }           \n    set_db si_aggressor_alignment                             timing_aware_edge       \n\n    # Mod, TL: Too few licenses to extract all corners in parallel . Use the following to reduce number of used licenses :\n    #set_db extract_rc_qrc_run_mode sequential\n    \n    # Floorplan attributes  [get_db -category floorplan]\n    #-------------------------------------------------------------------------------\n    set_db finish_floorplan_active_objs   [list macro soft_blockage core]\n    # Constraints for even or odd site width/ row height\n    set_db floorplan_row_site_height                          even\n    set_db floorplan_row_site_width                           even\n    \n    # Placement attributes  [get_db -category place]\n    #-------------------------------------------------------------------------------\n    set_db place_detail_legalization_inst_gap                 1 \n    set_db place_detail_use_no_diffusion_one_site_filler      false                        ;# False to not leave 1-site gaps\n    set_db place_detail_filler_gap_min_gap                    0.2\n    set_db place_detail_filler_gap_effort                     high\n    \n    set_db place_global_uniform_density                       true                        ;# Enable even cell distribution for designs with less than 70% utilization\n\n    set_db place_global_place_io_pins               true\n    set_db place_detail_use_check_drc               true\n    #set_db place_detail_color_aware_legal           true\n    \n    # Tieoff attributes  [get_db -category add_tieoffs]\n    #-------------------------------------------------------------------------------\n    set_db add_tieoffs_cells                        [list TIEHI TIELO]\n    # tieoff max fanout not honored without this?\n    set_db add_tieoffs_max_fanout 32\n\n    # Optimization attributes  [get_db -category opt]\n    #-------------------------------------------------------------------------------\n    set_db opt_fix_hold_allow_setup_tns_degradation           true                        ;# When set to true, allows setup total negative slack to degrade during hold optimization.\n    set_db opt_fix_hold_verbose                               true                        ;# When set to true, display extra info in the log about remaining hold violations.\n    set_db opt_new_inst_prefix            \"[get_db flow_report_name]_\"\n    # Note, do not use DEL* -cells for hold fixing because of HUGE variation\n    set_db opt_fix_hold_lib_cells                   [list  ]\n    # enable data checks during gigaplace (false by default)\n    #set_db opt_enable_data_to_data_checks     true\n\n    # fix max_fanout / max_load violations, false by default\n    set_db opt_fix_fanout_load true\n\n    # Clock attributes  [get_db -category cts]\n    #-------------------------------------------------------------------------------\n    set_db cts_top_fanout_threshold                           2000                        ;# Minimum number of transitive fanout in the clock tree for a net to be routed as a top net\n    set_db cts_target_skew                          0.15\n    set_db cts_target_max_transition_time           0.10\n\n    set_db cts_buffer_cells                         [list CLKBUFX12 CLKBUFX16 CLKBUFX2 CLKBUFX20 CLKBUFX3 CLKBUFX4 CLKBUFX6 CLKBUFX8]\n    set_db cts_inverter_cells                       [list CLKINVX1 CLKINVX12 CLKINVX16 CLKINVX2 CLKINVX20 CLKINVX3 CLKINVX4 CLKINVX6 CLKINVX8]\n    set_db cts_clock_gating_cells                   [list TLATNCAX12 TLATNCAX16 TLATNCAX2 TLATNCAX20 TLATNCAX3 TLATNCAX4 TLATNCAX6 TLATNCAX8]\n    set_db cts_logic_cells                          [get_db [get_db base_cells CLK*] .name]\n\n    #- Route types definitions occur during the \"init_floorplan\" flow_step\n    if {[get_db route_types] ne \"\"} {\n\tset_db cts_route_type_leaf                     cts_route_type_leaf\n\tset_db cts_route_type_trunk                    cts_route_type_trunk\n\tset_db cts_route_type_top                      cts_route_type_top\n    }\n    \n    # Only use inverters in clock tree, no buffers\n    set_db cts_use_inverters true\n\n    # Use max 32 fanout also in CTS\n    set_db cts_max_fanout 32\n\n    # power balance leakage / dynamic\n    #-------------------------------------------------------------------------------\n    # Optimize both leakage & dynamic with same weight\n    set_db opt_leakage_to_dynamic_ratio                 0.5\n\n    # Filler attributes  [get_db -category add_fillers]\n    #-------------------------------------------------------------------------------\n    #set_db add_fillers_avoid_abutment_patterns                \"1:1 2:1\"                   ;# Avoid 1:1 filler abutment\n    set_db add_fillers_cells                        [list  DECAP10 DECAP2 DECAP3 DECAP4 DECAP5 DECAP6 DECAP7 DECAP8 DECAP9  FILL1 FILL16 FILL2 FILL32 FILL4 FILL64 FILL8  ]\n    set_db add_fillers_no_single_site_gap true\n    # Insert fillers to toplevel hierarchy\n    set_db add_fillers_cell_name_style                      flat\n\n    # Routing attributes  [get_db -category route]\n    #-------------------------------------------------------------------------------\n    set_db route_early_global_bottom_routing_layer            [get_db [get_db layers Metal2] .route_index]\n    set_db route_early_global_top_routing_layer               [get_db [get_db layers Metal11] .route_index]\n    #set_db route_early_global_num_tracks_per_clock_wire     1\n    set_db route_early_global_num_tracks_per_clock_wire     5\n\n    # Note TL: use only up to M8 in routing\n    set_db route_design_bottom_routing_layer                  [get_db [get_db layers Metal2] .route_index]\n    set_db route_design_top_routing_layer                     [get_db [get_db layers Metal11] .route_index]\n\n    set_db route_design_detail_post_route_swap_via          none\n    set_db route_design_with_litho_driven                   true\n    set_db route_design_with_timing_driven                  true\n\n    # Antenna options\n    set_db route_design_antenna_pin_limit                   1000\n    set_db route_design_antenna_cell_name                   ANTENNA\n    set_db route_design_add_antenna_inst_prefix             \"ANTENNA\"\n    set_db route_design_antenna_diode_insertion             true\n    set_db route_design_detail_fix_antenna                  true\n\n    #set_db route_design_process_node                        45\n    set_db route_design_with_via_in_pin                     1:1 ; # enclose via inside stdcell pin shape on M1 accesses\n\n    # H240 trim grid definition\n    #set_db route_design_with_trim_metal \"-layer 2  #-mask2 {-pitch 0.24 -core_offset 0.225 -width 0.03 }  #-mask2 {-pitch 0.24 -core_offset 0.095 -width 0.03 }  #-mask1 {-pitch 0.24 -core_offset 0.015 -width 0.03 }  #-mask1 {-pitch 0.24 -core_offset 0.145 -width 0.03 }\"\n\n    set_db route_design_concurrent_minimize_via_count_effort  high                        ;# Reduce the via count while routing\n    set_db route_design_detail_use_multi_cut_via_effort       high                        ;# Turn on concurrent double/bar cut routing before CTS\n    #set_db route_design_with_via_only_for_block_cell_pin      2:2                         ;# Access M2 MACRO pin with VIA only\n\n    if [is_flow -after_history flow:route] {\n#\treset_db route_design_detail_use_multi_cut_via_effort                               ;# Turn off concurrent double/bar cut routing\n#\teval_legacy {setNanoRouteMode -drouteExpConcurrentMinimizeViaCountCost 64}          ;# Concurrently minimize via count adding via cost\n#\tset_db route_design_antenna_diode_insertion             true                        ;# Allow diode insertion for Antenna fixing\n\tset_db route_design_detail_post_route_swap_via          multicut                    ;# If postroute double cuts are desired..although the percentage of swap is low for N7\n#    }\n\n    eval_legacy {setNanoRouteMode  -routeExpShieldAddTappingVia true}                     ;# Add Tapping via for the specified distance for shielding\n\n    # Timing ECO attributes [get_db -category opt_signoff] \n    #-------------------------------------------------------------------------------\n    set_db distributed_child_license_checkout_list          tpsxl\n\n    # techniques                                                                    \n    #set_db opt_signoff_resize_inst  true                                           \n    #set_db opt_signoff_add_inst true                                               \n    #set_db opt_signoff_swap_inst true                                              \n    #set_db opt_signoff_delete_inst true                                            \n    #set_db opt_signoff_allow_skewing false                                         \n    #set_db opt_signoff_optimize_sequential_cells false                             \n    set_db opt_signoff_optimize_core_only                   true                                    \n    #set_db opt_signoff_optimize_replicated_modules false                           \n\n    # target\n    #set_db opt_signoff_setup_target_slack 0.0\n    #set_db opt_signoff_hold_target_slack 0.0 \n\n        # Note TL: both false by default\n     set_db opt_signoff_fix_si_slew true\n     set_db opt_signoff_fix_xtalk   true\n     set_db opt_signoff_fix_glitch  true\n\n    # Hold fixing\n    set_db opt_signoff_fix_hold_allow_setup_optimization      true                        ;# When set to true, incremental Setup fixing is performed during Hold fixing in order to create more Setup margins on Hold violated nodes that could not be fixed earlier due to Setup timing conflict\n    set_db opt_signoff_fix_hold_allow_setup_tns_degrade       true                        ;# When  specified,  the  Setup Total Negative Slack can be degraded during Hold time violations fixing while still maintaining the Setup Worst Negative Slack in every Setup active views.\n\n    # PBA\n    set_db opt_signoff_retime                               path_slew_propagation\n    #set_db opt_signoff_check_type both                 \n    #set_db opt_signoff_max_paths -1                    \n    #set_db opt_signoff_nworst -1                       \n    #set_db opt_signoff_max_slack 0.0                   \n\n    # I/OS\n    #set_db opt_signoff_eco_file_prefix {}\n    #set_db opt_signoff_partition_list_file {}\n    #set_db opt_signoff_prefix ESO            \n    #set_db opt_signoff_read_eco_opt_db {}    \n    #set_db opt_signoff_write_eco_opt_db ecoTimingDB\n    #set_db opt_signoff_verbose false               \n    #set_db opt_signoff_pre_sta_tcl"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"messages","value":"{count 2 id IMPSP-2904 severity warn short {option place_detail_filler_gap_effort and place_detail_filler_gap_min_gap will be obsolete from next release and is replaced by place_detail_legalization_inst_gap <site>.}} {count 1 id IMPOPT-7140 severity warn short {The \"set_db opt_hold_cells\" list is empty}} {count 1 id NRIF-83 severity warn short {When route_detail_post_route_swap_via is set to 'none', the post route via swapping step will be skipped in all scenarios.}} {count 1 id NRIF-90 severity warn short {Option set_db route_bottom_routing_layer is obsolete. It will continue to work for the current release. To ensure compatibility with future releases, use option set_db design_bottom_routing_layer instead.}} {count 1 id NRIF-91 severity warn short {Option set_db route_top_routing_layer is obsolete. It will continue to work for the current release. To ensure compatibility with future releases, use option set_db design_top_routing_layer instead.}} {count 2 id IMPPSP-1003 severity warn short {Found use of '%s'. This will continue to work in this release; however, it is recommended to use '%s' instead.}}"},{"name":"messages.instant","value":"{count 2 id IMPSP-2904 severity warn short {option place_detail_filler_gap_effort and place_detail_filler_gap_min_gap will be obsolete from next release and is replaced by place_detail_legalization_inst_gap <site>.}} {count 1 id IMPOPT-7140 severity warn short {The \"set_db opt_hold_cells\" list is empty}} {count 1 id NRIF-83 severity warn short {When route_detail_post_route_swap_via is set to 'none', the post route via swapping step will be skipped in all scenarios.}} {count 1 id NRIF-90 severity warn short {Option set_db route_bottom_routing_layer is obsolete. It will continue to work for the current release. To ensure compatibility with future releases, use option set_db design_bottom_routing_layer instead.}} {count 1 id NRIF-91 severity warn short {Option set_db route_top_routing_layer is obsolete. It will continue to work for the current release. To ensure compatibility with future releases, use option set_db design_top_routing_layer instead.}} {count 2 id IMPPSP-1003 severity warn short {Found use of '%s'. This will continue to work in this release; however, it is recommended to use '%s' instead.}}"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"init_innovus"},{"inherited":true,"name":"uuid","value":"e18dc730-fd47-4aaa-971e-0ca7393367ab"}],"name":"init_innovus","parent_key":"flow:block .steps flow:floorplan","path":"floorplan/init_innovus","previous":["5a09d677-8e30-4bd0-8698-6d94a42385b1","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc"],"real_end":1763128007.0,"real_start":1763128005.0,"snapshots":[],"total_cpu":1140.24,"total_cpu_user":883.75,"uuid":"e18dc730-fd47-4aaa-971e-0ca7393367ab"},{"branch":"default","delta_cpu":1.77,"delta_cpu_not_child":1.77,"delta_cpu_user":1.73,"delta_cpu_user_not_child":1.73,"delta_real_not_child":2.0,"key":"flow:block .steps flow:floorplan .steps flow_step:init_floorplan","metrics":[{"name":"design.name","value":"datapath_top"},{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"1.77"},{"inherited":true,"name":"flow.cputime.not_child","value":"1.77"},{"inherited":true,"name":"flow.cputime.total","value":"1142.01"},{"inherited":true,"name":"flow.cputime.user","value":"1.73"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"1.73"},{"inherited":true,"name":"flow.cputime.user.total","value":"885.48"},{"name":"flow.db.starting","value":"cdb /home/student/16/ex8/flow_datapath_top_1/dbs/syn_opt.cdb datapath_top {}"},{"name":"flow.log","value":"/home/student/16/ex8/flow_datapath_top_1/logs/floorplan.log"},{"name":"flow.machine","value":"ASIC-vm"},{"name":"flow.machine.cpu.frequency","value":"2112.001 Mhz"},{"name":"flow.machine.cpu.model","value":"12th Gen Intel(R) Core(TM) i7-12700"},{"name":"flow.machine.cpu.number","value":"8"},{"name":"flow.machine.hostname","value":"ASIC-vm"},{"name":"flow.machine.load","value":"2.41"},{"name":"flow.machine.memory.free","value":"3276556 kB"},{"name":"flow.machine.memory.total","value":"16369280 kB"},{"name":"flow.machine.os","value":"Linux 4.18.0-553.69.1.el8_10.x86_64"},{"name":"flow.machine.swap.free","value":"3899644 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"3017.05 MB"},{"name":"flow.memory.instant","value":"3017.05 MB"},{"inherited":true,"name":"flow.memory.resident","value":"2971.27 MB"},{"name":"flow.memory.resident.instant","value":"2971.27 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"2971.27 MB"},{"name":"flow.memory.resident.peak.instant","value":"2971.27 MB"},{"inherited":true,"name":"flow.realtime","value":"2"},{"inherited":true,"name":"flow.realtime.not_child","value":"2"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763128007.0 1763128009.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763128007.0 1763128009.0}"},{"inherited":true,"name":"flow.realtime.total","value":"1192"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"if {[file exists floorplan_def/[get_db flow_vars_design_name].pso]} {\n        read_power_switches -in_file floorplan_def/[get_db flow_vars_design_name].pso\n    }\n    \n    if {![get_feature pnr_db_handoff]} {\n        if {[get_feature -feature synth_spatial] || [get_feature -feature synth_physical]} {\n            read_def  dbs/syn_opt/[get_db flow_vars_design_name].def.gz\n        } else {\n            read_def  [get_db flow_vars_floorplan_def]\n        }\n    }\n    \n    if {![llength [get_db route_rules ndr_cts_2w25s_leaf]]} {\n        create_route_rule -name ndr_cts_2w25s_leaf -width {Metal1:Metal7 0.16} -spacing {Metal1:Metal7 0.15}\n    }\n    if {![llength [get_db route_rules ndr_cts_2w25s_trunk]]} {\n        create_route_rule -name ndr_cts_2w25s_trunk -width {Metal1:Metal7 0.16 Metal8:Metal9 0.32} -spacing {Metal1:Metal7 0.15 Metal8:Metal9 0.30}\n    }\n\n    create_route_type -name cts_route_type_top -preferred_routing_layer_effort medium -route_rule ndr_cts_2w25s_trunk -top_preferred_layer 9 -bottom_preferred_layer 8 -shield_net VSS\n    create_route_type -name cts_route_type_trunk -preferred_routing_layer_effort medium -route_rule ndr_cts_2w25s_trunk -top_preferred_layer 9 -bottom_preferred_layer 2 -shield_net VSS\n    create_route_type -name cts_route_type_leaf -preferred_routing_layer_effort medium -route_rule ndr_cts_2w25s_leaf -top_preferred_layer 7 -bottom_preferred_layer 2 -shield_net VSS\n\n    # VDDAON (secondary pg) NDR\n    if {![llength [get_db route_rules ndr_vddaon]]} {\n        create_route_rule -name ndr_vddaon -width {Metal1:Metal7 0.32 Metal8:Metal9 0.64}\n    }\n    create_route_type -name vddaon_ndr_route_type -stack_distance 0.001 -min_stack_layer 4 -preferred_routing_layer_effort high -route_rule ndr_vddaon -top_preferred_layer 6 -bottom_preferred_layer 5\n\n    if {![get_feature pnr_db_handoff]} {\n        # commit power intent only after reading in .def\n        commit_power_intent -verbose\n    }\n\n    if {[file exists scripts/post_init_floorplan.tcl]} {\n        source scripts/post_init_floorplan.tcl\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"init_floorplan"},{"inherited":true,"name":"uuid","value":"b65dd3ca-fe1c-413d-b844-85c9efcf70a0"}],"name":"init_floorplan","parent_key":"flow:block .steps flow:floorplan","path":"floorplan/init_floorplan","previous":["e18dc730-fd47-4aaa-971e-0ca7393367ab","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc"],"real_end":1763128009.0,"real_start":1763128007.0,"snapshots":[],"total_cpu":1142.01,"total_cpu_user":885.48,"uuid":"b65dd3ca-fe1c-413d-b844-85c9efcf70a0"},{"branch":"default","delta_cpu":1.72,"delta_cpu_not_child":1.72,"delta_cpu_user":1.72,"delta_cpu_user_not_child":1.72,"delta_real_not_child":2.0,"key":"flow:block .steps flow:floorplan .steps flow_step:check_tracks","metrics":[{"name":"design.name","value":"datapath_top"},{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"1.72"},{"inherited":true,"name":"flow.cputime.not_child","value":"1.72"},{"inherited":true,"name":"flow.cputime.total","value":"1143.73"},{"inherited":true,"name":"flow.cputime.user","value":"1.72"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"1.72"},{"inherited":true,"name":"flow.cputime.user.total","value":"887.2"},{"name":"flow.db.starting","value":"cdb /home/student/16/ex8/flow_datapath_top_1/dbs/syn_opt.cdb datapath_top {}"},{"name":"flow.log","value":"/home/student/16/ex8/flow_datapath_top_1/logs/floorplan.log"},{"name":"flow.machine","value":"ASIC-vm"},{"name":"flow.machine.cpu.frequency","value":"2112.001 Mhz"},{"name":"flow.machine.cpu.model","value":"12th Gen Intel(R) Core(TM) i7-12700"},{"name":"flow.machine.cpu.number","value":"8"},{"name":"flow.machine.hostname","value":"ASIC-vm"},{"name":"flow.machine.load","value":"2.41"},{"name":"flow.machine.memory.free","value":"3274508 kB"},{"name":"flow.machine.memory.total","value":"16369280 kB"},{"name":"flow.machine.os","value":"Linux 4.18.0-553.69.1.el8_10.x86_64"},{"name":"flow.machine.swap.free","value":"3899644 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"3017.05 MB"},{"name":"flow.memory.instant","value":"3017.05 MB"},{"inherited":true,"name":"flow.memory.resident","value":"2973.27 MB"},{"name":"flow.memory.resident.instant","value":"2973.27 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"2973.27 MB"},{"name":"flow.memory.resident.peak.instant","value":"2973.27 MB"},{"inherited":true,"name":"flow.realtime","value":"2"},{"inherited":true,"name":"flow.realtime.not_child","value":"2"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763128009.0 1763128011.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763128009.0 1763128011.0}"},{"inherited":true,"name":"flow.realtime.total","value":"1194"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"#- generate tracks after creating floorplan\n    if {[llength [get_db current_design .track_patterns]] == 0} {\n\tputs \"