y.instant","value":"2793.47 MB"},{"inherited":true,"name":"flow.memory.resident","value":"2782.82 MB"},{"name":"flow.memory.resident.instant","value":"2782.82 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"2782.82 MB"},{"name":"flow.memory.resident.peak.instant","value":"2782.82 MB"},{"inherited":true,"name":"flow.realtime","value":"44"},{"inherited":true,"name":"flow.realtime.not_child","value":"1"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763129369.0 1763129370.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763129326.0 1763129370.0}"},{"inherited":true,"name":"flow.realtime.total","value":"2160"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":""},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"messages","value":"{count 144 id IMPLF-200 severity warn short {Pin '%s' in macro '%s' has no ANTENNAGATEAREA value defined. The library data is incomplete and some process antenna rules will not be checked correctly.}} {count 2 id IMPLF-201 severity warn short {Pin '%s' in macro '%s' has no ANTENNADIFFAREA value defined. The library data is incomplete and some process antenna rules will not be checked correctly.}} {count 2 id IMPSE-538 severity warn short {The '%s' attribute is obsolete and will be removed in a future release. The obsolete option still works in this release but to avoid this warning and to ensure compatibility with future releases, remove the obsolete option from your script.}} {count 2 id IMPFP-3961 severity warn short {The techSite '%s' has no related standard cells in the LEF/OA library. The calculations for this site type cannot be made unless standard cell models of this type exist in the LEF/OA library. Ignore this warning if the SITE is not used by the library. Alternatively, remove the SITE definition for the LEF/OA library to avoid this message.}} {count 4 id IMPDBTCL-299 severity warn short {The attribute '%s' still works but will be obsolete in a future major release. You should remove it from your script before the next major release to avoid errors. It should be changed to the new name of '%s'.}} {count 19 id IMPDBTCL-321 severity warn short {The attribute '%s' still works but will be obsolete in a future major release. You should remove it from your script before the next major release to avoid errors.}} {count 1 id IMPESI-3478 severity warn short {Simulation based Equivalent Waveform Model without waveform propagation setting is not properly supported, using moment based EWM instead.}} {count 1 id IMPESI-3505 severity warn short {set_db delaycal_eng_%s (default=%s) will be obsoleted along with its sgs2set equivalent.  This parameter will continue to be supported in the current release, but will be removed in the next major release of the software.}} {count 4 id IMPSP-2904 severity warn short {option place_detail_filler_gap_effort and place_detail_filler_gap_min_gap will be obsolete from next release and is replaced by place_detail_legalization_inst_gap <site>.}} {count 2 id IMPOPT-7140 severity warn short {The \"set_db opt_hold_cells\" list is empty}} {count 2 id IMPOPT-7155 severity warn short {Option %s in 'set_db' will be obsolete. 'set_db %s %s'will mapped to 'set_db opt_skew_ccopt %s' internally when design_flow_effort is not set to extreme and 'opt_skew_ccopt' has not been explict set by user.}} {count 5 id IMPAFP-9024 severity warn short {This command is hidden and will be obsolete in the next major release. For module placement, use proto_design instead. For macro placement, use place_design -concurrent_macros to place both standard cells and macros together.}} {count 2 id NRIF-83 severity warn short {When route_detail_post_route_swap_via is set to 'none', the post route via swapping step will be skipped in all scenarios.}} {count 2 id NRIF-90 severity warn short {Option set_db route_bottom_routing_layer is obsolete. It will continue to work for the current release. To ensure compatibility with future releases, use option set_db design_bottom_routing_layer instead.}} {count 2 id NRIF-91 severity warn short {Option set_db route_top_routing_layer is obsolete. It will continue to work for the current release. To ensure compatibility with future releases, use option set_db design_top_routing_layer instead.}} {count 5808 id IMPCTE-290 severity warn short {Could not locate cell %s in any library for view %s.}} {count 1 id IMPCTE-107 severity warn short {The following globals have been obsoleted since version %s. They will be removed in the next release. \n%s}} {count 3 id IMPTCM-77 severity warn short {Option \"%s\" for command %s is obsolete and will be removed in a future release. The obsolete option still works in this release but to avoid this warning and to ensure compatibility with future releases, remove the obsolete option from your script.}} {count 2 id PRL-39 severity warn short {Number of local CPUs specified (%d) > Actual number of CPUs in the host (%d). The lower value will be used.}} {count 4 id IMPPSP-1003 severity warn short {Found use of '%s'. This will continue to work in this release; however, it is recommended to use '%s' instead.}} {count 20 id TECHLIB-302 severity warn short {No function defined for cell '%s'. The cell will only be used for analysis.}} {count 198 id TECHLIB-1329 severity warn short {The attribute '%s' on the %s in cell '%s' is missing, even though the cell has multiple supply voltages.}}"},{"name":"messages.instant","value":"{count 144 id IMPLF-200 severity warn short {Pin '%s' in