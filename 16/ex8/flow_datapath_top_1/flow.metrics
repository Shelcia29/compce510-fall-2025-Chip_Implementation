 else {\n        set_db flow_write_db_common false\n    }\n\n    #- Store non-default root attributes to metrics\n    catch {report_obj -tcl} flow_root_config\n    if {[dict exists $flow_root_config root:/]} {\n\tset flow_root_config [dict get $flow_root_config root:/]\n    } elseif {[dict exists $flow_root_config root:]} {\n\tset flow_root_config [dict get $flow_root_config root:]\n    } else {\n    }\n    foreach key [dict keys $flow_root_config] {\n\tif {[string length [dict get $flow_root_config $key]] > 200} {\n\t    dict set flow_root_config $key \"\\[long value truncated\\]\"\n\t}\n    }\n    set_metric -name flow.root_config -value $flow_root_config"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"block_finish"},{"inherited":true,"name":"uuid","value":"68777be3-e3ec-41b1-8497-ca2bfda2a89b"}],"name":"block_finish","parent_key":"flow:block .steps flow:postroute","path":"postroute/block_finish","previous":["275e3c36-24bd-4025-adb6-4391b4f97a90","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc","326eaeca-bf43-4b00-821d-196a853ffd53","d5eaa64e-b4b4-4fe8-b924-0123928725a8","749e5fcf-6573-477d-b5c5-9f3d84a4902a","c38b5bdc-a30b-4bec-b7bb-b4707272db21","3bfcb3a2-715b-42b4-8462-e81333571e5b"],"real_end":1763131359.0,"real_start":1763131357.0,"snapshots":[{"branch":"default","delta_cpu":4.58,"delta_cpu_not_child":4.58,"delta_cpu_user":2.13,"del