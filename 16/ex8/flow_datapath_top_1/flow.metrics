_floorplan_def]\n    }\n\n    #- add cells and commit power rules\n    if {[file exists [get_db flow_vars_power_intent]]} {\n\tcommit_power_intent\n    }\n\n    update_names -suffix _cn -name_collision -max_length 1000 [get_db current_design] \n\n    #- load tool configs which require design information\n    if {[file exists scripts/[get_db program_short_name]_config.tcl]} {\n\tuplevel #0 source -quiet scripts/[get_db program_short_name]_config.tcl\n    } else {\n\tuplevel #0 source -quiet [file join [get_db flow_source_directory] [get_db program_short_name]_config.tcl]\n    }\n\n    if {[get_db flow_feature_disable_naming_rules]} {\n\twrite_db -to_file [get_db flow_database_directory]/syn_generic.init_design.disable_naming_rules.db\n    } else {\n\twrite_db -to_file [get_db flow_database_directory]/syn_generic.init_design.db\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"23.15-s099_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-23.15-s099_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"messages","value":"{count 4 id message:TUI/TUI-61 severity Error short {A required object parameter could not be found.}} {count 4 id message:LBR/LBR-415 severity Info short {Unusable library cells found at the time of loading a library.}} {count 264 id message:LBR/LBR-155 severity Info short {Mismatch in unateness between 'timing_sense' attribute and the function.}} {count 4 id message:LBR/LBR-72 severity Info short {Detected an unsupported timing arc type.}} {count 3 id message:CHNM/CHNM-110 severity Warning short {Failed to change names.}} {count 1 id message:CHNM/CHNM-108 severity Warning short {Port names affected by this command do not automatically get updated in written out SV wrapper module.}} {count 3 id message:TIM/TIM-167 severity Info short {An external clock is being defined.}} {count 4 id message:PHYS/PHYS-150 severity Warning short {Pin does not exist in the netlist.}} {count 6 id message:PHYS/PHYS-154 severity Info short {Creating physical pin.}} {count 29 id message:PHYS/PHYS-181 severity Info short {Full preserve set on instance.}} {count 61 id message:PHYS/PHYS-232 severity Warning short {Unplaceable libcell found.}} {count 70 id message:PHYS/PHYS-2257 severity Warning short {Net specified in pin is undefined in the netlist.}} {count 85 id message:PHYS/PHYS-550 severity Info short {Disabling ungrouping on hinst.}} {count 1 id message:CPI/CPI-518 severity Info short {Completed level shifter insertion.}} {count 1 id message:CPI/CPI-517 severity Info short {Completed isolation cell insertion.}} {count 1 id message:CPI/CPI-503 severity Info short {No level shifter rules defined.}} {count 1 id message:CPI/CPI-502 severity Info short {No isolation rules defined.}} {count 8 id message:SDC/SDC-202 severity Error short {Could not interpret SDC command.}} {count 2 id message:SDC/SDC-204 severity Error short {Invalid SDC command option combination.}} {count 8 id message:SDC/SDC-208 severity Warning short {Could not find requested search value.}} {count 2 id message:SDC/SDC-209 severity Warning short {One or more commands failed when these constraints were applied.}}"},{"name":"messages.instant","value":"{count 4 id message:TUI/TUI-61 severity Error short {A required object parameter could not be found.}} {count 4 id message:LBR/LBR-415 severity Info short {Unusable library cells found at the time of loading a library.}} {count 264 id message:LBR/LBR-155 severity Info short {Mismatch in unateness between 'timing_sense' attribute and the function.}} {count 4 id message:LBR/LBR-72 severity Info short {Detected an unsupported timing arc type.}} {count 3 id message:CHNM/CHNM-110 severity Warning short {Failed to change names.}}