_retime_formatting_mode retime_replace timing_time_unit 1ns ui_units_capacitance 1pf ui_units_timing 1ns write_def_hierarchy_delimiter / write_lec_dft_constraints {{design_view revised module {} pins_to_0 {scan_mode_datapath_top scan_enable_datapath_top}}} write_lec_directory_naming_style fv/%s/postcts write_stream_via_names true"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"#- Make sure flow_report_name is reset from any reports executed during the flow\n    set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]\n    \n    if {[get_feature pnr_db_handoff] && [is_flow -quiet -inside flow:syn_opt]} {\n        set_db flow_write_db_common true\n    } else {\n        set_db flow_write_db_common false\n    }\n\n    #- Store non-default root attributes to metrics\n    catch {report_obj -tcl} flow_root_config\n    if {[dict exists $flow_root_config root:/]} {\n\tset flow_root_config [dict get $flow_root_config root:/]\n    } elseif {[dict exists $flow_root_config root:]} {\n\tset flow_root_config [dict get $flow_root_config root:]\n    } else {\n    }\n    foreach key [dict keys $flow_root_config] {\n\tif {[string length [dict get $flow_root_config $key]] > 200} {\n\t    dict set flow_root_config $key \"\\[long value truncated\\]\"\n\t}\n    }\n    set_metric -name flow.root_config -value $flow_root_config"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"block_finish"},{"inherited":true,"name":"uuid","value":"cbf69774-f131-4273-bc2c-cad04c9c5d1d"}],"name":"block_finish","parent_key":"flow:block .steps flow:postcts","path":"postcts/block_finish","previous":["899ec94c-12b5-4286-8187-18ff87083ef4","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc","326eaeca-bf43-4b00-821d-196a853ffd53","d5eaa64e-b4b4-4fe8-b924-0123928725a8","749e5fcf-6573-477d-b5c5-9f3d84a4902a"],"real_end":1763129203.0,"real_start":1763129200.0,"snapshots":[{"branch":"default","delta_cpu":3.46,"delta_cpu_not_child":3.46,"delta_cpu_user":1.95,"delta_cpu_user_not_child":1.95,"delta_real_not_child":9.0,"exclude_time_metric":true,"key":"flow:block .steps flow:postcts .steps flow_step:block_finish {.write_db write_db}","metrics":[{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"3.46"},{"inherited":true,"name":"flow.cputime.not_child","value":"3.46"},{"inherited":true,"name":"flow.cputime.total","value":"3207.11"},{"inherited":true,"name":"flow.cputime.user","value":"1.95"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"1.95"},{"inherited":true,"name":"flow.cputime.user.total","value":"2387.51"},{"name":"flow.exclude_time_metric","value":"1"},{"name":"flow.machine.load","value":"0.99"},{"inherited":true,"name":"flow.memory","value":"6651.23 MB"},{"name":"flow.memory.instant","value":"6651.23 MB"},{"inherited":true,"name":"flow.memory.resident","value":"3874.62 MB"},{"name":"flow.memory.resident.instant","value":"3874.62 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"4787.61 MB"},{"name":"flow.memory.resident.peak.instant","value":"4787.61 MB"},{"inherited":true,"name":"flow.realtime","value":"9"},{"inherited":true,"name":"flow.realtime.not_child","value":"9"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763129203.0 1763129212.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763129203.0 1763129212.0}"},{"inherited":true,"name":"flow.realtime.total","value":"2117"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"write_db"},{"inherited":true,"name":"uuid","value":"293ca957-305b-4ece-9f3f-cbb92de7692b"}],"name":"write_db","parent_key":"flow:block .steps flow:postcts .steps flow_step:block_finish","path":"postcts/block_finish/write_db","previous":["cbf69774-f131-4273-bc2c-cad04c9c5d1d"],"real_end":1763129212.0,"real_start":1763129203.0,"snapshots":[],"total_cpu":3207.11,"total_cpu_user":2387.51,"uuid":"293ca957-305b-4ece-9f3f-cbb92de7692b"}],"total_cpu":3206.47,"total_cpu_user":2388.36,"uuid":"cbf69774-f131-4273-bc2c-cad04c9c5d1d"},{"branch":"default","delta_cpu":8.74,"delta_cpu_not_child":0.37,"delta_cpu_user":8.53,"delta_cpu_user_not_child":0.37,"delta_real_not_child":0.0,"key":"flow:block .steps flow:postcts .steps flow:report_postcts","metrics":[{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"8.74"},{"inherited":true,"name":"flow.cputime.not_child","value":"0.37"},{"inherited":true,"name":"flow.cputime.total","value":"3215.21"},{"inherited":true,"name":"flow.cputime.user","value":"8.53"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"0.37"},{"inherited":true,"name":"flow.cputime.user.total","value":"2396.89"},{"inherited":true,"name":"flow.last_child_snapshot","value":"report_finish"},{"name":"flow.machine.load","value":"0.99"},{"inherited":true,"name":"flow.memory","value":"7033.43 MB"},{"name":"flow.memory.instant","value":"6651.23 MB"},{"inherited":true,"name":"flow.memory.resident","value":"4307.02 MB"},{"name":"flow.memory.resident.instant","value":"3894.1 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"4787.61 MB"},{"name":"flow.memory.resident.peak.instant","value":"4787.61 MB"},{"inherited":true,"name":"flow.realtime","value":"8"},{"inherited":true,"name":"