value":"4004092 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"4314.74 MB"},{"name":"flow.memory.instant","value":"4314.74 MB"},{"inherited":true,"name":"flow.memory.resident","value":"4314.74 MB"},{"name":"flow.memory.resident.instant","value":"4314.74 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"4314.74 MB"},{"name":"flow.memory.resident.peak.instant","value":"4314.74 MB"},{"inherited":true,"name":"flow.realtime","value":"3"},{"inherited":true,"name":"flow.realtime.not_child","value":"3"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763127379.0 1763127382.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763127379.0 1763127382.0}"},{"inherited":true,"name":"flow.realtime.total","value":"684"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"#- Re-run DFT rule checks\n    check_dft_rules\t     \n\n    if {0} {\n\n        add_core_wrapper_cell  -location [get_db ports {*src2dst* *dst2src*}]  -shared_through buffer  -no_mux_before_shared_cell  -wsen [get_db ports scan_enable*]\n\n        check_dft_rules\n\n        #report_core_wrapper_cell -report_flops\n\n        define_scan_chain -name 1500_chain  -sdi wchain_si_[get_db flow_vars_design_name]_0  -sdo wchain_so_[get_db flow_vars_design_name]_0  -create_ports\n\n        set num_chains [get_db current_design .dft_min_number_of_scan_chains]\n        reset_db current_design .dft_min_number_of_scan_chains\n        if {[get_db flow_feature_synth_physical] || [get_db flow_feature_synth_spatial]} {\n            place_dft_sequentials\n            \n            connect_scan_chains -chains 1500_chain  -elements [get_db scan_segments -if {.core_wrapper}]  -physical -incremental\n        } else {\n            connect_scan_chains -chains 1500_chain  -elements [get_db scan_segments -if {.core_wrapper}]  -incremental\n        }\n        set_db current_design .dft_min_number_of_scan_chains $num_chains\n    }\n\n    for {set i 0} {$i < [get_db [current_design] .dft_min_number_of_scan_chains]} {incr i} {\n        define_scan_chain  -sdi scan_in_[get_db flow_vars_design_name]_$i  -sdo scan_out_[get_db flow_vars_design_name]_$i  -create_ports  -name scan_chain_[get_db flow_vars_design_name]_$i  -terminal_lockup level_sensitive\n    }\n\n    #define_scan_chain -create_ports -sdi sdi -sdo sdo -terminal_lockup level_sensitive\n    if {[get_db flow_feature_synth_physical] || [get_db flow_feature_synth_spatial]} {\n\tconnect_scan_chains -chains scan_chain_*  -incremental  -physical -cluster_aggressively_high\n    } else {\n\tconnect_scan_chains -chains scan_chain_*  -incremental -zipper_stitch\n\t\n    }\n\n    # connect shift enable signal to AICG TE-pins (can be done only after design is uniquified)\n    # go through all instantiated cgs\n    set_db ui_respects_preserve false\n    foreach icg_inst [get_db [get_db insts -if {.base_name==inst_TLATNTSCAX*}] .name] {\n\tdisconnect [get_db pins $icg_inst/TE]\n\tconnect [get_db ports scan_enable_[get_db flow_vars_design_name]] [get_db pins $icg_inst/TE] -prefix DFT_AICG_TE_scan_enable_[get_db flow_vars_design_name]_\n    }\n    set_db ui_respects_preserve true"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"23.15-s099_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-23.15-s099_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"messages","value":"{count 1 id message:TUI/TUI-306 severity Info short {An additional product license has been checked out.}} {count 1 id message:POPT/POPT-105 severity Warning short {The 'lp_insert_clock_gating' attribute should be set before generic synthe