oot_config\n    if {[dict exists $flow_root_config root:/]} {\n\tset flow_root_config [dict get $flow_root_config root:/]\n    } elseif {[dict exists $flow_root_config root:]} {\n\tset flow_root_config [dict get $flow_root_config root:]\n    } else {\n    }\n    foreach key [dict keys $flow_root_config] {\n\tif {[string length [dict get $flow_root_config $key]] > 200} {\n\t    dict set flow_root_config $key \"\\[long value truncated\\]\"\n\t}\n    }\n    set_metric -name flow.root_config -value $flow_root_config"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"23.15-s099_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-23.15-s099_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"block_finish"},{"inherited":true,"name":"uuid","value":"c1569247-74f1-4b01-99a0-657de219dc6a"}],"name":"block_finish","parent_key":"flow:block .steps flow:syn_generic","path":"syn_generic/block_finish","previous":["ff08b339-609e-4eea-aaaa-76fc382cf974","169adade-4421-4afa-823b-ba1e3a6d30a7"],"real_end":1763127147.0,"real_start":1763127146.0,"snapshots":[{"branch":"default","delta_cpu":7.0,"delta_cpu_not_child":7.0,"delta_cpu_user":7.0,"delta_cpu_user_not_child":7.0,"delta_real_not_child":8.0,"exclude_time_metric":true,"key":"flow:block .steps flow:syn_generic .steps flow_step:block_finish {.write_db write_db}","metrics":[{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"7"},{"inherited":true,"name":"flow.cputime.not_child","value":"7"},{"inherited":true,"name":"flow.cputime.total","value":"342"},{"inherited":true,"name":"flow.cputime.user","value":"7"},{"