\n\t}\n    }\n\n    foreach dont_use_expr [get_db flow_vars_dont_use_list] {\n        set_db [get_db base_cells -if {*}${dont_use_expr}] .dont_use true\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"23.15-s099_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-23.15-s099_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"set_dont_use"},{"inherited":true,"name":"uuid","value":"fd13e869-20a7-4119-8544-ed29e0347fea"}],"name":"set_dont_use","parent_key":"flow:block .steps flow:syn_generic","path":"syn_generic/set_dont_use","previous":["ee2fe905-e6d6-4a0f-818b-31db1c63dc63","169adade-4421-4afa-823b-ba1e3a6d30a7"],"real_end":1763126684.0,"real_start":1763126683.0,"snapshots":[],"total_cpu":38.0,"total_cpu_user":38.0,"uuid":"fd13e869-20a7-4119-8544-ed29e0347fea"},{"branch":"default","delta_cpu":1.0,"delta_cpu_not_child":1.0,"delta_cpu_user":1.0,"delta_cpu_user_not_child":1.0,"delta_real_not_child":1.0,"key":"flow:block .steps flow:syn_generic .steps flow_step:set_dont_touch","metrics":[{"name":"design.name","value":"datapath_top"},{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"1"},{"inherited":true,"name":"flow.cputime.not_child","value":"1"},{"inherited":true,"name":"flow.cputime.total","value":"39"},{"inherited":true,"name":"flow.cputime.user","value":"1"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"1"},{"inherited":true,"name":"flow.cputime.user.total","value":"39"},{"name":"flow.log","value":"/home/student/16/ex8/flow_datapath_top_1/logs/syn_generic.log"},{"name":"flow.machine","value":"ASIC-vm"},{"name"