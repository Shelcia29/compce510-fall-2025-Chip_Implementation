8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"#- Make sure flow_report_name is reset from any reports executed during the flow\n    set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]\n    \n    if {[get_feature pnr_db_handoff] && [is_flow -quiet -inside flow:syn_opt]} {\n        set_db flow_write_db_common true\n    } else {\n        set_db flow_write_db_common false\n    }\n\n    #- Store non-default root attributes to metrics\n    catch {report_obj -tcl} flow_root_config\n    if {[dict exists $flow_root_config root:/]} {\n\tset flow_root_config [dict get $flow_root_config root:/]\n    } elseif {[dict exists $flow_root_config root:]} {\n\tset flow_root_config [dict get $flow_root_config root:]\n    } else {\n    }\n    foreach key [dict keys $flow_root_config] {\n\tif {[string length [dict get $flow_root_config $key]] > 200} {\n\t    dict set flow_root_config $key \"\\[long value truncated\\]\"\n\t}\n    }\n    set_metric -name flow.root_config -value $flow_root_config"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"block_finish"},{"inherited":true,"name":"uuid","value":"8e698490-71e2-4034-ad1a-9269847e8051"}],"name":"block_finish","parent_key":"flow:block .steps flow:prects","path":"prects/block_finish","previous":["986b0c9d-c348-4eee-8022-c91fd991a825","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc",