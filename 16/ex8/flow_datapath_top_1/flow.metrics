------------------------------\n  set_db design_process_node                        22\n\n  # Timing attributes  [get_db -category timing]\n  #-------------------------------------------------------------------------------\n  set_db timing_report_fields                               {timing_point net edge cell user_derate transition load delay arrival annotation}\n\n  set_db si_aggressor_alignment                             timing_aware_edge       \n  \n  # do not split report_constraint lines to enable scripting\n  set_table_style -no_frame_fix_width -nosplit\n\n  # Delaycal attributes  [get_db -category delaycal]\n  #-------------------------------------------------------------------------------\n\n  # set_delay_cal_mode -siAware true\n  set_db delaycal_enable_si                         true\n  # set_delay_cal_mode -ewm_type simulation -equivalent_waveform_model propagation\n  set_db delaycal_ewm_type simulation\n  set_db delaycal_equivalent_waveform_model propagation\n\n  # Note TL, true is more conservative\n  set_db delaycal_enable_quiet_receivers_for_hold true\n  # Note TL, true is more accurate\n  set_db delaycal_advanced_pin_cap_mode true \n  # Note TL, true is more accurate\n  set_db delaycal_accurate_receiver_out_load true\n\n  set_db timing_analysis_socv                       false\n  set_db timing_analysis_cppr                       both\n  set_db timing_analysis_type                       ocv\n\n  set_db timing_socv_rc_variation_mode                      false\n\n  # set_global timing_disable_retime_clock_path_slew_propagation false\n  set_db timing_disable_retime_clock_path_slew_propagation false\n\n  if {[get_feature -feature sta_eco]} {\n    \n    # Opt Signoff attributes  [get_db -category opt_signoff]\n    #-------------------------------------------------------------------------------\n    set_db opt_signoff_allow_multiple_incremental     true\n    if {[file exists [file join [get_db flow_report_directory] [get_db flow_report_name]]]} {\n      set_db opt_signoff_write_eco_opt_db             [get_db flow_report_directory]/[get_db flow_report_name]/sta_eco_timing_db\n    }\n    if {[file exists [file join [get_db flow_report_directory] [get_db flow_report_name] sta_eco_timing_db]]} {\n      set_db opt_signoff_read_eco_opt_db              [get_db flow_report_directory]/[get_db flow_report_name]/sta_eco_timing_db\n    }\n  }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Tempus Timing Solution"},{"name":"flow.tool.name.short","value":"tempus"},{"name":"flow.tool.version","value":"23.15-s108_1"},{"inherited":true,"name":"flow.tool_list","value":"tempus-23.15-s108_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"init_tempus"},{"inherited":true,"name":"uuid","value":"2652985f-6f13-4b61-bc1b-37ffd4fac070"}],"name":"init_tempus","parent_key":"flow:block .steps flow:sta","path":"sta/init_tempus","previous":["4674e382-d883-4647-b547-b2d90c370a62","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc","326eaeca-bf43-4b00-821d-196a853ffd53","d5eaa64e-b4b4-4fe8-b924-0123928725a8","749e5fcf-6573-477d-b5c5-9f3d84a4902a","c38b5bdc-a30b-4bec-b7bb-b4707272db21","3bfcb3a2-715b-42b4-8462-e81333571e5b","c172dd39-ae6f-41ce-adce-7689f598e974","968bce55-4a6e-4c12-be5e-0fc8c212be91"],"real_end":1763135076.0,"real_start":1763135073.0,"snapshots":[],"total_cpu":20590.0,"total_cpu_user":18820.2,"uuid":"2652985f-6f13-4b61-bc1b-37ffd4fac070"},{"branch":"default","delta_cpu":3.49,"delta_cpu_not_child":3.49,"delta_cpu_user":3.49,"delta_cpu_user_not_child":3.49,"delta_real_not_child":4.0,"key":"flow:block .steps flow:sta .steps flow_step:tempus_load_latency_files","metrics":[{"name":"design.name","value":"datapath_top"},{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"3.49"},{"inherited":true,"name":"flow.cputime.not_child","value":"3.49"},{"inherited":true,"name":"flow.cputime.total","value":"20593.5"},{"inherited":true,"name":"flow.cputime.user","value":"3.49"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"3.49"},{"inherited":true,"name":"flow.cputime.user.total","value":"18823.7"},{"name":"flow.db.starting","value":"tcl /home/student/16/ex8/flow_datapath_top_1/dbs/opt_signoff/init_sta.tcl . {}"},{"name":"flow.log","value":"/home/student/16/ex8/flow_datapath_top_1/logs/sta.log"},{"name":"flow.machine","value":"ASIC-vm"},{"name":"flow.machine.cpu.frequency","value":"2112.001 Mhz"},{"name":"flow.machine.cpu.model","value":"12th Gen Intel(R) Core(TM) i7-12700"},{"name":"flow.machine.cpu.number","value":"8"},{"name":"flow.machine.hostname","value":"ASIC-vm"},{"name":"flow.machine.load","value":"0.79"},{"name":"flow.machine.memory.free","value":"6319892 kB"},{"name":"flow.machine.memory.total","value":"16369280 kB"},{"name":"flow.machine.os","value":"Linux 4.18.0-553.69.1.el8_10.x86_64"},{"name":"flow.machine.swap.free","value":"3686396 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"4381.88 MB"},{"name":"flow.memory.instant","value":"4381.88 MB"},{"inherited":true,"name":"flow.memory.resident","value":"3129.89 MB"},{"name":"flow.memory.resident.instant","value":"3129.89 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"3129.89 MB"},{"name":"flow.memory.resident.peak.instant","value":"3129.89 MB"},{"inherited":true,"name":"flow.realtime","value":"3"},{"inherited":true,"name":"flow.realtime.not_child","value":"4"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763135077.0 1763135080.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763135077.0 1763135080.0}"},{"inherited":true,"name":"flow.realtime.total","value":"6492"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"foreach dpo [get_db analysis_views] {\n\tset dpo_latency_file [file join [get_db flow_db_directory]/latency_files [get_db $dpo .name]_latency.sdc]\n\tif {[file exists $dpo_latency_file]} {\n\t    update_analysis_view -name [get_db $dpo .name] -latency_file $dpo_latency_file\n\t} else {\n            puts \"Warning: Could not find latency file for view: [get_db $dpo .name] in [get_db flow_db_directory]/latency_files\"\n            puts \"Note: Using different view for latency\"\n            if {[regexp {^ss_0p81v.*worst_T_(\\w+)$} [get_db $dpo .name] -> mode_name]} {\n                set new_dpo_name ss_0p81v_m40c_rcworst_T_${mode_name}\n                set dpo_latency_file [file join [get_db flow_db_directory]/latency_files ${new_dpo_name}_latency.sdc]\n            } elseif {[regexp {^ss_0p81v.*worst_(\\w+)$} [get_db $dpo .name] -> mode_name]} {\n                set new_dpo_name ss_0p81v_m40c_rcworst_${mode_name}\n                set dpo_latency_file [file join [get_db flow_db_directory]/latency_files ${new_dpo_name}_latency.sdc]\n            } elseif {[regexp {^ff_0p99v.*best_(\\w+)$} [get_db $dpo .name] -> mode_name]} {\n                set new_dpo_name ff_0p99v_125c_cbest_${mode_name}\n                set dpo_latency_file [file join [get_db flow_db_directory]/latency_files ${new_dpo_name}_latency.sdc]\n            } elseif {[regexp {^ff_0p99v.*worst_(\\w+)$} [get_db $dpo .name] -> mode_name]} {\n                set new_dpo_name ff_0p99v_125c_cbest_${mode_name}\n                set dpo_latency_file [file join [get_db flow_db_directory]/latency_files ${new_dpo_name}_latency.sdc]\n            }\n                \n            if {[file exists $dpo_latency_file]} {\n                update_analysis_view -name [get_db $dpo .name] -latency_file $dpo_latency_file\n            } else {\n                puts \"Error: Could not map [get_db $dpo .name] to latency file $dpo_latency_file\"\n            }\n        }\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Tempus Timing Solution"},{"name":"flow.tool.name.short","value":"tempus"},{"name":"flow.tool.version","value":"23.15-s108_1"},{"inherited":true,"name":"flow.tool_list","value":"tempus-23.15-s108_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"messages","value":"{count 6 id IMPSE-110 severity error short {File '%s' line %s: %s.}}"},{"name":"messages.instant","value":"{count 6 id IMPSE-110 severity error short {File '%s' line %s: %s.}}"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"tempus_load_latency_files"},{"inherited":true,"name":"uuid","value":"abe31d68-929f-4f60-9931-99aff86c9601"}],"name":"tempus_load_latency_files","parent_key":"flow:block .steps flow:sta","path":"sta/tempus_load_latency_files","previous":["2652985f-6f13-4b61-bc1b-37ffd4fac070","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc","326eaeca-bf43-4b00-821d-196a853ffd53","d5eaa64e-b4b4-4fe8-b924-0123928725a8","749e5fcf-6573-477d-b5c5-9f3d84a4902a","c38b5bdc-a30b-4bec-b7bb-b4707272db21","3bfcb3a2-715b-42b4-8462-e81333571e5b","c172dd39-ae6f-41ce-adce-7689f598e974","968bce55-4a6e-4c12-be5e-0fc8c212be91"],"real_end":1763135080.0,"real_start":1763135077.0,"snapshots":[],"total_cpu":20593.5,"total_cpu_user":18823.7,"uuid":"abe31d68-929f-4f60-9931-99aff86c9601"},{"branch":"default","delta_cpu":3.54,"delta_cpu_not_child":3.54,"delta_cpu_user":3.54,"delta_cpu_user_not_child":3.54,"delta_real_not_child":3.0,"key":"flow:block .steps flow:sta .steps flow_step:tempus_set_propagated_clock","metrics