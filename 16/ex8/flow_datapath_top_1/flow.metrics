ame":"flow.realtime.not_child","value":"9"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763135084.0 1763135092.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763135084.0 1763135092.0}"},{"inherited":true,"name":"flow.realtime.total","value":"6503"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"#- initialize annotations using spef\n    if {[is_flow -quiet -inside flow:ir_static] || [is_flow -quiet -inside flow:ir_dynamic] || [is_flow -quiet -inside flow:ir_rampup]} {\n\tset views [get_db analysis_views [get_db power_view]]\n\tset decoupled \"-decoupled\"\n    } else {\n\tset views [get_db -u analysis_views -if {.is_setup || .is_hold || .is_leakage}]\n\tset decoupled \"\"\n    }\n    set spef_dir  [file normalize [file join [get_db flow_working_directory] [get_db flow_db_directory] [file rootname [get_db flow_report_name]]]]\n    puts \"Info: Using SPEF-dir: $spef_dir\"\n    set corners [lsort -u [concat [get_db -u [get_db delay_corners -if {.is_setup || .is_hold}] .late_rc_corner]  [get_db -u [get_db delay_corners -if {.is_setup || .is_hold}] .early_rc_corner]]]\n    puts \"Info: reading corners $corners\"\n    \n    foreach corner $corners {\n        set rcc_name [get_db ${corner} .name]\n\n        set spef_list [list ${spef_dir}/[get_db flow_vars_design_name].${rcc_name}.spef.gz]\n        # subblock SPEFs\n        foreach {blockname blockpath} [array get local_macro_exportdir] {\n            puts \"Info: Reading subblock SPEF ${blockpath}/dbs/opt_signoff/${blockname}.${rcc_name}.spef.gz\"\n            lappend spef_list ${blockpath}/dbs/opt_signoff/${blockname}.${rcc_name}.spef.gz\n        }\n        puts \"Info: read_spef \\\"${spef_list}\\\" -rc_corner $rcc_name\"\n        read_spef \"${spef_list}\" -rc_corner $rcc_name\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Tempus Timing Solution"},{"name":"flow.tool.name.short","value":"tempus"},{"name":"flow.tool.version","value":"23.15-s108_1"},{"inherited":true,"name":"flow.tool_list","value":"tempus-23.15-s108_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"messages","value":"{count 128 id SPEF-1152 severity warn short {Net '%s' is not fully specified as per its connectivity in design netlist. Missing ports have been added to the net using low RC values. The timing accuracy is not reliable for such nets.}}"},{"name":"messages.instant","value":"{count 128 id SPEF-1152 severity warn short {Net '%s' is not fully specified as per its connectivity in design netlist. Missing ports have been added to the net using low RC values. The timing accuracy is not reliable for such nets.}}"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"read_parasitics"},{"inherited":true,"name":"uuid","value":"6963d082-b8d1-4619-b0e9-25c2eb60e918"}],"name":"read_parasitics","parent_key":"flow:block .steps flow:sta","path":"sta/read_parasitics","previous":["6381a0c5-9b71-4c0e-bcb2-eac8a7c858b9","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc","326eaeca-bf43-4b00-821d-196a853ffd53","d5eaa64e-b4b4-4fe8-b924-0123928725a8","749e5fcf-6573-477d-b5c5-9f3d84a4902a","c38b5bdc-a30b-4bec-b7bb-b4707272db21","3bfcb3a2-715b-42b4-8462-e81333571e5b","c172dd39-ae6f-41ce-adce-7689f598e974","968bce55-4a6e-4c12-be5e-0fc8c212be91"],"real_end":1763135092.0,"real_start":1763135084.0,"snapshots":[],"total_cpu":20605.8,"total_cpu_user":18832.6,"uuid":"6963d082-b8d1-4619-b0e9-25c2eb60e918"},{"branch":"default","delta_cpu":3.46,"delta_cpu_not_child":3.46,"delta_cpu_user":3.17,"delta_cpu_user_not_child":3.17,"delta_real_not_child":3.0,"key":"flow:block .steps flow:sta .