ow.machine.swap.free","value":"3303932 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"7215.21 MB"},{"name":"flow.memory.instant","value":"7215.21 MB"},{"inherited":true,"name":"flow.memory.resident","value":"3931.9 MB"},{"name":"flow.memory.resident.instant","value":"3931.9 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"4807.29 MB"},{"name":"flow.memory.resident.peak.instant","value":"4807.29 MB"},{"inherited":true,"name":"flow.realtime","value":"13"},{"inherited":true,"name":"flow.realtime.not_child","value":"14"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763133963.0 1763133976.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763133963.0 1763133976.0}"},{"inherited":true,"name":"flow.realtime.total","value":"6435"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"set design  [get_db current_design .name]\n    set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]\n    if {![file exists $out_dir]} {\n\tfile mkdir $out_dir\n    }\n\n    # Export GDSII, no leaf cell data whatsoever\n    write_stream  -die_area_as_boundary  -format stream  -map_file [get_db flow_vars_gdsout_stream_map_file]  -unit 1000  -mode ALL  -pvs_fill  $out_dir/$design.hierarchical.gds.gz\n\n    # Export GDSII with macros from LEF-data\n    write_stream  -die_area_as_boundary  -format stream  -map_file [get_db flow_vars_gdsout_stream_map_file]  -output_macros  -unit 1000  -mode ALL  -pvs_fill  $out_dir/$design.output_macros.gds.gz\n\n    write_stream  -die_area_as_boundary  -format stream  -map_file [get_db flow_vars_gdsout_stream_map_file]  -unit 1000  -mode ALL  -pvs_fill  -merge [concat [get_db flow_vars_macro_gds_list] [get_db flow_vars_stdcell_gds_list] [get_db flow_vars_memory_gds_list] [get_db flow_vars_io_gds_list]]  -uniquify_cell_names  $out_dir/$design.merged.gds.gz\n\n    # write out LVS netlist\n    write_netlist -exclude_leaf_cells -exclude_insts_of_cells \"PAD73D6GU PAD73D6NU\" -include_phys_inst -include_pg_ports $out_dir/$design.lvs.v.gz\n\n    # write out LEC script to check that LVS netlist matches \"actual\" signoff netlist\n    write_do_lec  -flat  -golden_design $out_dir/$design.v.gz  -revised_design $out_dir/$design.lvs.v.gz  -log_file logs/lec.lvs.opt_signoff.log  lec.lvs.opt_signoff.do\n\n    # Export DEF\n    set_db write_def_include_lef_vias true\n    write_def -routing $out_dir/$design.def.gz\n    set_db write_def_include_lef_vias false"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"messages","value":"{count 1 id IMPOGDS-59 severity error short {The merge file '%s' does not exist.}} {count 3 id IMPOGDS-113 severity warn short {NO signoff PVS fill data setting in design, fill apply option is escaped.}} {count 1 id IMPOGDS-1171 severity warn short {Structure name %s too long(>32). 32 is limitation length of structure name in GDSII 3.0 which might be truncated in downstream tools, write_stream still keep the string length.}} {count 3 id IMPOGDS-1176 severity warn short {There are %d empty cells. Check innovus.log# for the details.\n  It is probably because your mapping file does not contain corresponding rules.\n  Use default mapping file(without option -mapFile) to output all information of a cell.}} {count 354 id IMPOGDS-1178 severity warn short {The GDSII cell '%s' is empty.}} {count 1 id IMPOGDS-215 severity warn short {Merge file : %s has larger units than output file units. You may have rounding problem.}} {count 2 id IMPOGDS-217 severity warn short {Master cell: %s not found in merged file(s) and will therefore not be included in the resulting write_stream file. Verify the file names specified with the -merge option are correct and that they contain a definition of this cell.}} {count 1 id IMPOGDS-218 severity warn short {Number of master cells not found after merging: %d}} {count 3 id IMPOGDS-250 severity warn short {Specified unit is smaller than the one in db. You may have rounding problems}} {count 1 id IMPOGDS-280 severity warn short {Maximum units in merge file is %d. Use -units %d to avoid rounding issue.}} {count 171 id IMPOGDS-391 severity warn short {Line %d: Object Type '%s' specified with layer '%s' is not legal. The map file maybe being a DFII/Virtuoso map file. For a list of legal object types refer to the map file syntax in the User Guide.}} {count 129 id IMPOGDS-392 severity warn short {Unknown layer %s}} {count 1 id IMPSYC-6363 severity warn short {%s is not existed.}}"},{"name":"messages.instant","value":"{count 1 id IMPOGDS-59 severity error short {The merge file '%s' does not exist.}} {count 3 id IMPOGDS-113 severity warn short {NO signoff PVS fill data setting in design, fill apply option is escaped.}} {count 1 id IMPOGDS-1171 severity warn short {Structure name %s too long(>32). 32 is limitation length of structure name in GDSII 3.0 which might be truncated in downstream tools, write_stream still keep the string length.}} {count 3 id IMPOGDS-1176 severity warn short {There are %d empty cells. Check innovus.log# for the details.\n  It is probably because your mapping file does not contain corresponding rules.\n  Use default mapping file(without option -mapFile) to output all information of a cell.}} {count 354 id IMPOGDS-1178 severity warn short {The GDSII cell '%s' is empty.}} {count 1 id IMPOGDS-215 severity warn short {Merge file : %s has larger units than output file units. You may have rounding problem.}} {count 2 id IMPOGDS-217 severit