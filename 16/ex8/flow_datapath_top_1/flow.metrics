ak","value":"4350.6 MB"},{"name":"flow.memory.resident.peak.instant","value":"4350.6 MB"},{"inherited":true,"name":"flow.realtime","value":"1"},{"inherited":true,"name":"flow.realtime.not_child","value":"1"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763126693.0 1763126694.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763126693.0 1763126694.0}"},{"inherited":true,"name":"flow.realtime.total","value":"60"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"foreach constr_mode [get_db flow_vars_constraint_modes] {\n\tset constr_files [list ]\n\tforeach sdc [get_db [get_db constraint_modes -if {.base_name==${constr_mode}}] .sdc_files] {\n\t    lappend constr_files $sdc\n\t}\n\tif {$constr_mode != \"func\"} {\n\t} else {\n\t    if {[is_flow -inside flow:syn_generic]} {\n\t\tlappend constr_files [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.hier_dft.tcl\n\t    }\n\t}\n\tupdate_constraint_mode -name $constr_mode -sdc_files $constr_files\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"23.15-s099_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-23.15-s099_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"messages","value":"{count 3 id message:TUI/TUI-61 severity Error short {A required object parameter could not be found.}} {count 7 id message:TIM/TIM-102 severity Info short {Removing a clock object.}} {count 3 id message:TIM/TIM-167 severity Info short {An external clock is being defined.}} {count 9 id message:TIM/TIM-307 severity Info short {Removing a timing exception.}} {count 7 id message:SDC/SDC-202 severity Error short 