MB"},{"inherited":true,"name":"flow.memory.resident","value":"5086.76 MB"},{"name":"flow.memory.resident.instant","value":"5086.76 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"5093.02 MB"},{"name":"flow.memory.resident.peak.instant","value":"5093.02 MB"},{"inherited":true,"name":"flow.realtime","value":"5"},{"inherited":true,"name":"flow.realtime.not_child","value":"5"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763134991.0 1763134996.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763134991.0 1763134996.0}"},{"inherited":true,"name":"flow.realtime.total","value":"6450"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"#- write dofile for LEC\n    if {[is_flow -inside flow:floorplan]} {\n\twrite_do_lec  -flat  -log_file [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  lec.[get_db flow_report_name].do\n    } else {\n\twrite_do_lec  -flat  -pre_compare [file join [string map [list %s [get_db current_design .name]] [get_db write_lec_directory_naming_style]] lec.[get_db flow_report_name].pre_compare]  -log_file [file join [get_db flow_log_directory] lec.[get_db flow_report_name].log]  lec.[get_db flow_report_name].do\n    }\n    \n    #- schedule the LEC flow\n    #FlowtoolPredictHint ArgumentRandomise -branch\n    schedule_flow  -flow lec  -branch [get_db flow_report_name]  -no_db  -no_sync  -tool_options \"-nogui -lp -do [file join [string map [list %s [get_db current_design .name]] [get_db write_lec_directory_naming_style]] lec.[get_db flow_report_name].do]\""},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"fl