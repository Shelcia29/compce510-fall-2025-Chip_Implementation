)\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"innovus_manage_derating"},{"inherited":true,"name":"uuid","value":"74ab7d1f-536b-4549-94bc-cc8ffa1d0621"}],"name":"innovus_manage_derating","parent_key":"flow:block .steps flow:floorplan","path":"floorplan/innovus_manage_derating","previous":["39b855cc-a569-4cc9-85e8-cdf9133666e5","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc"],"real_end":1763128018.0,"real_start":1763128016.0,"snapshots":[],"total_cpu":1150.75,"total_cpu_user":894.18,"uuid":"74ab7d1f-536b-4549-94bc-cc8ffa1d0621"},{"branch":"default","delta_cpu":1.97,"delta_cpu_not_child":1.97,"delta_cpu_user":1.82,"delta_cpu_user_not_child":1.82,"delta_real_not_child":2.0,"key":"flow:block .steps flow:floorplan .steps flow_step:create_path_groups","metrics":[{"name":"design.name","value":"datapath_top"},{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"1.97"},{"inherited":true,"name":"flow.cputime.not_child","value":"1.97"},{"inherited":true,"name":"flow.cputime.total","value":"1150.95"},{"inherited":true,"name":"flow.cputime.user","value":"1.82"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"1.82"},{"inherited":true,"name":"flow.cputime.user.total","value":"894.27"},{"name":"flow.db.starting","value":"cdb /home/student/16/ex8/flow_datapath_top_1/dbs/syn_opt.cdb datapath_to