 {\n\tif {[get_db $dpo .parent.name] != [get_db flow_vars_design_name]} {\n\t    set exit_loop false\n\t} else {\n\t    set exit_loop true\n\t}\n\twhile {!$exit_loop} {\n\t    set dpo [get_db $dpo .parent]\n\t    set_db $dpo .ungroup_ok false\n\t    if {[string first [string tolower [get_db flow_vars_design_name]] [string tolower [get_db $dpo .parent.name]]] == 0} {\n\t\tset exit_loop true\n\t    }\n\t}\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"23.15-s099_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-23.15-s099_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"genus_manage_ungrouping"},{"inherited":true,"name":"uuid","value":"667a21c4-9661-4e9d-8474-16d1957a9773"}],"name":"genus_manage_ungrouping","parent_key":"flow:block .steps flow:syn_generic","path":"syn_generic/genus_manage_ungrouping","previous":["8ea3c157-b482-44c7-bc0e-c5d2fa303265","169adade-4421-4afa-823b-ba1e3a6d30a7"],"real_end":1763126688.0,"real_start":1763126687.0,"snapshots":[],"total_cpu":40.0,"total_cpu_user":40.0,"uuid":"667a21c4-9661-4e9d-8474-16d1957a9773"},{"branch":"default","delta_cpu":1.0,"delta_cpu_not_child":1.0,"delta_cpu_user":1.0,"delta_cpu_user_not_child":1.0,"delta_real_not_child":2.0,"exclude_time_metric":true,"key":"flow:block .steps flow:syn_generic .steps flow_step:genus_uniquify_design","metrics":[{"name":"design.name","value":"datapath_top"},{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"1"},{"inherited":true,"name":"flow.cputime.not_child","value":"1"},{"inherited":true,"name":"flow.cputime.total","value":"40"},{"inherite