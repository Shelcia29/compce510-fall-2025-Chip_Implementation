tep:init_elaborate","metrics":[{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"1"},{"inherited":true,"name":"flow.cputime.not_child","value":"1"},{"inherited":true,"name":"flow.cputime.total","value":"14"},{"inherited":true,"name":"flow.cputime.user","value":"1"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"1"},{"inherited":true,"name":"flow.cputime.user.total","value":"14"},{"name":"flow.log","value":"/home/student/16/ex8/flow_datapath_top_1/logs/syn_generic.log"},{"name":"flow.machine","value":"ASIC-vm"},{"name":"flow.machine.cpu.frequency","value":"2112.001 Mhz"},{"name":"flow.machine.cpu.model","value":"12th Gen Intel(R) Core(TM) i7-12700"},{"name":"flow.machine.cpu.number","value":"8"},{"name":"flow.machine.hostname","value":"ASIC-vm"},{"name":"flow.machine.load","value":"1.64"},{"name":"flow.machine.memory.free","value":"160828 kB"},{"name":"flow.machine.memory.total","value":"16369280 kB"},{"name":"flow.machine.os","value":"Linux 4.18.0-553.69.1.el8_10.x86_64"},{"name":"flow.machine.swap.free","value":"4191484 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"605.977 MB"},{"name":"flow.memory.instant","value":"605.977 MB"},{"inherited":true,"name":"flow.memory.resident","value":"605.977 MB"},{"name":"flow.memory.resident.instant","value":"605.977 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"605.977 MB"},{"name":"flow.memory.resident.peak.instant","value":"605.977 MB"},{"inherited":true,"name":"flow.realtime","value":"1"},{"inherited":true,"name":"flow.realtime.not_child","value":"1"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763126656.0 1763126657.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763126656.0 1763126657.0}"},{"inherited":true,"name":"flow.realtime.total","value":"29"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"# Tool settings\n    set_db information_level 9\n    \n    # TL: Warns for each missing io port in def...\n    suppress_messages PHYS-156\n    # TL: Warns about multiple connections to power pins\n    suppress_messages PHYS-2381\n\n    # HDL attributes [get_db -category hdl]\n    #-------------------------------------------------------------------------------\n    if {![get_db flow_feature_disable_naming_rules]} {\n\tputs \"Info: Setting naming rules\"\n\tset_db hdl_array_naming_style %s_%d\n\tset_db hdl_instance_array_naming_style %s_%d\n\tset_db hdl_generate_index_style   %s_%d\n\tset_db hdl_generate_separator _\n\tset_db hdl_bus_wire_naming_style %s_%d\n\tset_db hdl_record_naming_style %s_%s\n    }\n    if {[get_feature -feature flow_express]} {\n\t# track RTL filename, row & column information for e.g. removed registers\n\tset_db hdl_track_filename_row_col true\n    }\n    set_db hdl_max_loop_limit 32768\n    # Add, TL. new variable because of LTEMOD rtl, new in genus 18.73 (not official release)\n    #set_db hdl_array_read_mux_opto true\n    # Don't use scan ports for functional stuff\n    set_db use_scan_seqs_for_non_dft \t\tfalse\n    # Do not optimize away any logic which has floating nets in RTL\n    set_db hdl_unconnected_value none\n    # Do not set top name to a monstrous string with all non-default parameter values\n    set_db hdl_parameterize_module_name false\n    # no ungrouping to see hierarchy areas\n    #set_db auto_ungroup none\n\n    # Note, TL: temp fix for \"interface signals using configurations bug\"\n    set_db hdl_link_hier_inst_across_hdl_libraries true"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"23.15-s099_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-23.15-s099_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"init_elaborate"},{"inherited":true,"name":"uuid","value":"71e305dd-5d60-4a34-a86b-94aaea131785"}],"name":"init_elaborate","parent_key":"flow:block .steps flow:syn_generic","path":"syn_generic/init_elaborate","previous":["77c96972-ce22-47b5-babf-e0cec5cb0520","169adade-4421-4afa-823b-ba1e3a6d30a7"],"real_end":1763126657.0,"real_start":1763126656.0,"snapshots":[],"total_cpu":14.0,"total_cpu_user":14.0,"uuid":"71e305dd-5d60-4a34-a86b-94aaea131785"},{"branch":"default","delta_cpu":4.0,"delta_cpu_not_child":2.0,"delta_cpu_user":4.0,"delta_cpu_user_not_child":2.0,"delta_real_not_child":3.0,"key":"flow:block .steps flow:syn_generic .steps flow_step:elaborate_design","metrics":[{"name":"design.name","value":"datapath_top"},{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"4"},{"inherited":true,"name":"flow.cputime.total","value":"18"},{"inherited":true,"name":"flow.cputime.user","value":"4"},{"inherited":true,"name":"flow.cputime.user.total","value":"18"},{"inherited":true,"name":"flow.last_child_snapshot","value":"elaborate"},{"name":"flow.log","value":"/home/student/16/ex8/flow_datapath_top_1/logs/syn_generic.log"},{"name":"flow.machine","value":"ASIC-vm"},{"name":"flow.machine.cpu.frequency","value":"2112.001 Mhz"},{"name":"flow.machine.cpu.model","value":"12th Gen Intel(R) Core(TM) i7-12700"},{"name":"flow.machine.cpu.number","value":"8"},{"name":"flow.machine.hostname","value":"ASIC-vm"},{"name":"flow.machine.load","value":"3.19"},{"name":"flow.machine.memory.free","value":"1007132 kB"},{"name":"flow.machine.memory.total","value":"16369280 kB"},{"name":"flow.machine.os","value":"Linux 4.18.0-553.69.1.el8_10.x86_64"},{"name":"flow.machine.swap.free","value":"4190972 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"770.951 MB"},{"name":"flow.memory.instant","value":"770.951 MB"},{"inherited":true,"name":"flow.memory.resident","value":"770.951 MB"},{"name":"flow.memory.resident.instant","value":"770.951 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"770.951 MB"},{"name":"flow.memory.resident.peak.instant","value":"770.951 MB"},{"inherited":true,"name":"flow.realtime","value":"4"},{"inherited":true,"name":"flow.realtime.not_child","value":"3"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763126657.0 1763126661.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763126657.0 1763126661.0}"},{"inherited":true,"name":"flow.realtime.total","value":"33"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"if {[get_db current_design] eq \"\"} {\n\t#- setup library information\n\tglobal mmmc_vars\n\tif {[file exists scripts/mmmc_config.tcl]} {\n\t    read_mmmc             scripts/mmmc_config.tcl\n\t} else {\n\t    read_mmmc             [get_db flow_source_directory]/mmmc_config.tcl\n\t}\n\tread_physical         -lef [get_db flow_vars_lef_list]\n\t\n\t#- read and elaborate design\n\t#read_hdl\n\tif {[file exists scripts/compile_[get_db flow_vars_design_name].tcl]} {\n\t    puts \"\\nInfo: Sourcing scripts/compile_[get_db flow_vars_design_name].tcl\"\n\t    source scripts/compile_[get_db flow_vars_design_name].tcl\n\t    puts \"\\n\"\n\t} else {\n\t    puts \"\\nFatal: Compile-script not found! (scripts/compile_[get_db flow_vars_design_name].tcl)\"\n\t    puts \"             Run make create_genustech\\n\"\n\t    exit\n\t}\n\n\t# Check for non-default parameters for toplevel\n\tset topname [get_db flow_vars_design_name]\n\tif {[get_db flow_vars_design_top] != \"\"} {\n\t    set topname [get_db flow_vars_design_top]\n\t}\n\tif {[get_db flow_vars_elaboration_parameters] != \"\"} {\n\t    elaborate -parameters \"[get_db flow_vars_elaboration_parameters]\" ${topname}\n\t} else {\n\t    elaborate ${topname}\n\t}\n\t\n\t# possible post-elaborate step\n\tif {[file exists scripts/post_elaborate.tcl]} {\n\t    puts \"\\nInfo: Sourcing scripts/post_elaborate.tcl\"\n\t    source scripts/post_elaborate.tcl\n\t    puts \"\\n\"\n\t} elseif {[file exists [get_db flow_source_directory]/post_elaborate.tcl]} {\n\t    puts \"\\nInfo: Sourcing [get_db flow_source_directory]/post_elaborate.tcl\"\n\t    source [get_db flow_source_directory]/post_elaborate.tcl\n\t    puts \"\\n\"\n\t}\n\t\n\t# report macros after elaboration to see if linking is ok\n\tputs \"\\nInfo: All macros in design:\"\n\tget_db insts -if {.is_macro==true} -foreach {puts [get_db $object .name]}\n\tputs \"\\n\"\n\t\n\t\n\t# print memories into a text file (/reports folder)\n\tset fp [open [get_db flow_report_directory]/[get_db flow_vars_design_name].memories.txt w]\n\tif {[llength [get_db insts -if {.is_memory}]] > 0} {\n\t    get_db insts -if {.is_memory} -foreach {puts $fp \"[get_db $object .name] : [get_db $object .base_cell.name]\"}\n\t} else {\n\t    puts $fp \"no memories found\"\n\t}\n\t\n\tclose $fp\n    }\n\n    if {![get_db flow_feature_disable_naming_rules]} {\n\twrite_db -to_file [get_db flow_database_directory]/syn_generic.elaborate_design.db\n    }\n\n    report_messages -warning > [get_db flow_report_directory]/elaboration/report_messages_warnings.txt\n    report_messages -error > [get_db flow_report_directory]/elaboration/report_messages_errors.txt\n    check_design -multiple_driver -unresolved -undriven > [get_db flow_report_directory]/elaboration/check_design_fatal.txt\n    check_design -unloaded -unloaded_comb > [get_db flow_report_directory]/elaboration/check_design_unloaded.txt\n    check_design -combo_loops > [get_db flow_report_directory]/elaboration/check_design_combo_loops.txt"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"23.15-s099_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-23.15-s099_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"messages","value":"{count 4 id message:LBR/LBR-518 severity Info short {Missing a function attribute in the output pin definition.}} {count 7 id message:LBR/LBR-40 severity Info short {An unsupported construct was detected in this library.}} {count 7 id message:LBR/LBR-415 severity Info short {Unusable library cells found at the time of loading a library.}} {count 16 id message:LBR/LBR-141 severity Warning short {Clock function definition makes cell unusable.}} {count 20 id message:LBR/LBR-9 severity Warning short {Library cell has no output pins defined.}} {count 100 id message:LBR/LBR-41 severity Info short {An output library pin lacks a function attribute.}} {count 3 id message:LBR/LBR-412 severity Info short {Created nominal operating condition.}} {count 1 id message:LBR/LBR-161 severity Info short {Setting the maximum print count of this message to 10 if information_level is less than 9.}} {count 124 id message:LBR/LBR-162 severity Info short {Both 'pos_unate' and 'neg_unate' timing_sense arcs have been processed.}} {count 528 id message:LBR/LBR-155 severity Info short {Mismatch in unateness between 'timing_sense' attribute and the function.}} {count 8 id message:LBR/LBR-72 severity Info short {Detected an unsupported timing arc type.}} {count 1 id message:LBR/LBR-109 severity Info short {Set default library domain.}} {count 99 id message:ELABUTL/ELABUTL-124 severity Warning short {Unconnected instance input port detected.}} {count 103 id message:ELABUTL/ELABUTL-132 severity Info short {Unused instance port.}} {count 96 id message:PHYS/PHYS-279 severity Warning short {Physical cell not defined in library.}} {count 119 id message:PHYS/PHYS-129 severity Info short {Via with no resistance will have a value of '0.0' assigned for resistance value.}} {count 1 id message:ELAB/ELAB-1 severity Info short {Elaborating Design.}} {count 5 id message:ELAB/ELAB-2 severity Info short {Elaborating Subdesign.}} {count 1 id message:ELAB/ELAB-3 severity Info short {Done Elaborating Design.}} {count 2 id message:CWD/CWD-19 severity Info short {An implementation was inferred.}} {count 2 id message:CWD/CWD-36 severity Info short {Sorted the set of valid implementations for synthetic operator.}} {count 3 id message:VLOGPT/VLOGPT-679 severity Info short {Definition of macro.}} {count 7 id message:CDFG/CDFG-250 severity Info short {Processing multi-dimensional arrays.}} {count 6 id message:CDFG/CDFG-303 severity Info short {Processing HDL design.}} {count 90 id message:CDFG/CDFG-425 severity Info short {Instantiated design.}} {count 90 id message:CDFG/CDFG-426 severity Info short {Searching for library cell.}} {count 1 id message:CDFG/CDFG-466 severity Warning short {Connected signal is wider than libpin.}} {count 2 id message:CDFG/CDFG-500 severity Info short {Unused module input port.}} {count 85 id message:CDFG/CDFG-567 severity Info short {Instantiating Subdesign.}} {count 6 id message:CDFG/CDFG-742 severity Info short {Common subexpression elimination.}} {count 1 id message:CDFG/CDFG-818 severity Warning short {Using default parameter value for module elaboration.}} {count 6 id message:CDFG2G/CDFG2G-110 severity Info short {Finished processing module.}}"},{"name":"messages.instant","value":"{count 4 id message:LBR/LBR-518 severity Info short {Missing a function attribute in the output pin definition.}} {count 7 id message:LBR/LBR-40 severity Info short {An unsupported construct was detected in this library.}} {count 7 id message:LBR/LBR-415 severity Info short {Unusable library cells found at the time of loading a library.}} {count 16 id message:LBR/LBR-141 severity Warning short {Clock function definition makes cell unusable.}} {count