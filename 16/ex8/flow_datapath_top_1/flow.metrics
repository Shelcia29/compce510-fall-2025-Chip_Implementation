_config root:]\n    } else {\n    }\n    foreach key [dict keys $flow_root_config] {\n\tif {[string length [dict get $flow_root_config $key]] > 200} {\n\t    dict set flow_root_config $key \"\\[long value truncated\\]\"\n\t}\n    }\n    set_metric -name flow.root_config -value $flow_root_config"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"23.15-s099_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-23.15-s099_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"block_finish"},{"inherited":true,"name":"uuid","value":"640983bd-70a0-4739-99b1-f69de5893aee"}],"name":"block_finish","parent_key":"flow:block .steps flow:syn_opt","path":"syn_opt/block_finish","previous":["c04839fd-e9d2-4b61-8500-166db8a93661","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371"],"real_end":1763127821.0,"real_start":1763127820.0,"snapshots":[{"branch":"default","delta_cpu":28.0,"delta_cpu_not_child":28.0,"delta_cpu_user":28.0,"delta_cpu_user_not_child":28.0,"delta_real_not_child":39.0,"exclude_time_metric":true,"key":"flow:block .steps flow:syn_opt .steps flow_step:block_finish {.write_db write_db}","metrics":[{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"28"},{"inherited":true,"name":"flow.cputime.not_child","value":"28"},{"inherited":true,"name":"flow.cputime.total","value":"1118.65"},{"inherited":true,"name":"flow.cputime.user","value":"28"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"28"},{"inherited":true,"name":"flow.cputime.user.total","value":"873.04"},{"name":