763135092.0 1763135095.0}"},{"inherited":true,"name":"flow.realtime.total","value":"6506"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"if {0} {\n    # only set functional mode clock uncertainties\n    set_interactive_constraint_modes [get_db constraint_modes -if {(.is_setup||.is_hold) && .name==*func*} -u]\n    set clock_names [get_db -u [get_db clocks -if {.base_name!=*_virtual}] .base_name]\n\n    global mmmc_vars\n    # Note TL: Fix these. Clock uncertainties are corner specific, not mode specific\n    if {[is_flow -quiet -after flow:opt_signoff] || [is_flow -quiet -inside flow:opt_signoff] ||\n\t[is_flow -quiet -after flow:sta] || [is_flow -quiet -inside flow:sta]} {\n\tset stp 0.085\n\tset hld 0.050\n    } elseif {[is_flow -quiet -after flow:floorplan] || [is_flow -quiet -inside flow:floorplan]} {\n\tset stp 0.105\n\tset hld 0.065\n    } elseif {[is_flow -quiet -after flow:syn_generic] || [is_flow -quiet -inside flow:syn_generic]} {\n\tset stp 0.105\n\tset hld 0.065\n    } else {\n\tputs \"Error([info script]): flow step out of bounds (syn_generic <-> floorplan <-> sta)\"\n    }\n\n    puts \"Info([info script]): Setting setup uncertainty to $stp, hold uncertainty to $hld\"\n    foreach clock_name $clock_names {\n\tset_clock_uncertainty -setup $stp [get_clocks $clock_name]\n\tset_clock_uncertainty -hold $hld [get_clocks $clock_name]\n\n\tif {[llength [get_db clocks -if \".base_name==${clock_name}_virtual && .view_name==*func\"]]} {\n\t    set_clock_uncertainty -setup $stp [get_clocks ${clock_name}_virtual]\n\t    set_clock_uncertainty -setup $stp -from [get_clocks ${clock_name}_virtual] -to   [get_clocks $clock_name]\n\t    set_clock_uncertainty -setup $stp -to   [get_clocks ${clock_name}_virtual] -from [get_clocks $clock_name]\n\t    set_clock_uncertainty -hold $hld [get_clocks ${clock_name}_virtual]\n\t}\n    }\n    set_interactive_constraint_modes {}\n}"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Tempus Timing Solution"},{"name":"flow.tool.name.short","value":"tempus"},{"name":"flow.tool.version","value":"23.15-s108_1"},{"inherited":true,"name":"flow.tool_list","value":"tempus-23.15-s108_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"manage_uncertainty"},{"inherited":true,"name":"uuid","value":"92bd7eb2-a9a9-4e93-b843-20447854810b"}],"name":"manage_uncertainty","parent_key":"flow:block .steps flow:sta","path":"sta/manage_uncertainty","previous":["6963d082-b8d1-4619-b0e9-25c2eb60e918","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc","326eaeca-bf43-4b00-821d-196a853ffd53","d5eaa64e-b4b4-4fe8-b924-0123928725a8","749e5fcf-6573-477d-b5c5-9f3d84a4902a","c38b5bdc-a30b-4bec-b7bb-b4707272db21","3bfcb3a2-715b-42b4-8462-e81333571e5b","c172dd39-ae6f-41ce-adce-7689f598e974","968bce55-4a6e-4c12-be5e-0fc8c212be91"],"real_end":1763135095.0,"real_start":1763135092.0,"snapshots":[],"total_cpu":20609.3,"total_cpu_user":18835.8,"uuid":"92bd7eb2-a9a9-4e93-b843-20447854810b"},{"branch":"default","delta_cpu":3.44,"delta_cpu_not_child":3.44,"delta_cpu_user":3.12,"delta_cpu_user_not_child":3.12,"delta_real_not_child":4.0,"exclude_time_metric":true,"key":"flow:block .steps flow:sta .steps flow_step:tempus_manage_derating","metrics":[{"name":"design.name","value":"datapath_top"},{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"3.44"},{"inherited":true,"name":"flow.cputime.not_child","value":"3.44"},{"inherited":true,"name":"flow.cputime.total","value":"20612.7"},{"inherited":true,"name":"flow.cputime.user","value":"3.12"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"3.12"},{"inherited":true,"name":"flow.cputime.user.total","value":"18838.9"},{"name":"flow.db.starting","value":"tcl /home/student/16/ex8/flow_datapath_top_1/dbs/opt_signoff/init_sta.tcl . {}"},{"name":"flow.exclude_time_metric","value":"1"},{"name":"flow.log","value":"/home/student/16/ex8/flow_datapath_top_1/logs/sta.log"},{"name":"flow.machine","value":"ASIC-vm"},{"name":"flow.machine.cpu.frequency","value":"2112.001 Mhz"},{"name":"flow.machine.cpu.model","value":"12th Gen Intel(R) Core(TM) i7-12700"},{"name":"flow.machine.cpu.number","value":"8"},{"name":"flow.machine.hostname","value":"ASIC-vm"},{"name":"flow.machine.load","value":"1.11"},{"name":"flow.machine.memory.free","value":"6410920 kB"},{"name":"flow.machine.memory.total","value":"16369280 kB"},{"name":"flow.machine.os","value":"Linux 4.18.0-553.69.1.el8_10.x86_64"},{"name":"flow.machine.swap.free","value":"3686396 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"4468.89 MB"},{"name":"flow.memory.instant","value":"4468.89 MB"},{"inherited":true,"name":"flow.memory.resident","value":"3215.07 MB"},{"name":"flow.memory.resident.instant","value":"3215.07 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"3337.57 MB"},{"name":"flow.memory.resident.peak.instant","value":"3337.57 MB"},{"inherited":true,"name":"flow.realtime","value":"3"},{"inherited":true,"name":"flow.realtime.not_child","value":"4"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763135096.0 1763135099.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763135096.0 1763135099.0}"},{"inherited":true,"name":"flow.realtime.total","value":"6509"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"global mmmc_vars\n    foreach active_av [get_db [get_db analysis_views -if {.is_setup || .is_hold}] .name] {\n\t# SOCV RC variation\n\tset_socv_rc_variation_factor -view ${active_av} -late  $mmmc_vars(late_rc_variation_factor)\n\tset_socv_rc_variation_factor -view ${active_av} -early $mmmc_vars(early_rc_variation_factor)\n\n    }\n\n    set_socv_reporting_nsigma_multiplier -hold $mmmc_vars(timing_socv_analysis_nsigma_multiplier)  -setup $mmmc_vars(timing_socv_analysis_nsigma_multiplier) -views [get_db [get_db analysis_views -if {.is_setup || .is_hold}] .name]\n\n    foreach dc [get_db [get_db delay_corners] .name] {\n        regexp {([^_]+)_([^_]+)_([^_]+)_([\\w]+)} $dc -> corn volt temp rc\n\n        # If rc-corner name ends in _T it is a setup corner\n        if {[regexp {_T$} $rc]} {\n            # For setup only derate capturing clock -> early\n            set_timing_derate -add -clock -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},socv_clock_cell_early)\n        } else {\n            if {[regexp {ss} $corn]} {\n                # For hold in SS derate launching clock and data\n                set_timing_derate -add -data  -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},socv_data_cell_early)\n                set_timing_derate -add -clock -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},socv_clock_cell_early)\n            } else {\n                # For hold in FF only derate capturing clock -> late\n                set_timing_derate -add -clock -cell_delay -late  -delay_corner ${dc} $mmmc_vars(${dc},socv_clock_cell_late)\n            }\n        }\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Tempus Timing Solution"},{"name":"flow.tool.name.short","value":"tempus"},{"name":"flow.tool.version","value":"23.15-s108_1"},{"inherited":true,"name":"flow.tool_list","value":"tempus-23.15-s108_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"nam