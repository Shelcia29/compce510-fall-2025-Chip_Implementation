arly -max_paths 1   -nworst 1 -path_type full_clock -net > [get_db flow_report_directory]/[get_db flow_report_name]/hold.worst.rpt\n    report_timing -early -max_paths 500 -nworst 1 -path_type full_clock      > [get_db flow_report_directory]/[get_db flow_report_name]/hold.gba.rpt\n    \n    #- Reports that show detailed timing with Path Based Analysis (PBA)\n    if {[is_flow -quiet -inside flow:sta]} {\n\treport_timing -early -max_paths 50 -nworst 1 -path_type full_clock -retime path_slew_propagation  > [get_db flow_report_directory]/[get_db flow_report_name]/hold.pba.rpt\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"report_early_paths"},{"inherited":true,"name":"uuid","value":"b02d5d24-89bf-450b-8ec2-7364ef936057"}],"name":"report_early_paths","parent_key":"flow:block .steps flow:opt_signoff .steps flow:report_postroute","path":"opt_signoff/report_postroute/report_early_paths","previous":["d73a07f4-8121-4096-9480-eed12537b81a","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc","326eaeca-bf43-4b00-821d-196a853ffd53","d5eaa64e-b4b4-4fe8-b924-0123928725a8","749e5fcf-6573-477d-b5c5-9f3d84a4902a","c38b5bdc-a30b-4bec-b7bb-b4707272db21","3bfcb3a2-715b-42b4-8462-e81333571e5b","c172dd39-ae6f-41ce-adce-7689f598e974"],"real_end":1763134459.0,"real_start":1763134455.0,"snapshots":[],"total_cpu":20558.5,"total_cpu_user":18794.9,"uuid":"b02d5d24