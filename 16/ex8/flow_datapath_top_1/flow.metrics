oad","value":"2.38"},{"name":"flow.machine.memory.free","value":"3270472 kB"},{"name":"flow.machine.memory.total","value":"16369280 kB"},{"name":"flow.machine.os","value":"Linux 4.18.0-553.69.1.el8_10.x86_64"},{"name":"flow.machine.swap.free","value":"3899644 kB"},{"name":"flow.machine.swap.total","value":"4194300 kB"},{"inherited":true,"name":"flow.memory","value":"3017.05 MB"},{"name":"flow.memory.instant","value":"3017.05 MB"},{"inherited":true,"name":"flow.memory.resident","value":"2977.36 MB"},{"name":"flow.memory.resident.instant","value":"2977.36 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"2977.43 MB"},{"name":"flow.memory.resident.peak.instant","value":"2977.43 MB"},{"inherited":true,"name":"flow.realtime","value":"2"},{"inherited":true,"name":"flow.realtime.not_child","value":"2"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763128014.0 1763128016.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763128014.0 1763128016.0}"},{"inherited":true,"name":"flow.realtime.total","value":"1198"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"if {0} {\n    # only set functional mode clock uncertainties\n    set_interactive_constraint_modes [get_db constraint_modes -if {(.is_setup||.is_hold) && .name==*func*} -u]\n    set clock_names [get_db -u [get_db clocks -if {.base_name!=*_virtual}] .base_name]\n\n    global mmmc_vars\n    # Note TL: Fix these. Clock uncertainties are corner specific, not mode specific\n    if {[is_flow -quiet -after flow:opt_signoff] || [is_flow -quiet -inside flow:opt_signoff] ||\n\t[is_flow -quiet -after flow:sta] || [is_flow -quiet -inside flow:sta]} {\n\tset stp 0.085\n\tset hld 0.050\n    } elseif {[is_flow -quiet -after flow:floorplan] || [is_flow -quiet -inside flow:floorplan]} {\n\tset stp 0.105\n\tset hld 0.065\n    } elseif {[is_flow -quiet -after flow:syn_generic] || [is_flow -quiet -inside flow:syn_generic]} {\n\tset stp 0.105\n\tset hld 0.065\n    } else {\n\tputs \"Error([info script]): flow step out of bounds (syn_generic <-> floorplan <-> sta)\"\n    }\n\n    puts \"Info([info script]): Setting setup uncertainty to $stp, hold uncertainty to $hld\"\n    foreach clock_name $clock_names {\n\tset_clock_uncertainty -setup $stp [get_clocks $clock_name]\n\tset_clock_uncertainty -hold $hld [get_clocks $clock_name]\n\n\tif {[llength [get_db clocks -if \".base_name==${clock_name}_virtual && .view_name==*func\"]]} {\n\t    set_clock_uncertainty -setup $stp [get_clocks ${clock_name}_virtual]\n\t    set_clock_uncertainty -setup $stp -from [get_clocks ${clock_name}_virtual] -to   [get_clocks $clock_name]\n\t    set_clock_uncertainty -setup $stp -to   [get_clocks ${clock_name}_virtual] -from [get_clocks $clock_name]\n\t    set_clock_uncertainty -hold $hld [get_clocks ${clock_name}_virtual]\n\t}\n    }\n    set_interactive_constraint_modes {}\n}"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"manage_uncertainty"},{"inherited":true,"name":"uuid","value":"39b855cc-a569-4cc9-85e8-cdf9133666e5"}],"name":"manage_uncertainty","parent_key":"flow:block .steps flow:floorplan","path":"floorplan/manage_uncertainty","previous":["58c56a22-7f06-4871-a79b-7f5be605cd07","169adade-4421-4afa-823b-ba1e3a6d30a7","8de45006-2138-4f30-b928-cadf4694531a","bb0873dd-c343-4613-b5a4-e30a38738371","0e507ed1-78c3-4987-af3a-20782ca0f1bc"],"real_end":1763128016.0,"real_start":1763128014.0,"snapshots