"name":"flow.memory.instant","value":"2889.87 MB"},{"inherited":true,"name":"flow.memory.resident","value":"2878.18 MB"},{"name":"flow.memory.resident.instant","value":"2878.18 MB"},{"inherited":true,"name":"flow.memory.resident.peak","value":"2878.18 MB"},{"name":"flow.memory.resident.peak.instant","value":"2878.18 MB"},{"inherited":true,"name":"flow.realtime","value":"2"},{"inherited":true,"name":"flow.realtime.not_child","value":"2"},{"inherited":true,"name":"flow.realtime.self_slice","value":"1763130190.0 1763130192.0"},{"inherited":true,"name":"flow.realtime.slices","value":"{1763130190.0 1763130192.0}"},{"inherited":true,"name":"flow.realtime.total","value":"2835"},{"name":"flow.run_directory","value":"/home/student/16/ex8/flow_datapath_top_1"},{"name":"flow.step.tcl","value":"# disable ULVT cells until postroute\n    if {[get_db flow_feature_dont_use_ulvt]} {\n\tif {[is_flow -before flow:postroute]} {\n\t    set_db [get_db base_cells -if {.lib_cells.library.name==*ulvt*}] .dont_use true\n\t} else {\n\t    set_db [get_db base_cells -if {.lib_cells.library.name==*ulvt*}] .dont_use false\n\t}\n    }\n\n    foreach dont_use_expr [get_db flow_vars_dont_use_list] {\n        set_db [get_db base_cells -if {*}${dont_use_expr}] .dont_use true\n    }"},{"name":"flow.template.feature_enabled","value":"report_lec synth_spatial opt_early_cts opt_signoff add_scan pnr_db_handoff"},{"name":"flow.template.type","value":"block"},{"name":"flow.tool.name","value":"Innovus Implementation System"},{"name":"flow.tool.name.short","value":"innovus"},{"name":"flow.tool.version","value":"23.15-s106_1"},{"inherited":true,"name":"flow.tool_list","value":"innovus-23.15-s106_1"},{"name":"flow.user","value":"student"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"set_dont_use"},{"inherited":true,"name":"uuid","value":"a1885530-3743-4cc9-a36e-39916d840f95"}],"name":"set_dont_use","parent_key":"flow:block .steps flo