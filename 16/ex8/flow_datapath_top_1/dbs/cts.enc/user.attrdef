proc jls::sanity_check_for_xreplay_dump_annotation_info {obj args} {



  # assure that specified value is ok
  set args_str  {*}$args
  set vals [split $args_str " "]
  set pin_type {in out clock enable all}
  set annotation_type {asserted unasserted unconnected non_toggle all}
  set obj_type {port port_dft seq comb reg reg_dft mem mem_dft icgc latch bbox pad pm mux drivers rtl_drivers all}
  #format for show_details option for report_sdb_annotation: <obj_type>[:<annotation_type>[:<pin_prop_type>]]
  foreach val $vals {
      set show_details_value [split $val ":"]
      set length [llength $show_details_value]
      if { $length > 0 && ( [llength [lsearch -all $obj_type [lindex $show_details_value 0] ] ] == 0) } {
          puts "Error   : Invalid $val is given for attribute xreplay_dump_annotation_info." 
          return 0
      }
      if { $length > 1 && ( [llength [lsearch -all $annotation_type [lindex $show_details_value 1] ] ] == 0) } {
          puts "Error   : Invalid $val is given for attribute xreplay_dump_annotation_info." 
          return 0
      }
      if { $length > 2 && ( [llength [lsearch -all $pin_type [lindex $show_details_value 2] ] ] == 0) } {
          puts "Error   : Invalid $val is given for attribute xreplay_dump_annotation_info." 
          return 0
      }
  }
  return 1
}
define_attribute xreplay_dump_annotation_info -data_type string -obj_type root -category joules -help_string {Attribute will pass arguments to xreplay_stimulus command.} -check_function {jls::sanity_check_for_xreplay_dump_annotation_info} -hidden -quiet
define_attribute xreplay_extra_options -data_type string -obj_type root -category joules -help_string {Attribute will pass arguments to xreplay command.} -hidden -quiet
proc jls::ckattr_xrun_exe {obj args} {



  # assure that specified executable is ok
  if {[auto_execok $args] eq ""} {
    jls::puts_send "Can not find specified executable: $args"
    return 0
  }
  return 1
}
