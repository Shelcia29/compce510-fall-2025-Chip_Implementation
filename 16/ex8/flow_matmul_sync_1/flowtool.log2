syn_map:#@ Begin verbose source ./scripts/local_macro_setup.tcl
syn_map:@file(local_macro_setup.tcl) 10: if {1} {
syn_map:array unset global_macro_exportdir
syn_map:
syn_map:set macro_scan_abstract_filelist [list ]
syn_map:set macro_lef_filelist [list ]
syn_map:
syn_map:
syn_map:array unset memarray
syn_map:
syn_map:# Go through global settings for macros and see if there's a local override
syn_map:foreach {blockname blockpath} [array get global_macro_exportdir] {
syn_map:
syn_map:    # do not read in a model for DUT
syn_map:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
syn_map:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
syn_map:	continue
syn_map:    }
syn_map:
syn_map:    if {[info exists local_macro_exportdir($blockname)]} {
syn_map:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
syn_map:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
syn_map:	    puts "\#OLD\#: $blockpath"
syn_map:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
syn_map:	    set $blockpath $local_macro_exportdir($blockname)
syn_map:	}
syn_map:    }
syn_map:
syn_map:    # scan abstract for DFT
syn_map:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
syn_map:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
syn_map:    } else {
syn_map:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
syn_map:    }
syn_map:
syn_map:    # MACROs
syn_map:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
syn_map:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
syn_map:    } else {
syn_map:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
syn_map:	exit 1
syn_map:    }
syn_map:
syn_map:    # Read .lib -files
syn_map:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
syn_map:    foreach dc $mmmc_vars(delay_corners) {
syn_map:
syn_map:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_map:
syn_map:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_map:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_map:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_map:	} else {
syn_map:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
syn_map:	    exit 1
syn_map:	}
syn_map:    }
syn_map:}
syn_map:# sanity check to see if global setting are missing block which are defined in local settings!
syn_map:foreach {blockname blockpath} [array get local_macro_exportdir] {
syn_map:    # do not read in a model for DUT
syn_map:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
syn_map:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
syn_map:	continue
syn_map:    }
syn_map:
syn_map:    set found 0
