postroute:@flow 19: foreach key [dict keys $flow_root_config] {
postroute:	if {[string length [dict get $flow_root_config $key]] > 200} {
postroute:	    dict set flow_root_config $key "\[long value truncated\]"
postroute:	}
postroute:    }
postroute:@@flow 24: set_metric -name flow.root_config -value $flow_root_config
postroute:#@ End verbose flow_step postroute.block_finish
