syn_generic:########################################################################
syn_generic:# Memories
syn_generic:########################################################################
syn_generic:
syn_generic:set memory_gds_filelist [list]
syn_generic:set memory_spi_filelist [list]
syn_generic:foreach {memdir memlist} [array get memarray] {
syn_generic:
syn_generic:    set mem_directory ./models
syn_generic:    foreach mem $memlist {
syn_generic:
syn_generic:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
syn_generic:
syn_generic:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
syn_generic:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
syn_generic:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
syn_generic:
syn_generic:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
syn_generic:
syn_generic:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
syn_generic:
syn_generic:        foreach dc $mmmc_vars(delay_corners) {
syn_generic:
syn_generic:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_generic:
syn_generic:	    if {[regexp {SS} $dc]} {
syn_generic:		set volt "0P720V"
syn_generic:		set temp "125C"
syn_generic:	    } else {
syn_generic:		set volt "0P880V"
syn_generic:		set temp "M40C"
syn_generic:	    }
syn_generic:	    
syn_generic:
syn_generic:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
syn_generic:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
syn_generic:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
syn_generic:        }
syn_generic:    }
syn_generic:}
