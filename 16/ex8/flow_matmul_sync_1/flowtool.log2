cts:#@ Begin verbose flow_step activate_views
cts:@flow 2: set db [get_db flow_starting_db]
cts:@flow 3: set flow [lindex [get_db flow_hier_path] end]
cts:@flow 4: set setup_views [get_feature $flow -feature setup_views]
cts:@flow 5: set hold_views [get_feature $flow -feature hold_views]
cts:@flow 6: set leakage_view [get_feature $flow -feature leakage_view]
cts:@flow 7: set dynamic_view [get_feature $flow -feature dynamic_view]
cts:@flow 9: if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {...}
cts:#@ End verbose flow_step activate_views
cts:##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan generate_models opt_signoff}
cts:#@ Begin verbose flow_step init_mcpu
cts:@flow 2: # Multi host/cpu attributes
cts:@flow 3: #-----------------------------------------------------------------------------
cts:@flow 4: # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
cts:@flow 5: # the specified dist script.  This connects the number of CPUs being reserved
cts:@flow 6: # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
cts:@flow 7: # a typical environment variable exported by distribution platforms and is
cts:@flow 8: # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
cts:@flow 9: if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
cts:@flow 10: set max_cpus $::env(FLOWTOOL_NUM_CPUS)
cts:@flow 11: }
cts:@flow 17: switch -glob {innovus} {
cts:@@flow 0: set_multi_cpu_usage -verbose -local_cpu   $max_cpus
cts:**WARN: (PRL-39):	Number of local CPUs specified (16) > Actual number of CPUs in the host (8). The lower value will be used.
cts:set_multi_cpu_usage -local_cpu 8
cts:@flow 1: if {[get_feature -feature opt_signoff]} {
cts:@flow 2: if {[is_flow -inside flow:opt_signoff]} {...}
cts:@flow 6: }
cts:@flow 7: if {[get_feature -feature sta_eco]} {...}
cts:@flow 13: }
cts:#@ End verbose flow_step init_mcpu
