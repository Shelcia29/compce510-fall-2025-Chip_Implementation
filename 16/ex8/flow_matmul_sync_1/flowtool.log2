route:#@ Begin verbose flow_step activate_views
route:@flow 2: set db [get_db flow_starting_db]
route:@flow 3: set flow [lindex [get_db flow_hier_path] end]
route:@flow 4: set setup_views [get_feature $flow -feature setup_views]
route:@flow 5: set hold_views [get_feature $flow -feature hold_views]
route:@flow 6: set leakage_view [get_feature $flow -feature leakage_view]
route:@flow 7: set dynamic_view [get_feature $flow -feature dynamic_view]
route:@flow 9: if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {...}
