syn_map:    #- Extend flow report name based on context
syn_map:    if {[is_flow -quiet -inside flow:sta] || [is_flow -quiet -inside flow:sta_dmmmc] || [is_flow -quiet -inside flow:sta_eco]} {
syn_map:	if {![regexp {sta$} [get_db flow_report_name]]} {
syn_map:	    set_db flow_report_name [expr {[string is space [get_db flow_report_name]] ? "sta" : "[get_db flow_report_name].sta"}]
syn_map:	}
syn_map:    } elseif {[is_flow -quiet -inside flow:ir_early_static] || [is_flow -quiet -inside flow:ir_early_dynamic]} {
syn_map:	if {![regexp {era$} [get_db flow_report_name]]} {
syn_map:	    set_db flow_report_name [expr {[string is space [get_db flow_report_name]] ? "era" : "[get_db flow_report_name].era"}]
syn_map:	}
syn_map:    } elseif {[is_flow -quiet -inside flow:ir_grid] || [is_flow -quiet -inside flow:ir_static] || [is_flow -quiet -inside flow:ir_dynamic] || [is_flow -quiet -inside flow:ir_rampup]} {
syn_map:	if {![regexp {ir$} [get_db flow_report_name]]} {
syn_map:	    set_db flow_report_name [expr {[string is space [get_db flow_report_name]] ? "ir" : "[get_db flow_report_name].ir"}]
syn_map:	}
syn_map:    } elseif {[regexp {block_start|hier_start|eco_start} [get_db flow_step_current]]} {
syn_map:	set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]
syn_map:    } else {
syn_map:    }
syn_map:
syn_map:    #- Create report directory (if necessary)
syn_map:    file mkdir [file normalize [file join [get_db flow_report_directory] [get_db flow_report_name]]]
