postroute:@file 174: foreach myAttr [dict keys $flow_vars] {
postroute:  if { ![is_attribute -obj_type root $myAttr]} {
postroute:    define_attribute $myAttr \
postroute:      -category user_flow \
postroute:      -data_type [dict get $flow_vars $myAttr type] \
postroute:      -default [dict get $flow_vars $myAttr default] \
postroute:      -help_string [dict get $flow_vars $myAttr description] \
postroute:      -obj_type root
postroute:    }
postroute:}
