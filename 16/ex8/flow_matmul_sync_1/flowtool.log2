opt_signoff:#@ Begin verbose flow_step opt_signoff.innovus_manage_derating
opt_signoff:@flow 3: # socv not implemented yet
opt_signoff:@flow 4: if {0} {...}
opt_signoff:@flow 12: global mmmc_vars
opt_signoff:@flow 13: foreach setup_dc [get_db [get_db delay_corners -if {.is_setup || .is_hold}] .name] {
opt_signoff:	# Cell OCV
opt_signoff:	# Data
opt_signoff:	set_timing_derate -data  -cell_delay -early -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_data_cell_early)
opt_signoff:	set_timing_derate -data  -cell_delay -late  -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_data_cell_late)
opt_signoff:	# Clock
opt_signoff:	set_timing_derate -clock -cell_delay -early -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_clock_cell_early)
opt_signoff:	set_timing_derate -clock -cell_delay -late  -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_clock_cell_late)
opt_signoff:	
opt_signoff:	# Wire OCV
opt_signoff:	# Data
opt_signoff:	set_timing_derate -data  -net_delay  -early -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_data_net_early)
opt_signoff:	set_timing_derate -data  -net_delay  -late  -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_data_net_late)
opt_signoff:	# Clock
opt_signoff:	set_timing_derate -clock -net_delay  -early -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_clock_net_early)
opt_signoff:	set_timing_derate -clock -net_delay  -late  -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_clock_net_late)
opt_signoff:    }
