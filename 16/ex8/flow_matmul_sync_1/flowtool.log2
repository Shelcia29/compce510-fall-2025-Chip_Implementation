opt_signoff:#@ Begin verbose flow_step opt_signoff.write_lec_constraints
opt_signoff:@flow 2: # Innovus scan lec constraints
opt_signoff:@flow 3: file mkdir  [file join [string map [list %s [get_db current_design .name]] [get_db write_lec_directory_naming_style]]]
opt_signoff:@flow 4: set FH [open [file join [string map [list %s [get_db current_design .name]] [get_db write_lec_directory_naming_style]] lec.[get_db flow_report_name].pre_compare] "w"]
opt_signoff:@flow 6: foreach pin [get_db [get_db ports {scan_enable* WRSTN* WEXT}] .name] {
opt_signoff:        puts $FH "add_pin_constraints 0 \{$pin\} -both"
opt_signoff:    }
opt_signoff:@flow 9: foreach pin [get_db [get_db [get_db insts {*lockup_latch* *lockup_flop*}] .pins -if {.base_name==D}] .name] {
opt_signoff:        puts $FH "add_primary_input \{$pin\} -both"
opt_signoff:        puts $FH "add_ignored_inputs \{$pin\} -both"
opt_signoff:    }
opt_signoff:@flow 13: foreach mc [get_db -u [get_db insts -if {.is_memory}] .base_cell] {
opt_signoff:        foreach msp [get_db $mc .base_pins.base_name *si*] {
opt_signoff:            puts $FH "add_ignored_inputs \{$msp\} -module [get_db $mc .base_name] -both"
opt_signoff:        }
opt_signoff:    }
opt_signoff:@flow 18: foreach cb [get_db -u [get_db insts -if {.is_macro && !.is_memory}] .base_cell] {
opt_signoff:        foreach msp [get_db $cb .base_pins.base_name *scan_in*] {
opt_signoff:            puts $FH "add_ignored_inputs \{$msp\} -module [get_db $cb .base_name] -both"
opt_signoff:        }
opt_signoff:    }
opt_signoff:@flow 24: close $FH
opt_signoff:#@ End verbose flow_step opt_signoff.write_lec_constraints
opt_signoff:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
