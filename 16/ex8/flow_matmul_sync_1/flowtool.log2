floorplan:@flow 25: # merge .libs to one single multimode file
floorplan:@flow 26: foreach corner_name [get_db -u [get_db analysis_views -if {.is_setup||.is_hold||.is_leakage||.is_dynamic}] .delay_corner.name] {
floorplan:
floorplan:	set constraint_modes [join [get_db -u analysis_views .constraint_mode.name] ","]
floorplan:	set files [glob models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}_{${constraint_modes}}.lib]
floorplan:	if {![llength $files]} {
floorplan:	    puts "Error: No files corresponding to corner: ${corner_name} and constraint_modes: ${constraint_modes} in models/[get_db flow_report_name]/"
floorplan:	    continue
floorplan:	}
floorplan:	set mode_list [list ]
floorplan:	set mode_group ""
floorplan:	foreach ff $files {
floorplan:	    set mode ""
floorplan:	    set cmodes [regsub -all "," $constraint_modes "|"]
floorplan:	    if {![regexp "_(${cmodes})\.lib" $ff -> mode]} {
floorplan:		puts "Error: Bad filename $ff"
floorplan:		continue
floorplan:	    }
floorplan:	    lappend mode_list $mode
floorplan:	    if {$mode_group == ""} {
floorplan:		set mode_group $mode
floorplan:	    } else {
floorplan:		set mode_group ${mode_group}_${mode}
floorplan:	    }
floorplan:	}
floorplan:
floorplan:	merge_model_timing -input_library_file $files  -mode_group $mode_group  -modes $mode_list  -merged_library_file models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}.lib
floorplan:    }
