cts:@@flow 3: set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]
cts:@flow 5: if {[get_feature pnr_db_handoff] && [is_flow -quiet -inside flow:syn_opt]} {...
cts:@flow 7: } else {
cts:@@flow 8: set_db flow_write_db_common false
cts:@flow 9: }
cts:@flow 11: #- Store non-default root attributes to metrics
cts:@flow 12: catch {report_obj -tcl} flow_root_config
cts:@flow 13: if {[dict exists $flow_root_config root:/]} {
cts:@flow 14: set flow_root_config [dict get $flow_root_config root:/]
cts:@flow 15: }
cts:@flow 19: foreach key [dict keys $flow_root_config] {
cts:	if {[string length [dict get $flow_root_config $key]] > 200} {
cts:	    dict set flow_root_config $key "\[long value truncated\]"
cts:	}
cts:    }
cts:@@flow 24: set_metric -name flow.root_config -value $flow_root_config
cts:#@ End verbose flow_step cts.block_finish
