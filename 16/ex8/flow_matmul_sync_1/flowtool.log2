floorplan:Warning: Overriding project mmmc setup from local folder
floorplan:Info: Sourcing scripts/mmmc_setup.tcl
floorplan:#@ Begin verbose source scripts/mmmc_setup.tcl (pre)
floorplan:@file 1: ##############################################################################
floorplan:@file 2: # Project level Mode & Corner definitions
floorplan:@file 3: ##############################################################################
floorplan:@file 4: # Time-stamp: <2025-09-23 16:49:18 qftele>
floorplan:@file 5:
floorplan:@file 6: set MMMC_SETUP_VERSION "v1.0"
floorplan:@file 7: # $TECHNOLOGY is set in tech_setup.tcl
floorplan:@file 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
floorplan:Info: MMMC SETUP: gpdk045 : v1.0
floorplan:@file 9:
floorplan:@file 10: # Delay corner list
floorplan:@file 11: set mmmc_vars(delay_corners) \
floorplan:    [list \
floorplan:	 slow_0p9v_125c_cmax \
floorplan:	 fast_1p1v_0c_cmin \
floorplan:	 ]
floorplan:@file 16:
floorplan:@file 17:
floorplan:@file 18: # Read .lib -files
floorplan:@file 19: foreach dc $mmmc_vars(delay_corners) {
floorplan:
floorplan:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
floorplan:
floorplan:    # qrc techfile
floorplan:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
floorplan:    # temperature
floorplan:    if {${temp} == "m40c"} {
floorplan:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
floorplan:    } elseif {${temp} == "125c"} {
floorplan:	set mmmc_vars("${rc}_${temp}",temperature) "125"
floorplan:    } elseif {${temp} == "0c"} {
floorplan:	set mmmc_vars("${rc}_${temp}",temperature) "0"
floorplan:    } else {
floorplan:	set mmmc_vars("${rc}_${temp}",temperature) "25"
floorplan:    }
floorplan:
floorplan:
floorplan:    ###########################################
floorplan:    # OCVs &  Clock uncertainties for FLAT OCV
floorplan:    ###########################################
floorplan:
floorplan:    # use following uncertainties
floorplan:    # FUNC:
floorplan:    # setup:
floorplan:    # clock jitter: defined through clock cycle
floorplan:    # TECH uncertainty: 25ps
floorplan:    # extra uncertainty (implementation): 20ps
floorplan:    # extra uncertainty (signoff STA): 0ps
floorplan:    # hold:
floorplan:    # TECH uncertainty (SSG): 50ps
floorplan:    # TECH uncertainty (fast): 40ps
floorplan:    # extra uncertainty (implementation): 15ps
floorplan:    # extra uncertainty (signoff STA): 0ps
floorplan:
floorplan:    # Note, add 1% OCV on top of previous to match LVF
floorplan:    # so flat values below have 0.01 added (subtracted) because of this
floorplan:
floorplan:    # setup in slow, 0.81v, -40C/125c, cmax
floorplan:    if {$corn eq "slow" &&
floorplan:	$volt eq "0p9v" &&
floorplan:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
floorplan:	($rc eq "cmax")} {
floorplan:	
floorplan:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
floorplan:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
floorplan:	# +2.0% for launching clock cell
floorplan:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
floorplan:	# hold not checked in this corner
floorplan:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
floorplan:	# + 6.9% on data cell
floorplan:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
floorplan:
floorplan:	# -6.0% for clock net
floorplan:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
floorplan:	# +6.0% for clock net
floorplan:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
floorplan:	# hold not checked in this corner
floorplan:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
floorplan:	# +6.0 for data net
floorplan:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
floorplan:
floorplan:    # hold in slow, 0.81v, -40c/125c, cmax
floorplan:    } elseif {$corn eq "slow" &&
floorplan:	      $volt eq "0p9v" &&
floorplan:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
floorplan:	      ($rc eq "cmax")} {
floorplan:	
floorplan:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
floorplan:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
floorplan:	# +3.2% for capturing clock cell
floorplan:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
floorplan:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
floorplan:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
floorplan:	# setup not checked
floorplan:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
floorplan:
floorplan:	# -8.5% for launching clock net
floorplan:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
floorplan:	# no derate on capturing clock net
floorplan:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
floorplan:	# -8.5% for data net
floorplan:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
floorplan:	# setup not checked
floorplan:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
floorplan:
floorplan:    # hold in fast, 0.99v, -40c/0c/125c, cmax
floorplan:    } elseif {$corn eq "fast" &&
floorplan:	      $volt eq "1p1v" &&
floorplan:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
floorplan:	      ($rc eq "cmax")} {
floorplan:	
floorplan:	# -3.7% for launching clock cell
floorplan:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
floorplan:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
floorplan:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
floorplan:	# -12.1% for data
floorplan:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
floorplan:	# setup not checked
floorplan:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
floorplan:
floorplan:	# -8.5% for launching clock net
floorplan:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
floorplan:	# no derate on capturing clock net
floorplan:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
floorplan:	# -8.5% for data net
floorplan:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
floorplan:	# setup not checked
floorplan:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
floorplan:
floorplan:    # hold in fast, 0.99v, -40c/0c/125c, cmin
floorplan:    } elseif {$corn eq "fast" &&
floorplan:	      $volt eq "1p1v" &&
floorplan:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
floorplan:	      ($rc eq "cmin")} {
floorplan:	
floorplan:	# -3.7% for launching clock cell
floorplan:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
floorplan:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
floorplan:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
floorplan:	# -12.1% for data
floorplan:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
floorplan:	# setup not checked
floorplan:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
floorplan:
floorplan:	# no derate on launching clock net
floorplan:	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
floorplan:	# +8.5% for capturing clock net
floorplan:	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
floorplan:	# no derate for data net
floorplan:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
floorplan:	# setup not checked
floorplan:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
floorplan:
floorplan:    } else {
floorplan:	puts "Fatal: delay corner ${dc} OCVs not defined (corner: $corn, voltage: $volt, temperature: $temp, rc: ${rc})"
floorplan:	exit 1
floorplan:    }
floorplan:
floorplan:    ###########################################
floorplan:    # OCVs &  Clock uncertainties for SOCV
floorplan:    ###########################################
floorplan:
floorplan:    # Note, only voltage and temperature OCVs needed
floorplan:
floorplan:    # Early & late variation factors from:
floorplan:    set mmmc_vars(early_rc_variation_factor) 0.06
floorplan:    set mmmc_vars(late_rc_variation_factor) 0.06
floorplan:
floorplan:    set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
floorplan:
floorplan:    # slow, 0.81v, -40c
floorplan:    if {$corn eq "slow" &&
floorplan:	$volt eq "0p9v" &&
floorplan:	$temp eq "m40c"} {
floorplan:        
floorplan:        # DATA  @ 20.3mV : 7.4%
floorplan:        # DATA  @ 10c    : 0.9%
floorplan:        # CLOCK @ 20.3mV : 5.4%
floorplan:        # CLOCK @ 10c    : 0.7%
floorplan:
floorplan:        # For setup only derate clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
floorplan:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
floorplan:        # For hold in slow derate data & launching clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
floorplan:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
floorplan:
floorplan:    } elseif {$corn eq "slow" &&
floorplan:	$volt eq "0p9v" &&
floorplan:	$temp eq "125c"} {
floorplan:       
floorplan:        # DATA  @ 20.3mV : 5.0%
floorplan:        # DATA  @ 10c    : 0.3%
floorplan:        # CLOCK @ 20.3mV : 3.5%
floorplan:        # CLOCK @ 10c    : 0.2%
floorplan:
floorplan:        # For setup only derate clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
floorplan:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
floorplan:        # For hold in slow derate data & launching clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
floorplan:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
floorplan:
floorplan:    } elseif {$corn eq "slow" &&
floorplan:	$volt eq "0p9v" &&
floorplan:	$temp eq "0c"} {
floorplan:       
floorplan:        # DATA  @ 20.3mV : 6.6%
floorplan:        # DATA  @ 10c    : 0.8%
floorplan:        # CLOCK @ 20.3mV : 4.9%
floorplan:        # CLOCK @ 10c    : 0.6%
floorplan:
floorplan:        # For setup only derate clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
floorplan:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
floorplan:        # For hold in slow derate data & launching clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
floorplan:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
floorplan:
floorplan:    } elseif {$corn eq "fast" &&
floorplan:	$volt eq "1p1v" &&
floorplan:	$temp eq "m40c"} {
floorplan:       
floorplan:        # DATA  @ 45mV   : 7.4%
floorplan:        # DATA  @ 10c    : 0.5%
floorplan:        # CLOCK @ 45mV   : 5.1%
floorplan:        # CLOCK @ 10c    : 0.6%
floorplan:
floorplan:        # For setup only derate clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
floorplan:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
floorplan:        # For hold in slow derate data & launching clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
floorplan:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
floorplan:
floorplan:     } elseif {$corn eq "fast" &&
floorplan:	$volt eq "1p1v" &&
floorplan:	$temp eq "125c"} {
floorplan:
floorplan:        # DATA  @ 45mV   : 5.8%
floorplan:        # DATA  @ 10c    : 0.5%
floorplan:        # CLOCK @ 45mV   : 3.6%
floorplan:        # CLOCK @ 10c    : 0.6%
floorplan:
floorplan:        # For setup only derate clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
floorplan:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
floorplan:        # For hold in slow derate data & launching clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
floorplan:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
floorplan:
floorplan:    } elseif {$corn eq "fast" &&
floorplan:	$volt eq "1p1v" &&
floorplan:	$temp eq "0c"} {
floorplan:
floorplan:        # DATA  @ 45mV   : 7.0%
floorplan:        # DATA  @ 10c    : 0.4%
floorplan:        # CLOCK @ 45mV   : 4.7%
floorplan:        # CLOCK @ 10c    : 0.4%
floorplan:
floorplan:        # For setup only derate clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
floorplan:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
floorplan:        # For hold in slow derate data & launching clock
floorplan:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
floorplan:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
floorplan:
floorplan:     } else {
floorplan:        puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
floorplan:        exit 1
floorplan:    }
floorplan:}
