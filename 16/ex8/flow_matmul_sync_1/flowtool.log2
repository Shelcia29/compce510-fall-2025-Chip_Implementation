syn_opt:@flow_step(add_scan_logic) 40:     # connect shift enable signal to AICG TE-pins (can be done only after design is uniquified)
syn_opt:@flow_step(add_scan_logic) 41:     # go through all instantiated cgs
syn_opt:@flow_step(add_scan_logic) 42:     set_db ui_respects_preserve false
syn_opt:  Setting attribute of root '/': 'ui_respects_preserve' = false
syn_opt:@flow_step(add_scan_logic) 43:     foreach icg_inst [get_db [get_db insts -if {.base_name==inst_TLATNTSCAX*}] .name] {
syn_opt:                               	disconnect [get_db pins $icg_inst/TE]
syn_opt:                               	connect [get_db ports scan_enable_[get_db flow_vars_design_name]] [get_db pins $icg_inst/TE] -prefix DFT_AICG_TE_scan_enable_[get_db flow_vars_design_name]_
syn_opt:                                   }
syn_opt:@flow_step(add_scan_logic) 47:     set_db ui_respects_preserve true
syn_opt:  Setting attribute of root '/': 'ui_respects_preserve' = true
syn_opt:#@ End verbose flow_step syn_opt.add_scan_logic
