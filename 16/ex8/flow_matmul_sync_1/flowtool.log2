postroute:Info: Sourcing scripts/mmmc_setup.tcl
postroute:#@ Begin verbose source scripts/mmmc_setup.tcl (pre)
postroute:@file 1: ##############################################################################
postroute:@file 2: # Project level Mode & Corner definitions
postroute:@file 3: ##############################################################################
postroute:@file 4: # Time-stamp: <2025-09-23 16:49:18 qftele>
postroute:@file 5:
postroute:@file 6: set MMMC_SETUP_VERSION "v1.0"
postroute:@file 7: # $TECHNOLOGY is set in tech_setup.tcl
postroute:@file 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
postroute:Info: MMMC SETUP: gpdk045 : v1.0
postroute:@file 9:
postroute:@file 10: # Delay corner list
postroute:@file 11: set mmmc_vars(delay_corners) \
postroute:    [list \
postroute:	 slow_0p9v_125c_cmax \
postroute:	 fast_1p1v_0c_cmin \
postroute:	 ]
postroute:@file 16:
postroute:@file 17:
postroute:@file 18: # Read .lib -files
postroute:@file 19: foreach dc $mmmc_vars(delay_corners) {
postroute:
postroute:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postroute:
postroute:    # qrc techfile
postroute:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
postroute:    # temperature
postroute:    if {${temp} == "m40c"} {
postroute:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
postroute:    } elseif {${temp} == "125c"} {
postroute:	set mmmc_vars("${rc}_${temp}",temperature) "125"
postroute:    } elseif {${temp} == "0c"} {
postroute:	set mmmc_vars("${rc}_${temp}",temperature) "0"
postroute:    } else {
postroute:	set mmmc_vars("${rc}_${temp}",temperature) "25"
postroute:    }
postroute:
postroute:
postroute:    ###########################################
postroute:    # OCVs &  Clock uncertainties for FLAT OCV
postroute:    ###########################################
postroute:
postroute:    # use following uncertainties
postroute:    # FUNC:
postroute:    # setup:
postroute:    # clock jitter: defined through clock cycle
postroute:    # TECH uncertainty: 25ps
postroute:    # extra uncertainty (implementation): 20ps
postroute:    # extra uncertainty (signoff STA): 0ps
postroute:    # hold:
postroute:    # TECH uncertainty (SSG): 50ps
postroute:    # TECH uncertainty (fast): 40ps
postroute:    # extra uncertainty (implementation): 15ps
postroute:    # extra uncertainty (signoff STA): 0ps
postroute:
postroute:    # Note, add 1% OCV on top of previous to match LVF
postroute:    # so flat values below have 0.01 added (subtracted) because of this
postroute:
postroute:    # setup in slow, 0.81v, -40C/125c, cmax
postroute:    if {$corn eq "slow" &&
postroute:	$volt eq "0p9v" &&
postroute:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
postroute:	($rc eq "cmax")} {
postroute:	
postroute:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
postroute:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
postroute:	# +2.0% for launching clock cell
postroute:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
postroute:	# hold not checked in this corner
postroute:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
postroute:	# + 6.9% on data cell
postroute:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
postroute:
postroute:	# -6.0% for clock net
postroute:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
postroute:	# +6.0% for clock net
postroute:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
postroute:	# hold not checked in this corner
postroute:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
postroute:	# +6.0 for data net
postroute:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
postroute:
postroute:    # hold in slow, 0.81v, -40c/125c, cmax
postroute:    } elseif {$corn eq "slow" &&
postroute:	      $volt eq "0p9v" &&
postroute:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
postroute:	      ($rc eq "cmax")} {
postroute:	
postroute:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
postroute:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
postroute:	# +3.2% for capturing clock cell
postroute:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
postroute:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
postroute:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
postroute:	# setup not checked
postroute:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
postroute:
postroute:	# -8.5% for launching clock net
postroute:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
postroute:	# no derate on capturing clock net
postroute:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
postroute:	# -8.5% for data net
postroute:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
postroute:	# setup not checked
postroute:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
postroute:
postroute:    # hold in fast, 0.99v, -40c/0c/125c, cmax
postroute:    } elseif {$corn eq "fast" &&
postroute:	      $volt eq "1p1v" &&
postroute:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
postroute:	      ($rc eq "cmax")} {
postroute:	
postroute:	# -3.7% for launching clock cell
postroute:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
postroute:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
postroute:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
postroute:	# -12.1% for data
postroute:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
postroute:	# setup not checked
postroute:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
postroute:
postroute:	# -8.5% for launching clock net
postroute:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
postroute:	# no derate on capturing clock net
postroute:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
postroute:	# -8.5% for data net
postroute:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
postroute:	# setup not checked
postroute:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
postroute:
postroute:    # hold in fast, 0.99v, -40c/0c/125c, cmin
postroute:    } elseif {$corn eq "fast" &&
postroute:	      $volt eq "1p1v" &&
postroute:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
postroute:	      ($rc eq "cmin")} {
postroute:	
postroute:	# -3.7% for launching clock cell
postroute:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
postroute:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
postroute:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
postroute:	# -12.1% for data
postroute:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
postroute:	# setup not checked
postroute:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
postroute:
postroute:	# no derate on launching clock net
postroute:	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
postroute:	# +8.5% for capturing clock net
postroute:	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
postroute:	# no derate for data net
postroute:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
postroute:	# setup not checked
postroute:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
postroute:
postroute:    } else {
postroute:	puts "Fatal: delay corner ${dc} OCVs not defined (corner: $corn, voltage: $volt, temperature: $temp, rc: ${rc})"
postroute:	exit 1
postroute:    }
postroute:
postroute:    ###########################################
postroute:    # OCVs &  Clock uncertainties for SOCV
postroute:    ###########################################
postroute:
postroute:    # Note, only voltage and temperature OCVs needed
postroute:
postroute:    # Early & late variation factors from:
postroute:    set mmmc_vars(early_rc_variation_factor) 0.06
postroute:    set mmmc_vars(late_rc_variation_factor) 0.06
postroute:
postroute:    set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
postroute:
postroute:    # slow, 0.81v, -40c
postroute:    if {$corn eq "slow" &&
postroute:	$volt eq "0p9v" &&
postroute:	$temp eq "m40c"} {
postroute:        
postroute:        # DATA  @ 20.3mV : 7.4%
postroute:        # DATA  @ 10c    : 0.9%
postroute:        # CLOCK @ 20.3mV : 5.4%
postroute:        # CLOCK @ 10c    : 0.7%
postroute:
postroute:        # For setup only derate clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
postroute:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postroute:        # For hold in slow derate data & launching clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
postroute:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
postroute:
postroute:    } elseif {$corn eq "slow" &&
postroute:	$volt eq "0p9v" &&
postroute:	$temp eq "125c"} {
postroute:       
postroute:        # DATA  @ 20.3mV : 5.0%
postroute:        # DATA  @ 10c    : 0.3%
postroute:        # CLOCK @ 20.3mV : 3.5%
postroute:        # CLOCK @ 10c    : 0.2%
postroute:
postroute:        # For setup only derate clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
postroute:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postroute:        # For hold in slow derate data & launching clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
postroute:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
postroute:
postroute:    } elseif {$corn eq "slow" &&
postroute:	$volt eq "0p9v" &&
postroute:	$temp eq "0c"} {
postroute:       
postroute:        # DATA  @ 20.3mV : 6.6%
postroute:        # DATA  @ 10c    : 0.8%
postroute:        # CLOCK @ 20.3mV : 4.9%
postroute:        # CLOCK @ 10c    : 0.6%
postroute:
postroute:        # For setup only derate clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
postroute:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postroute:        # For hold in slow derate data & launching clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
postroute:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
postroute:
postroute:    } elseif {$corn eq "fast" &&
postroute:	$volt eq "1p1v" &&
postroute:	$temp eq "m40c"} {
postroute:       
postroute:        # DATA  @ 45mV   : 7.4%
postroute:        # DATA  @ 10c    : 0.5%
postroute:        # CLOCK @ 45mV   : 5.1%
postroute:        # CLOCK @ 10c    : 0.6%
postroute:
postroute:        # For setup only derate clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
postroute:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postroute:        # For hold in slow derate data & launching clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
postroute:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
postroute:
postroute:     } elseif {$corn eq "fast" &&
postroute:	$volt eq "1p1v" &&
postroute:	$temp eq "125c"} {
postroute:
postroute:        # DATA  @ 45mV   : 5.8%
postroute:        # DATA  @ 10c    : 0.5%
postroute:        # CLOCK @ 45mV   : 3.6%
postroute:        # CLOCK @ 10c    : 0.6%
postroute:
postroute:        # For setup only derate clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
postroute:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postroute:        # For hold in slow derate data & launching clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
postroute:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
postroute:
postroute:    } elseif {$corn eq "fast" &&
postroute:	$volt eq "1p1v" &&
postroute:	$temp eq "0c"} {
postroute:
postroute:        # DATA  @ 45mV   : 7.0%
postroute:        # DATA  @ 10c    : 0.4%
postroute:        # CLOCK @ 45mV   : 4.7%
postroute:        # CLOCK @ 10c    : 0.4%
postroute:
postroute:        # For setup only derate clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
postroute:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
postroute:        # For hold in slow derate data & launching clock
postroute:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
postroute:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
postroute:
postroute:     } else {
postroute:        puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
postroute:        exit 1
postroute:    }
postroute:}
postroute:@file 272:
postroute:@file 273: # Constraint mode list
postroute:@file 274: set mmmc_vars(constraint_modes) [get_db flow_vars_constraint_modes]
postroute:@file 275:
postroute:@file 276: foreach cm $mmmc_vars(constraint_modes) {
postroute:    if {[get_db program_short_name] == "genus"} {
postroute:#	if {${cm} == "func"} {
postroute:	    set mmmc_vars(${cm},sdc_files) [list [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.${cm}.tcl \
postroute:						[get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].boundary_conditions.tcl \
postroute:						]
postroute:#	} else {
postroute:#	    set mmmc_vars(${cm},sdc_files) [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.dummy.tcl
postroute:#	}
postroute:    } else {
postroute:	if {${cm} == "func"} {
postroute:	    set mmmc_vars(${cm},sdc_files) [list [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.${cm}.tcl \
postroute:						[get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].boundary_conditions.tcl \
postroute:						[get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.hier_dft.tcl \
postroute:						]
postroute:	} else {
postroute:	    set mmmc_vars(${cm},sdc_files) [list [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.${cm}.tcl \
postroute:						[get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].boundary_conditions.tcl \
postroute:						]
postroute:	}
postroute:    }
postroute:}
postroute:#@ End verbose source scripts/mmmc_setup.tcl
postroute:Warning: Overriding project library setup from local folder
postroute:Info: Sourcing scripts/library_setup.tcl
postroute:#@ Begin verbose source scripts/library_setup.tcl (pre)
postroute:@file 1: ################################################################################
postroute:@file 2: # Project level Library setup
