postcts:##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan generate_models opt_signoff}
postcts:#@ Begin verbose flow_step activate_views
postcts:@flow 2: set db [get_db flow_starting_db]
postcts:@flow 3: set flow [lindex [get_db flow_hier_path] end]
postcts:@flow 4: set setup_views [get_feature $flow -feature setup_views]
postcts:@flow 5: set hold_views [get_feature $flow -feature hold_views]
postcts:@flow 6: set leakage_view [get_feature $flow -feature leakage_view]
postcts:@flow 7: set dynamic_view [get_feature $flow -feature dynamic_view]
postcts:@flow 9: if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {...}
postcts:#@ End verbose flow_step activate_views
postcts:##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan generate_models opt_signoff}
postcts:#@ Begin verbose flow_step init_mcpu
postcts:@flow 2: # Multi host/cpu attributes
postcts:@flow 3: #-----------------------------------------------------------------------------
postcts:@flow 4: # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
postcts:@flow 5: # the specified dist script.  This connects the number of CPUs being reserved
postcts:@flow 6: # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
postcts:@flow 7: # a typical environment variable exported by distribution platforms and is
postcts:@flow 8: # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
postcts:@flow 9: if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
postcts:@flow 10: set max_cpus $::env(FLOWTOOL_NUM_CPUS)
postcts:@flow 11: }
postcts:@flow 17: switch -glob {innovus} {
postcts:@@flow 0: set_multi_cpu_usage -verbose -local_cpu   $max_cpus
postcts:**WARN: (PRL-39):	Number of local CPUs specified (16) > Actual number of CPUs in the host (8). The lower value will be used.
postcts:set_multi_cpu_usage -local_cpu 8
postcts:@flow 1: if {[get_feature -feature opt_signoff]} {
postcts:@flow 2: if {[is_flow -inside flow:opt_signoff]} {...}
postcts:@flow 6: }
postcts:@flow 7: if {[get_feature -feature sta_eco]} {...}
postcts:@flow 13: }
postcts:#@ End verbose flow_step init_mcpu
postcts:End steps for plugin point Cadence.plugin.flowkit.read_db.pre
