opt_signoff:Warning: Overriding project mmmc setup from local folder
opt_signoff:Info: Sourcing scripts/mmmc_setup.tcl
opt_signoff:#@ Begin verbose source scripts/mmmc_setup.tcl (pre)
opt_signoff:@file 1: ##############################################################################
opt_signoff:@file 2: # Project level Mode & Corner definitions
opt_signoff:@file 3: ##############################################################################
opt_signoff:@file 4: # Time-stamp: <2025-09-23 16:49:18 qftele>
opt_signoff:@file 5:
opt_signoff:@file 6: set MMMC_SETUP_VERSION "v1.0"
opt_signoff:@file 7: # $TECHNOLOGY is set in tech_setup.tcl
opt_signoff:@file 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
opt_signoff:Info: MMMC SETUP: gpdk045 : v1.0
opt_signoff:@file 9:
opt_signoff:@file 10: # Delay corner list
opt_signoff:@file 11: set mmmc_vars(delay_corners) \
opt_signoff:    [list \
opt_signoff:	 slow_0p9v_125c_cmax \
opt_signoff:	 fast_1p1v_0c_cmin \
opt_signoff:	 ]
opt_signoff:@file 16:
opt_signoff:@file 17:
opt_signoff:@file 18: # Read .lib -files
opt_signoff:@file 19: foreach dc $mmmc_vars(delay_corners) {
opt_signoff:
opt_signoff:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
opt_signoff:
opt_signoff:    # qrc techfile
opt_signoff:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
opt_signoff:    # temperature
opt_signoff:    if {${temp} == "m40c"} {
opt_signoff:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
opt_signoff:    } elseif {${temp} == "125c"} {
opt_signoff:	set mmmc_vars("${rc}_${temp}",temperature) "125"
opt_signoff:    } elseif {${temp} == "0c"} {
opt_signoff:	set mmmc_vars("${rc}_${temp}",temperature) "0"
opt_signoff:    } else {
opt_signoff:	set mmmc_vars("${rc}_${temp}",temperature) "25"
opt_signoff:    }
opt_signoff:
opt_signoff:
opt_signoff:    ###########################################
opt_signoff:    # OCVs &  Clock uncertainties for FLAT OCV
opt_signoff:    ###########################################
opt_signoff:
opt_signoff:    # use following uncertainties
opt_signoff:    # FUNC:
opt_signoff:    # setup:
opt_signoff:    # clock jitter: defined through clock cycle
opt_signoff:    # TECH uncertainty: 25ps
opt_signoff:    # extra uncertainty (implementation): 20ps
opt_signoff:    # extra uncertainty (signoff STA): 0ps
opt_signoff:    # hold:
opt_signoff:    # TECH uncertainty (SSG): 50ps
opt_signoff:    # TECH uncertainty (fast): 40ps
opt_signoff:    # extra uncertainty (implementation): 15ps
opt_signoff:    # extra uncertainty (signoff STA): 0ps
opt_signoff:
opt_signoff:    # Note, add 1% OCV on top of previous to match LVF
opt_signoff:    # so flat values below have 0.01 added (subtracted) because of this
opt_signoff:
opt_signoff:    # setup in slow, 0.81v, -40C/125c, cmax
opt_signoff:    if {$corn eq "slow" &&
opt_signoff:	$volt eq "0p9v" &&
opt_signoff:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
opt_signoff:	($rc eq "cmax")} {
opt_signoff:	
opt_signoff:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
opt_signoff:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
opt_signoff:	# +2.0% for launching clock cell
opt_signoff:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
opt_signoff:	# hold not checked in this corner
opt_signoff:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
opt_signoff:	# + 6.9% on data cell
opt_signoff:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
opt_signoff:
opt_signoff:	# -6.0% for clock net
opt_signoff:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
opt_signoff:	# +6.0% for clock net
opt_signoff:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
opt_signoff:	# hold not checked in this corner
opt_signoff:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
opt_signoff:	# +6.0 for data net
opt_signoff:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
opt_signoff:
opt_signoff:    # hold in slow, 0.81v, -40c/125c, cmax
opt_signoff:    } elseif {$corn eq "slow" &&
opt_signoff:	      $volt eq "0p9v" &&
opt_signoff:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
opt_signoff:	      ($rc eq "cmax")} {
opt_signoff:	
opt_signoff:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
opt_signoff:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
opt_signoff:	# +3.2% for capturing clock cell
opt_signoff:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
opt_signoff:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
opt_signoff:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
opt_signoff:	# setup not checked
opt_signoff:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
opt_signoff:
opt_signoff:	# -8.5% for launching clock net
opt_signoff:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
opt_signoff:	# no derate on capturing clock net
opt_signoff:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
opt_signoff:	# -8.5% for data net
opt_signoff:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
opt_signoff:	# setup not checked
opt_signoff:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
opt_signoff:
opt_signoff:    # hold in fast, 0.99v, -40c/0c/125c, cmax
opt_signoff:    } elseif {$corn eq "fast" &&
opt_signoff:	      $volt eq "1p1v" &&
opt_signoff:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
opt_signoff:	      ($rc eq "cmax")} {
opt_signoff:	
opt_signoff:	# -3.7% for launching clock cell
opt_signoff:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
opt_signoff:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
opt_signoff:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
opt_signoff:	# -12.1% for data
opt_signoff:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
opt_signoff:	# setup not checked
opt_signoff:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
opt_signoff:
opt_signoff:	# -8.5% for launching clock net
opt_signoff:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
opt_signoff:	# no derate on capturing clock net
opt_signoff:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
opt_signoff:	# -8.5% for data net
opt_signoff:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
opt_signoff:	# setup not checked
opt_signoff:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
opt_signoff:
opt_signoff:    # hold in fast, 0.99v, -40c/0c/125c, cmin
opt_signoff:    } elseif {$corn eq "fast" &&
opt_signoff:	      $volt eq "1p1v" &&
opt_signoff:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
opt_signoff:	      ($rc eq "cmin")} {
opt_signoff:	
opt_signoff:	# -3.7% for launching clock cell
opt_signoff:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
opt_signoff:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
opt_signoff:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
opt_signoff:	# -12.1% for data
opt_signoff:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
opt_signoff:	# setup not checked
opt_signoff:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
opt_signoff:
opt_signoff:	# no derate on launching clock net
opt_signoff:	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
opt_signoff:	# +8.5% for capturing clock net
opt_signoff:	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
opt_signoff:	# no derate for data net
opt_signoff:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
opt_signoff:	# setup not checked
opt_signoff:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
opt_signoff:
opt_signoff:    } else {
opt_signoff:	puts "Fatal: delay corner ${dc} OCVs not defined (corner: $corn, voltage: $volt, temperature: $temp, rc: ${rc})"
opt_signoff:	exit 1
opt_signoff:    }
opt_signoff:
opt_signoff:    ###########################################
opt_signoff:    # OCVs &  Clock uncertainties for SOCV
opt_signoff:    ###########################################
opt_signoff:
opt_signoff:    # Note, only voltage and temperature OCVs needed
opt_signoff:
opt_signoff:    # Early & late variation factors from:
opt_signoff:    set mmmc_vars(early_rc_variation_factor) 0.06
opt_signoff:    set mmmc_vars(late_rc_variation_factor) 0.06
opt_signoff:
opt_signoff:    set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
opt_signoff:
opt_signoff:    # slow, 0.81v, -40c
opt_signoff:    if {$corn eq "slow" &&
opt_signoff:	$volt eq "0p9v" &&
opt_signoff:	$temp eq "m40c"} {
opt_signoff:        
opt_signoff:        # DATA  @ 20.3mV : 7.4%
opt_signoff:        # DATA  @ 10c    : 0.9%
opt_signoff:        # CLOCK @ 20.3mV : 5.4%
opt_signoff:        # CLOCK @ 10c    : 0.7%
opt_signoff:
opt_signoff:        # For setup only derate clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
opt_signoff:        # For hold in slow derate data & launching clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
opt_signoff:
opt_signoff:    } elseif {$corn eq "slow" &&
opt_signoff:	$volt eq "0p9v" &&
opt_signoff:	$temp eq "125c"} {
opt_signoff:       
opt_signoff:        # DATA  @ 20.3mV : 5.0%
opt_signoff:        # DATA  @ 10c    : 0.3%
opt_signoff:        # CLOCK @ 20.3mV : 3.5%
opt_signoff:        # CLOCK @ 10c    : 0.2%
opt_signoff:
opt_signoff:        # For setup only derate clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
opt_signoff:        # For hold in slow derate data & launching clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
opt_signoff:
opt_signoff:    } elseif {$corn eq "slow" &&
opt_signoff:	$volt eq "0p9v" &&
opt_signoff:	$temp eq "0c"} {
opt_signoff:       
opt_signoff:        # DATA  @ 20.3mV : 6.6%
opt_signoff:        # DATA  @ 10c    : 0.8%
opt_signoff:        # CLOCK @ 20.3mV : 4.9%
opt_signoff:        # CLOCK @ 10c    : 0.6%
opt_signoff:
opt_signoff:        # For setup only derate clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
opt_signoff:        # For hold in slow derate data & launching clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
opt_signoff:
opt_signoff:    } elseif {$corn eq "fast" &&
opt_signoff:	$volt eq "1p1v" &&
opt_signoff:	$temp eq "m40c"} {
opt_signoff:       
opt_signoff:        # DATA  @ 45mV   : 7.4%
opt_signoff:        # DATA  @ 10c    : 0.5%
opt_signoff:        # CLOCK @ 45mV   : 5.1%
opt_signoff:        # CLOCK @ 10c    : 0.6%
opt_signoff:
opt_signoff:        # For setup only derate clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
opt_signoff:        # For hold in slow derate data & launching clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
opt_signoff:
opt_signoff:     } elseif {$corn eq "fast" &&
opt_signoff:	$volt eq "1p1v" &&
opt_signoff:	$temp eq "125c"} {
opt_signoff:
opt_signoff:        # DATA  @ 45mV   : 5.8%
opt_signoff:        # DATA  @ 10c    : 0.5%
opt_signoff:        # CLOCK @ 45mV   : 3.6%
opt_signoff:        # CLOCK @ 10c    : 0.6%
opt_signoff:
opt_signoff:        # For setup only derate clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
opt_signoff:        # For hold in slow derate data & launching clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
opt_signoff:
opt_signoff:    } elseif {$corn eq "fast" &&
opt_signoff:	$volt eq "1p1v" &&
opt_signoff:	$temp eq "0c"} {
opt_signoff:
opt_signoff:        # DATA  @ 45mV   : 7.0%
opt_signoff:        # DATA  @ 10c    : 0.4%
opt_signoff:        # CLOCK @ 45mV   : 4.7%
opt_signoff:        # CLOCK @ 10c    : 0.4%
opt_signoff:
opt_signoff:        # For setup only derate clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
opt_signoff:        # For hold in slow derate data & launching clock
opt_signoff:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
opt_signoff:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
opt_signoff:
opt_signoff:     } else {
opt_signoff:        puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
opt_signoff:        exit 1
opt_signoff:    }
opt_signoff:}
