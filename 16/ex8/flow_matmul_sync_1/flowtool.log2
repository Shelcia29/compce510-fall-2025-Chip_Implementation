syn_generic:#@ Begin verbose flow_step syn_generic.elaborate_design
syn_generic:@flow_step(elaborate_design)  2:     if {[get_db current_design] eq ""} {
syn_generic:                                 	#- setup library information
syn_generic:                                 	global mmmc_vars
syn_generic:                                 	if {[file exists scripts/mmmc_config.tcl]} {
syn_generic:                                 	    read_mmmc             scripts/mmmc_config.tcl
syn_generic:                                 	} else {
syn_generic:                                 	    read_mmmc             [get_db flow_source_directory]/mmmc_config.tcl
syn_generic:                                 	}
syn_generic:                                 	read_physical         -lef [get_db flow_vars_lef_list]
syn_generic:                                 	
syn_generic:                                 	#- read and elaborate design
syn_generic:                                 	#read_hdl
syn_generic:                                 	if {[file exists scripts/compile_[get_db flow_vars_design_name].tcl]} {
syn_generic:                                 	    puts "\nInfo: Sourcing scripts/compile_[get_db flow_vars_design_name].tcl"
syn_generic:                                 	    source scripts/compile_[get_db flow_vars_design_name].tcl
syn_generic:                                 	    puts "\n"
syn_generic:                                 	} else {
syn_generic:                                 	    puts "\nFatal: Compile-script not found! (scripts/compile_[get_db flow_vars_design_name].tcl)"
syn_generic:                                 	    puts "             Run make create_genustech\n"
syn_generic:                                 	    exit
syn_generic:                                 	}
syn_generic:                                 
syn_generic:                                 	# Check for non-default parameters for toplevel
syn_generic:                                 	set topname [get_db flow_vars_design_name]
syn_generic:                                 	if {[get_db flow_vars_design_top] != ""} {
syn_generic:                                 	    set topname [get_db flow_vars_design_top]
syn_generic:                                 	}
syn_generic:                                 	if {[get_db flow_vars_elaboration_parameters] != ""} {
syn_generic:                                 	    elaborate -parameters "[get_db flow_vars_elaboration_parameters]" ${topname}
syn_generic:                                 	} else {
syn_generic:                                 	    elaborate ${topname}
syn_generic:                                 	}
syn_generic:                                 	
syn_generic:                                 	# possible post-elaborate step
syn_generic:                                 	if {[file exists scripts/post_elaborate.tcl]} {
syn_generic:                                 	    puts "\nInfo: Sourcing scripts/post_elaborate.tcl"
syn_generic:                                 	    source scripts/post_elaborate.tcl
syn_generic:                                 	    puts "\n"
syn_generic:                                 	} elseif {[file exists [get_db flow_source_directory]/post_elaborate.tcl]} {
syn_generic:                                 	    puts "\nInfo: Sourcing [get_db flow_source_directory]/post_elaborate.tcl"
syn_generic:                                 	    source [get_db flow_source_directory]/post_elaborate.tcl
syn_generic:                                 	    puts "\n"
syn_generic:                                 	}
syn_generic:                                 	
syn_generic:                                 	# report macros after elaboration to see if linking is ok
syn_generic:                                 	puts "\nInfo: All macros in design:"
syn_generic:                                 	get_db insts -if {.is_macro==true} -foreach {puts [get_db $object .name]}
syn_generic:                                 	puts "\n"
syn_generic:                                 	
syn_generic:                                 	
syn_generic:                                 	# print memories into a text file (/reports folder)
syn_generic:                                 	set fp [open [get_db flow_report_directory]/[get_db flow_vars_design_name].memories.txt w]
syn_generic:                                 	if {[llength [get_db insts -if {.is_memory}]] > 0} {
syn_generic:                                 	    get_db insts -if {.is_memory} -foreach {puts $fp "[get_db $object .name] : [get_db $object .base_cell.name]"}
syn_generic:                                 	} else {
syn_generic:                                 	    puts $fp "no memories found"
syn_generic:                                 	}
syn_generic:                                 	
syn_generic:                                 	close $fp
syn_generic:                                     }
