route:@file 173: # Transform all dict to attribute
route:@file 174: foreach myAttr [dict keys $flow_vars] {
route:  if { ![is_attribute -obj_type root $myAttr]} {
route:    define_attribute $myAttr \
route:      -category user_flow \
route:      -data_type [dict get $flow_vars $myAttr type] \
route:      -default [dict get $flow_vars $myAttr default] \
route:      -help_string [dict get $flow_vars $myAttr description] \
route:      -obj_type root
route:    }
route:}
