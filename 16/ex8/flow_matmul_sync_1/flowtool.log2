syn_generic:#@ Begin verbose flow_step init_mcpu
syn_generic:@flow_step(init_mcpu)  2:     # Multi host/cpu attributes
syn_generic:@flow_step(init_mcpu)  3:     #-----------------------------------------------------------------------------
syn_generic:@flow_step(init_mcpu)  4:     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
syn_generic:@flow_step(init_mcpu)  5:     # the specified dist script.  This connects the number of CPUs being reserved
syn_generic:@flow_step(init_mcpu)  6:     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_generic:@flow_step(init_mcpu)  7:     # a typical environment variable exported by distribution platforms and is
syn_generic:@flow_step(init_mcpu)  8:     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_generic:@flow_step(init_mcpu)  9:     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_generic:                          	set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_generic:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_generic:                          	set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_generic:                              } else {
syn_generic:                          	set max_cpus 8
syn_generic:                              }
syn_generic:@flow_step(init_mcpu) 17:     switch -glob [get_db program_short_name] {
syn_generic:                          	joules*       -
syn_generic:                          	genus*        {
syn_generic:                          	    set_db max_cpus_per_server                $max_cpus
syn_generic:                          	}
syn_generic:                          	innovus*      -
syn_generic:                          	tempus*       -
syn_generic:                          	voltus*       {
syn_generic:                          	    set_multi_cpu_usage -verbose -local_cpu   $max_cpus
syn_generic:                          	    if {[get_feature -feature opt_signoff]} {
syn_generic:                          		if {[is_flow -inside flow:opt_signoff]} {
syn_generic:                          		    set_multi_cpu_usage -verbose -remote_host         1 -cpu_per_remote_host $max_cpus
syn_generic:                          		    set_distributed_hosts                             -local
syn_generic:                          		}
syn_generic:                          	    }
syn_generic:                          	    if {[get_feature -feature sta_eco]} {
syn_generic:                          		if {[is_flow -inside flow:sta_eco]} {
syn_generic:                          		    set_multi_cpu_usage -verbose -remote_host         1 -cpu_per_remote_host $max_cpus
syn_generic:                          		    set_distributed_hosts                             -local
syn_generic:                          		}
syn_generic:                          	    }
syn_generic:                          	}
syn_generic:                          	default       {}
syn_generic:                              }
syn_generic:  Setting attribute of root '/': 'max_cpus_per_server' = 16
syn_generic:#@ End verbose flow_step init_mcpu
