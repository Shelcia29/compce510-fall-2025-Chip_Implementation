sta:@flow 12: set corners [lsort -u [concat [get_db -u [get_db delay_corners -if {.is_setup || .is_hold}] .late_rc_corner]  [get_db -u [get_db delay_corners -if {.is_setup || .is_hold}] .early_rc_corner]]]
sta:@flow 13: puts "Info: reading corners $corners"
sta:Info: reading corners rc_corner:cmax_125c rc_corner:cmin_0c
sta:@flow 15: foreach corner $corners {
sta:        set rcc_name [get_db ${corner} .name]
sta:
sta:        set spef_list [list ${spef_dir}/[get_db flow_vars_design_name].${rcc_name}.spef.gz]
sta:        # subblock SPEFs
sta:        foreach {blockname blockpath} [array get local_macro_exportdir] {
sta:            puts "Info: Reading subblock SPEF ${blockpath}/dbs/opt_signoff/${blockname}.${rcc_name}.spef.gz"
sta:            lappend spef_list ${blockpath}/dbs/opt_signoff/${blockname}.${rcc_name}.spef.gz
sta:        }
sta:        puts "Info: read_spef \"${spef_list}\" -rc_corner $rcc_name"
sta:        read_spef "${spef_list}" -rc_corner $rcc_name
sta:    }
