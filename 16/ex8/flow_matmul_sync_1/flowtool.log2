syn_opt:# lef_filelist originally set in libray_setup.tcl
syn_opt:puts "Info: Adding macro info to flow_vars_lef_list in [info script]"
syn_opt:set_db flow_vars_lef_list [concat [get_db flow_vars_lef_list] $macro_lef_filelist]
syn_opt:set pll_idx [lsearch -regexp [get_db flow_vars_lef_list] {CLKPLL}]
syn_opt:set_db flow_vars_lef_list [lreplace [get_db flow_vars_lef_list] $pll_idx $pll_idx]
syn_opt:
syn_opt:puts "Info: re-writing flow_vars_scan_abstracts in [info script]"
syn_opt:set_db flow_vars_scan_abstracts $macro_scan_abstract_filelist
syn_opt:}
