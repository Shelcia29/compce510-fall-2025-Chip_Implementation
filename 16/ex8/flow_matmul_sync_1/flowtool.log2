opt_signoff:#@ Begin verbose flow_step opt_signoff.innovus_to_tempus
opt_signoff:@flow 2: #- create output location
opt_signoff:@flow 3: set design  [get_db [current_design] .name]
opt_signoff:@flow 5: if {[get_db flow_branch] ne ""} {...
opt_signoff:@flow 7: } else {
opt_signoff:@flow 8: set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
opt_signoff:@flow 9: }
opt_signoff:@flow 11: if {![file exists $out_dir]} {...}
opt_signoff:@flow 15: #- write design and library information
opt_signoff:@@flow 16: write_netlist -top_module_first -top_module $design [file join $out_dir $design.v.gz]
opt_signoff:Writing Netlist "dbs/opt_signoff/matmul_sync.v.gz" ...
opt_signoff:@flow 18: #- write init_design sequence for STA flow
opt_signoff:@flow 19: set FH [open $out_dir/init_sta.tcl w]
opt_signoff:@flow 20: if {[file exists scripts/mmmc_config.tcl]} {...
opt_signoff:@flow 22: } else {
opt_signoff:@flow 23: puts $FH "read_mmmc \[get_db flow_source_directory\]/mmmc_config.tcl"
opt_signoff:@flow 24: }
opt_signoff:@flow 26: puts $FH "set netlist_list \[list \\"
opt_signoff:@flow 27: puts $FH "dbs/opt_signoff/[get_db flow_vars_design_name].v.gz \\"
opt_signoff:@flow 28: puts $FH "\]"
opt_signoff:@flow 29: puts $FH ""
opt_signoff:@flow 30: puts $FH "# All subsystems need to be defined in local_macro_setup!"
opt_signoff:@flow 31: puts $FH "foreach {blockname blockpath} \[array get local_macro_exportdir\] {"
opt_signoff:@flow 32: puts $FH "    lappend netlist_list \${blockpath}/dbs/opt_signoff/\${blockname}.v.gz"
opt_signoff:@flow 33: puts $FH "}"
opt_signoff:@flow 34: puts $FH ""
opt_signoff:@flow 35: puts $FH "read_netlist \"\${netlist_list}\""
opt_signoff:@flow 36: puts $FH "set STA_SIGNOFF 1"
opt_signoff:@flow 37: puts $FH "init_design"
opt_signoff:@flow 38: puts $FH "read_power_intent -1801 [get_db flow_vars_power_intent]"
opt_signoff:@flow 39: puts $FH "commit_power_intent -verbose"
opt_signoff:@flow 40: puts $FH "set_db flow_report_name [get_db flow_report_name]"
opt_signoff:@flow 41: puts $FH "read_activity_file -format TCF dbs/syn_opt/[get_db flow_vars_design_name].tcf"
opt_signoff:@@flow 43: get_db insts -if {.is_macro && !.is_memory} -foreach {puts $FH "set_spef_transform -inst [get_db $object .name] -orient [get_db $object .orient] -x_offset [get_db $object .location.x] -y_offset [get_db $object .location.y]"}
opt_signoff:@flow 45: close $FH
opt_signoff:@@flow 47: set_db flow_post_db_overwrite $out_dir/init_sta.tcl
