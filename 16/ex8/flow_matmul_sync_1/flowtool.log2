syn_generic:#@ Begin verbose flow_step syn_generic.report_synth.report_dft_genus
syn_generic:@flow_step(report_dft_genus)  2:     report_scan_setup        > [file join [get_db flow_report_directory] [get_db flow_report_name] [get_db flow_report_prefix]scan.setup.rpt]
syn_generic:@flow_step(report_dft_genus)  4:     if {[is_flow -inside flow:syn_opt]} {
syn_generic:                                 	report_scan_chains       > [file join [get_db flow_report_directory] [get_db flow_report_name] [get_db flow_report_prefix]scan.chains.rpt]
syn_generic:                                 	if {[llength [get_db actual_scan_chains]] > 0} {
syn_generic:                                 	    write_scandef            > [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.def]
syn_generic:                                             # By default compression chains are written to abstract. For hierarchical integration has to be fullscan
syn_generic:                                             if {[get_feature -feature dft_compressor] && [get_db dft_add_test_compression_new_flow]} {
syn_generic:                                                 # spatial synthesis seems to delete scan clock in some cases, redefine it here
syn_generic:                                                 foreach name [list jtag_tck_[get_db flow_vars_design_name] jtag_tck] {
syn_generic:                                                     set tck_port [get_db ports $name]
syn_generic:                                                     if {[llength $tck_port]} {
syn_generic:                                                         if {$tck_port ni [get_db [get_db test_clocks] .sources]} {
syn_generic:                                                             define_test_clock -name jtag_tck_[get_db flow_vars_design_name] $tck_port
syn_generic:                                                         }
syn_generic:                                                         break
syn_generic:                                                     }
syn_generic:                                                 }
syn_generic:                                 
syn_generic:                                                 define_dft_cfg_mode -name FULLSCAN -type scan  -mode_enable_low [get_db test_signals -if {.function==compression_enable || .function==spread_enable}]
syn_generic:                                 
syn_generic:                                                 check_dft_rules -dft_cfg_mode FULLSCAN
syn_generic:                                 
syn_generic:                                                 for {set i 0} {$i < [get_db dft_compression_num_scanin]} {incr i} {
syn_generic:                                                     define_scan_chain -name FULLSCAN_$i  -sdi [get_db [get_db test_signals -if {.function==compress_sdi && .index==$i}] .pin]  -sdo [get_db [get_db test_signals -if {.function==compress_sdo && .index==$i}] .pin]  -dft_configuration_mode FULLSCAN  -multi_mode -analyze
syn_generic:                                                 }
syn_generic:                                 
syn_generic:                                                 write_dft_abstract_model -write_as_libcell -dft_cfg_mode FULLSCAN >  [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.abstract]
syn_generic:                                 
syn_generic:                                                 # input->inout arcs aren't written to abstract
syn_generic:                                                 # TODO deleting self controllable definition would be good as now scan out
syn_generic:                                                 # controllables overwrite them but it requires the order to always be same
syn_generic:                                                 dft_utils::read_scan_abstract [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.abstract]
syn_generic:                                                 foreach port [get_db ports -if {.is_user_scan_out}] {
syn_generic:                                                     set controllable [report_dft_trace_back -continue $port]
syn_generic:                                                     if {[get_db $controllable .obj_type]!="port"} {
syn_generic:                                                         continue
syn_generic:                                                     }
syn_generic:                                                     dft_utils::add_dft_controllable -from [get_db $controllable .name] -to [get_db $port .name]
syn_generic:                                                 }
syn_generic:                                                 dft_utils::write_scan_abstract [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.abstract]
syn_generic:                                 
syn_generic:                                                 delete_obj [get_db dft_configuration_modes FULLSCAN]
syn_generic:                                                 check_dft_rules
syn_generic:                                 
syn_generic:                                                 report_core_wrapper_cell -report_flops > [file join [get_db flow_report_directory] [get_db flow_report_name] [get_db flow_report_prefix]core_wrapper.rpt]
syn_generic:                                             } else {
syn_generic:                                                 write_dft_abstract_model -write_as_libcell > [file join [get_db flow_db_directory] [get_db flow_report_name] [get_db flow_report_prefix][get_db current_design .name].scan.abstract]
syn_generic:                                             }
syn_generic:                                 	}
syn_generic:                                     }
