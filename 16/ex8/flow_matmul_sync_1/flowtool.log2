opt_signoff:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
opt_signoff:@file 1: ################################################################################
opt_signoff:@file 2: # Local setup for macros in hierarchical designs
opt_signoff:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
opt_signoff:@file 4: ################################################################################
opt_signoff:@file 5: # Time-stamp: <2025-10-30 09:01:30 qftele>
opt_signoff:@file 6: #########################################################################################################
opt_signoff:@file 7: # Macro info
opt_signoff:@file 8: # List versions of macros used in DUT
opt_signoff:@file 9: #########################################################################################################
opt_signoff:@file 10: if {1} {
opt_signoff:@file 11: array unset global_macro_exportdir
opt_signoff:@file 12:
opt_signoff:@file 13: set macro_scan_abstract_filelist [list ]
opt_signoff:@file 14: set macro_lef_filelist [list ]
opt_signoff:@file 15:
opt_signoff:@file 16:
opt_signoff:@file 17: array unset memarray
opt_signoff:@file 18:
opt_signoff:@file 19: # Go through global settings for macros and see if there's a local override
opt_signoff:@file 20: foreach {blockname blockpath} [array get global_macro_exportdir] {
opt_signoff:
opt_signoff:    # do not read in a model for DUT
opt_signoff:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
opt_signoff:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
opt_signoff:	continue
opt_signoff:    }
opt_signoff:
opt_signoff:    if {[info exists local_macro_exportdir($blockname)]} {
opt_signoff:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
opt_signoff:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
opt_signoff:	    puts "\#OLD\#: $blockpath"
opt_signoff:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
opt_signoff:	    set $blockpath $local_macro_exportdir($blockname)
opt_signoff:	}
opt_signoff:    }
opt_signoff:
opt_signoff:    # scan abstract for DFT
opt_signoff:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
opt_signoff:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
opt_signoff:    } else {
opt_signoff:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
opt_signoff:    }
opt_signoff:
opt_signoff:    # MACROs
opt_signoff:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
opt_signoff:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
opt_signoff:    } else {
opt_signoff:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
opt_signoff:	exit 1
opt_signoff:    }
opt_signoff:
opt_signoff:    # Read .lib -files
opt_signoff:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
opt_signoff:    foreach dc $mmmc_vars(delay_corners) {
opt_signoff:
opt_signoff:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
opt_signoff:
opt_signoff:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
opt_signoff:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	} else {
opt_signoff:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
opt_signoff:	    exit 1
opt_signoff:	}
opt_signoff:    }
opt_signoff:}
opt_signoff:@file 67: # sanity check to see if global setting are missing block which are defined in local settings!
opt_signoff:@file 68: foreach {blockname blockpath} [array get local_macro_exportdir] {
opt_signoff:    # do not read in a model for DUT
opt_signoff:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
opt_signoff:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
opt_signoff:	continue
opt_signoff:    }
opt_signoff:
opt_signoff:    set found 0
opt_signoff:    if {[info exists global_macro_exportdir($blockname)]} {
opt_signoff:	set found 1
opt_signoff:    }
opt_signoff:
opt_signoff:    if {!$found} {
opt_signoff:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
opt_signoff:    } else {
opt_signoff:	# it was found so it's already set
opt_signoff:	continue
opt_signoff:    }
opt_signoff:
opt_signoff:    # scan abstract for DFT
opt_signoff:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
opt_signoff:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
opt_signoff:    } else {
opt_signoff:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
opt_signoff:    }
opt_signoff:
opt_signoff:    # MACROs
opt_signoff:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
opt_signoff:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
opt_signoff:    } else {
opt_signoff:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
opt_signoff:	exit 1
opt_signoff:    }
opt_signoff:
opt_signoff:    # Read .lib -files
opt_signoff:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
opt_signoff:    foreach dc $mmmc_vars(delay_corners) {
opt_signoff:
opt_signoff:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
opt_signoff:
opt_signoff:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
opt_signoff:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
opt_signoff:	} else {
opt_signoff:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
opt_signoff:	    exit 1
opt_signoff:	}
opt_signoff:    }
opt_signoff:}
opt_signoff:@file 117:
opt_signoff:@file 118: ########################################################################
opt_signoff:@file 119: # Memories
opt_signoff:@file 120: ########################################################################
opt_signoff:@file 121:
opt_signoff:@file 122: set memory_gds_filelist [list]
opt_signoff:@file 123: set memory_spi_filelist [list]
opt_signoff:@file 124: foreach {memdir memlist} [array get memarray] {
opt_signoff:
opt_signoff:    set mem_directory ./models
opt_signoff:    foreach mem $memlist {
opt_signoff:
opt_signoff:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
opt_signoff:
opt_signoff:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
opt_signoff:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
opt_signoff:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
opt_signoff:
opt_signoff:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
opt_signoff:
opt_signoff:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
opt_signoff:
opt_signoff:        foreach dc $mmmc_vars(delay_corners) {
opt_signoff:
opt_signoff:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
opt_signoff:
opt_signoff:	    if {[regexp {SS} $dc]} {
opt_signoff:		set volt "0P720V"
opt_signoff:		set temp "125C"
opt_signoff:	    } else {
opt_signoff:		set volt "0P880V"
opt_signoff:		set temp "M40C"
opt_signoff:	    }
opt_signoff:	    
opt_signoff:
opt_signoff:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
opt_signoff:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
opt_signoff:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
opt_signoff:        }
opt_signoff:    }
opt_signoff:}
opt_signoff:@file 158:
