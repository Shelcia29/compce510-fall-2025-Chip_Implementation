syn_generic:#@ Begin verbose flow_step syn_generic.generate_activity_file
syn_generic:@flow_step(generate_activity_file)  2:     if {[get_db flow_feature_run_joules_power]} {
syn_generic:                                       	set ::rtls::use_joules_write_parsers 1
syn_generic:                                       	set_db lp_enable_jls_sdb_flow 1
syn_generic:                                       	set_default_activity -pin_types primary_input -duty 0 -freq 0
syn_generic:                                       	set_default_activity -pin_types seq_out -duty 0 -freq 0
syn_generic:                                       
syn_generic:                                       	read_stimulus  -file [lindex [get_db flow_vars_tcf_file] 0]  -dut_instance [lindex [get_db flow_vars_tcf_file] 1]  -frame 30  -start -end 25261ns  -scrub_prep -resim_cg_enables
syn_generic:                                       
syn_generic:                                       	propagate_activity -mode time_based
syn_generic:                                       	#compute_ideal_power -mode time_based
syn_generic:                                       	#compute_power -mode time_based
syn_generic:                                       
syn_generic:                                       	#write_tcf > [get_db flow_database_directory]/[get_db flow_vars_design_name].tcf
syn_generic:                                       	if {![file exists [get_db flow_report_directory]/joules]} {file mkdir [get_db flow_report_directory]/joules}
syn_generic:                                       	report_sdb_annotation > [get_db flow_report_directory]/joules/report_sdb_annotation.txt
syn_generic:                                           }
syn_generic:#@ End verbose flow_step syn_generic.generate_activity_file
syn_generic:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_generic:UM:              1              1                                      generate_activity_file
