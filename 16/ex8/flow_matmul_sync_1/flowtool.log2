syn_opt:@flow_step(genus_add_dft_constraints)  3:     foreach constr_mode [get_db flow_vars_constraint_modes] {
syn_opt:                                          	set constr_files [list ]
syn_opt:                                          	foreach sdc [get_db [get_db constraint_modes -if {.base_name==${constr_mode}}] .sdc_files] {
syn_opt:                                          	    lappend constr_files $sdc
syn_opt:                                          	}
syn_opt:                                          	if {$constr_mode != "func"} {
syn_opt:                                          	} else {
syn_opt:                                          	    if {[is_flow -inside flow:syn_generic]} {
syn_opt:                                          		lappend constr_files [get_db flow_vars_data_directory]/constraints/[get_db flow_vars_design_name].constraints.hier_dft.tcl
syn_opt:                                          	    }
syn_opt:                                          	}
syn_opt:                                          	update_constraint_mode -name $constr_mode -sdc_files $constr_files
syn_opt:                                              }
