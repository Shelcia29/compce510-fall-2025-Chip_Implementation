syn_generic:#@ Begin verbose flow_step syn_generic.create_cost_group
syn_generic:@flow_step(create_cost_group)  2:     #- Clear existing path_groups
syn_generic:@flow_step(create_cost_group)  3:     get_db cost_groups -if {.name != default} -foreach {delete_obj $object}
syn_generic:    Removing cost_group 'clk_i'.
syn_generic:Info    : Removed object. [TUI-58]
syn_generic:        : Removed cost_group 'cost_group:matmul_sync/clk_i'.
syn_generic:    Removing cost_group 'clk_i_virtual'.
syn_generic:Info    : Removed object. [TUI-58]
syn_generic:        : Removed cost_group 'cost_group:matmul_sync/clk_i_virtual'.
syn_generic:@flow_step(create_cost_group)  5:     #- Add basic path_groups
syn_generic:@flow_step(create_cost_group)  6:     set mems [get_cells -hierarchical -filter "@is_memory_cell"]
syn_generic:@flow_step(create_cost_group)  7:     set icgs [filter_collection [all_registers] "@is_integrated_clock_gating_cell"]
syn_generic:@flow_step(create_cost_group)  8:     set regs [remove_from_collection [all_registers -edge_triggered] $icgs]
syn_generic:@flow_step(create_cost_group) 10:     foreach mode [get_db constraint_modes -if {.is_setup}] {
syn_generic:                                          set_interactive_constraint_mode $mode
syn_generic:                                          group_path -name in2out -from [all_inputs] -to [all_outputs]
syn_generic:                                          if {[sizeof_collection [get_cells $regs]] > 0} {
syn_generic:                                              group_path -name in2reg -from [all_inputs] -to $regs
syn_generic:                                              group_path -name reg2out -from $regs -to [all_outputs]
syn_generic:                                              group_path -name reg2reg -from $regs -to $regs
syn_generic:                                          }
syn_generic:                                          if {[sizeof_collection [get_cells $mems]] > 0} {
syn_generic:                                              group_path -name mem2reg -from $mems -to $regs
syn_generic:                                              group_path -name reg2mem -from $regs -to $mems
syn_generic:                                              group_path -name mem2mem -from $mems -to $mems
syn_generic:                                          }
syn_generic:                                          if {[sizeof_collection [get_cells $icgs]] > 0} {
syn_generic:                                              group_path -name reg2icg -from $regs -to $icgs
syn_generic:                                          }
syn_generic:                                      }
syn_generic:#@ End verbose flow_step syn_generic.create_cost_group
syn_generic:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_generic:UM:              1              1                                      create_cost_group
