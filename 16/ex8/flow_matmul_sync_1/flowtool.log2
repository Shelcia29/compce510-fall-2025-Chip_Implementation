prects:Warning: Overriding project macro setup from local folder
prects:Info: Sourcing scripts/local_macro_setup.tcl
prects:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
prects:@file 1: ################################################################################
prects:@file 2: # Local setup for macros in hierarchical designs
prects:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
prects:@file 4: ################################################################################
prects:@file 5: # Time-stamp: <2025-10-30 09:01:30 qftele>
prects:@file 6: #########################################################################################################
prects:@file 7: # Macro info
prects:@file 8: # List versions of macros used in DUT
prects:@file 9: #########################################################################################################
prects:@file 10: if {1} {
prects:@file 11: array unset global_macro_exportdir
prects:@file 12:
prects:@file 13: set macro_scan_abstract_filelist [list ]
prects:@file 14: set macro_lef_filelist [list ]
prects:@file 15:
prects:@file 16:
prects:@file 17: array unset memarray
prects:@file 18:
prects:@file 19: # Go through global settings for macros and see if there's a local override
prects:@file 20: foreach {blockname blockpath} [array get global_macro_exportdir] {
prects:
prects:    # do not read in a model for DUT
prects:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
prects:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
prects:	continue
prects:    }
prects:
prects:    if {[info exists local_macro_exportdir($blockname)]} {
prects:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
prects:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
prects:	    puts "\#OLD\#: $blockpath"
prects:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
prects:	    set $blockpath $local_macro_exportdir($blockname)
prects:	}
prects:    }
prects:
prects:    # scan abstract for DFT
prects:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
prects:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
prects:    } else {
prects:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
prects:    }
prects:
prects:    # MACROs
prects:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
prects:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
prects:    } else {
prects:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
prects:	exit 1
prects:    }
prects:
prects:    # Read .lib -files
prects:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
prects:    foreach dc $mmmc_vars(delay_corners) {
prects:
prects:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
prects:
prects:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
prects:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	} else {
prects:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
prects:	    exit 1
prects:	}
prects:    }
prects:}
prects:@file 67: # sanity check to see if global setting are missing block which are defined in local settings!
prects:@file 68: foreach {blockname blockpath} [array get local_macro_exportdir] {
prects:    # do not read in a model for DUT
prects:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
prects:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
prects:	continue
prects:    }
prects:
prects:    set found 0
prects:    if {[info exists global_macro_exportdir($blockname)]} {
prects:	set found 1
prects:    }
prects:
prects:    if {!$found} {
prects:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
prects:    } else {
prects:	# it was found so it's already set
prects:	continue
prects:    }
prects:
prects:    # scan abstract for DFT
prects:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
prects:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
prects:    } else {
prects:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
prects:    }
prects:
prects:    # MACROs
prects:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
prects:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
prects:    } else {
prects:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
prects:	exit 1
prects:    }
prects:
prects:    # Read .lib -files
prects:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
prects:    foreach dc $mmmc_vars(delay_corners) {
prects:
prects:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
prects:
prects:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
prects:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
prects:	} else {
prects:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
prects:	    exit 1
prects:	}
prects:    }
prects:}
prects:@file 117:
prects:@file 118: ########################################################################
prects:@file 119: # Memories
prects:@file 120: ########################################################################
prects:@file 121:
prects:@file 122: set memory_gds_filelist [list]
prects:@file 123: set memory_spi_filelist [list]
prects:@file 124: foreach {memdir memlist} [array get memarray] {
prects:
prects:    set mem_directory ./models
prects:    foreach mem $memlist {
prects:
prects:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
prects:
prects:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
prects:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
prects:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
prects:
prects:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
prects:
prects:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
prects:
prects:        foreach dc $mmmc_vars(delay_corners) {
prects:
prects:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
prects:
prects:	    if {[regexp {SS} $dc]} {
prects:		set volt "0P720V"
prects:		set temp "125C"
prects:	    } else {
prects:		set volt "0P880V"
prects:		set temp "M40C"
prects:	    }
prects:	    
prects:
prects:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
prects:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
prects:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
prects:        }
prects:    }
prects:}
