sta:@flow 42: #set_multi_cpu_usage -local_cpu 8 -remote_host 1 -cpu_per_remote_host 8
sta:@flow 44: # merge .libs to one single multimode file
sta:@flow 45: foreach corner_name [get_db -u [get_db analysis_views "[get_db  flow_vars_setup_pnr_active_views] [get_db flow_vars_hold_pnr_active_views]"] .delay_corner.name] {
sta:
sta:        set constraint_modes [join [get_db -u analysis_views .constraint_mode.name] ","]
sta:        set files [glob models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}_{${constraint_modes}}.lib]
sta:	if {![llength $files]} {
sta:	    puts "Error: No files corresponding to corner: ${corner_name} and constraint_modes: ${constraint_modes} in models/[get_db flow_report_name]/"
sta:	    continue
sta:	}
sta:	set mode_list [list ]
sta:	set mode_group ""
sta:	foreach ff $files {
sta:	    set mode ""
sta:	    set cmodes [regsub -all "," $constraint_modes "|"]
sta:	    if {![regexp "_(${cmodes})\.lib" $ff -> mode]} {
sta:		puts "Error: Bad filename $ff"
sta:		continue
sta:	    }
sta:	    lappend mode_list $mode
sta:	    if {$mode_group == ""} {
sta:		set mode_group $mode
sta:	    } else {
sta:		set mode_group ${mode_group}_${mode}
sta:	    }
sta:	}
sta:
sta:        if {[llength $files] > 1} {
sta:            merge_model_timing -input_library_file $files  -mode_group $mode_group  -modes $mode_list  -merged_library_file models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}.lib
sta:        } else {
sta:            # we only have one mode
sta:            exec cp [lindex $files 0] models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}.lib
sta:        }
sta:    }
sta:Multi-CPU acceleration using 8 CPU(s).
