postroute:#@ Begin verbose flow_step postroute.init_innovus
postroute:@flow 3: # Tool settings: NOTE: already set by flow_config.tcl
postroute:@flow 4: #set_multi_cpu_usage -local_cpu 8 -remote_host 1 -cpu_per_remote_host 8
postroute:@flow 6: if {[get_feature -feature report_lec]} {
postroute:@flow 7: # Init attributes  [get_db -category init]
postroute:@flow 8: 	#-------------------------------------------------------------------------------
postroute:@@flow 9: set_db write_lec_directory_naming_style "fv/%s/[get_db flow_report_name]"
postroute:@flow 10:
postroute:@flow 11: }
postroute:@@flow 12: set_db init_design_uniquify 1
postroute:@flow 14: # Design attributes  [get_db -category design]
postroute:@flow 15: #-------------------------------------------------------------------------------
postroute:@@flow 16: set_db design_process_node            45
postroute:##  Process: 45            (User Set)               
postroute:##     Node: (not set)                           
postroute:
postroute:##  Check design process and node:  
postroute:##  Design tech node is not set.
postroute:
postroute:Applying the recommended capacitance filtering threshold values for 45nm process node: total_c_th=0, relative_c_th=1 and coupling_c_th=0.1.
postroute:	These values will be used by all post-route extraction engines, including TQuantus, IQuantus and Quantus QRC extraction.
postroute:	Capacitance filtering mode(extract_rc_cap_filter_mode option of the set_db) is 'relative_and_coupling' for all engines.
postroute:	The accuracy mode for post_route extract_rc_effort_level low extraction will be set to 'high'.
postroute:	Default value for EffortLevel(extract_rc_effort_level option of the set_db) in post_route extraction mode is 'medium'.
postroute:@flow 17: if {[get_feature -feature flow_express]} {...}
postroute:@@flow 20: set_db design_early_clock_flow              true
postroute:@flow 22: # Via naming
postroute:@flow 23: #-------------------------------------------------------------------------------
postroute:@flow 24: # Use design name as prefix for VIAs, as otherwise they will cause collision when merging designs on toplevel
postroute:@@flow 25: set_db write_stream_via_names true
postroute:@flow 27: # Timing attributes  [get_db -category timing && delaycalc]
postroute:@flow 28: #-------------------------------------------------------------------------------
postroute:@@flow 29: set_db timing_analysis_cppr           both
postroute:@@flow 30: set_db timing_analysis_type           ocv
postroute:@@flow 31: set_db timing_report_fields           {timing_point net cell fanout load transition delay incr_delay arrival edge user_derate power_domain}
postroute:@flow 33: #set_db timing_analysis_socv                               true                        ;# Enable socv analysis
postroute:@flow 34: #set_db timing_socv_rc_variation_mode                      true                        ;# Enable interconnect variation mode in SOCV mode
postroute:@flow 35: #set_db  timing_report_enable_verbose_ssta_mode true
postroute:@flow 37: # Add, TL: flow sets this to "no_async", async is default and should be used
postroute:@@flow 38: set_db timing_analysis_async_checks async
postroute:@flow 39: # Add, TL: maybe a bit hazardous... disable default io delay for ports which are unconstrained!
postroute:@flow 40: # if true, will cause hold problems (since launching clock is the receiving clock (with same latency!))
postroute:@@flow 41: set_db timing_apply_default_primary_input_assertion false
postroute:@@flow 43: set_db delaycal_advanced_node_pin_cap_settings true
postroute:@@flow 44: set_db delaycal_advanced_pin_cap_mode true
postroute:@flow 47: # Extraction attributes  [get_db -category extract_rc]
postroute:@flow 48: #-------------------------------------------------------------------------------
postroute:@flow 49: if {[get_feature -feature add_pvs_fill] || [get_feature -feature add_pegasus_beol_fill]} {...}
postroute:@flow 52: if {[is_flow -after flow:opt_signoff] || [is_flow -inside flow:opt_signoff]} {...}
postroute:@flow 58: if {[is_flow -after flow:route]} {
postroute:@@flow 59: set_db delaycal_enable_si           true
postroute:AAE_INFO: switching set_db delaycal_enable_si from false to true ...
postroute:AAE_INFO: The setting is changed from false to true in set_db delaycal_enable_si
postroute:@@flow 60: set_db extract_rc_engine            post_route
postroute:@flow 61: # Note, TL: default is false, see effect of setting to true
postroute:@flow 62: 	#set_db si_delay_separate_on_data                  true
postroute:@flow 63: }
postroute:@flow 64: if {1} {
postroute:@@flow 65: set_db delaycal_equivalent_waveform_model               propagation
postroute:@flow 66: }
postroute:@@flow 69: set_db si_aggressor_alignment                             timing_aware_edge       
postroute:@flow 71: # Mod, TL: Too few licenses to extract all corners in parallel . Use the following to reduce number of used licenses :
postroute:@flow 72: #set_db extract_rc_qrc_run_mode sequential
