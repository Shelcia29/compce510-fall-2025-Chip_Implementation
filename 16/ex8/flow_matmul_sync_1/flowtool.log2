sta:@flow 6: } else {
sta:@flow 7: set views [get_db -u analysis_views -if {.is_setup || .is_hold || .is_leakage}]
sta:@flow 8: set decoupled ""
sta:@flow 9: }
sta:@flow 10: set spef_dir  [file normalize [file join [get_db flow_working_directory] [get_db flow_db_directory] [file rootname [get_db flow_report_name]]]]
sta:@flow 11: puts "Info: Using SPEF-dir: $spef_dir"
