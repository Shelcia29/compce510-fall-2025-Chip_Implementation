floorplan:#@ Begin verbose flow_step floorplan.innovus_generate_etm
floorplan:@flow 2: if {![file exists models]} {...}
floorplan:@flow 3: if {![file exists models/[get_db flow_report_name]]} {...}
floorplan:@flow 4: set spef_dir  [file normalize [file join [get_db flow_working_directory] [get_db flow_db_directory] [file rootname [get_db flow_report_name]]]]
floorplan:@flow 5: puts "Info: Using SPEF-dir: $spef_dir"
floorplan:Info: Using SPEF-dir: /home/student/16/ex8/flow_matmul_sync_1/dbs/floorplan
floorplan:@flow 6: set active_setup_views [get_db [get_db analysis_views -if {.is_setup||.is_leakage||.is_dynamic}] .name]
floorplan:@flow 7: set active_hold_views [get_db [get_db analysis_views -if {.is_hold}] .name]
floorplan:@flow 8: #set_multi_cpu_usage -local_cpu 4 -remote_host 1 -cpu_per_remote_host 4
floorplan:@flow 9: foreach view_dpo [get_db analysis_views -if {.is_setup||.is_hold||.is_leakage||.is_dynamic}] {
floorplan:	puts "Info: Writing timing model for analysis_view [get_db $view_dpo .name]"
floorplan:	set_analysis_view -setup [get_db $view_dpo .name] -hold [get_db $view_dpo .name]
floorplan:	# Note, TL. Parasitics are extracted only after route step
floorplan:	if {[is_flow -quiet -after flow:route]} {
floorplan:	    set corner_name [get_db $view_dpo .delay_corner.late_rc_corner.name]
floorplan:	    set spef_file [glob -nocomplain -directory ${spef_dir} *.${corner_name}.spef*]
floorplan:	    puts "Info: Reading SPEF-file ${spef_file} for corner $corner_name"
floorplan:	    read_spef -rc_corner ${corner_name} ${spef_file}
floorplan:	}
floorplan:	write_timing_model -include_power_ground [file join models [get_db flow_report_name] [get_db [current_design] .name].[get_db $view_dpo .name].lib] -view [get_db $view_dpo .name]
floorplan:    }
