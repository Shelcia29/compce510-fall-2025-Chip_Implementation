cts:@file 173: # Transform all dict to attribute
cts:@file 174: foreach myAttr [dict keys $flow_vars] {
cts:  if { ![is_attribute -obj_type root $myAttr]} {
cts:    define_attribute $myAttr \
cts:      -category user_flow \
cts:      -data_type [dict get $flow_vars $myAttr type] \
cts:      -default [dict get $flow_vars $myAttr default] \
cts:      -help_string [dict get $flow_vars $myAttr description] \
cts:      -obj_type root
cts:    }
cts:}
