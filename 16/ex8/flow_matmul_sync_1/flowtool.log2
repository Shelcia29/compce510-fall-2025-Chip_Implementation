route:#@ Begin verbose flow_step init_mcpu
route:@flow 2: # Multi host/cpu attributes
route:@flow 3: #-----------------------------------------------------------------------------
route:@flow 4: # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
route:@flow 5: # the specified dist script.  This connects the number of CPUs being reserved
route:@flow 6: # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
route:@flow 7: # a typical environment variable exported by distribution platforms and is
route:@flow 8: # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
route:@flow 9: if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
