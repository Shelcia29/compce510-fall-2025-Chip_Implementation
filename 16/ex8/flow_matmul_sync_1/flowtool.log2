syn_generic:@flow_step(set_dont_use)  3:     if {[get_db flow_feature_dont_use_ulvt]} {
syn_generic:                             	if {[is_flow -before flow:postroute]} {
syn_generic:                             	    set_db [get_db base_cells -if {.lib_cells.library.name==*ulvt*}] .dont_use true
syn_generic:                             	} else {
syn_generic:                             	    set_db [get_db base_cells -if {.lib_cells.library.name==*ulvt*}] .dont_use false
syn_generic:                             	}
syn_generic:                                 }
syn_generic:@flow_step(set_dont_use) 11:     foreach dont_use_expr [get_db flow_vars_dont_use_list] {
syn_generic:                                     set_db [get_db base_cells -if {*}${dont_use_expr}] .dont_use true
syn_generic:                                 }
syn_generic:#@ End verbose flow_step syn_generic.set_dont_use
syn_generic:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
