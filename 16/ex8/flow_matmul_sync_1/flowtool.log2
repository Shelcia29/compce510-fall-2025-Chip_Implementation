route:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
route:@file 1: ################################################################################
route:@file 2: # Local setup for macros in hierarchical designs
route:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
route:@file 4: ################################################################################
route:@file 5: # Time-stamp: <2025-10-30 09:01:30 qftele>
route:@file 6: #########################################################################################################
route:@file 7: # Macro info
route:@file 8: # List versions of macros used in DUT
route:@file 9: #########################################################################################################
route:@file 10: if {1} {
route:@file 11: array unset global_macro_exportdir
route:@file 12:
route:@file 13: set macro_scan_abstract_filelist [list ]
route:@file 14: set macro_lef_filelist [list ]
route:@file 15:
route:@file 16:
route:@file 17: array unset memarray
route:@file 18:
route:@file 19: # Go through global settings for macros and see if there's a local override
route:@file 20: foreach {blockname blockpath} [array get global_macro_exportdir] {
route:
route:    # do not read in a model for DUT
route:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
route:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
route:	continue
route:    }
route:
route:    if {[info exists local_macro_exportdir($blockname)]} {
route:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
route:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
route:	    puts "\#OLD\#: $blockpath"
route:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
route:	    set $blockpath $local_macro_exportdir($blockname)
route:	}
route:    }
route:
route:    # scan abstract for DFT
route:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
route:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
route:    } else {
route:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
route:    }
route:
route:    # MACROs
route:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
route:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
route:    } else {
route:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
route:	exit 1
route:    }
route:
route:    # Read .lib -files
route:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
route:    foreach dc $mmmc_vars(delay_corners) {
route:
route:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
route:
route:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
route:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	} else {
route:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
route:	    exit 1
route:	}
route:    }
route:}
route:@file 67: # sanity check to see if global setting are missing block which are defined in local settings!
route:@file 68: foreach {blockname blockpath} [array get local_macro_exportdir] {
route:    # do not read in a model for DUT
route:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
route:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
route:	continue
route:    }
route:
route:    set found 0
route:    if {[info exists global_macro_exportdir($blockname)]} {
route:	set found 1
route:    }
route:
route:    if {!$found} {
route:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
route:    } else {
route:	# it was found so it's already set
route:	continue
route:    }
route:
route:    # scan abstract for DFT
route:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
route:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
route:    } else {
route:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
route:    }
route:
route:    # MACROs
route:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
route:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
route:    } else {
route:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
route:	exit 1
route:    }
route:
route:    # Read .lib -files
route:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
route:    foreach dc $mmmc_vars(delay_corners) {
route:
route:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
route:
route:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
route:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
route:	} else {
route:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
route:	    exit 1
route:	}
route:    }
route:}
route:@file 117:
route:@file 118: ########################################################################
route:@file 119: # Memories
route:@file 120: ########################################################################
route:@file 121:
route:@file 122: set memory_gds_filelist [list]
route:@file 123: set memory_spi_filelist [list]
route:@file 124: foreach {memdir memlist} [array get memarray] {
route:
route:    set mem_directory ./models
route:    foreach mem $memlist {
route:
route:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
route:
route:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
route:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
route:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
route:
route:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
route:
route:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
route:
route:        foreach dc $mmmc_vars(delay_corners) {
route:
route:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
route:
route:	    if {[regexp {SS} $dc]} {
route:		set volt "0P720V"
route:		set temp "125C"
route:	    } else {
route:		set volt "0P880V"
route:		set temp "M40C"
route:	    }
route:	    
route:
route:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
route:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
route:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
route:        }
route:    }
route:}
route:@file 158:
route:@file 159: ########################################################################
route:@file 160: # Manual hacks for dirty models
route:@file 161: ########################################################################
route:@file 162: # .lefs
route:@file 163: # .libs
route:@file 164:
route:@file 165: # lef_filelist originally set in libray_setup.tcl
route:@file 166: puts "Info: Adding macro info to flow_vars_lef_list in [info script]"
route:Info: Adding macro info to flow_vars_lef_list in scripts/local_macro_setup.tcl
route:@@file 167: set_db flow_vars_lef_list [concat [get_db flow_vars_lef_list] $macro_lef_filelist]
route:@file 168: set pll_idx [lsearch -regexp [get_db flow_vars_lef_list] {CLKPLL}]
route:@@file 169: set_db flow_vars_lef_list [lreplace [get_db flow_vars_lef_list] $pll_idx $pll_idx]
route:@file 170:
