syn_map:#@ Begin verbose source ./scripts/local_macro_setup.tcl
syn_map:@file(local_macro_setup.tcl) 10: if {1} {
syn_map:array unset global_macro_exportdir
syn_map:
syn_map:set macro_scan_abstract_filelist [list ]
syn_map:set macro_lef_filelist [list ]
syn_map:
syn_map:
syn_map:array unset memarray
syn_map:
syn_map:# Go through global settings for macros and see if there's a local override
syn_map:foreach {blockname blockpath} [array get global_macro_exportdir] {
syn_map:
syn_map:    # do not read in a model for DUT
syn_map:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
syn_map:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
syn_map:	continue
syn_map:    }
syn_map:
syn_map:    if {[info exists local_macro_exportdir($blockname)]} {
syn_map:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
syn_map:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
syn_map:	    puts "\#OLD\#: $blockpath"
syn_map:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
syn_map:	    set $blockpath $local_macro_exportdir($blockname)
syn_map:	}
syn_map:    }
syn_map:
syn_map:    # scan abstract for DFT
syn_map:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
syn_map:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
syn_map:    } else {
syn_map:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
syn_map:    }
syn_map:
syn_map:    # MACROs
syn_map:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
syn_map:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
syn_map:    } else {
syn_map:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
syn_map:	exit 1
syn_map:    }
syn_map:
syn_map:    # Read .lib -files
syn_map:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
syn_map:    foreach dc $mmmc_vars(delay_corners) {
syn_map:
syn_map:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_map:
syn_map:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_map:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_map:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_map:	} else {
syn_map:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
syn_map:	    exit 1
syn_map:	}
syn_map:    }
syn_map:}
syn_map:# sanity check to see if global setting are missing block which are defined in local settings!
syn_map:foreach {blockname blockpath} [array get local_macro_exportdir] {
syn_map:    # do not read in a model for DUT
syn_map:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
syn_map:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
syn_map:	continue
syn_map:    }
syn_map:
syn_map:    set found 0
syn_map:    if {[info exists global_macro_exportdir($blockname)]} {
syn_map:	set found 1
syn_map:    }
syn_map:
syn_map:    if {!$found} {
syn_map:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
syn_map:    } else {
syn_map:	# it was found so it's already set
syn_map:	continue
syn_map:    }
syn_map:
syn_map:    # scan abstract for DFT
syn_map:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
syn_map:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
syn_map:    } else {
syn_map:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
syn_map:    }
syn_map:
syn_map:    # MACROs
syn_map:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
syn_map:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
syn_map:    } else {
syn_map:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
syn_map:	exit 1
syn_map:    }
syn_map:
syn_map:    # Read .lib -files
syn_map:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
syn_map:    foreach dc $mmmc_vars(delay_corners) {
syn_map:
syn_map:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_map:
syn_map:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_map:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_map:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_map:	} else {
syn_map:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
syn_map:	    exit 1
syn_map:	}
syn_map:    }
syn_map:}
syn_map:
syn_map:########################################################################
syn_map:# Memories
syn_map:########################################################################
syn_map:
syn_map:set memory_gds_filelist [list]
syn_map:set memory_spi_filelist [list]
syn_map:foreach {memdir memlist} [array get memarray] {
syn_map:
syn_map:    set mem_directory ./models
syn_map:    foreach mem $memlist {
syn_map:
syn_map:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
syn_map:
syn_map:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
syn_map:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
syn_map:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
syn_map:
syn_map:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
syn_map:
syn_map:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
syn_map:
syn_map:        foreach dc $mmmc_vars(delay_corners) {
syn_map:
syn_map:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_map:
syn_map:	    if {[regexp {SS} $dc]} {
syn_map:		set volt "0P720V"
syn_map:		set temp "125C"
syn_map:	    } else {
syn_map:		set volt "0P880V"
syn_map:		set temp "M40C"
syn_map:	    }
syn_map:	    
syn_map:
syn_map:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
syn_map:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
syn_map:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
syn_map:        }
syn_map:    }
syn_map:}
syn_map:
syn_map:########################################################################
syn_map:# Manual hacks for dirty models
syn_map:########################################################################
syn_map:# .lefs
syn_map:# .libs
syn_map:
syn_map:# lef_filelist originally set in libray_setup.tcl
syn_map:puts "Info: Adding macro info to flow_vars_lef_list in [info script]"
syn_map:set_db flow_vars_lef_list [concat [get_db flow_vars_lef_list] $macro_lef_filelist]
syn_map:set pll_idx [lsearch -regexp [get_db flow_vars_lef_list] {CLKPLL}]
syn_map:set_db flow_vars_lef_list [lreplace [get_db flow_vars_lef_list] $pll_idx $pll_idx]
syn_map:
syn_map:puts "Info: re-writing flow_vars_scan_abstracts in [info script]"
syn_map:set_db flow_vars_scan_abstracts $macro_scan_abstract_filelist
syn_map:}
