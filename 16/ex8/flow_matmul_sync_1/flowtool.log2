route:#@ Begin verbose flow_step activate_views
route:@flow 2: set db [get_db flow_starting_db]
route:@flow 3: set flow [lindex [get_db flow_hier_path] end]
route:@flow 4: set setup_views [get_feature $flow -feature setup_views]
route:@flow 5: set hold_views [get_feature $flow -feature hold_views]
route:@flow 6: set leakage_view [get_feature $flow -feature leakage_view]
route:@flow 7: set dynamic_view [get_feature $flow -feature dynamic_view]
route:@flow 9: if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {...}
route:#@ End verbose flow_step activate_views
route:##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan generate_models opt_signoff}
route:#@ Begin verbose flow_step init_mcpu
route:@flow 2: # Multi host/cpu attributes
route:@flow 3: #-----------------------------------------------------------------------------
route:@flow 4: # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
route:@flow 5: # the specified dist script.  This connects the number of CPUs being reserved
route:@flow 6: # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
route:@flow 7: # a typical environment variable exported by distribution platforms and is
route:@flow 8: # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
route:@flow 9: if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
route:@flow 10: set max_cpus $::env(FLOWTOOL_NUM_CPUS)
route:@flow 11: }
route:@flow 17: switch -glob {innovus} {
route:@@flow 0: set_multi_cpu_usage -verbose -local_cpu   $max_cpus
route:**WARN: (PRL-39):	Number of local CPUs specified (16) > Actual number of CPUs in the host (8). The lower value will be used.
route:set_multi_cpu_usage -local_cpu 8
route:@flow 1: if {[get_feature -feature opt_signoff]} {
route:@flow 2: if {[is_flow -inside flow:opt_signoff]} {...}
route:@flow 6: }
route:@flow 7: if {[get_feature -feature sta_eco]} {...}
route:@flow 13: }
route:#@ End verbose flow_step init_mcpu
