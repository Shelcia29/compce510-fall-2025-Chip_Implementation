syn_map:#@ End verbose flow_step syn_map.init_genus
syn_map:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_map:UM:              1              1                                      init_genus
syn_map:##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan generate_models opt_signoff}
syn_map:#@ Begin verbose flow_step syn_map.pre_syn_map
syn_map:@flow_step(pre_syn_map)  2:     clock_gating import -hierarchical -verbose
syn_map:Importing clock_gating logic from root:
syn_map:Info    : Multimode clock gating check is disabled. [TIM-1000]
syn_map:    Automatically cost grouped 0 clock gate paths.
syn_map:Imported 0 Clock Gating instances
syn_map:
syn_map:@flow_step(pre_syn_map)  3:     # If we're not doing scan insertion, set all clock gates as controllable.
syn_map:@flow_step(pre_syn_map)  4:     # Otherwise check_dft_rules will mark flops driven by them with errors
syn_map:@flow_step(pre_syn_map)  5:     # and they will not b replaced by scan flops. This will give optimistic
syn_map:@flow_step(pre_syn_map)  6:     # area numbers when doing synthesis trials
syn_map:@flow_step(pre_syn_map)  7:     if {![get_feature -feature add_scan]} {
syn_map:                            	# go through all instantiated cgs
syn_map:                            	foreach icg_inst [get_db [get_db insts -if {.base_name==inst_CKLNQD*}] .name] {
syn_map:                            	    puts "Info: ICG: $icg_inst ([get_db [get_db insts $icg_inst] .base_cell.base_name])"
syn_map:                            	    set_db [get_db pins $icg_inst/Q] .dft_controllable "[get_db pins $icg_inst/CP] non_inverting"
syn_map:                            
syn_map:                            	    # prevent Genus from adding RC_CG_INST* hierarchy to instantiated clock gates
syn_map:                            	    # Note, TE has to be connected manually to shift enable later on!
syn_map:                            	    set_db [get_db insts $icg_inst] .lp_clock_gating_exclude true
syn_map:                            	}
syn_map:                            	# go through all automatically inserted cgs
syn_map:                            	foreach aicg_inst [get_db [get_db insts *RC_CGIC_INST] .name] {
syn_map:                            	    if {[llength [get_db pins $aicg_inst/CP]]} {
syn_map:                            		set_db [get_db pins $aicg_inst/Q] .dft_controllable "[get_db pins $aicg_inst/CP] non_inverting"
syn_map:                            	    } elseif {[llength [get_db pins $aicg_inst/CPN]]} {
syn_map:                            		set_db [get_db pins $aicg_inst/Q] .dft_controllable "[get_db pins $aicg_inst/CPN] non_inverting"
syn_map:                            	    } else {
syn_map:                            		puts "Error: No CP nor CPN pin on inst: $aicg_inst. Cannot set cell output as dft_controllable"
syn_map:                            	    }
syn_map:                            	}
syn_map:                                }
syn_map:@flow_step(pre_syn_map) 28:     check_dft_rules
