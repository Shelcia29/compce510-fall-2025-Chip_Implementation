floorplan:#@ Begin verbose flow_step floorplan.create_path_groups
floorplan:@flow 2: #- Clear existing path_groups
floorplan:@@flow 3: reset_path_group -all
floorplan:@flow 5: #- Add basic path_groups
floorplan:**WARN: (TCLCMD-513):	The software could not find a matching object of the specified type for the pattern '*'
floorplan:**ERROR: (TCLCMD-917):	Cannot find 'cells' that match '*'
floorplan:@flow 6: set mems [get_cells -hierarchical -filter "@is_memory_cell"]
floorplan:@flow 7: set icgs [filter_collection [all_registers] "@is_integrated_clock_gating_cell"]
floorplan:@flow 8: set regs [remove_from_collection [all_registers -edge_triggered] $icgs]
floorplan:@flow 10: foreach mode [get_db constraint_modes -if {.is_setup}] {
floorplan:        set_interactive_constraint_mode $mode
floorplan:        group_path -name in2out -from [all_inputs] -to [all_outputs]
floorplan:        if {[sizeof_collection [get_cells $regs]] > 0} {
floorplan:            group_path -name in2reg -from [all_inputs] -to $regs
floorplan:            group_path -name reg2out -from $regs -to [all_outputs]
floorplan:            group_path -name reg2reg -from $regs -to $regs
floorplan:        }
floorplan:        if {[sizeof_collection [get_cells $mems]] > 0} {
floorplan:            group_path -name mem2reg -from $mems -to $regs
floorplan:            group_path -name reg2mem -from $regs -to $mems
floorplan:            group_path -name mem2mem -from $mems -to $mems
floorplan:        }
floorplan:        if {[sizeof_collection [get_cells $icgs]] > 0} {
floorplan:            group_path -name reg2icg -from $regs -to $icgs
floorplan:        }
floorplan:    }
