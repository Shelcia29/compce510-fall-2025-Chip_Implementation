cts:Warning: Overriding project macro setup from local folder
cts:Info: Sourcing scripts/local_macro_setup.tcl
cts:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
cts:@file 1: ################################################################################
cts:@file 2: # Local setup for macros in hierarchical designs
cts:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
cts:@file 4: ################################################################################
cts:@file 5: # Time-stamp: <2025-10-30 09:01:30 qftele>
cts:@file 6: #########################################################################################################
cts:@file 7: # Macro info
cts:@file 8: # List versions of macros used in DUT
cts:@file 9: #########################################################################################################
cts:@file 10: if {1} {
cts:@file 11: array unset global_macro_exportdir
cts:@file 12:
cts:@file 13: set macro_scan_abstract_filelist [list ]
cts:@file 14: set macro_lef_filelist [list ]
cts:@file 15:
cts:@file 16:
cts:@file 17: array unset memarray
cts:@file 18:
cts:@file 19: # Go through global settings for macros and see if there's a local override
cts:@file 20: foreach {blockname blockpath} [array get global_macro_exportdir] {
cts:
cts:    # do not read in a model for DUT
cts:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
cts:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
cts:	continue
cts:    }
cts:
cts:    if {[info exists local_macro_exportdir($blockname)]} {
cts:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
cts:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
cts:	    puts "\#OLD\#: $blockpath"
cts:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
cts:	    set $blockpath $local_macro_exportdir($blockname)
cts:	}
cts:    }
cts:
cts:    # scan abstract for DFT
cts:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
cts:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
cts:    } else {
cts:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
cts:    }
cts:
cts:    # MACROs
cts:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
cts:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
cts:    } else {
cts:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
cts:	exit 1
cts:    }
cts:
cts:    # Read .lib -files
cts:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
cts:    foreach dc $mmmc_vars(delay_corners) {
cts:
cts:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
cts:
cts:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
cts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
cts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
cts:	} else {
cts:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
cts:	    exit 1
cts:	}
cts:    }
cts:}
cts:@file 67: # sanity check to see if global setting are missing block which are defined in local settings!
cts:@file 68: foreach {blockname blockpath} [array get local_macro_exportdir] {
cts:    # do not read in a model for DUT
cts:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
cts:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
cts:	continue
cts:    }
cts:
cts:    set found 0
cts:    if {[info exists global_macro_exportdir($blockname)]} {
cts:	set found 1
cts:    }
cts:
cts:    if {!$found} {
cts:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
cts:    } else {
cts:	# it was found so it's already set
cts:	continue
cts:    }
cts:
cts:    # scan abstract for DFT
cts:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
cts:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
cts:    } else {
cts:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
cts:    }
cts:
cts:    # MACROs
cts:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
cts:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
cts:    } else {
cts:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
cts:	exit 1
cts:    }
cts:
cts:    # Read .lib -files
cts:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
cts:    foreach dc $mmmc_vars(delay_corners) {
cts:
cts:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
cts:
cts:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
cts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
cts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
cts:	} else {
cts:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
cts:	    exit 1
cts:	}
cts:    }
cts:}
cts:@file 117:
cts:@file 118: ########################################################################
cts:@file 119: # Memories
cts:@file 120: ########################################################################
cts:@file 121:
cts:@file 122: set memory_gds_filelist [list]
cts:@file 123: set memory_spi_filelist [list]
cts:@file 124: foreach {memdir memlist} [array get memarray] {
cts:
cts:    set mem_directory ./models
cts:    foreach mem $memlist {
cts:
cts:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
cts:
cts:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
cts:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
cts:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
cts:
cts:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
cts:
cts:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
cts:
cts:        foreach dc $mmmc_vars(delay_corners) {
cts:
cts:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
cts:
cts:	    if {[regexp {SS} $dc]} {
cts:		set volt "0P720V"
cts:		set temp "125C"
cts:	    } else {
cts:		set volt "0P880V"
cts:		set temp "M40C"
cts:	    }
cts:	    
cts:
cts:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
cts:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
cts:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
cts:        }
cts:    }
cts:}
