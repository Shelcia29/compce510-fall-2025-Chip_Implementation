cts:@flow 2: # Multi host/cpu attributes
cts:@flow 3: #-----------------------------------------------------------------------------
cts:@flow 4: # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
cts:@flow 5: # the specified dist script.  This connects the number of CPUs being reserved
cts:@flow 6: # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
cts:@flow 7: # a typical environment variable exported by distribution platforms and is
cts:@flow 8: # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
cts:@flow 9: if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
cts:@flow 10: set max_cpus $::env(FLOWTOOL_NUM_CPUS)
cts:@flow 11: }
cts:@flow 17: switch -glob {innovus} {
cts:@@flow 0: set_multi_cpu_usage -verbose -local_cpu   $max_cpus
cts:**WARN: (PRL-39):	Number of local CPUs specified (16) > Actual number of CPUs in the host (8). The lower value will be used.
cts:set_multi_cpu_usage -local_cpu 8
