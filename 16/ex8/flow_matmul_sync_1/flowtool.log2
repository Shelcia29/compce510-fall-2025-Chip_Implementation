postroute:@flow 11: #- Store non-default root attributes to metrics
postroute:@flow 12: catch {report_obj -tcl} flow_root_config
postroute:@flow 13: if {[dict exists $flow_root_config root:/]} {
postroute:@flow 14: set flow_root_config [dict get $flow_root_config root:/]
