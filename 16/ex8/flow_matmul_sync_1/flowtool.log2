postcts:#@ Begin verbose flow_step postcts.report_postcts.init_innovus
postcts:@flow 3: # Tool settings: NOTE: already set by flow_config.tcl
postcts:@flow 4: #set_multi_cpu_usage -local_cpu 8 -remote_host 1 -cpu_per_remote_host 8
postcts:@flow 6: if {[get_feature -feature report_lec]} {
postcts:@flow 7: # Init attributes  [get_db -category init]
postcts:@flow 8: 	#-------------------------------------------------------------------------------
postcts:@@flow 9: set_db write_lec_directory_naming_style "fv/%s/[get_db flow_report_name]"
postcts:@flow 10:
postcts:@flow 11: }
postcts:@@flow 12: set_db init_design_uniquify 1
postcts:@flow 14: # Design attributes  [get_db -category design]
postcts:@flow 15: #-------------------------------------------------------------------------------
postcts:@@flow 16: set_db design_process_node            45
postcts:##  Process: 45            (User Set)               
postcts:##     Node: (not set)                           
postcts:
postcts:##  Check design process and node:  
postcts:##  Design tech node is not set.
postcts:
postcts:Applying the recommended capacitance filtering threshold values for 45nm process node: total_c_th=0, relative_c_th=1 and coupling_c_th=0.1.
postcts:	These values will be used by all post-route extraction engines, including TQuantus, IQuantus and Quantus QRC extraction.
postcts:	Capacitance filtering mode(extract_rc_cap_filter_mode option of the set_db) is 'relative_and_coupling' for all engines.
postcts:	The accuracy mode for post_route extract_rc_effort_level low extraction will be set to 'high'.
postcts:	Default value for EffortLevel(extract_rc_effort_level option of the set_db) in post_route extraction mode is 'medium'.
postcts:@flow 17: if {[get_feature -feature flow_express]} {...}
postcts:@@flow 20: set_db design_early_clock_flow              true
postcts:@flow 22: # Via naming
postcts:@flow 23: #-------------------------------------------------------------------------------
postcts:@flow 24: # Use design name as prefix for VIAs, as otherwise they will cause collision when merging designs on toplevel
postcts:@@flow 25: set_db write_stream_via_names true
postcts:@flow 27: # Timing attributes  [get_db -category timing && delaycalc]
postcts:@flow 28: #-------------------------------------------------------------------------------
postcts:@@flow 29: set_db timing_analysis_cppr           both
postcts:@@flow 30: set_db timing_analysis_type           ocv
postcts:@@flow 31: set_db timing_report_fields           {timing_point net cell fanout load transition delay incr_delay arrival edge user_derate power_domain}
postcts:@flow 33: #set_db timing_analysis_socv                               true                        ;# Enable socv analysis
postcts:@flow 34: #set_db timing_socv_rc_variation_mode                      true                        ;# Enable interconnect variation mode in SOCV mode
postcts:@flow 35: #set_db  timing_report_enable_verbose_ssta_mode true
postcts:@flow 37: # Add, TL: flow sets this to "no_async", async is default and should be used
postcts:@@flow 38: set_db timing_analysis_async_checks async
postcts:@flow 39: # Add, TL: maybe a bit hazardous... disable default io delay for ports which are unconstrained!
postcts:@flow 40: # if true, will cause hold problems (since launching clock is the receiving clock (with same latency!))
postcts:@@flow 41: set_db timing_apply_default_primary_input_assertion false
postcts:@@flow 43: set_db delaycal_advanced_node_pin_cap_settings true
postcts:@@flow 44: set_db delaycal_advanced_pin_cap_mode true
postcts:@flow 47: # Extraction attributes  [get_db -category extract_rc]
postcts:@flow 48: #-------------------------------------------------------------------------------
postcts:@flow 49: if {[get_feature -feature add_pvs_fill] || [get_feature -feature add_pegasus_beol_fill]} {...}
postcts:@flow 52: if {[is_flow -after flow:opt_signoff] || [is_flow -inside flow:opt_signoff]} {...}
postcts:@flow 58: if {[is_flow -after flow:route]} {...}
postcts:@flow 64: if {0} {...
postcts:@flow 66: } else {
postcts:@@flow 67: set_db delaycal_equivalent_waveform_model               no_propagation
postcts:@flow 68: }
postcts:@@flow 69: set_db si_aggressor_alignment                             timing_aware_edge       
postcts:@flow 71: # Mod, TL: Too few licenses to extract all corners in parallel . Use the following to reduce number of used licenses :
postcts:@flow 72: #set_db extract_rc_qrc_run_mode sequential
postcts:@flow 74: # Floorplan attributes  [get_db -category floorplan]
postcts:@flow 75: #-------------------------------------------------------------------------------
postcts:@@flow 76: set_db finish_floorplan_active_objs   [list macro soft_blockage core]
postcts:@flow 77: # Constraints for even or odd site width/ row height
postcts:@@flow 78: set_db floorplan_row_site_height                          even
postcts:@@flow 79: set_db floorplan_row_site_width                           even
postcts:@flow 81: # Placement attributes  [get_db -category place]
postcts:@flow 82: #-------------------------------------------------------------------------------
postcts:@@flow 83: set_db place_detail_legalization_inst_gap                 1 
postcts:@@flow 84: set_db place_detail_use_no_diffusion_one_site_filler      false                        ;
postcts:@flow 84: # False to not leave 1-site gaps
postcts:@@flow 85: set_db place_detail_filler_gap_min_gap                    0.2
postcts:**WARN: (IMPSP-2904):	option place_detail_filler_gap_effort and place_detail_filler_gap_min_gap will be obsolete from next release and is replaced by place_detail_legalization_inst_gap <site>.
postcts:@@flow 86: set_db place_detail_filler_gap_effort                     high
postcts:**WARN: (IMPSP-2904):	option place_detail_filler_gap_effort and place_detail_filler_gap_min_gap will be obsolete from next release and is replaced by place_detail_legalization_inst_gap <site>.
postcts:@@flow 88: set_db place_global_uniform_density                       true                        ;
postcts:@flow 88: # Enable even cell distribution for designs with less than 70% utilization
postcts:@@flow 90: set_db place_global_place_io_pins               true
postcts:@@flow 91: set_db place_detail_use_check_drc               true
postcts:@flow 92: #set_db place_detail_color_aware_legal           true
postcts:@flow 94: # Tieoff attributes  [get_db -category add_tieoffs]
postcts:@flow 95: #-------------------------------------------------------------------------------
postcts:@@flow 96: set_db add_tieoffs_cells                        [list TIEHI TIELO]
postcts:@flow 97: # tieoff max fanout not honored without this?
postcts:@@flow 98: set_db add_tieoffs_max_fanout 32
postcts:@flow 100: # Optimization attributes  [get_db -category opt]
postcts:@flow 101: #-------------------------------------------------------------------------------
postcts:@@flow 102: set_db opt_fix_hold_allow_setup_tns_degradation           true                        ;
postcts:@flow 102: # When set to true, allows setup total negative slack to degrade during hold optimization.
postcts:@@flow 103: set_db opt_fix_hold_verbose                               true                        ;
postcts:@flow 103: # When set to true, display extra info in the log about remaining hold violations.
postcts:@@flow 104: set_db opt_new_inst_prefix            "[get_db flow_report_name]_"
postcts:@flow 105: # Note, do not use DEL* -cells for hold fixing because of HUGE variation
postcts:@@flow 106: set_db opt_fix_hold_lib_cells                   [list  ]
postcts:**WARN: (IMPOPT-7140):	The "set_db opt_hold_cells" list is empty
postcts:@flow 107: # enable data checks during gigaplace (false by default)
postcts:@flow 108: #set_db opt_enable_data_to_data_checks     true
postcts:@flow 110: # fix max_fanout / max_load violations, false by default
postcts:@@flow 111: set_db opt_fix_fanout_load true
postcts:@flow 113: # Clock attributes  [get_db -category cts]
postcts:@flow 114: #-------------------------------------------------------------------------------
postcts:@@flow 115: set_db cts_top_fanout_threshold                           2000                        ;
postcts:@flow 115: # Minimum number of transitive fanout in the clock tree for a net to be routed as a top net
postcts:@@flow 116: set_db cts_target_skew                          0.15
postcts:@@flow 117: set_db cts_target_max_transition_time           0.10
postcts:@@flow 119: set_db cts_buffer_cells                         [list CLKBUFX12 CLKBUFX16 CLKBUFX2 CLKBUFX20 CLKBUFX3 CLKBUFX4 CLKBUFX6 CLKBUFX8]
postcts:@@flow 120: set_db cts_inverter_cells                       [list CLKINVX1 CLKINVX12 CLKINVX16 CLKINVX2 CLKINVX20 CLKINVX3 CLKINVX4 CLKINVX6 CLKINVX8]
postcts:@@flow 121: set_db cts_clock_gating_cells                   [list TLATNCAX12 TLATNCAX16 TLATNCAX2 TLATNCAX20 TLATNCAX3 TLATNCAX4 TLATNCAX6 TLATNCAX8]
postcts:@@flow 122: set_db cts_logic_cells                          [get_db [get_db base_cells CLK*] .name]
postcts:@flow 124: #- Route types definitions occur during the "init_floorplan" flow_step
postcts:@flow 125: if {[get_db route_types] ne ""} {
postcts:@@flow 126: set_db cts_route_type_leaf                     cts_route_type_leaf
postcts:@@flow 127: set_db cts_route_type_trunk                    cts_route_type_trunk
postcts:@@flow 128: set_db cts_route_type_top                      cts_route_type_top
postcts:@flow 129: }
postcts:@flow 131: # Only use inverters in clock tree, no buffers
postcts:@@flow 132: set_db cts_use_inverters true
postcts:@flow 134: # Use max 32 fanout also in CTS
postcts:@@flow 135: set_db cts_max_fanout 32
postcts:@flow 137: # power balance leakage / dynamic
postcts:@flow 138: #-------------------------------------------------------------------------------
postcts:@flow 139: # Optimize both leakage & dynamic with same weight
postcts:@@flow 140: set_db opt_leakage_to_dynamic_ratio                 0.5
postcts:@flow 142: # Filler attributes  [get_db -category add_fillers]
postcts:@flow 143: #-------------------------------------------------------------------------------
postcts:@flow 144: #set_db add_fillers_avoid_abutment_patterns                "1:1 2:1"                   ;# Avoid 1:1 filler abutment
postcts:@@flow 145: set_db add_fillers_cells                        [list  DECAP10 DECAP2 DECAP3 DECAP4 DECAP5 DECAP6 DECAP7 DECAP8 DECAP9  FILL1 FILL16 FILL2 FILL32 FILL4 FILL64 FILL8  ]
postcts:@@flow 146: set_db add_fillers_no_single_site_gap true
postcts:@flow 147: # Insert fillers to toplevel hierarchy
postcts:@@flow 148: set_db add_fillers_cell_name_style                      flat
postcts:@flow 150: # Routing attributes  [get_db -category route]
