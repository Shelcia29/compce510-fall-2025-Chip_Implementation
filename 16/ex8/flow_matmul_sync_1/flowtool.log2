postcts:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
postcts:@file 1: ################################################################################
postcts:@file 2: # Local setup for macros in hierarchical designs
postcts:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
postcts:@file 4: ################################################################################
postcts:@file 5: # Time-stamp: <2025-10-30 09:01:30 qftele>
postcts:@file 6: #########################################################################################################
postcts:@file 7: # Macro info
postcts:@file 8: # List versions of macros used in DUT
postcts:@file 9: #########################################################################################################
postcts:@file 10: if {1} {
postcts:@file 11: array unset global_macro_exportdir
postcts:@file 12:
postcts:@file 13: set macro_scan_abstract_filelist [list ]
postcts:@file 14: set macro_lef_filelist [list ]
postcts:@file 15:
postcts:@file 16:
postcts:@file 17: array unset memarray
postcts:@file 18:
postcts:@file 19: # Go through global settings for macros and see if there's a local override
postcts:@file 20: foreach {blockname blockpath} [array get global_macro_exportdir] {
postcts:
postcts:    # do not read in a model for DUT
postcts:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
postcts:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
postcts:	continue
postcts:    }
postcts:
postcts:    if {[info exists local_macro_exportdir($blockname)]} {
postcts:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
postcts:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
postcts:	    puts "\#OLD\#: $blockpath"
postcts:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
postcts:	    set $blockpath $local_macro_exportdir($blockname)
postcts:	}
postcts:    }
postcts:
postcts:    # scan abstract for DFT
postcts:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
postcts:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
postcts:    } else {
postcts:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
postcts:    }
postcts:
postcts:    # MACROs
postcts:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
postcts:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
postcts:    } else {
postcts:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
postcts:	exit 1
postcts:    }
postcts:
postcts:    # Read .lib -files
postcts:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
postcts:    foreach dc $mmmc_vars(delay_corners) {
postcts:
postcts:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postcts:
postcts:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postcts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	} else {
postcts:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
postcts:	    exit 1
postcts:	}
postcts:    }
postcts:}
postcts:@file 67: # sanity check to see if global setting are missing block which are defined in local settings!
postcts:@file 68: foreach {blockname blockpath} [array get local_macro_exportdir] {
postcts:    # do not read in a model for DUT
postcts:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
postcts:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
postcts:	continue
postcts:    }
postcts:
postcts:    set found 0
postcts:    if {[info exists global_macro_exportdir($blockname)]} {
postcts:	set found 1
postcts:    }
postcts:
postcts:    if {!$found} {
postcts:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
postcts:    } else {
postcts:	# it was found so it's already set
postcts:	continue
postcts:    }
postcts:
postcts:    # scan abstract for DFT
postcts:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
postcts:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
postcts:    } else {
postcts:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
postcts:    }
postcts:
postcts:    # MACROs
postcts:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
postcts:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
postcts:    } else {
postcts:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
postcts:	exit 1
postcts:    }
postcts:
postcts:    # Read .lib -files
postcts:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
postcts:    foreach dc $mmmc_vars(delay_corners) {
postcts:
postcts:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postcts:
postcts:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postcts:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postcts:	} else {
postcts:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
postcts:	    exit 1
postcts:	}
postcts:    }
postcts:}
postcts:@file 117:
postcts:@file 118: ########################################################################
postcts:@file 119: # Memories
postcts:@file 120: ########################################################################
postcts:@file 121:
postcts:@file 122: set memory_gds_filelist [list]
postcts:@file 123: set memory_spi_filelist [list]
postcts:@file 124: foreach {memdir memlist} [array get memarray] {
postcts:
postcts:    set mem_directory ./models
postcts:    foreach mem $memlist {
postcts:
postcts:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
postcts:
postcts:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
postcts:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
postcts:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
postcts:
postcts:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
postcts:
postcts:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
postcts:
postcts:        foreach dc $mmmc_vars(delay_corners) {
postcts:
postcts:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postcts:
postcts:	    if {[regexp {SS} $dc]} {
postcts:		set volt "0P720V"
postcts:		set temp "125C"
postcts:	    } else {
postcts:		set volt "0P880V"
postcts:		set temp "M40C"
postcts:	    }
postcts:	    
postcts:
postcts:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
postcts:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
postcts:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
postcts:        }
postcts:    }
postcts:}
