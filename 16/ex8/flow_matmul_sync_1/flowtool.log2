syn_generic:#@ Begin verbose source ./scripts/local_macro_setup.tcl
syn_generic:@file(local_macro_setup.tcl) 10: if {1} {
syn_generic:array unset global_macro_exportdir
syn_generic:
syn_generic:set macro_scan_abstract_filelist [list ]
syn_generic:set macro_lef_filelist [list ]
syn_generic:
syn_generic:
syn_generic:array unset memarray
syn_generic:
syn_generic:# Go through global settings for macros and see if there's a local override
syn_generic:foreach {blockname blockpath} [array get global_macro_exportdir] {
syn_generic:
syn_generic:    # do not read in a model for DUT
syn_generic:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
syn_generic:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
syn_generic:	continue
syn_generic:    }
syn_generic:
syn_generic:    if {[info exists local_macro_exportdir($blockname)]} {
syn_generic:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
syn_generic:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
syn_generic:	    puts "\#OLD\#: $blockpath"
syn_generic:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
syn_generic:	    set $blockpath $local_macro_exportdir($blockname)
syn_generic:	}
syn_generic:    }
syn_generic:
syn_generic:    # scan abstract for DFT
syn_generic:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
syn_generic:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
syn_generic:    } else {
syn_generic:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
syn_generic:    }
syn_generic:
syn_generic:    # MACROs
syn_generic:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
syn_generic:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
syn_generic:    } else {
syn_generic:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
syn_generic:	exit 1
syn_generic:    }
syn_generic:
syn_generic:    # Read .lib -files
syn_generic:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
syn_generic:    foreach dc $mmmc_vars(delay_corners) {
syn_generic:
syn_generic:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_generic:
syn_generic:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_generic:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_generic:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_generic:	} else {
syn_generic:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
syn_generic:	    exit 1
syn_generic:	}
syn_generic:    }
syn_generic:}
syn_generic:# sanity check to see if global setting are missing block which are defined in local settings!
syn_generic:foreach {blockname blockpath} [array get local_macro_exportdir] {
syn_generic:    # do not read in a model for DUT
syn_generic:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
syn_generic:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
syn_generic:	continue
syn_generic:    }
syn_generic:
syn_generic:    set found 0
syn_generic:    if {[info exists global_macro_exportdir($blockname)]} {
syn_generic:	set found 1
syn_generic:    }
syn_generic:
syn_generic:    if {!$found} {
syn_generic:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
syn_generic:    } else {
syn_generic:	# it was found so it's already set
syn_generic:	continue
syn_generic:    }
syn_generic:
syn_generic:    # scan abstract for DFT
syn_generic:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
syn_generic:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
syn_generic:    } else {
syn_generic:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
syn_generic:    }
syn_generic:
syn_generic:    # MACROs
syn_generic:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
syn_generic:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
syn_generic:    } else {
syn_generic:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
syn_generic:	exit 1
syn_generic:    }
syn_generic:
syn_generic:    # Read .lib -files
syn_generic:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
syn_generic:    foreach dc $mmmc_vars(delay_corners) {
syn_generic:
syn_generic:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_generic:
syn_generic:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
syn_generic:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_generic:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
syn_generic:	} else {
syn_generic:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
syn_generic:	    exit 1
syn_generic:	}
syn_generic:    }
syn_generic:}
