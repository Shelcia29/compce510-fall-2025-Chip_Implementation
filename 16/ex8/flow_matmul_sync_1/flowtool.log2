syn_generic:#@ Begin verbose source ./scripts/post_elaborate.tcl
syn_generic:@file(post_elaborate.tcl) 5: puts "\nInfo: All macros in design:"
syn_generic:
syn_generic:Info: All macros in design:
syn_generic:@file(post_elaborate.tcl) 6: get_db insts -if {.is_macro==true} -foreach {puts [get_db $object .name]}
syn_generic:@file(post_elaborate.tcl) 7: puts "\n"
syn_generic:
syn_generic:
syn_generic:@file(post_elaborate.tcl) 11: set fp [open [get_db flow_report_directory]/[get_db flow_vars_design_name].memories.txt w]
syn_generic:@file(post_elaborate.tcl) 12: if {[llength [get_db insts -if {.is_memory}]] > 0} {
syn_generic:    get_db insts -if {.is_memory} -foreach {puts $fp "[get_db $object .name] : [get_db $object .base_cell.name]"}
syn_generic:} else {
syn_generic:    puts $fp "no memories found"
syn_generic:}
syn_generic:@file(post_elaborate.tcl) 18: close $fp
syn_generic:@file(post_elaborate.tcl) 20: check_design -multiple_driver -unresolved -undriven > [get_db flow_report_directory]/elaboration/check_design_fatal.txt
syn_generic:
syn_generic:#@ End verbose source ./scripts/post_elaborate.tcl
