syn_opt:########################################################################
syn_opt:# Memories
syn_opt:########################################################################
syn_opt:
syn_opt:set memory_gds_filelist [list]
syn_opt:set memory_spi_filelist [list]
syn_opt:foreach {memdir memlist} [array get memarray] {
syn_opt:
syn_opt:    set mem_directory ./models
syn_opt:    foreach mem $memlist {
syn_opt:
syn_opt:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
syn_opt:
syn_opt:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
syn_opt:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
syn_opt:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
syn_opt:
syn_opt:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
syn_opt:
syn_opt:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
syn_opt:
syn_opt:        foreach dc $mmmc_vars(delay_corners) {
syn_opt:
syn_opt:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_opt:
syn_opt:	    if {[regexp {SS} $dc]} {
syn_opt:		set volt "0P720V"
syn_opt:		set temp "125C"
syn_opt:	    } else {
syn_opt:		set volt "0P880V"
syn_opt:		set temp "M40C"
syn_opt:	    }
syn_opt:	    
syn_opt:
syn_opt:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
syn_opt:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
syn_opt:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
syn_opt:        }
syn_opt:    }
syn_opt:}
