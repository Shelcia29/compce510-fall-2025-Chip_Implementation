floorplan:	if {[string length [dict get $flow_root_config $key]] > 200} {
floorplan:	    dict set flow_root_config $key "\[long value truncated\]"
floorplan:	}
floorplan:    }
floorplan:@@flow 24: set_metric -name flow.root_config -value $flow_root_config
