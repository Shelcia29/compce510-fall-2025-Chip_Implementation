floorplan:#@ Begin verbose flow_step floorplan.innovus_manage_derating
floorplan:@flow 3: # socv not implemented yet
floorplan:@flow 4: if {0} {...}
floorplan:@flow 12: global mmmc_vars
floorplan:@flow 13: foreach setup_dc [get_db [get_db delay_corners -if {.is_setup || .is_hold}] .name] {
floorplan:	# Cell OCV
floorplan:	# Data
floorplan:	set_timing_derate -data  -cell_delay -early -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_data_cell_early)
floorplan:	set_timing_derate -data  -cell_delay -late  -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_data_cell_late)
floorplan:	# Clock
floorplan:	set_timing_derate -clock -cell_delay -early -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_clock_cell_early)
floorplan:	set_timing_derate -clock -cell_delay -late  -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_clock_cell_late)
floorplan:	
floorplan:	# Wire OCV
floorplan:	# Data
floorplan:	set_timing_derate -data  -net_delay  -early -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_data_net_early)
floorplan:	set_timing_derate -data  -net_delay  -late  -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_data_net_late)
floorplan:	# Clock
floorplan:	set_timing_derate -clock -net_delay  -early -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_clock_net_early)
floorplan:	set_timing_derate -clock -net_delay  -late  -delay_corner ${setup_dc} $mmmc_vars(${setup_dc},flat_clock_net_late)
floorplan:    }
floorplan:#@ End verbose flow_step floorplan.innovus_manage_derating
floorplan:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
floorplan:UM:           1.72              1                                      innovus_manage_derating
