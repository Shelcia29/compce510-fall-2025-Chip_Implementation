postroute:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
postroute:@file 1: ################################################################################
postroute:@file 2: # Local setup for macros in hierarchical designs
postroute:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
postroute:@file 4: ################################################################################
postroute:@file 5: # Time-stamp: <2025-10-30 09:01:30 qftele>
postroute:@file 6: #########################################################################################################
postroute:@file 7: # Macro info
postroute:@file 8: # List versions of macros used in DUT
postroute:@file 9: #########################################################################################################
postroute:@file 10: if {1} {
postroute:@file 11: array unset global_macro_exportdir
postroute:@file 12:
postroute:@file 13: set macro_scan_abstract_filelist [list ]
postroute:@file 14: set macro_lef_filelist [list ]
postroute:@file 15:
postroute:@file 16:
postroute:@file 17: array unset memarray
postroute:@file 18:
postroute:@file 19: # Go through global settings for macros and see if there's a local override
postroute:@file 20: foreach {blockname blockpath} [array get global_macro_exportdir] {
postroute:
postroute:    # do not read in a model for DUT
postroute:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
postroute:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
postroute:	continue
postroute:    }
postroute:
postroute:    if {[info exists local_macro_exportdir($blockname)]} {
postroute:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
postroute:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
postroute:	    puts "\#OLD\#: $blockpath"
postroute:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
postroute:	    set $blockpath $local_macro_exportdir($blockname)
postroute:	}
postroute:    }
postroute:
postroute:    # scan abstract for DFT
postroute:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
postroute:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
postroute:    } else {
postroute:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
postroute:    }
postroute:
postroute:    # MACROs
postroute:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
postroute:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
postroute:    } else {
postroute:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
postroute:	exit 1
postroute:    }
postroute:
postroute:    # Read .lib -files
postroute:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
postroute:    foreach dc $mmmc_vars(delay_corners) {
postroute:
postroute:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postroute:
postroute:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postroute:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	} else {
postroute:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
postroute:	    exit 1
postroute:	}
postroute:    }
postroute:}
postroute:@file 67: # sanity check to see if global setting are missing block which are defined in local settings!
postroute:@file 68: foreach {blockname blockpath} [array get local_macro_exportdir] {
postroute:    # do not read in a model for DUT
postroute:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
postroute:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
postroute:	continue
postroute:    }
postroute:
postroute:    set found 0
postroute:    if {[info exists global_macro_exportdir($blockname)]} {
postroute:	set found 1
postroute:    }
postroute:
postroute:    if {!$found} {
postroute:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
postroute:    } else {
postroute:	# it was found so it's already set
postroute:	continue
postroute:    }
postroute:
postroute:    # scan abstract for DFT
postroute:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
postroute:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
postroute:    } else {
postroute:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
postroute:    }
postroute:
postroute:    # MACROs
postroute:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
postroute:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
postroute:    } else {
postroute:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
postroute:	exit 1
postroute:    }
postroute:
postroute:    # Read .lib -files
postroute:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
postroute:    foreach dc $mmmc_vars(delay_corners) {
postroute:
postroute:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postroute:
postroute:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
postroute:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
postroute:	} else {
postroute:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
postroute:	    exit 1
postroute:	}
postroute:    }
postroute:}
postroute:@file 117:
postroute:@file 118: ########################################################################
postroute:@file 119: # Memories
postroute:@file 120: ########################################################################
postroute:@file 121:
postroute:@file 122: set memory_gds_filelist [list]
postroute:@file 123: set memory_spi_filelist [list]
postroute:@file 124: foreach {memdir memlist} [array get memarray] {
postroute:
postroute:    set mem_directory ./models
postroute:    foreach mem $memlist {
postroute:
postroute:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
postroute:
postroute:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
postroute:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
postroute:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
postroute:
postroute:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
postroute:
postroute:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
postroute:
postroute:        foreach dc $mmmc_vars(delay_corners) {
postroute:
postroute:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
postroute:
postroute:	    if {[regexp {SS} $dc]} {
postroute:		set volt "0P720V"
postroute:		set temp "125C"
postroute:	    } else {
postroute:		set volt "0P880V"
postroute:		set temp "M40C"
postroute:	    }
postroute:	    
postroute:
postroute:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
postroute:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
postroute:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
postroute:        }
postroute:    }
postroute:}
