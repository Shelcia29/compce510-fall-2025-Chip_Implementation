syn_generic:@flow_step(report_design_genus)  5:     foreach view_dpo [get_db analysis_views -if {.is_active && (.is_setup || .is_hold)}] {
syn_generic:                                            set cmode [get_db $view_dpo .constraint_mode.name]
syn_generic:                                            if {![info exists cmode_done($cmode)]} {
syn_generic:                                                check_timing_intent -view $view_dpo -verbose        > [file join [get_db flow_report_directory] [get_db flow_report_name] [get_db flow_report_prefix]check_timing_intent.${cmode}.rpt]
syn_generic:                                                set cmode_done($cmode) 1
syn_generic:                                            } else {
syn_generic:                                                continue
syn_generic:                                            }
syn_generic:                                        }
