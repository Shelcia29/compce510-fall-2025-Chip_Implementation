syn_opt:#@ Begin verbose source ./scripts/mmmc_setup.tcl
syn_opt:@file(mmmc_setup.tcl) 6: set MMMC_SETUP_VERSION "v1.0"
syn_opt:@file(mmmc_setup.tcl) 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
syn_opt:Info: MMMC SETUP: gpdk045 : v1.0
syn_opt:@file(mmmc_setup.tcl) 11: set mmmc_vars(delay_corners) \
syn_opt:    [list \
syn_opt:	 slow_0p9v_125c_cmax \
syn_opt:	 fast_1p1v_0c_cmin \
syn_opt:	 ]
syn_opt:@file(mmmc_setup.tcl) 19: foreach dc $mmmc_vars(delay_corners) {
syn_opt:
syn_opt:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_opt:
syn_opt:    # qrc techfile
syn_opt:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
syn_opt:    # temperature
syn_opt:    if {${temp} == "m40c"} {
syn_opt:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
syn_opt:    } elseif {${temp} == "125c"} {
syn_opt:	set mmmc_vars("${rc}_${temp}",temperature) "125"
syn_opt:    } elseif {${temp} == "0c"} {
syn_opt:	set mmmc_vars("${rc}_${temp}",temperature) "0"
syn_opt:    } else {
syn_opt:	set mmmc_vars("${rc}_${temp}",temperature) "25"
syn_opt:    }
syn_opt:
syn_opt:
syn_opt:    ###########################################
syn_opt:    # OCVs &  Clock uncertainties for FLAT OCV
syn_opt:    ###########################################
syn_opt:
syn_opt:    # use following uncertainties
syn_opt:    # FUNC:
syn_opt:    # setup:
syn_opt:    # clock jitter: defined through clock cycle
syn_opt:    # TECH uncertainty: 25ps
syn_opt:    # extra uncertainty (implementation): 20ps
syn_opt:    # extra uncertainty (signoff STA): 0ps
syn_opt:    # hold:
syn_opt:    # TECH uncertainty (SSG): 50ps
syn_opt:    # TECH uncertainty (fast): 40ps
syn_opt:    # extra uncertainty (implementation): 15ps
syn_opt:    # extra uncertainty (signoff STA): 0ps
syn_opt:
syn_opt:    # Note, add 1% OCV on top of previous to match LVF
syn_opt:    # so flat values below have 0.01 added (subtracted) because of this
syn_opt:
syn_opt:    # setup in slow, 0.81v, -40C/125c, cmax
syn_opt:    if {$corn eq "slow" &&
syn_opt:	$volt eq "0p9v" &&
syn_opt:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_opt:	($rc eq "cmax")} {
syn_opt:	
syn_opt:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
syn_opt:	# +2.0% for launching clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
syn_opt:	# hold not checked in this corner
syn_opt:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
syn_opt:	# + 6.9% on data cell
syn_opt:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
syn_opt:
syn_opt:	# -6.0% for clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
syn_opt:	# +6.0% for clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
syn_opt:	# hold not checked in this corner
syn_opt:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
syn_opt:	# +6.0 for data net
syn_opt:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
syn_opt:
syn_opt:    # hold in slow, 0.81v, -40c/125c, cmax
syn_opt:    } elseif {$corn eq "slow" &&
syn_opt:	      $volt eq "0p9v" &&
syn_opt:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_opt:	      ($rc eq "cmax")} {
syn_opt:	
syn_opt:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
syn_opt:	# +3.2% for capturing clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
syn_opt:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
syn_opt:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
syn_opt:	# setup not checked
syn_opt:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
syn_opt:
syn_opt:	# -8.5% for launching clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
syn_opt:	# no derate on capturing clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
syn_opt:	# -8.5% for data net
syn_opt:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
syn_opt:	# setup not checked
syn_opt:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
syn_opt:
syn_opt:    # hold in fast, 0.99v, -40c/0c/125c, cmax
syn_opt:    } elseif {$corn eq "fast" &&
syn_opt:	      $volt eq "1p1v" &&
syn_opt:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_opt:	      ($rc eq "cmax")} {
syn_opt:	
syn_opt:	# -3.7% for launching clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
syn_opt:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
syn_opt:	# -12.1% for data
syn_opt:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
syn_opt:	# setup not checked
syn_opt:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
syn_opt:
syn_opt:	# -8.5% for launching clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
syn_opt:	# no derate on capturing clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
syn_opt:	# -8.5% for data net
syn_opt:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
syn_opt:	# setup not checked
syn_opt:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
syn_opt:
syn_opt:    # hold in fast, 0.99v, -40c/0c/125c, cmin
syn_opt:    } elseif {$corn eq "fast" &&
syn_opt:	      $volt eq "1p1v" &&
syn_opt:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_opt:	      ($rc eq "cmin")} {
syn_opt:	
syn_opt:	# -3.7% for launching clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
syn_opt:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
syn_opt:	# -12.1% for data
syn_opt:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
syn_opt:	# setup not checked
syn_opt:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
syn_opt:
syn_opt:	# no derate on launching clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
syn_opt:	# +8.5% for capturing clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
syn_opt:	# no derate for data net
syn_opt:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
syn_opt:	# setup not checked
syn_opt:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
syn_opt:
syn_opt:    } else {
syn_opt:	puts "Fatal: delay corner ${dc} OCVs not defined (corner: $corn, voltage: $volt, temperature: $temp, rc: ${rc})"
syn_opt:	exit 1
syn_opt:    }
syn_opt:
syn_opt:    ###########################################
syn_opt:    # OCVs &  Clock uncertainties for SOCV
syn_opt:    ###########################################
syn_opt:
syn_opt:    # Note, only voltage and temperature OCVs needed
syn_opt:
syn_opt:    # Early & late variation factors from:
syn_opt:    set mmmc_vars(early_rc_variation_factor) 0.06
syn_opt:    set mmmc_vars(late_rc_variation_factor) 0.06
syn_opt:
syn_opt:    set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
syn_opt:
syn_opt:    # slow, 0.81v, -40c
syn_opt:    if {$corn eq "slow" &&
syn_opt:	$volt eq "0p9v" &&
syn_opt:	$temp eq "m40c"} {
syn_opt:        
syn_opt:        # DATA  @ 20.3mV : 7.4%
syn_opt:        # DATA  @ 10c    : 0.9%
syn_opt:        # CLOCK @ 20.3mV : 5.4%
syn_opt:        # CLOCK @ 10c    : 0.7%
syn_opt:
syn_opt:        # For setup only derate clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
syn_opt:        # For hold in slow derate data & launching clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
syn_opt:
syn_opt:    } elseif {$corn eq "slow" &&
syn_opt:	$volt eq "0p9v" &&
syn_opt:	$temp eq "125c"} {
syn_opt:       
syn_opt:        # DATA  @ 20.3mV : 5.0%
syn_opt:        # DATA  @ 10c    : 0.3%
syn_opt:        # CLOCK @ 20.3mV : 3.5%
syn_opt:        # CLOCK @ 10c    : 0.2%
syn_opt:
syn_opt:        # For setup only derate clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
syn_opt:        # For hold in slow derate data & launching clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
syn_opt:
syn_opt:    } elseif {$corn eq "slow" &&
syn_opt:	$volt eq "0p9v" &&
syn_opt:	$temp eq "0c"} {
syn_opt:       
syn_opt:        # DATA  @ 20.3mV : 6.6%
syn_opt:        # DATA  @ 10c    : 0.8%
syn_opt:        # CLOCK @ 20.3mV : 4.9%
syn_opt:        # CLOCK @ 10c    : 0.6%
syn_opt:
syn_opt:        # For setup only derate clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
syn_opt:        # For hold in slow derate data & launching clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
syn_opt:
syn_opt:    } elseif {$corn eq "fast" &&
syn_opt:	$volt eq "1p1v" &&
syn_opt:	$temp eq "m40c"} {
syn_opt:       
syn_opt:        # DATA  @ 45mV   : 7.4%
syn_opt:        # DATA  @ 10c    : 0.5%
syn_opt:        # CLOCK @ 45mV   : 5.1%
syn_opt:        # CLOCK @ 10c    : 0.6%
syn_opt:
syn_opt:        # For setup only derate clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
syn_opt:        # For hold in slow derate data & launching clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
syn_opt:
syn_opt:     } elseif {$corn eq "fast" &&
syn_opt:	$volt eq "1p1v" &&
syn_opt:	$temp eq "125c"} {
syn_opt:
syn_opt:        # DATA  @ 45mV   : 5.8%
syn_opt:        # DATA  @ 10c    : 0.5%
syn_opt:        # CLOCK @ 45mV   : 3.6%
syn_opt:        # CLOCK @ 10c    : 0.6%
syn_opt:
syn_opt:        # For setup only derate clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
syn_opt:        # For hold in slow derate data & launching clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
syn_opt:
syn_opt:    } elseif {$corn eq "fast" &&
syn_opt:	$volt eq "1p1v" &&
syn_opt:	$temp eq "0c"} {
syn_opt:
syn_opt:        # DATA  @ 45mV   : 7.0%
syn_opt:        # DATA  @ 10c    : 0.4%
syn_opt:        # CLOCK @ 45mV   : 4.7%
syn_opt:        # CLOCK @ 10c    : 0.4%
syn_opt:
syn_opt:        # For setup only derate clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
syn_opt:        # For hold in slow derate data & launching clock
syn_opt:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
syn_opt:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
syn_opt:
syn_opt:     } else {
syn_opt:        puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
syn_opt:        exit 1
syn_opt:    }
syn_opt:}
