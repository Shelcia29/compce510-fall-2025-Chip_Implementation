floorplan:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
floorplan:@file 1: ################################################################################
floorplan:@file 2: # Local setup for macros in hierarchical designs
floorplan:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
floorplan:@file 4: ################################################################################
floorplan:@file 5: # Time-stamp: <2025-10-30 09:01:30 qftele>
floorplan:@file 6: #########################################################################################################
floorplan:@file 7: # Macro info
floorplan:@file 8: # List versions of macros used in DUT
floorplan:@file 9: #########################################################################################################
floorplan:@file 10: if {1} {
floorplan:@file 11: array unset global_macro_exportdir
floorplan:@file 12:
floorplan:@file 13: set macro_scan_abstract_filelist [list ]
floorplan:@file 14: set macro_lef_filelist [list ]
floorplan:@file 15:
floorplan:@file 16:
floorplan:@file 17: array unset memarray
floorplan:@file 18:
floorplan:@file 19: # Go through global settings for macros and see if there's a local override
floorplan:@file 20: foreach {blockname blockpath} [array get global_macro_exportdir] {
floorplan:
floorplan:    # do not read in a model for DUT
floorplan:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
floorplan:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
floorplan:	continue
floorplan:    }
floorplan:
floorplan:    if {[info exists local_macro_exportdir($blockname)]} {
floorplan:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
floorplan:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
floorplan:	    puts "\#OLD\#: $blockpath"
floorplan:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
floorplan:	    set $blockpath $local_macro_exportdir($blockname)
floorplan:	}
floorplan:    }
floorplan:
floorplan:    # scan abstract for DFT
floorplan:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
floorplan:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
floorplan:    } else {
floorplan:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
floorplan:    }
floorplan:
floorplan:    # MACROs
floorplan:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
floorplan:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
floorplan:    } else {
floorplan:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
floorplan:	exit 1
floorplan:    }
floorplan:
floorplan:    # Read .lib -files
floorplan:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
floorplan:    foreach dc $mmmc_vars(delay_corners) {
floorplan:
floorplan:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
floorplan:
floorplan:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
floorplan:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	} else {
floorplan:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
floorplan:	    exit 1
floorplan:	}
floorplan:    }
floorplan:}
floorplan:@file 67: # sanity check to see if global setting are missing block which are defined in local settings!
floorplan:@file 68: foreach {blockname blockpath} [array get local_macro_exportdir] {
floorplan:    # do not read in a model for DUT
floorplan:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
floorplan:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
floorplan:	continue
floorplan:    }
floorplan:
floorplan:    set found 0
floorplan:    if {[info exists global_macro_exportdir($blockname)]} {
floorplan:	set found 1
floorplan:    }
floorplan:
floorplan:    if {!$found} {
floorplan:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
floorplan:    } else {
floorplan:	# it was found so it's already set
floorplan:	continue
floorplan:    }
floorplan:
floorplan:    # scan abstract for DFT
floorplan:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
floorplan:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
floorplan:    } else {
floorplan:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
floorplan:    }
floorplan:
floorplan:    # MACROs
floorplan:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
floorplan:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
floorplan:    } else {
floorplan:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
floorplan:	exit 1
floorplan:    }
floorplan:
floorplan:    # Read .lib -files
floorplan:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
floorplan:    foreach dc $mmmc_vars(delay_corners) {
floorplan:
floorplan:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
floorplan:
floorplan:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
floorplan:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
floorplan:	} else {
floorplan:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
floorplan:	    exit 1
floorplan:	}
floorplan:    }
floorplan:}
floorplan:@file 117:
floorplan:@file 118: ########################################################################
floorplan:@file 119: # Memories
floorplan:@file 120: ########################################################################
floorplan:@file 121:
floorplan:@file 122: set memory_gds_filelist [list]
floorplan:@file 123: set memory_spi_filelist [list]
floorplan:@file 124: foreach {memdir memlist} [array get memarray] {
floorplan:
floorplan:    set mem_directory ./models
floorplan:    foreach mem $memlist {
floorplan:
floorplan:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
floorplan:
floorplan:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
floorplan:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
floorplan:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
floorplan:
floorplan:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
floorplan:
floorplan:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
floorplan:
floorplan:        foreach dc $mmmc_vars(delay_corners) {
floorplan:
floorplan:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
floorplan:
floorplan:	    if {[regexp {SS} $dc]} {
floorplan:		set volt "0P720V"
floorplan:		set temp "125C"
floorplan:	    } else {
floorplan:		set volt "0P880V"
floorplan:		set temp "M40C"
floorplan:	    }
floorplan:	    
floorplan:
floorplan:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
floorplan:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
floorplan:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
floorplan:        }
floorplan:    }
floorplan:}
