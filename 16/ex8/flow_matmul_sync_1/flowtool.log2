sta:Warning: Overriding project mmmc setup from local folder
sta:Info: Sourcing scripts/mmmc_setup.tcl
sta:#@ Begin verbose source scripts/mmmc_setup.tcl (pre)
sta:@file 1: ##############################################################################
sta:@file 2: # Project level Mode & Corner definitions
sta:@file 3: ##############################################################################
sta:@file 4: # Time-stamp: <2025-09-23 16:49:18 qftele>
sta:@file 5:
sta:@file 6: set MMMC_SETUP_VERSION "v1.0"
sta:@file 7: # $TECHNOLOGY is set in tech_setup.tcl
sta:@file 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
sta:Info: MMMC SETUP: gpdk045 : v1.0
sta:@file 9:
sta:@file 10: # Delay corner list
sta:@file 11: set mmmc_vars(delay_corners) \
sta:    [list \
sta:	 slow_0p9v_125c_cmax \
sta:	 fast_1p1v_0c_cmin \
sta:	 ]
sta:@file 16:
sta:@file 17:
sta:@file 18: # Read .lib -files
sta:@file 19: foreach dc $mmmc_vars(delay_corners) {
sta:
sta:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
sta:
sta:    # qrc techfile
sta:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
sta:    # temperature
sta:    if {${temp} == "m40c"} {
sta:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
sta:    } elseif {${temp} == "125c"} {
sta:	set mmmc_vars("${rc}_${temp}",temperature) "125"
sta:    } elseif {${temp} == "0c"} {
sta:	set mmmc_vars("${rc}_${temp}",temperature) "0"
sta:    } else {
sta:	set mmmc_vars("${rc}_${temp}",temperature) "25"
sta:    }
sta:
sta:
sta:    ###########################################
sta:    # OCVs &  Clock uncertainties for FLAT OCV
sta:    ###########################################
sta:
sta:    # use following uncertainties
sta:    # FUNC:
sta:    # setup:
sta:    # clock jitter: defined through clock cycle
sta:    # TECH uncertainty: 25ps
sta:    # extra uncertainty (implementation): 20ps
sta:    # extra uncertainty (signoff STA): 0ps
sta:    # hold:
sta:    # TECH uncertainty (SSG): 50ps
sta:    # TECH uncertainty (fast): 40ps
sta:    # extra uncertainty (implementation): 15ps
sta:    # extra uncertainty (signoff STA): 0ps
sta:
sta:    # Note, add 1% OCV on top of previous to match LVF
sta:    # so flat values below have 0.01 added (subtracted) because of this
sta:
sta:    # setup in slow, 0.81v, -40C/125c, cmax
sta:    if {$corn eq "slow" &&
sta:	$volt eq "0p9v" &&
sta:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
sta:	($rc eq "cmax")} {
sta:	
sta:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
sta:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
sta:	# +2.0% for launching clock cell
sta:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
sta:	# hold not checked in this corner
sta:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
sta:	# + 6.9% on data cell
sta:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
sta:
sta:	# -6.0% for clock net
sta:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
sta:	# +6.0% for clock net
sta:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
sta:	# hold not checked in this corner
sta:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
sta:	# +6.0 for data net
sta:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
sta:
sta:    # hold in slow, 0.81v, -40c/125c, cmax
sta:    } elseif {$corn eq "slow" &&
sta:	      $volt eq "0p9v" &&
sta:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
sta:	      ($rc eq "cmax")} {
sta:	
sta:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
sta:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
sta:	# +3.2% for capturing clock cell
sta:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
sta:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
sta:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
sta:	# setup not checked
sta:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
sta:
sta:	# -8.5% for launching clock net
sta:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
sta:	# no derate on capturing clock net
sta:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
sta:	# -8.5% for data net
sta:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
sta:	# setup not checked
sta:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
sta:
sta:    # hold in fast, 0.99v, -40c/0c/125c, cmax
sta:    } elseif {$corn eq "fast" &&
sta:	      $volt eq "1p1v" &&
sta:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
sta:	      ($rc eq "cmax")} {
sta:	
sta:	# -3.7% for launching clock cell
sta:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
sta:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
sta:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
sta:	# -12.1% for data
sta:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
sta:	# setup not checked
sta:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
sta:
sta:	# -8.5% for launching clock net
sta:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
sta:	# no derate on capturing clock net
sta:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
sta:	# -8.5% for data net
sta:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
sta:	# setup not checked
sta:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
sta:
sta:    # hold in fast, 0.99v, -40c/0c/125c, cmin
sta:    } elseif {$corn eq "fast" &&
sta:	      $volt eq "1p1v" &&
sta:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
sta:	      ($rc eq "cmin")} {
sta:	
sta:	# -3.7% for launching clock cell
sta:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
sta:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
sta:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
sta:	# -12.1% for data
sta:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
sta:	# setup not checked
sta:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
sta:
sta:	# no derate on launching clock net
sta:	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
sta:	# +8.5% for capturing clock net
sta:	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
sta:	# no derate for data net
sta:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
sta:	# setup not checked
sta:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
sta:
sta:    } else {
sta:	puts "Fatal: delay corner ${dc} OCVs not defined (corner: $corn, voltage: $volt, temperature: $temp, rc: ${rc})"
sta:	exit 1
sta:    }
sta:
sta:    ###########################################
sta:    # OCVs &  Clock uncertainties for SOCV
sta:    ###########################################
sta:
sta:    # Note, only voltage and temperature OCVs needed
sta:
sta:    # Early & late variation factors from:
sta:    set mmmc_vars(early_rc_variation_factor) 0.06
sta:    set mmmc_vars(late_rc_variation_factor) 0.06
sta:
sta:    set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
sta:
sta:    # slow, 0.81v, -40c
sta:    if {$corn eq "slow" &&
sta:	$volt eq "0p9v" &&
sta:	$temp eq "m40c"} {
sta:        
sta:        # DATA  @ 20.3mV : 7.4%
sta:        # DATA  @ 10c    : 0.9%
sta:        # CLOCK @ 20.3mV : 5.4%
sta:        # CLOCK @ 10c    : 0.7%
sta:
sta:        # For setup only derate clock
sta:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
sta:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
sta:        # For hold in slow derate data & launching clock
sta:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
sta:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
sta:
sta:    } elseif {$corn eq "slow" &&
sta:	$volt eq "0p9v" &&
sta:	$temp eq "125c"} {
sta:       
sta:        # DATA  @ 20.3mV : 5.0%
sta:        # DATA  @ 10c    : 0.3%
sta:        # CLOCK @ 20.3mV : 3.5%
sta:        # CLOCK @ 10c    : 0.2%
sta:
sta:        # For setup only derate clock
sta:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
sta:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
sta:        # For hold in slow derate data & launching clock
sta:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
sta:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
sta:
sta:    } elseif {$corn eq "slow" &&
sta:	$volt eq "0p9v" &&
sta:	$temp eq "0c"} {
sta:       
sta:        # DATA  @ 20.3mV : 6.6%
sta:        # DATA  @ 10c    : 0.8%
sta:        # CLOCK @ 20.3mV : 4.9%
sta:        # CLOCK @ 10c    : 0.6%
sta:
sta:        # For setup only derate clock
sta:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
sta:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
sta:        # For hold in slow derate data & launching clock
sta:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
sta:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
sta:
sta:    } elseif {$corn eq "fast" &&
sta:	$volt eq "1p1v" &&
sta:	$temp eq "m40c"} {
sta:       
sta:        # DATA  @ 45mV   : 7.4%
sta:        # DATA  @ 10c    : 0.5%
sta:        # CLOCK @ 45mV   : 5.1%
sta:        # CLOCK @ 10c    : 0.6%
sta:
sta:        # For setup only derate clock
sta:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
sta:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
sta:        # For hold in slow derate data & launching clock
sta:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
sta:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
sta:
sta:     } elseif {$corn eq "fast" &&
sta:	$volt eq "1p1v" &&
sta:	$temp eq "125c"} {
sta:
sta:        # DATA  @ 45mV   : 5.8%
sta:        # DATA  @ 10c    : 0.5%
sta:        # CLOCK @ 45mV   : 3.6%
sta:        # CLOCK @ 10c    : 0.6%
sta:
sta:        # For setup only derate clock
sta:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
sta:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
sta:        # For hold in slow derate data & launching clock
sta:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
sta:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
sta:
sta:    } elseif {$corn eq "fast" &&
sta:	$volt eq "1p1v" &&
sta:	$temp eq "0c"} {
sta:
sta:        # DATA  @ 45mV   : 7.0%
sta:        # DATA  @ 10c    : 0.4%
sta:        # CLOCK @ 45mV   : 4.7%
sta:        # CLOCK @ 10c    : 0.4%
sta:
sta:        # For setup only derate clock
sta:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
sta:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
sta:        # For hold in slow derate data & launching clock
sta:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
sta:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
sta:
sta:     } else {
sta:        puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
sta:        exit 1
sta:    }
sta:}
