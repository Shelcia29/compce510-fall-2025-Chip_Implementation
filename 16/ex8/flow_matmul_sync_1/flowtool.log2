syn_map:  if { ![is_attribute -obj_type root $myAttr]} {
syn_map:    define_attribute $myAttr \
syn_map:      -category user_flow \
syn_map:      -data_type [dict get $flow_vars $myAttr type] \
syn_map:      -default [dict get $flow_vars $myAttr default] \
syn_map:      -help_string [dict get $flow_vars $myAttr description] \
syn_map:      -obj_type root
syn_map:    }
syn_map:}
