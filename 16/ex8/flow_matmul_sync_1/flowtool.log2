floorplan:@file 173: # Transform all dict to attribute
floorplan:@file 174: foreach myAttr [dict keys $flow_vars] {
floorplan:  if { ![is_attribute -obj_type root $myAttr]} {
floorplan:    define_attribute $myAttr \
floorplan:      -category user_flow \
floorplan:      -data_type [dict get $flow_vars $myAttr type] \
floorplan:      -default [dict get $flow_vars $myAttr default] \
floorplan:      -help_string [dict get $flow_vars $myAttr description] \
floorplan:      -obj_type root
floorplan:    }
floorplan:}
