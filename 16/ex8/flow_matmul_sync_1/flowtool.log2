cts:Warning: Overriding project mmmc setup from local folder
cts:Info: Sourcing scripts/mmmc_setup.tcl
cts:#@ Begin verbose source scripts/mmmc_setup.tcl (pre)
cts:@file 1: ##############################################################################
cts:@file 2: # Project level Mode & Corner definitions
cts:@file 3: ##############################################################################
cts:@file 4: # Time-stamp: <2025-09-23 16:49:18 qftele>
cts:@file 5:
cts:@file 6: set MMMC_SETUP_VERSION "v1.0"
cts:@file 7: # $TECHNOLOGY is set in tech_setup.tcl
cts:@file 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
cts:Info: MMMC SETUP: gpdk045 : v1.0
cts:@file 9:
cts:@file 10: # Delay corner list
cts:@file 11: set mmmc_vars(delay_corners) \
cts:    [list \
cts:	 slow_0p9v_125c_cmax \
cts:	 fast_1p1v_0c_cmin \
cts:	 ]
cts:@file 16:
cts:@file 17:
cts:@file 18: # Read .lib -files
cts:@file 19: foreach dc $mmmc_vars(delay_corners) {
cts:
cts:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
cts:
cts:    # qrc techfile
cts:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
cts:    # temperature
cts:    if {${temp} == "m40c"} {
cts:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
cts:    } elseif {${temp} == "125c"} {
cts:	set mmmc_vars("${rc}_${temp}",temperature) "125"
cts:    } elseif {${temp} == "0c"} {
cts:	set mmmc_vars("${rc}_${temp}",temperature) "0"
cts:    } else {
cts:	set mmmc_vars("${rc}_${temp}",temperature) "25"
cts:    }
cts:
cts:
cts:    ###########################################
cts:    # OCVs &  Clock uncertainties for FLAT OCV
cts:    ###########################################
cts:
cts:    # use following uncertainties
cts:    # FUNC:
cts:    # setup:
cts:    # clock jitter: defined through clock cycle
cts:    # TECH uncertainty: 25ps
cts:    # extra uncertainty (implementation): 20ps
cts:    # extra uncertainty (signoff STA): 0ps
cts:    # hold:
cts:    # TECH uncertainty (SSG): 50ps
cts:    # TECH uncertainty (fast): 40ps
cts:    # extra uncertainty (implementation): 15ps
cts:    # extra uncertainty (signoff STA): 0ps
cts:
cts:    # Note, add 1% OCV on top of previous to match LVF
cts:    # so flat values below have 0.01 added (subtracted) because of this
cts:
cts:    # setup in slow, 0.81v, -40C/125c, cmax
cts:    if {$corn eq "slow" &&
cts:	$volt eq "0p9v" &&
cts:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
cts:	($rc eq "cmax")} {
cts:	
cts:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
cts:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
cts:	# +2.0% for launching clock cell
cts:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
cts:	# hold not checked in this corner
cts:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
cts:	# + 6.9% on data cell
cts:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
cts:
cts:	# -6.0% for clock net
cts:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
cts:	# +6.0% for clock net
cts:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
cts:	# hold not checked in this corner
cts:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
cts:	# +6.0 for data net
cts:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
cts:
cts:    # hold in slow, 0.81v, -40c/125c, cmax
cts:    } elseif {$corn eq "slow" &&
cts:	      $volt eq "0p9v" &&
cts:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
cts:	      ($rc eq "cmax")} {
cts:	
cts:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
cts:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
cts:	# +3.2% for capturing clock cell
cts:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
cts:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
cts:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
cts:	# setup not checked
cts:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
cts:
cts:	# -8.5% for launching clock net
cts:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
cts:	# no derate on capturing clock net
cts:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
cts:	# -8.5% for data net
cts:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
cts:	# setup not checked
cts:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
cts:
cts:    # hold in fast, 0.99v, -40c/0c/125c, cmax
cts:    } elseif {$corn eq "fast" &&
cts:	      $volt eq "1p1v" &&
cts:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
cts:	      ($rc eq "cmax")} {
cts:	
cts:	# -3.7% for launching clock cell
cts:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
cts:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
cts:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
cts:	# -12.1% for data
cts:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
cts:	# setup not checked
cts:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
cts:
cts:	# -8.5% for launching clock net
cts:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
cts:	# no derate on capturing clock net
cts:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
cts:	# -8.5% for data net
cts:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
cts:	# setup not checked
cts:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
cts:
cts:    # hold in fast, 0.99v, -40c/0c/125c, cmin
cts:    } elseif {$corn eq "fast" &&
cts:	      $volt eq "1p1v" &&
cts:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
cts:	      ($rc eq "cmin")} {
cts:	
cts:	# -3.7% for launching clock cell
cts:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
cts:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
cts:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
cts:	# -12.1% for data
cts:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
cts:	# setup not checked
cts:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
cts:
cts:	# no derate on launching clock net
cts:	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
cts:	# +8.5% for capturing clock net
cts:	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
cts:	# no derate for data net
cts:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
cts:	# setup not checked
cts:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
cts:
cts:    } else {
cts:	puts "Fatal: delay corner ${dc} OCVs not defined (corner: $corn, voltage: $volt, temperature: $temp, rc: ${rc})"
cts:	exit 1
cts:    }
cts:
cts:    ###########################################
cts:    # OCVs &  Clock uncertainties for SOCV
cts:    ###########################################
cts:
cts:    # Note, only voltage and temperature OCVs needed
cts:
cts:    # Early & late variation factors from:
cts:    set mmmc_vars(early_rc_variation_factor) 0.06
cts:    set mmmc_vars(late_rc_variation_factor) 0.06
cts:
cts:    set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
cts:
cts:    # slow, 0.81v, -40c
cts:    if {$corn eq "slow" &&
cts:	$volt eq "0p9v" &&
cts:	$temp eq "m40c"} {
cts:        
cts:        # DATA  @ 20.3mV : 7.4%
cts:        # DATA  @ 10c    : 0.9%
cts:        # CLOCK @ 20.3mV : 5.4%
cts:        # CLOCK @ 10c    : 0.7%
cts:
cts:        # For setup only derate clock
cts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
cts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
cts:        # For hold in slow derate data & launching clock
cts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
cts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
cts:
cts:    } elseif {$corn eq "slow" &&
cts:	$volt eq "0p9v" &&
cts:	$temp eq "125c"} {
cts:       
cts:        # DATA  @ 20.3mV : 5.0%
cts:        # DATA  @ 10c    : 0.3%
cts:        # CLOCK @ 20.3mV : 3.5%
cts:        # CLOCK @ 10c    : 0.2%
cts:
cts:        # For setup only derate clock
cts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
cts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
cts:        # For hold in slow derate data & launching clock
cts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
cts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
cts:
cts:    } elseif {$corn eq "slow" &&
cts:	$volt eq "0p9v" &&
cts:	$temp eq "0c"} {
cts:       
cts:        # DATA  @ 20.3mV : 6.6%
cts:        # DATA  @ 10c    : 0.8%
cts:        # CLOCK @ 20.3mV : 4.9%
cts:        # CLOCK @ 10c    : 0.6%
cts:
cts:        # For setup only derate clock
cts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
cts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
cts:        # For hold in slow derate data & launching clock
cts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
cts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
cts:
cts:    } elseif {$corn eq "fast" &&
cts:	$volt eq "1p1v" &&
cts:	$temp eq "m40c"} {
cts:       
cts:        # DATA  @ 45mV   : 7.4%
cts:        # DATA  @ 10c    : 0.5%
cts:        # CLOCK @ 45mV   : 5.1%
cts:        # CLOCK @ 10c    : 0.6%
cts:
cts:        # For setup only derate clock
cts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
cts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
cts:        # For hold in slow derate data & launching clock
cts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
cts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
cts:
cts:     } elseif {$corn eq "fast" &&
cts:	$volt eq "1p1v" &&
cts:	$temp eq "125c"} {
cts:
cts:        # DATA  @ 45mV   : 5.8%
cts:        # DATA  @ 10c    : 0.5%
cts:        # CLOCK @ 45mV   : 3.6%
cts:        # CLOCK @ 10c    : 0.6%
cts:
cts:        # For setup only derate clock
cts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
cts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
cts:        # For hold in slow derate data & launching clock
cts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
cts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
cts:
cts:    } elseif {$corn eq "fast" &&
cts:	$volt eq "1p1v" &&
cts:	$temp eq "0c"} {
cts:
cts:        # DATA  @ 45mV   : 7.0%
cts:        # DATA  @ 10c    : 0.4%
cts:        # CLOCK @ 45mV   : 4.7%
cts:        # CLOCK @ 10c    : 0.4%
cts:
cts:        # For setup only derate clock
cts:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
cts:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
cts:        # For hold in slow derate data & launching clock
cts:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
cts:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
cts:
cts:     } else {
cts:        puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
cts:        exit 1
cts:    }
cts:}
