prects:Warning: Overriding project mmmc setup from local folder
prects:Info: Sourcing scripts/mmmc_setup.tcl
prects:#@ Begin verbose source scripts/mmmc_setup.tcl (pre)
prects:@file 1: ##############################################################################
prects:@file 2: # Project level Mode & Corner definitions
prects:@file 3: ##############################################################################
prects:@file 4: # Time-stamp: <2025-09-23 16:49:18 qftele>
prects:@file 5:
prects:@file 6: set MMMC_SETUP_VERSION "v1.0"
prects:@file 7: # $TECHNOLOGY is set in tech_setup.tcl
prects:@file 8: puts "Info: MMMC SETUP: $TECHNOLOGY : $MMMC_SETUP_VERSION"
prects:Info: MMMC SETUP: gpdk045 : v1.0
prects:@file 9:
prects:@file 10: # Delay corner list
prects:@file 11: set mmmc_vars(delay_corners) \
prects:    [list \
prects:	 slow_0p9v_125c_cmax \
prects:	 fast_1p1v_0c_cmin \
prects:	 ]
prects:@file 16:
prects:@file 17:
prects:@file 18: # Read .lib -files
prects:@file 19: foreach dc $mmmc_vars(delay_corners) {
prects:
prects:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
prects:
prects:    # qrc techfile
prects:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
prects:    # temperature
prects:    if {${temp} == "m40c"} {
prects:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
prects:    } elseif {${temp} == "125c"} {
prects:	set mmmc_vars("${rc}_${temp}",temperature) "125"
prects:    } elseif {${temp} == "0c"} {
prects:	set mmmc_vars("${rc}_${temp}",temperature) "0"
prects:    } else {
prects:	set mmmc_vars("${rc}_${temp}",temperature) "25"
prects:    }
prects:
prects:
prects:    ###########################################
prects:    # OCVs &  Clock uncertainties for FLAT OCV
prects:    ###########################################
prects:
prects:    # use following uncertainties
prects:    # FUNC:
prects:    # setup:
prects:    # clock jitter: defined through clock cycle
prects:    # TECH uncertainty: 25ps
prects:    # extra uncertainty (implementation): 20ps
prects:    # extra uncertainty (signoff STA): 0ps
prects:    # hold:
prects:    # TECH uncertainty (SSG): 50ps
prects:    # TECH uncertainty (fast): 40ps
prects:    # extra uncertainty (implementation): 15ps
prects:    # extra uncertainty (signoff STA): 0ps
prects:
prects:    # Note, add 1% OCV on top of previous to match LVF
prects:    # so flat values below have 0.01 added (subtracted) because of this
prects:
prects:    # setup in slow, 0.81v, -40C/125c, cmax
prects:    if {$corn eq "slow" &&
prects:	$volt eq "0p9v" &&
prects:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
prects:	($rc eq "cmax")} {
prects:	
prects:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
prects:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
prects:	# +2.0% for launching clock cell
prects:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
prects:	# hold not checked in this corner
prects:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
prects:	# + 6.9% on data cell
prects:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
prects:
prects:	# -6.0% for clock net
prects:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
prects:	# +6.0% for clock net
prects:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
prects:	# hold not checked in this corner
prects:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
prects:	# +6.0 for data net
prects:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
prects:
prects:    # hold in slow, 0.81v, -40c/125c, cmax
prects:    } elseif {$corn eq "slow" &&
prects:	      $volt eq "0p9v" &&
prects:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
prects:	      ($rc eq "cmax")} {
prects:	
prects:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
prects:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
prects:	# +3.2% for capturing clock cell
prects:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
prects:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
prects:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
prects:	# setup not checked
prects:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
prects:
prects:	# -8.5% for launching clock net
prects:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
prects:	# no derate on capturing clock net
prects:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
prects:	# -8.5% for data net
prects:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
prects:	# setup not checked
prects:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
prects:
prects:    # hold in fast, 0.99v, -40c/0c/125c, cmax
prects:    } elseif {$corn eq "fast" &&
prects:	      $volt eq "1p1v" &&
prects:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
prects:	      ($rc eq "cmax")} {
prects:	
prects:	# -3.7% for launching clock cell
prects:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
prects:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
prects:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
prects:	# -12.1% for data
prects:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
prects:	# setup not checked
prects:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
prects:
prects:	# -8.5% for launching clock net
prects:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
prects:	# no derate on capturing clock net
prects:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
prects:	# -8.5% for data net
prects:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
prects:	# setup not checked
prects:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
prects:
prects:    # hold in fast, 0.99v, -40c/0c/125c, cmin
prects:    } elseif {$corn eq "fast" &&
prects:	      $volt eq "1p1v" &&
prects:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
prects:	      ($rc eq "cmin")} {
prects:	
prects:	# -3.7% for launching clock cell
prects:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
prects:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
prects:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
prects:	# -12.1% for data
prects:	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
prects:	# setup not checked
prects:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
prects:
prects:	# no derate on launching clock net
prects:	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
prects:	# +8.5% for capturing clock net
prects:	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
prects:	# no derate for data net
prects:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
prects:	# setup not checked
prects:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
prects:
prects:    } else {
prects:	puts "Fatal: delay corner ${dc} OCVs not defined (corner: $corn, voltage: $volt, temperature: $temp, rc: ${rc})"
prects:	exit 1
prects:    }
prects:
prects:    ###########################################
prects:    # OCVs &  Clock uncertainties for SOCV
prects:    ###########################################
prects:
prects:    # Note, only voltage and temperature OCVs needed
prects:
prects:    # Early & late variation factors from:
prects:    set mmmc_vars(early_rc_variation_factor) 0.06
prects:    set mmmc_vars(late_rc_variation_factor) 0.06
prects:
prects:    set mmmc_vars(timing_socv_analysis_nsigma_multiplier) 3
prects:
prects:    # slow, 0.81v, -40c
prects:    if {$corn eq "slow" &&
prects:	$volt eq "0p9v" &&
prects:	$temp eq "m40c"} {
prects:        
prects:        # DATA  @ 20.3mV : 7.4%
prects:        # DATA  @ 10c    : 0.9%
prects:        # CLOCK @ 20.3mV : 5.4%
prects:        # CLOCK @ 10c    : 0.7%
prects:
prects:        # For setup only derate clock
prects:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
prects:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
prects:        # For hold in slow derate data & launching clock
prects:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
prects:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
prects:
prects:    } elseif {$corn eq "slow" &&
prects:	$volt eq "0p9v" &&
prects:	$temp eq "125c"} {
prects:       
prects:        # DATA  @ 20.3mV : 5.0%
prects:        # DATA  @ 10c    : 0.3%
prects:        # CLOCK @ 20.3mV : 3.5%
prects:        # CLOCK @ 10c    : 0.2%
prects:
prects:        # For setup only derate clock
prects:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
prects:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
prects:        # For hold in slow derate data & launching clock
prects:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
prects:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
prects:
prects:    } elseif {$corn eq "slow" &&
prects:	$volt eq "0p9v" &&
prects:	$temp eq "0c"} {
prects:       
prects:        # DATA  @ 20.3mV : 6.6%
prects:        # DATA  @ 10c    : 0.8%
prects:        # CLOCK @ 20.3mV : 4.9%
prects:        # CLOCK @ 10c    : 0.6%
prects:
prects:        # For setup only derate clock
prects:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
prects:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
prects:        # For hold in slow derate data & launching clock
prects:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
prects:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
prects:
prects:    } elseif {$corn eq "fast" &&
prects:	$volt eq "1p1v" &&
prects:	$temp eq "m40c"} {
prects:       
prects:        # DATA  @ 45mV   : 7.4%
prects:        # DATA  @ 10c    : 0.5%
prects:        # CLOCK @ 45mV   : 5.1%
prects:        # CLOCK @ 10c    : 0.6%
prects:
prects:        # For setup only derate clock
prects:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.057"
prects:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
prects:        # For hold in slow derate data & launching clock
prects:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.057"
prects:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
prects:
prects:     } elseif {$corn eq "fast" &&
prects:	$volt eq "1p1v" &&
prects:	$temp eq "125c"} {
prects:
prects:        # DATA  @ 45mV   : 5.8%
prects:        # DATA  @ 10c    : 0.5%
prects:        # CLOCK @ 45mV   : 3.6%
prects:        # CLOCK @ 10c    : 0.6%
prects:
prects:        # For setup only derate clock
prects:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
prects:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
prects:        # For hold in slow derate data & launching clock
prects:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.042"
prects:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
prects:
prects:    } elseif {$corn eq "fast" &&
prects:	$volt eq "1p1v" &&
prects:	$temp eq "0c"} {
prects:
prects:        # DATA  @ 45mV   : 7.0%
prects:        # DATA  @ 10c    : 0.4%
prects:        # CLOCK @ 45mV   : 4.7%
prects:        # CLOCK @ 10c    : 0.4%
prects:
prects:        # For setup only derate clock
prects:	set mmmc_vars(${dc},socv_clock_cell_late)   "0.051"
prects:	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
prects:        # For hold in slow derate data & launching clock
prects:	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.051"
prects:	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
prects:
prects:     } else {
prects:        puts "Fatal: corner / voltage / temperature combination not allowed (corner: $corn, voltage: $volt, temperature: $temp)"
prects:        exit 1
prects:    }
prects:}
