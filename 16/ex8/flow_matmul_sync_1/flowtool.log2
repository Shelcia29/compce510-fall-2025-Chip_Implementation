syn_opt:Info: MMMC SETUP: gpdk045 : v1.0
syn_opt:@file(mmmc_setup.tcl) 11: set mmmc_vars(delay_corners) \
syn_opt:    [list \
syn_opt:	 slow_0p9v_125c_cmax \
syn_opt:	 fast_1p1v_0c_cmin \
syn_opt:	 ]
syn_opt:@file(mmmc_setup.tcl) 19: foreach dc $mmmc_vars(delay_corners) {
syn_opt:
syn_opt:    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
syn_opt:
syn_opt:    # qrc techfile
syn_opt:    set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
syn_opt:    # temperature
syn_opt:    if {${temp} == "m40c"} {
syn_opt:	set mmmc_vars("${rc}_${temp}",temperature) "-40"
syn_opt:    } elseif {${temp} == "125c"} {
syn_opt:	set mmmc_vars("${rc}_${temp}",temperature) "125"
syn_opt:    } elseif {${temp} == "0c"} {
syn_opt:	set mmmc_vars("${rc}_${temp}",temperature) "0"
syn_opt:    } else {
syn_opt:	set mmmc_vars("${rc}_${temp}",temperature) "25"
syn_opt:    }
syn_opt:
syn_opt:
syn_opt:    ###########################################
syn_opt:    # OCVs &  Clock uncertainties for FLAT OCV
syn_opt:    ###########################################
syn_opt:
syn_opt:    # use following uncertainties
syn_opt:    # FUNC:
syn_opt:    # setup:
syn_opt:    # clock jitter: defined through clock cycle
syn_opt:    # TECH uncertainty: 25ps
syn_opt:    # extra uncertainty (implementation): 20ps
syn_opt:    # extra uncertainty (signoff STA): 0ps
syn_opt:    # hold:
syn_opt:    # TECH uncertainty (SSG): 50ps
syn_opt:    # TECH uncertainty (fast): 40ps
syn_opt:    # extra uncertainty (implementation): 15ps
syn_opt:    # extra uncertainty (signoff STA): 0ps
syn_opt:
syn_opt:    # Note, add 1% OCV on top of previous to match LVF
syn_opt:    # so flat values below have 0.01 added (subtracted) because of this
syn_opt:
syn_opt:    # setup in slow, 0.81v, -40C/125c, cmax
syn_opt:    if {$corn eq "slow" &&
syn_opt:	$volt eq "0p9v" &&
syn_opt:	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_opt:	($rc eq "cmax")} {
syn_opt:	
syn_opt:	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
syn_opt:	# +2.0% for launching clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
syn_opt:	# hold not checked in this corner
syn_opt:	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
syn_opt:	# + 6.9% on data cell
syn_opt:	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
syn_opt:
syn_opt:	# -6.0% for clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
syn_opt:	# +6.0% for clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
syn_opt:	# hold not checked in this corner
syn_opt:	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
syn_opt:	# +6.0 for data net
syn_opt:	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
syn_opt:
syn_opt:    # hold in slow, 0.81v, -40c/125c, cmax
syn_opt:    } elseif {$corn eq "slow" &&
syn_opt:	      $volt eq "0p9v" &&
syn_opt:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_opt:	      ($rc eq "cmax")} {
syn_opt:	
syn_opt:	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
syn_opt:	# +3.2% for capturing clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
syn_opt:	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
syn_opt:	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
syn_opt:	# setup not checked
syn_opt:	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
syn_opt:
syn_opt:	# -8.5% for launching clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
syn_opt:	# no derate on capturing clock net
syn_opt:	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
syn_opt:	# -8.5% for data net
syn_opt:	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
syn_opt:	# setup not checked
syn_opt:	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
syn_opt:
syn_opt:    # hold in fast, 0.99v, -40c/0c/125c, cmax
syn_opt:    } elseif {$corn eq "fast" &&
syn_opt:	      $volt eq "1p1v" &&
syn_opt:	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
syn_opt:	      ($rc eq "cmax")} {
syn_opt:	
syn_opt:	# -3.7% for launching clock cell
syn_opt:	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
syn_opt:	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
