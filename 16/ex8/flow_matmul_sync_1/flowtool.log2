floorplan:#@ Begin verbose flow_step activate_views
floorplan:@flow 2: set db [get_db flow_starting_db]
floorplan:@flow 3: set flow [lindex [get_db flow_hier_path] end]
floorplan:@flow 4: set setup_views [get_feature $flow -feature setup_views]
floorplan:@flow 5: set hold_views [get_feature $flow -feature hold_views]
floorplan:@flow 6: set leakage_view [get_feature $flow -feature leakage_view]
floorplan:@flow 7: set dynamic_view [get_feature $flow -feature dynamic_view]
floorplan:@flow 9: if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {...}
floorplan:#@ End verbose flow_step activate_views
