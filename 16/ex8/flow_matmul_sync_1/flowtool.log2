sta:#@ Begin verbose source scripts/local_macro_setup.tcl (pre)
sta:@file 1: ################################################################################
sta:@file 2: # Local setup for macros in hierarchical designs
sta:@file 3: # Setup lef & libs fr tools, regardless of whether DUT contains any macros
sta:@file 4: ################################################################################
sta:@file 5: # Time-stamp: <2025-10-30 09:01:30 qftele>
sta:@file 6: #########################################################################################################
sta:@file 7: # Macro info
sta:@file 8: # List versions of macros used in DUT
sta:@file 9: #########################################################################################################
sta:@file 10: if {1} {
sta:@file 11: array unset global_macro_exportdir
sta:@file 12:
sta:@file 13: set macro_scan_abstract_filelist [list ]
sta:@file 14: set macro_lef_filelist [list ]
sta:@file 15:
sta:@file 16:
sta:@file 17: array unset memarray
sta:@file 18:
sta:@file 19: # Go through global settings for macros and see if there's a local override
sta:@file 20: foreach {blockname blockpath} [array get global_macro_exportdir] {
sta:
sta:    # do not read in a model for DUT
sta:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
sta:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
sta:	continue
sta:    }
sta:
sta:    if {[info exists local_macro_exportdir($blockname)]} {
sta:	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
sta:	    puts "Warning([info script]): Overriding global setting for $blockname ->"
sta:	    puts "\#OLD\#: $blockpath"
sta:	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
sta:	    set $blockpath $local_macro_exportdir($blockname)
sta:	}
sta:    }
sta:
sta:    # scan abstract for DFT
sta:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
sta:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
sta:    } else {
sta:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
sta:    }
sta:
sta:    # MACROs
sta:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
sta:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
sta:    } else {
sta:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
sta:	exit 1
sta:    }
sta:
sta:    # Read .lib -files
sta:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
sta:    foreach dc $mmmc_vars(delay_corners) {
sta:
sta:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
sta:
sta:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
sta:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	} else {
sta:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
sta:	    exit 1
sta:	}
sta:    }
sta:}
sta:@file 67: # sanity check to see if global setting are missing block which are defined in local settings!
sta:@file 68: foreach {blockname blockpath} [array get local_macro_exportdir] {
sta:    # do not read in a model for DUT
sta:    if {![string compare $blockname [get_db flow_vars_design_name]]} {
sta:	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
sta:	continue
sta:    }
sta:
sta:    set found 0
sta:    if {[info exists global_macro_exportdir($blockname)]} {
sta:	set found 1
sta:    }
sta:
sta:    if {!$found} {
sta:	puts "Warning([info script]): Global setting for $blockname set in local setting not found from global settings! Report this to project toplevel!"	
sta:    } else {
sta:	# it was found so it's already set
sta:	continue
sta:    }
sta:
sta:    # scan abstract for DFT
sta:    if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
sta:	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
sta:    } else {
sta:	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
sta:    }
sta:
sta:    # MACROs
sta:    if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
sta:	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
sta:    } else {
sta:	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
sta:	exit 1
sta:    }
sta:
sta:    # Read .lib -files
sta:    # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
sta:    foreach dc $mmmc_vars(delay_corners) {
sta:
sta:	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
sta:
sta:	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
sta:	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
sta:	} else {
sta:	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
sta:	    exit 1
sta:	}
sta:    }
sta:}
sta:@file 117:
sta:@file 118: ########################################################################
sta:@file 119: # Memories
sta:@file 120: ########################################################################
sta:@file 121:
sta:@file 122: set memory_gds_filelist [list]
sta:@file 123: set memory_spi_filelist [list]
sta:@file 124: foreach {memdir memlist} [array get memarray] {
sta:
sta:    set mem_directory ./models
sta:    foreach mem $memlist {
sta:
sta:        lappend macro_lef_filelist ${mem_directory}/${mem}.lef
sta:
sta:        # lappend macro_scan_abstract_filelist ${mem_directory}/${mem}/${mem}.ctl
sta:        #lappend dft_library ${mem_directory}/model/verilog/${mem}.v
sta:        #lappend dft_ncsim_library ${mem_directory}/model/verilog/${mem}.v
sta:
sta:        #lappend memory_gds_filelist ${mem_directory}/gds/${mem}.gds
sta:
sta:        #lappend memory_spi_filelist ${mem_directory}/cdl/${mem}.cdl
sta:
sta:        foreach dc $mmmc_vars(delay_corners) {
sta:
sta:	    regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
sta:
sta:	    if {[regexp {SS} $dc]} {
sta:		set volt "0P720V"
sta:		set temp "125C"
sta:	    } else {
sta:		set volt "0P880V"
sta:		set temp "M40C"
sta:	    }
sta:	    
sta:
sta:            lappend mmmc_vars(${dc},timing_nldm) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
sta:            lappend mmmc_vars(${dc},timing_ccs) ${mem_directory}/${mem}.slow_0p9v_125c_cmax_func.lib
sta:            #lappend mmmc_vars(${dc},timing_lvf) ${mem_directory}/${mem}/${mem}_${corn}g_${rc}_${volt}_${volt}_${temp}.lib_ecsm_tv
sta:        }
sta:    }
sta:}
