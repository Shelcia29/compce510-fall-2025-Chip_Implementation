[11/14 15:15:00     12s] @file 174: foreach myAttr [dict keys $flow_vars] {
[11/14 15:15:00     12s]   if { ![is_attribute -obj_type root $myAttr]} {
[11/14 15:15:00     12s]     define_attribute $myAttr \
[11/14 15:15:00     12s]       -category user_flow \
[11/14 15:15:00     12s]       -data_type [dict get $flow_vars $myAttr type] \
[11/14 15:15:00     12s]       -default [dict get $flow_vars $myAttr default] \
[11/14 15:15:00     12s]       -help_string [dict get $flow_vars $myAttr description] \
[11/14 15:15:00     12s]       -obj_type root
[11/14 15:15:00     12s]     }
[11/14 15:15:00     12s] }
