[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
[11/14 15:15:00     12s] 	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
