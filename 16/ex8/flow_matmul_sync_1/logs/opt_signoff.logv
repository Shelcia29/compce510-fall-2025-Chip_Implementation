[11/14 15:15:00     12s] 
[11/14 15:15:00     12s]     # hold in fast, 0.99v, -40c/0c/125c, cmax
[11/14 15:15:00     12s]     } elseif {$corn eq "fast" &&
[11/14 15:15:00     12s] 	      $volt eq "1p1v" &&
[11/14 15:15:00     12s] 	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
[11/14 15:15:00     12s] 	      ($rc eq "cmax")} {
[11/14 15:15:00     12s] 	
[11/14 15:15:00     12s] 	# -3.7% for launching clock cell
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
[11/14 15:15:00     12s] 	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
[11/14 15:15:00     12s] 	# -12.1% for data
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
[11/14 15:15:00     12s] 	# setup not checked
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
[11/14 15:15:00     12s] 
[11/14 15:15:00     12s] 	# -8.5% for launching clock net
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
[11/14 15:15:00     12s] 	# no derate on capturing clock net
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
