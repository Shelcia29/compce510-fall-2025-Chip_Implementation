[11/14 15:15:00     12s] @file 5:
[11/14 15:15:00     12s] @file 6: set MMMC_SETUP_VERSION "v1.0"
[11/14 15:15:00     12s] @file 7: # $TECHNOLOGY is set in tech_setup.tcl
