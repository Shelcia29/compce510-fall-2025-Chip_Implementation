[11/14 15:15:00     12s] 	# +6.0% for clock net
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
[11/14 15:15:00     12s] 	# hold not checked in this corner
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
[11/14 15:15:00     12s] 	# +6.0 for data net
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
[11/14 15:15:00     12s] 
[11/14 15:15:00     12s]     # hold in slow, 0.81v, -40c/125c, cmax
[11/14 15:15:00     12s]     } elseif {$corn eq "slow" &&
[11/14 15:15:00     12s] 	      $volt eq "0p9v" &&
