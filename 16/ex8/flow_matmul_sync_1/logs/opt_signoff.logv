[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
[11/14 15:15:00     12s] 	# +3.2% for capturing clock cell
[11/14 15:15:00     12s] 	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
