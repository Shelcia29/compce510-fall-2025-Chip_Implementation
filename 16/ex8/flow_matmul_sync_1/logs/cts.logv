[11/14 14:52:05     12s]     } elseif {$corn eq "fast" &&
[11/14 14:52:05     12s] 	      $volt eq "1p1v" &&
[11/14 14:52:05     12s] 	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
