[11/14 14:52:05     12s] 	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
[11/14 14:52:05     12s] 	# setup not checked
[11/14 14:52:05     12s] 	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
[11/14 14:52:05     12s] 
