[11/14 14:52:05     12s]     foreach dc $mmmc_vars(delay_corners) {
[11/14 14:52:05     12s] 
[11/14 14:52:05     12s] 	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
[11/14 14:52:05     12s] 
[11/14 14:52:05     12s] 	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
[11/14 14:52:05     12s] 	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 14:52:05     12s] 	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 14:52:05     12s] 	} else {
[11/14 14:52:05     12s] 	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
[11/14 14:52:05     12s] 	    exit 1
[11/14 14:52:05     12s] 	}
[11/14 14:52:05     12s]     }
[11/14 14:52:05     12s] }
