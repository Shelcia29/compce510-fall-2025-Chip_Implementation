[11/14 14:52:05     12s] 	
[11/14 14:52:05     12s] 	# -3.7% for launching clock cell
[11/14 14:52:05     12s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
[11/14 14:52:05     12s] 	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
