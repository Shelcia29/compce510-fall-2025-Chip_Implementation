[11/14 14:52:05     12s] 	# no derate on launching clock net
[11/14 14:52:05     12s] 	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
[11/14 14:52:05     12s] 	# +8.5% for capturing clock net
