[11/14 15:05:56     12s] 
[11/14 15:05:56     12s]     } elseif {$corn eq "fast" &&
[11/14 15:05:56     12s] 	$volt eq "1p1v" &&
[11/14 15:05:56     12s] 	$temp eq "0c"} {
[11/14 15:05:56     12s] 
[11/14 15:05:56     12s]         # DATA  @ 45mV   : 7.0%
[11/14 15:05:56     12s]         # DATA  @ 10c    : 0.4%
[11/14 15:05:56     12s]         # CLOCK @ 45mV   : 4.7%
[11/14 15:05:56     12s]         # CLOCK @ 10c    : 0.4%
[11/14 15:05:56     12s] 
