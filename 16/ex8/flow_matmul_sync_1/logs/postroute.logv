[11/14 15:05:56     12s] 	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
[11/14 15:05:56     12s] 
[11/14 15:05:56     12s] 	# -8.5% for launching clock net
[11/14 15:05:56     12s] 	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
