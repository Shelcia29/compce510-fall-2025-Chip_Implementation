[11/14 15:05:56     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.079"
[11/14 15:05:56     12s] 
[11/14 15:05:56     12s]      } elseif {$corn eq "fast" &&
[11/14 15:05:56     12s] 	$volt eq "1p1v" &&
[11/14 15:05:56     12s] 	$temp eq "125c"} {
[11/14 15:05:56     12s] 
[11/14 15:05:56     12s]         # DATA  @ 45mV   : 5.8%
[11/14 15:05:56     12s]         # DATA  @ 10c    : 0.5%
[11/14 15:05:56     12s]         # CLOCK @ 45mV   : 3.6%
[11/14 15:05:56     12s]         # CLOCK @ 10c    : 0.6%
[11/14 15:05:56     12s] 
[11/14 15:05:56     12s]         # For setup only derate clock
[11/14 15:05:56     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.042"
[11/14 15:05:56     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 15:05:56     12s]         # For hold in slow derate data & launching clock
