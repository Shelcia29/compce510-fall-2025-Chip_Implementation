[11/14 15:05:56     12s]       -category user_flow \
[11/14 15:05:56     12s]       -data_type [dict get $flow_vars $myAttr type] \
[11/14 15:05:56     12s]       -default [dict get $flow_vars $myAttr default] \
[11/14 15:05:56     12s]       -help_string [dict get $flow_vars $myAttr description] \
[11/14 15:05:56     12s]       -obj_type root
[11/14 15:05:56     12s]     }
[11/14 15:05:56     12s] }
