[11/14 15:05:56     12s]     foreach dc $mmmc_vars(delay_corners) {
[11/14 15:05:56     12s] 
[11/14 15:05:56     12s] 	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
[11/14 15:05:56     12s] 
[11/14 15:05:56     12s] 	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
[11/14 15:05:56     12s] 	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 15:05:56     12s] 	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 15:05:56     12s] 	} else {
