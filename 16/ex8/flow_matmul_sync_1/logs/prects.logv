[11/14 14:48:43     12s] 
[11/14 14:48:43     12s]     # hold in fast, 0.99v, -40c/0c/125c, cmax
[11/14 14:48:43     12s]     } elseif {$corn eq "fast" &&
[11/14 14:48:43     12s] 	      $volt eq "1p1v" &&
[11/14 14:48:43     12s] 	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
[11/14 14:48:43     12s] 	      ($rc eq "cmax")} {
