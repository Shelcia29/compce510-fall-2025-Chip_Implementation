[11/14 14:48:43     12s]       -default [dict get $flow_vars $myAttr default] \
[11/14 14:48:43     12s]       -help_string [dict get $flow_vars $myAttr description] \
[11/14 14:48:43     12s]       -obj_type root
[11/14 14:48:43     12s]     }
[11/14 14:48:43     12s] }
