[11/14 14:56:01     12s] ##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan generate_models opt_signoff}
[11/14 14:56:01     12s] #@ Begin verbose flow_step activate_views
[11/14 14:56:01     12s] @flow 2: set db [get_db flow_starting_db]
[11/14 14:56:01     12s] @flow 3: set flow [lindex [get_db flow_hier_path] end]
[11/14 14:56:01     12s] @flow 4: set setup_views [get_feature $flow -feature setup_views]
[11/14 14:56:01     12s] @flow 5: set hold_views [get_feature $flow -feature hold_views]
[11/14 14:56:01     12s] @flow 6: set leakage_view [get_feature $flow -feature leakage_view]
[11/14 14:56:01     12s] @flow 7: set dynamic_view [get_feature $flow -feature dynamic_view]
[11/14 14:56:01     12s] @flow 9: if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {...}
[11/14 14:56:01     12s] #@ End verbose flow_step activate_views
[11/14 14:56:01     12s] ##FLOW_KIT: enabling features from command line: {report_lec synth_spatial pnr_db_handoff add_scan generate_models opt_signoff}
[11/14 14:56:01     12s] #@ Begin verbose flow_step init_mcpu
[11/14 14:56:01     12s] @flow 2: # Multi host/cpu attributes
[11/14 14:56:01     12s] @flow 3: #-----------------------------------------------------------------------------
[11/14 14:56:01     12s] @flow 4: # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[11/14 14:56:01     12s] @flow 5: # the specified dist script.  This connects the number of CPUs being reserved
[11/14 14:56:01     12s] @flow 6: # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[11/14 14:56:01     12s] @flow 7: # a typical environment variable exported by distribution platforms and is
[11/14 14:56:01     12s] @flow 8: # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[11/14 14:56:01     12s] @flow 9: if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[11/14 14:56:01     12s] @flow 10: set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[11/14 14:56:01     12s] @flow 11: }
[11/14 14:56:01     12s] @flow 17: switch -glob {innovus} {
[11/14 14:56:01     12s] @@flow 0: set_multi_cpu_usage -verbose -local_cpu   $max_cpus
[11/14 14:56:01     12s] **WARN: (PRL-39):	Number of local CPUs specified (16) > Actual number of CPUs in the host (8). The lower value will be used.
[11/14 14:56:01     12s] set_multi_cpu_usage -local_cpu 8
[11/14 14:56:01     12s] @flow 1: if {[get_feature -feature opt_signoff]} {
[11/14 14:56:01     12s] @flow 2: if {[is_flow -inside flow:opt_signoff]} {...}
[11/14 14:56:01     12s] @flow 6: }
[11/14 14:56:01     12s] @flow 7: if {[get_feature -feature sta_eco]} {...}
[11/14 14:56:01     12s] @flow 13: }
[11/14 14:56:01     12s] #@ End verbose flow_step init_mcpu
[11/14 14:56:01     12s] End steps for plugin point Cadence.plugin.flowkit.read_db.pre
