[11/14 14:46:28     12s]     # slow, 0.81v, -40c
[11/14 14:46:28     12s]     if {$corn eq "slow" &&
[11/14 14:46:28     12s] 	$volt eq "0p9v" &&
[11/14 14:46:28     12s] 	$temp eq "m40c"} {
[11/14 14:46:28     12s]         
[11/14 14:46:28     12s]         # DATA  @ 20.3mV : 7.4%
[11/14 14:46:28     12s]         # DATA  @ 10c    : 0.9%
[11/14 14:46:28     12s]         # CLOCK @ 20.3mV : 5.4%
[11/14 14:46:28     12s]         # CLOCK @ 10c    : 0.7%
[11/14 14:46:28     12s] 
[11/14 14:46:28     12s]         # For setup only derate clock
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.054"
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 14:46:28     12s]         # For hold in slow derate data & launching clock
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
[11/14 14:46:28     12s] 
[11/14 14:46:28     12s]     } elseif {$corn eq "slow" &&
[11/14 14:46:28     12s] 	$volt eq "0p9v" &&
[11/14 14:46:28     12s] 	$temp eq "125c"} {
[11/14 14:46:28     12s]        
[11/14 14:46:28     12s]         # DATA  @ 20.3mV : 5.0%
[11/14 14:46:28     12s]         # DATA  @ 10c    : 0.3%
[11/14 14:46:28     12s]         # CLOCK @ 20.3mV : 3.5%
[11/14 14:46:28     12s]         # CLOCK @ 10c    : 0.2%
[11/14 14:46:28     12s] 
[11/14 14:46:28     12s]         # For setup only derate clock
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.037"
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 14:46:28     12s]         # For hold in slow derate data & launching clock
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.037"
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.053"
[11/14 14:46:28     12s] 
[11/14 14:46:28     12s]     } elseif {$corn eq "slow" &&
[11/14 14:46:28     12s] 	$volt eq "0p9v" &&
[11/14 14:46:28     12s] 	$temp eq "0c"} {
[11/14 14:46:28     12s]        
[11/14 14:46:28     12s]         # DATA  @ 20.3mV : 6.6%
[11/14 14:46:28     12s]         # DATA  @ 10c    : 0.8%
[11/14 14:46:28     12s]         # CLOCK @ 20.3mV : 4.9%
[11/14 14:46:28     12s]         # CLOCK @ 10c    : 0.6%
[11/14 14:46:28     12s] 
[11/14 14:46:28     12s]         # For setup only derate clock
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_clock_cell_late)   "0.055"
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_data_cell_late)    "0.0"
[11/14 14:46:28     12s]         # For hold in slow derate data & launching clock
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.055"
[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.074"
[11/14 14:46:28     12s] 
[11/14 14:46:28     12s]     } elseif {$corn eq "fast" &&
[11/14 14:46:28     12s] 	$volt eq "1p1v" &&
[11/14 14:46:28     12s] 	$temp eq "m40c"} {
[11/14 14:46:28     12s]        
[11/14 14:46:28     12s]         # DATA  @ 45mV   : 7.4%
[11/14 14:46:28     12s]         # DATA  @ 10c    : 0.5%
[11/14 14:46:28     12s]         # CLOCK @ 45mV   : 5.1%
[11/14 14:46:28     12s]         # CLOCK @ 10c    : 0.6%
[11/14 14:46:28     12s] 
