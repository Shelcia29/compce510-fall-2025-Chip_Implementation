[11/14 14:46:28     12s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.063"
[11/14 14:46:28     12s] 
[11/14 14:46:28     12s]     } elseif {$corn eq "fast" &&
[11/14 14:46:28     12s] 	$volt eq "1p1v" &&
[11/14 14:46:28     12s] 	$temp eq "0c"} {
[11/14 14:46:28     12s] 
[11/14 14:46:28     12s]         # DATA  @ 45mV   : 7.0%
[11/14 14:46:28     12s]         # DATA  @ 10c    : 0.4%
[11/14 14:46:28     12s]         # CLOCK @ 45mV   : 4.7%
[11/14 14:46:28     12s]         # CLOCK @ 10c    : 0.4%
[11/14 14:46:28     12s] 
