[11/14 14:47:24     62s] @flow 25: # merge .libs to one single multimode file
[11/14 14:47:24     62s] @flow 26: foreach corner_name [get_db -u [get_db analysis_views -if {.is_setup||.is_hold||.is_leakage||.is_dynamic}] .delay_corner.name] {
[11/14 14:47:24     62s] 
[11/14 14:47:24     62s] 	set constraint_modes [join [get_db -u analysis_views .constraint_mode.name] ","]
[11/14 14:47:24     62s] 	set files [glob models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}_{${constraint_modes}}.lib]
[11/14 14:47:24     62s] 	if {![llength $files]} {
[11/14 14:47:24     62s] 	    puts "Error: No files corresponding to corner: ${corner_name} and constraint_modes: ${constraint_modes} in models/[get_db flow_report_name]/"
[11/14 14:47:24     62s] 	    continue
[11/14 14:47:24     62s] 	}
[11/14 14:47:24     62s] 	set mode_list [list ]
[11/14 14:47:24     62s] 	set mode_group ""
[11/14 14:47:24     62s] 	foreach ff $files {
[11/14 14:47:24     62s] 	    set mode ""
[11/14 14:47:24     62s] 	    set cmodes [regsub -all "," $constraint_modes "|"]
[11/14 14:47:24     62s] 	    if {![regexp "_(${cmodes})\.lib" $ff -> mode]} {
[11/14 14:47:24     62s] 		puts "Error: Bad filename $ff"
[11/14 14:47:24     62s] 		continue
[11/14 14:47:24     62s] 	    }
[11/14 14:47:24     62s] 	    lappend mode_list $mode
[11/14 14:47:24     62s] 	    if {$mode_group == ""} {
[11/14 14:47:24     62s] 		set mode_group $mode
[11/14 14:47:24     62s] 	    } else {
[11/14 14:47:24     62s] 		set mode_group ${mode_group}_${mode}
[11/14 14:47:24     62s] 	    }
[11/14 14:47:24     62s] 	}
[11/14 14:47:24     62s] 
[11/14 14:47:24     62s] 	merge_model_timing -input_library_file $files  -mode_group $mode_group  -modes $mode_list  -merged_library_file models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}.lib
[11/14 14:47:24     62s]     }
