[11/14 15:45:55     37s] @flow 3: global mmmc_vars
[11/14 15:45:55     37s] @flow 4: foreach active_av [get_db [get_db analysis_views -if {.is_setup || .is_hold}] .name] {
[11/14 15:45:55     37s] 	# SOCV RC variation
[11/14 15:45:55     37s] 	set_socv_rc_variation_factor -view ${active_av} -late  $mmmc_vars(late_rc_variation_factor)
[11/14 15:45:55     37s] 	set_socv_rc_variation_factor -view ${active_av} -early $mmmc_vars(early_rc_variation_factor)
[11/14 15:45:55     37s] 
[11/14 15:45:55     37s]     }
[11/14 15:45:55     37s] @@flow 11: set_socv_reporting_nsigma_multiplier -hold $mmmc_vars(timing_socv_analysis_nsigma_multiplier)  -setup $mmmc_vars(timing_socv_analysis_nsigma_multiplier) -views [get_db [get_db analysis_views -if {.is_setup || .is_hold}] .name]
[11/14 15:45:55     37s] @flow 13: foreach dc [get_db [get_db delay_corners] .name] {
[11/14 15:45:55     37s]         regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
[11/14 15:45:55     37s] 
[11/14 15:45:55     37s]         # If rc-corner name ends in _T it is a setup corner
[11/14 15:45:55     37s]         if {[regexp {_T$} $rc]} {
[11/14 15:45:55     37s]             # For setup only derate capturing clock -> early
[11/14 15:45:55     37s]             set_timing_derate -add -clock -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},socv_clock_cell_early)
[11/14 15:45:55     37s]         } else {
[11/14 15:45:55     37s]             if {[regexp {ss} $corn]} {
[11/14 15:45:55     37s]                 # For hold in SS derate launching clock and data
[11/14 15:45:55     37s]                 set_timing_derate -add -data  -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},socv_data_cell_early)
[11/14 15:45:55     37s]                 set_timing_derate -add -clock -cell_delay -early -delay_corner ${dc} $mmmc_vars(${dc},socv_clock_cell_early)
[11/14 15:45:55     37s]             } else {
[11/14 15:45:55     37s]                 # For hold in FF only derate capturing clock -> late
[11/14 15:45:55     37s]                 set_timing_derate -add -clock -cell_delay -late  -delay_corner ${dc} $mmmc_vars(${dc},socv_clock_cell_late)
[11/14 15:45:55     37s]             }
[11/14 15:45:55     37s]         }
[11/14 15:45:55     37s]     }
[11/14 15:45:55     37s] #@ End verbose flow_step sta.tempus_manage_derating
