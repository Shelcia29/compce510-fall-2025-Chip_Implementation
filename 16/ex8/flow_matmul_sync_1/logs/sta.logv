[11/14 15:45:27     11s] @file 10: if {1} {
[11/14 15:45:27     11s] @file 11: array unset global_macro_exportdir
[11/14 15:45:27     11s] @file 12:
[11/14 15:45:27     11s] @file 13: set macro_scan_abstract_filelist [list ]
[11/14 15:45:27     11s] @file 14: set macro_lef_filelist [list ]
[11/14 15:45:27     11s] @file 15:
[11/14 15:45:27     11s] @file 16:
[11/14 15:45:27     11s] @file 17: array unset memarray
[11/14 15:45:27     11s] @file 18:
[11/14 15:45:27     11s] @file 19: # Go through global settings for macros and see if there's a local override
[11/14 15:45:27     11s] @file 20: foreach {blockname blockpath} [array get global_macro_exportdir] {
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     # do not read in a model for DUT
[11/14 15:45:27     11s]     if {![string compare $blockname [get_db flow_vars_design_name]]} {
[11/14 15:45:27     11s] 	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT"
[11/14 15:45:27     11s] 	continue
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     if {[info exists local_macro_exportdir($blockname)]} {
[11/14 15:45:27     11s] 	if {[string compare $blockpath $local_macro_exportdir($blockname)]} {
[11/14 15:45:27     11s] 	    puts "Warning([info script]): Overriding global setting for $blockname ->"
[11/14 15:45:27     11s] 	    puts "\#OLD\#: $blockpath"
[11/14 15:45:27     11s] 	    puts "\#NEW\#: $local_macro_exportdir($blockname)"
[11/14 15:45:27     11s] 	    set $blockpath $local_macro_exportdir($blockname)
[11/14 15:45:27     11s] 	}
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     # scan abstract for DFT
[11/14 15:45:27     11s]     if {[file exists $blockpath/dbs/syn_opt/$blockname.scan.abstract]} {
[11/14 15:45:27     11s] 	lappend macro_scan_abstract_filelist $blockpath/dbs/syn_opt/$blockname.scan.abstract
[11/14 15:45:27     11s]     } else {
[11/14 15:45:27     11s] 	puts "Error([info script]): scan abstract not found for block $blockname from $blockpath/dbs/syn_opt"
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     # MACROs
[11/14 15:45:27     11s]     if {[file exists $blockpath/models/opt_signoff/$blockname.lef]} {
[11/14 15:45:27     11s] 	lappend macro_lef_filelist $blockpath/models/opt_signoff/$blockname.lef
[11/14 15:45:27     11s]     } else {
[11/14 15:45:27     11s] 	puts "Fatal([info script]): .lef not found for block $blockname from $blockpath/models/opt_signoff"
[11/14 15:45:27     11s] 	exit 1
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     # Read .lib -files
[11/14 15:45:27     11s]     # mmmc_vars(delay_corners) is set in mmmc_setup.tcl
[11/14 15:45:27     11s]     foreach dc $mmmc_vars(delay_corners) {
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s] 	regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s] 	if {[file exists $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib]} {
[11/14 15:45:27     11s] 	    lappend mmmc_vars(${dc},timing_nldm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 15:45:27     11s] 	    lappend mmmc_vars(${dc},timing_ecsm) $blockpath/models/opt_signoff.sta/$blockname.${corn}_${volt}_${temp}_${rc}.lib
[11/14 15:45:27     11s] 	} else {
[11/14 15:45:27     11s] 	    puts "Fatal([info script]): .lib not found for block $blockname from $blockpath/models/opt_signoff.sta"
[11/14 15:45:27     11s] 	    exit 1
[11/14 15:45:27     11s] 	}
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] }
[11/14 15:45:27     11s] @file 67: # sanity check to see if global setting are missing block which are defined in local settings!
[11/14 15:45:27     11s] @file 68: foreach {blockname blockpath} [array get local_macro_exportdir] {
[11/14 15:45:27     11s]     # do not read in a model for DUT
[11/14 15:45:27     11s]     if {![string compare $blockname [get_db flow_vars_design_name]]} {
[11/14 15:45:27     11s] 	puts "Info([info script]): Skipping reading in model for $blockname since it's DUT. Remove the definition from local macro settings!"
[11/14 15:45:27     11s] 	continue
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     set found 0
[11/14 15:45:27     11s]     if {[info exists global_macro_exportdir($blockname)]} {
[11/14 15:45:27     11s] 	set found 1
