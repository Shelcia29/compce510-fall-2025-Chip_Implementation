[11/14 15:45:32     16s] @file 9:
[11/14 15:45:32     16s] @file 10: # Delay corner list
[11/14 15:45:32     16s] @file 11: set mmmc_vars(delay_corners) \
[11/14 15:45:32     16s]     [list \
[11/14 15:45:32     16s] 	 slow_0p9v_125c_cmax \
[11/14 15:45:32     16s] 	 fast_1p1v_0c_cmin \
[11/14 15:45:32     16s] 	 ]
[11/14 15:45:32     16s] @file 16:
[11/14 15:45:32     16s] @file 17:
[11/14 15:45:32     16s] @file 18: # Read .lib -files
[11/14 15:45:32     16s] @file 19: foreach dc $mmmc_vars(delay_corners) {
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s]     regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s]     # qrc techfile
[11/14 15:45:32     16s]     set mmmc_vars("${rc}_${temp}",qrc_tech) "[get_db flow_vars_qrc_tech_directory]/gpdk045.tch"
[11/14 15:45:32     16s]     # temperature
[11/14 15:45:32     16s]     if {${temp} == "m40c"} {
[11/14 15:45:32     16s] 	set mmmc_vars("${rc}_${temp}",temperature) "-40"
[11/14 15:45:32     16s]     } elseif {${temp} == "125c"} {
[11/14 15:45:32     16s] 	set mmmc_vars("${rc}_${temp}",temperature) "125"
[11/14 15:45:32     16s]     } elseif {${temp} == "0c"} {
[11/14 15:45:32     16s] 	set mmmc_vars("${rc}_${temp}",temperature) "0"
[11/14 15:45:32     16s]     } else {
[11/14 15:45:32     16s] 	set mmmc_vars("${rc}_${temp}",temperature) "25"
[11/14 15:45:32     16s]     }
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s]     ###########################################
[11/14 15:45:32     16s]     # OCVs &  Clock uncertainties for FLAT OCV
[11/14 15:45:32     16s]     ###########################################
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s]     # use following uncertainties
[11/14 15:45:32     16s]     # FUNC:
[11/14 15:45:32     16s]     # setup:
[11/14 15:45:32     16s]     # clock jitter: defined through clock cycle
[11/14 15:45:32     16s]     # TECH uncertainty: 25ps
[11/14 15:45:32     16s]     # extra uncertainty (implementation): 20ps
[11/14 15:45:32     16s]     # extra uncertainty (signoff STA): 0ps
[11/14 15:45:32     16s]     # hold:
[11/14 15:45:32     16s]     # TECH uncertainty (SSG): 50ps
[11/14 15:45:32     16s]     # TECH uncertainty (fast): 40ps
[11/14 15:45:32     16s]     # extra uncertainty (implementation): 15ps
[11/14 15:45:32     16s]     # extra uncertainty (signoff STA): 0ps
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s]     # Note, add 1% OCV on top of previous to match LVF
[11/14 15:45:32     16s]     # so flat values below have 0.01 added (subtracted) because of this
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s]     # setup in slow, 0.81v, -40C/125c, cmax
[11/14 15:45:32     16s]     if {$corn eq "slow" &&
[11/14 15:45:32     16s] 	$volt eq "0p9v" &&
[11/14 15:45:32     16s] 	($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
[11/14 15:45:32     16s] 	($rc eq "cmax")} {
[11/14 15:45:32     16s] 	
[11/14 15:45:32     16s] 	# -2.0% + -3.7% (10mV V-margin) + -0.6% (10c T-margin) for capturing clock cell
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.927"
[11/14 15:45:32     16s] 	# +2.0% for launching clock cell
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_cell_late)   "1.03"
[11/14 15:45:32     16s] 	# hold not checked in this corner
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_cell_early)   "1.0"
[11/14 15:45:32     16s] 	# + 6.9% on data cell
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_cell_late)    "1.079"
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s] 	# -6.0% for clock net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_net_early)  "0.93"
[11/14 15:45:32     16s] 	# +6.0% for clock net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_net_late)   "1.07"
[11/14 15:45:32     16s] 	# hold not checked in this corner
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_net_early)   "1.0"
[11/14 15:45:32     16s] 	# +6.0 for data net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_net_late)    "1.07"
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s]     # hold in slow, 0.81v, -40c/125c, cmax
[11/14 15:45:32     16s]     } elseif {$corn eq "slow" &&
[11/14 15:45:32     16s] 	      $volt eq "0p9v" &&
[11/14 15:45:32     16s] 	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
[11/14 15:45:32     16s] 	      ($rc eq "cmax")} {
[11/14 15:45:32     16s] 	
[11/14 15:45:32     16s] 	# -3.2% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for launching clock cell
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.882"
[11/14 15:45:32     16s] 	# +3.2% for capturing clock cell
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_cell_late)   "1.042"
[11/14 15:45:32     16s] 	# -9.7% + -7.0% (20mV V-margin) + -0.6% (10c T-margin) for data
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_cell_early)   "0.817"
[11/14 15:45:32     16s] 	# setup not checked
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s] 	# -8.5% for launching clock net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
[11/14 15:45:32     16s] 	# no derate on capturing clock net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
[11/14 15:45:32     16s] 	# -8.5% for data net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
[11/14 15:45:32     16s] 	# setup not checked
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s]     # hold in fast, 0.99v, -40c/0c/125c, cmax
[11/14 15:45:32     16s]     } elseif {$corn eq "fast" &&
[11/14 15:45:32     16s] 	      $volt eq "1p1v" &&
[11/14 15:45:32     16s] 	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
[11/14 15:45:32     16s] 	      ($rc eq "cmax")} {
[11/14 15:45:32     16s] 	
[11/14 15:45:32     16s] 	# -3.7% for launching clock cell
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_cell_early)  "0.953"
[11/14 15:45:32     16s] 	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_cell_late)   "1.103"
[11/14 15:45:32     16s] 	# -12.1% for data
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
[11/14 15:45:32     16s] 	# setup not checked
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s] 	# -8.5% for launching clock net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_net_early)  "0.905"
[11/14 15:45:32     16s] 	# no derate on capturing clock net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_net_late)   "1.0"
[11/14 15:45:32     16s] 	# -8.5% for data net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_net_early)   "0.905"
[11/14 15:45:32     16s] 	# setup not checked
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_net_late)    "1.0"
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s]     # hold in fast, 0.99v, -40c/0c/125c, cmin
[11/14 15:45:32     16s]     } elseif {$corn eq "fast" &&
[11/14 15:45:32     16s] 	      $volt eq "1p1v" &&
[11/14 15:45:32     16s] 	      ($temp eq "m40c" || $temp eq "0c" || $temp eq "125c") &&
[11/14 15:45:32     16s] 	      ($rc eq "cmin")} {
[11/14 15:45:32     16s] 	
