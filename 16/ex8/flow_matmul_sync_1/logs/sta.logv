[11/14 15:45:27     11s] @file 1: # Flowkit v19.10-s008_1
[11/14 15:45:27     11s] @file 2: # Time-stamp: <2025-06-08 13:33:38 qftele>
[11/14 15:45:27     11s] @file 3:
[11/14 15:45:27     11s] @file 4:
[11/14 15:45:27     11s] @file 5: ##############################################################################
[11/14 15:45:27     11s] @file 6: ## CONSTRAINT MODES
[11/14 15:45:27     11s] @file 7: ##############################################################################
[11/14 15:45:27     11s] @file 8: foreach constraint_mode $mmmc_vars(constraint_modes) {
[11/14 15:45:27     11s]     create_constraint_mode -name $constraint_mode -sdc_files $mmmc_vars($constraint_mode,sdc_files)
[11/14 15:45:27     11s] }
[11/14 15:45:27     11s] @file 11:
[11/14 15:45:27     11s] @file 12: array unset tcs
[11/14 15:45:27     11s] @file 13: array unset rcs
[11/14 15:45:27     11s] @file 14: array unset ocs
[11/14 15:45:27     11s] @file 15: foreach dc $mmmc_vars(delay_corners) {
[11/14 15:45:27     11s]     regexp {([^_]+)_([^_]+)_([^_]+)_([\w]+)} $dc -> corn volt temp rc
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     # temperature
[11/14 15:45:27     11s]     set temp_val "0.0"
[11/14 15:45:27     11s]     if {${temp} == "m40c" || ${temp} == "M40C"} {
[11/14 15:45:27     11s]         set temp_val "-40.0"
[11/14 15:45:27     11s]     } elseif {${temp} == "125c" || ${temp} == "125C"} {
[11/14 15:45:27     11s]         set temp_val "125.0"
[11/14 15:45:27     11s]     } elseif {${temp} == "25c" || ${temp} == "25C"} {
[11/14 15:45:27     11s]         set temp_val "25.0"
[11/14 15:45:27     11s]     } elseif {${temp} == "85c" || ${temp} == "85C"} {
[11/14 15:45:27     11s]         set temp_val "85.0"
[11/14 15:45:27     11s]     } else {
[11/14 15:45:27     11s]         set temp_val "0.0"
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s]     
[11/14 15:45:27     11s]     # voltage
[11/14 15:45:27     11s]     set volt_val "0.9"
[11/14 15:45:27     11s]     set volt_val [regsub {[v|V]} [regsub {[p|P]} $volt "."] ""]
[11/14 15:45:27     11s]     
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     ## LIBRARY SETS
[11/14 15:45:27     11s]     if {[get_db program_short_name] == "genus"} {
[11/14 15:45:27     11s] 	create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_nldm)
[11/14 15:45:27     11s]     } elseif {[get_db program_short_name] == "innovus"} {
[11/14 15:45:27     11s] 	create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
[11/14 15:45:27     11s]     } elseif {[get_db program_short_name] == "tempus"} {
[11/14 15:45:27     11s]         if {[info exist $mmmc_vars(${dc},timing_lvf)] && [info exist $mmmc_vars(${dc},timing_socv)]} {
[11/14 15:45:27     11s]             create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_lvf) -socv $mmmc_vars(${dc},timing_socv)
[11/14 15:45:27     11s]         } else {
[11/14 15:45:27     11s]             create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
[11/14 15:45:27     11s]         }
[11/14 15:45:27     11s]     } elseif {[get_db program_short_name] == "voltus"} {
[11/14 15:45:27     11s]         if {[info exist $mmmc_vars(${dc},timing_lvf)] && [info exist $mmmc_vars(${dc},timing_socv)]} {
[11/14 15:45:27     11s]             create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_lvf) -socv $mmmc_vars(${dc},timing_socv)
[11/14 15:45:27     11s]         } else {
[11/14 15:45:27     11s]             create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
[11/14 15:45:27     11s]         }
[11/14 15:45:27     11s]     } else {
[11/14 15:45:27     11s] 	create_library_set -name "${corn}_${volt}_${temp}_ls" -timing $mmmc_vars(${dc},timing_ecsm)
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     ## OPERATING CONDITIONS
[11/14 15:45:27     11s]     if {![info exists ocs("${volt}_${temp}")]} {
[11/14 15:45:27     11s] 	create_opcond -name "${volt}_${temp}" -process 1.0 -voltage $volt_val -temperature $temp_val
[11/14 15:45:27     11s] 	set ocs("${volt}_${temp}") 1
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     ## TIMING CONDITIONS
[11/14 15:45:27     11s]     if {![info exists tcs("${corn}_${volt}_${temp}")]} {
[11/14 15:45:27     11s] 	create_timing_condition -name "${corn}_${volt}_${temp}" -library_sets "${corn}_${volt}_${temp}_ls" -opcond "${volt}_${temp}"
[11/14 15:45:27     11s] 	set tcs("${corn}_${volt}_${temp}") 1
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s]     
[11/14 15:45:27     11s]     ## RC CORNERS
[11/14 15:45:27     11s]     if {![info exists rcs("${rc}_${temp}")]} {
[11/14 15:45:27     11s] 	create_rc_corner -name "${rc}_${temp}" -qrc_tech $mmmc_vars("${rc}_${temp}",qrc_tech) -temperature $mmmc_vars("${rc}_${temp}",temperature)
[11/14 15:45:27     11s] 	set rcs("${rc}_${temp}") 1
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     ## DELAY CORNERS
[11/14 15:45:27     11s]     create_delay_corner -name ${dc} -timing_condition "${corn}_${volt}_${temp}" -rc_corner "${rc}_${temp}"
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     ## ANALYSIS VIEWS
[11/14 15:45:27     11s]     foreach constraint_mode $mmmc_vars(constraint_modes) {
[11/14 15:45:27     11s] 	create_analysis_view -name "${dc}_${constraint_mode}" -delay_corner $dc -constraint_mode $constraint_mode
[11/14 15:45:27     11s]     }
[11/14 15:45:27     11s] }
