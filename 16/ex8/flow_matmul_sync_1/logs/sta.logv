[11/14 15:49:22    129s] @flow 44: # merge .libs to one single multimode file
[11/14 15:49:22    129s] @flow 45: foreach corner_name [get_db -u [get_db analysis_views "[get_db  flow_vars_setup_pnr_active_views] [get_db flow_vars_hold_pnr_active_views]"] .delay_corner.name] {
[11/14 15:49:22    129s] 
[11/14 15:49:22    129s]         set constraint_modes [join [get_db -u analysis_views .constraint_mode.name] ","]
[11/14 15:49:22    129s]         set files [glob models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}_{${constraint_modes}}.lib]
[11/14 15:49:22    129s] 	if {![llength $files]} {
[11/14 15:49:22    129s] 	    puts "Error: No files corresponding to corner: ${corner_name} and constraint_modes: ${constraint_modes} in models/[get_db flow_report_name]/"
[11/14 15:49:22    129s] 	    continue
[11/14 15:49:22    129s] 	}
[11/14 15:49:22    129s] 	set mode_list [list ]
[11/14 15:49:22    129s] 	set mode_group ""
[11/14 15:49:22    129s] 	foreach ff $files {
[11/14 15:49:22    129s] 	    set mode ""
[11/14 15:49:22    129s] 	    set cmodes [regsub -all "," $constraint_modes "|"]
[11/14 15:49:22    129s] 	    if {![regexp "_(${cmodes})\.lib" $ff -> mode]} {
[11/14 15:49:22    129s] 		puts "Error: Bad filename $ff"
[11/14 15:49:22    129s] 		continue
[11/14 15:49:22    129s] 	    }
[11/14 15:49:22    129s] 	    lappend mode_list $mode
[11/14 15:49:22    129s] 	    if {$mode_group == ""} {
[11/14 15:49:22    129s] 		set mode_group $mode
[11/14 15:49:22    129s] 	    } else {
[11/14 15:49:22    129s] 		set mode_group ${mode_group}_${mode}
[11/14 15:49:22    129s] 	    }
[11/14 15:49:22    129s] 	}
[11/14 15:49:22    129s] 
[11/14 15:49:22    129s]         if {[llength $files] > 1} {
[11/14 15:49:22    129s]             merge_model_timing -input_library_file $files  -mode_group $mode_group  -modes $mode_list  -merged_library_file models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}.lib
[11/14 15:49:22    129s]         } else {
[11/14 15:49:22    129s]             # we only have one mode
[11/14 15:49:22    129s]             exec cp [lindex $files 0] models/[get_db flow_report_name]/[get_db [current_design] .name].${corner_name}.lib
[11/14 15:49:22    129s]         }
[11/14 15:49:22    129s]     }
