[11/14 15:45:32     16s] 	# +3.7% + +5.1% (30mV V-margin) + 0.5% (10c T-margin) for capturing clock cell
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_cell_late)   "1.083"
[11/14 15:45:32     16s] 	# -12.1% for data
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_cell_early)   "0.869"
[11/14 15:45:32     16s] 	# setup not checked
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_data_cell_late)    "1.0"
[11/14 15:45:32     16s] 
[11/14 15:45:32     16s] 	# no derate on launching clock net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_net_early)  "1.0"
[11/14 15:45:32     16s] 	# +8.5% for capturing clock net
[11/14 15:45:32     16s] 	set mmmc_vars(${dc},flat_clock_net_late)   "1.075"
[11/14 15:45:32     16s] 	# no derate for data net
