[11/14 15:45:27     11s]         # For hold in slow derate data & launching clock
[11/14 15:45:27     11s] 	set mmmc_vars(${dc},socv_clock_cell_early)  "-0.061"
[11/14 15:45:27     11s] 	set mmmc_vars(${dc},socv_data_cell_early)   "-0.083"
[11/14 15:45:27     11s] 
[11/14 15:45:27     11s]     } elseif {$corn eq "slow" &&
[11/14 15:45:27     11s] 	$volt eq "0p9v" &&
