[11/14 15:46:28     83s] #@ Begin verbose flow_step sta.tempus_generate_etm
[11/14 15:46:28     83s] @flow 2: if {![file exists models]} {...}
[11/14 15:46:28     83s] @flow 3: if {![file exists models/[get_db flow_report_name]]} {
[11/14 15:46:28     83s] @flow 3: file mkdir models/[get_db flow_report_name]
[11/14 15:46:28     83s] @flow 3: }
[11/14 15:46:28     83s] @flow 4: set spef_dir  [file normalize [file join [get_db flow_working_directory] [get_db flow_db_directory] [file rootname [get_db flow_report_name]]]]
[11/14 15:46:28     83s] @flow 5: puts "Info: Using SPEF-dir: $spef_dir"
[11/14 15:46:28     83s] Info: Using SPEF-dir: /home/student/16/ex8/flow_matmul_sync_1/dbs/opt_signoff
[11/14 15:46:28     83s] @flow 6: set active_setup_views [get_db [get_db analysis_views -if {.is_setup||.is_leakage||.is_dynamic}] .name]
[11/14 15:46:28     83s] @flow 7: set active_hold_views [get_db [get_db analysis_views -if {.is_hold}] .name]
[11/14 15:46:28     83s] @flow 9: # ETM model must be generated with the following setting
[11/14 15:46:28     83s] @@flow 10: set_db timing_extract_model_slew_propagation_mode path_based_slew
[11/14 15:46:28     83s] @flow 11: # The following setting speeds up ETM generation
[11/14 15:46:28     83s] @@flow 12: set_db timing_enable_timing_window_pessimism_removal false
[11/14 15:46:28     83s] @flow 14: # do ETM models only for PNR views
[11/14 15:46:28     83s] @flow 15: set pnr_aviews [get_db analysis_views  "[get_db  flow_vars_setup_pnr_active_views] [get_db flow_vars_hold_pnr_active_views]"]
[11/14 15:46:28     83s] @flow 16: set pnr_corners [get_db -u ${pnr_aviews} .delay_corner.late_rc_corner.name]
[11/14 15:46:28     83s] @flow 17: #set all_corners [get_db -u [get_db analysis_views -if {.is_setup||.is_hold||.is_leakage||.is_dynamic}] .delay_corner.late_rc_corner.name]
[11/14 15:46:28     83s] @flow 18: #set all_aviews [get_db analysis_views -if {(.is_setup||.is_hold||.is_leakage||.is_dynamic)}]
[11/14 15:46:28     83s] @flow 19: foreach corner_name $pnr_corners {
[11/14 15:46:28     83s] 
[11/14 15:46:28     83s] 	# rc_corner for which we read parasitics must be active, so we must first activate one before reading spef.
[11/14 15:46:28     83s] 	foreach view_dpo $pnr_aviews {
[11/14 15:46:28     83s] 	    if {[get_db $view_dpo .delay_corner.late_rc_corner.name] == $corner_name} {
[11/14 15:46:28     83s] 		puts "Info: Temp set_analysis_view in order to load parasitics"
[11/14 15:46:28     83s] 		set_analysis_view -setup [get_db $view_dpo .name] -hold [get_db $view_dpo .name]
[11/14 15:46:28     83s] 		break
[11/14 15:46:28     83s] 	    }
[11/14 15:46:28     83s] 	}
[11/14 15:46:28     83s] 	set spef_file [glob -nocomplain -directory ${spef_dir} *.${corner_name}.spef*]
[11/14 15:46:28     83s] 	puts "Info: Reading SPEF-file ${spef_file} for corner $corner_name"
[11/14 15:46:28     83s] 	read_spef -rc_corner ${corner_name} ${spef_file}
[11/14 15:46:28     83s] 
[11/14 15:46:28     83s] 	foreach view_dpo $pnr_aviews {
[11/14 15:46:28     83s] 	    if {[get_db $view_dpo .delay_corner.late_rc_corner.name] == $corner_name} {
[11/14 15:46:28     83s] 		puts "Info: Writing timing model for analysis_view [get_db $view_dpo .name]"
[11/14 15:46:28     83s] 		set_analysis_view -setup [get_db $view_dpo .name] -hold [get_db $view_dpo .name]
[11/14 15:46:28     83s] 		
[11/14 15:46:28     83s] 		write_timing_model -include_power_ground [file join models [get_db flow_report_name] [get_db [current_design] .name].[get_db $view_dpo .name].lib] -view [get_db $view_dpo .name]
[11/14 15:46:28     83s] 	    }
[11/14 15:46:28     83s] 	}
[11/14 15:46:28     83s]     }
[11/14 15:46:28     83s] Info: Temp set_analysis_view in order to load parasitics
