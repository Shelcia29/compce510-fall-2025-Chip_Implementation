upf_version 2.0
create_supply_set Set_VDD_VSS
create_power_domain pd_aon -include_scope
create_supply_port VSS -direction {in}
create_supply_port VDD -direction {in}
create_supply_net VDD
create_supply_net VSS
create_supply_set Set_VDD_VSS -function {power VDD} -function {ground VSS} -update
create_power_domain pd_aon -supply {primary Set_VDD_VSS} -update
connect_supply_net VDD -ports {VDD}
connect_supply_net VSS -ports {VSS}
add_power_state  Set_VDD_VSS \
 -state  on {-supply_expr {power == `{FULL_ON, 0.9} && ground == `{FULL_ON, 0.0}}}
add_power_state  pd_aon \
 -state  aon_state {-logic_expr {Set_VDD_VSS == on}}

