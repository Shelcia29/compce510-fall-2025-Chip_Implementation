proc jls::ckattr_jls_exe {obj args} {

  # assure that specified executable is ok
  if {$args eq "default_search_order"} {
    # default value - return ok
    return 1
  } elseif {[auto_execok $args] eq ""} {
    jls::puts_send "Can not find specified executable: $args"
    return 0
  }
  return 1
}
define_attribute joules_executable -data_type string -obj_type root -category joules -help_string {Joules executable to be used for encapsulated runs.} -check_function {jls::ckattr_jls_exe} -default_value {/opt/soc/eda/cadence/DDI231/bin/joules} -hidden -quiet
