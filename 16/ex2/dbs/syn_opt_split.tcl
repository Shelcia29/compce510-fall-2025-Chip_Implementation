    exec sed -i s:SDF_LIST:\([get_db flow_vars_sdf_list]\):g [get_db flow_vars_data_directory]/compiled_sdf/compile_sdf.sh
    catch {exec -ignorestderr [get_db flow_vars_data_directory]/compiled_sdf/compile_sdf.sh}
