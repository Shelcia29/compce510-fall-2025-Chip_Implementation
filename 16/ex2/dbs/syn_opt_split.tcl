    #- Number of scan chains determined automatically
    #define_scan_chain -create_ports -sdi sdi -sdo sdo -terminal_lockup level_sensitive

    define_scan_chain -sdi scan_in0 -sdo scan_out0 -create_ports -name scan_chain_0

