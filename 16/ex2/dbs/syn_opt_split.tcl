        puts $FH "source [file join [get_db flow_database_directory] [get_db flow_report_name] [get_db [current_design] .name].preserve.tcl]"
    }
    puts $FH ""
    
    close $FH
    
    set_db flow_post_db_overwrite $release_script

}
