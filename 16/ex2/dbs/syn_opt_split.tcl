    if {[file exists scripts/mmmc_config.tcl]} {
        puts $FH "read_mmmc scripts/mmmc_config.tcl"
    } else {
        puts $FH "read_mmmc \[get_db flow_source_directory\]/mmmc_config.tcl"
    }
    puts $FH ""
    puts $FH "read_physical -lef \[get_db flow_vars_lef_list\]"
